# Auto detect text files and perform LF normalization
* text=auto

# Scientific evaluator assets are byte-frozen and must use canonical LF endings.
tests/evaluator_assets/todo_smoke_*_checks.py text eol=lf

# Kaggle bundle evaluator assets are byte-frozen with recorded SHA256 fingerprints
# that are computed from canonical LF content. Pin LF so checkout line-ending
# state cannot break the fingerprint contract.
kaggle_upload/code/tests/evaluator_assets/todo_smoke_*_checks.py text eol=lf

# Baseline and bundled todo repositories are byte-frozen scientific fixtures.
# Pin LF so snapshot/workspace byte-identity is checkout-state-independent.
benchmark_data/repositories/todo/** text eol=lf
kaggle_upload/data/repositories/todo/** text eol=lf

# Python
*.py text diff=python
*.pyw text

# Markdown
*.md text diff=markdown

# YAML
*.yml text
*.yaml text

# Notebooks
*.ipynb text

# Lock files
*.txt text

# Generated bundle manifests are byte-frozen and must use canonical LF endings.
# This guarantees committed-tree manifest equality across checkout platforms.
kaggle_upload/*_manifest.json text eol=lf

# Sparse-v2 raw-response evidence is byte-frozen with recorded SHA-256 sidecars
# (and run-record raw_response_sha256) computed from canonical LF content.
# scripts/verify_paper_claims.py recomputes those hashes with read_bytes(), so
# pin LF to make the 30/30 raw-response SHA verification checkout-state
# independent on Windows (core.autocrlf).
reports/scientific-stagec-djangocms-impactplan-v2-01/runs/raw/*.txt text eol=lf
reports/scientific-stagec-djangocms-impactplan-v2-01/runs/raw/*.sha256 text eol=lf

# Qwen3-32B cross-model and Qwen3-Coder-30B-A3B cross-model raw-response
# evidence is byte-frozen with recorded SHA-256 sidecars (and run-record
# raw_response_sha256) computed from canonical LF content. Their zero-API
# verifiers recompute those hashes from the raw files, so pin LF to make the
# raw-response SHA verification checkout-state independent on Windows
# (core.autocrlf).
reports/scientific-stagec-djangocms-qwen3-32b-crossmodel-01/runs/raw/*.txt text eol=lf
reports/scientific-stagec-djangocms-qwen3-32b-crossmodel-01/runs/raw/*.sha256 text eol=lf
reports/scientific-stagec-djangocms-qwen3-coder-30b-a3b-crossmodel-01/runs/raw/*.txt text eol=lf
reports/scientific-stagec-djangocms-qwen3-coder-30b-a3b-crossmodel-01/runs/raw/*.sha256 text eol=lf

# M1A / M1B controlled-encoding ablation raw-response evidence is byte-frozen
# with recorded SHA-256 sidecars computed from canonical LF content; the
# zero-API verifiers recompute those hashes from the raw files.
research/controlled-encoding-ablation-01/probes/raw/*.txt text eol=lf
research/controlled-encoding-ablation-01/probes/raw/*.sha256 text eol=lf
research/controlled-encoding-ablation-16k-01/probes/raw/*.txt text eol=lf
research/controlled-encoding-ablation-16k-01/probes/raw/*.sha256 text eol=lf
research/controlled-encoding-ablation-16k-01/runs/raw/*.txt text eol=lf
research/controlled-encoding-ablation-16k-01/runs/raw/*.sha256 text eol=lf

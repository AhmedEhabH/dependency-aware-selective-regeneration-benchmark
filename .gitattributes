# Auto detect text files and perform LF normalization
* text=auto

# Scientific evaluator assets are byte-frozen and must use canonical LF endings.
tests/evaluator_assets/todo_smoke_*_checks.py text eol=lf

# Python
*.py text diff=python
*.pyw text

# Markdown
*.md text diff=markdown

# YAML
*.yml text
*.yaml text

# Notebooks
*.ipynb text

# Lock files
*.txt text

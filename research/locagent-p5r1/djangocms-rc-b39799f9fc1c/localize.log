185 | class ShowSubMenu(InclusionTag):
186 |     """
187 |     show the sub menu of the current nav-node.
188 |     - levels: how many levels deep
189 |     - root_level: the level to start the menu at
190 |     - nephews: the level of descendants of siblings (nephews) to show
191 |     - template: template used to render the navigation
192 |     """
193 |     name = 'show_sub_menu'
194 |     template = 'menu/dummy.html'
195 | 
196 |     options = Options(
197 |         IntegerArgument('levels', default=100, required=False),
198 |         Argument('root_level', default=None, required=False),
199 |         IntegerArgument('nephews', default=100, required=False),
200 |         Argument('template', default='menu/sub_menu.html', required=False),
201 |     )
202 | 
203 |     def get_context(self, context, levels, root_level, nephews, template):
204 |         # Django 1.4 doesn't accept 'None' as a tag value and resolve to ''
205 |         # So we need to force it to None again
206 |         if not root_level and root_level != 0:
207 |             root_level = None
208 |         try:
209 |             # If there's an exception (500), default context_processors may not be called.
210 |             request = context['request']
211 |         except KeyError:
212 |             return {'template': 'menu/empty.html'}
213 | 
214 |         menu_renderer = context.get('cms_menu_renderer')
215 | 
216 |         if not menu_renderer:
217 |             menu_renderer = menu_pool.get_renderer(request)
218 | 
219 |         nodes = menu_renderer.get_nodes()
220 |         children = []
221 |         # adjust root_level so we cut before the specified level, not after
222 |         include_root = False
223 |         if root_level is not None and root_level > 0:
224 |             root_level -= 1
225 |         elif root_level is not None and root_level == 0:
226 |             include_root = True
227 |         for node in nodes:
228 |             if root_level is None:
229 |                 if node.selected:
230 |                     # if no root_level specified, set it to the selected nodes level
231 |                     root_level = node.level
232 |                     # is this the ancestor of current selected node at the root level?
233 |             is_root_ancestor = (node.ancestor and node.level == root_level)
234 |             # is a node selected on the root_level specified
235 |             root_selected = (node.selected and node.level == root_level)
236 |             if is_root_ancestor or root_selected:
237 |                 cut_after(node, levels, [])
238 |                 children = node.children
239 |                 for child in children:
240 |                     if child.sibling:
241 |                         cut_after(child, nephews, [])
242 |                         # if root_level was 0 we need to give the menu the entire tree
243 |                     # not just the children
244 |                 if include_root:
245 |                     children = menu_renderer.apply_modifiers([node], post_cut=True)
246 |                 else:
247 |                     children = menu_renderer.apply_modifiers(children, post_cut=True)
248 |         context['children'] = children
249 |         context['template'] = template
250 |         context['from_level'] = 0
251 |         context['to_level'] = 0
252 |         context['extra_inactive'] = 0
253 |         context['extra_active'] = 0

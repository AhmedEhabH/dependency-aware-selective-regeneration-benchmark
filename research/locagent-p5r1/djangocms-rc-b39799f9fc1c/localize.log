1346 |     def get_tree(self, request):
1347 |         """
1348 |         Get html for the descendants (only) of given page or if no page_id is
1349 |         provided, all the root nodes.
1350 | 
1351 |         Used for lazy loading pages in cms.pagetree.js
1352 |         """
1353 |         site = get_site(request)
1354 |         pages = Page.objects.on_site(site).order_by('node__path')
1355 |         node_id = request.GET.get('nodeId')
1356 |         open_nodes = list(map(int, request.GET.getlist('openNodes[]')))
1357 | 
1358 |         if node_id:
1359 |             page = get_object_or_404(pages, node_id=int(node_id))
1360 |             pages = page.get_descendant_pages().filter(Q(node__in=open_nodes) | Q(node__parent__in=open_nodes))
1361 |         else:
1362 |             page = None
1363 |             pages = pages.filter(
1364 |                 # get all root nodes
1365 |                 # or children which were previously open
1366 |                 # or children of the open descendants
1367 |                 Q(node__depth=1) | Q(node__depth=2, node__in=open_nodes) | Q(node__parent__in=open_nodes)
1368 |             )
1369 |         pages = pages.prefetch_related(
1370 |             Prefetch(
1371 |                 'pagecontent_set',
1372 |                 to_attr='filtered_translations',
1373 |                 queryset=self.get_queryset(request),
1374 |             ),
1375 |         )
1376 |         rows = self.get_tree_rows(
1377 |             request,
1378 |             pages=pages,
1379 |             language=get_site_language_from_request(request, site_id=site.pk),
1380 |             depth=(page.node.depth + 1 if page else 1),
1381 |             follow_descendants=True,
1382 |         )
1383 |         return HttpResponse(u''.join(rows))
1384 | 
1385 |     def get_tree_rows(self, request, pages, language, depth=1,
1386 |                       follow_descendants=True):
1387 |         """
1388 |         Used for rendering the page tree, inserts into context everything what
1389 |         we need for single item
1390 |         """
1391 |         user = request.user
1392 |         site = get_site(request)
1393 |         permissions_on = get_cms_setting('PERMISSION')
1394 |         template = get_template(self.page_tree_row_template)
1395 |         is_popup = (IS_POPUP_VAR in request.POST or IS_POPUP_VAR in request.GET)
1396 |         languages = get_language_list(site.pk)
1397 |         user_can_add = page_permissions.user_can_add_subpage
1398 |         user_can_change = page_permissions.user_can_change_page
1399 |         user_can_change_advanced = page_permissions.user_can_change_page_advanced_settings
1400 |         page_content_type = ContentType.objects.get_for_model(PageContent)
1401 | 
1402 |         def render_page_row(page):
1403 |             page.page_content_cache = {trans.language: trans for trans in page.filtered_translations}
1404 | 
1405 |             for _language in languages:
1406 |                 # EmptyPageContent is used to prevent the cms from trying
1407 |                 # to find a translation in the database
1408 |                 page.page_content_cache.setdefault(_language, EmptyPageContent(language=_language))
1409 | 
1410 |             has_move_page_permission = page_permissions.user_can_move_page(request.user, page, site=site)
1411 | 
1412 |             if permissions_on and not has_move_page_permission:
1413 |                 # TODO: check if this is really needed
1414 |                 metadata = '{"valid_children": False, "draggable": False}'
1415 |             else:
1416 |                 metadata = ''
1417 | 
1418 |             context = {
1419 |                 'admin': self,
1420 |                 'opts': self.opts,
1421 |                 'site': site,
1422 |                 'page': page,
1423 |                 'page_content': page.get_content_obj(language, fallback=True),
1424 |                 'page_content_type': page_content_type,
1425 |                 'node': page.node,
1426 |                 'ancestors': [node.item for node in page.node.get_cached_ancestors()],
1427 |                 'descendants': [node.item for node in page.node.get_cached_descendants()],

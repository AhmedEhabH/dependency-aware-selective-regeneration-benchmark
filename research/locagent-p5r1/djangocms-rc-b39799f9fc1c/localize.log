 889 |     def duplicate(self, request, object_id):
 890 |         """
 891 |         Leverages the add view logic to duplicate the page.
 892 |         """
 893 |         obj = self.get_object(request, object_id=object_id)
 894 | 
 895 |         if obj is None:
 896 |             raise self._get_404_exception(object_id)
 897 | 
 898 |         request = copy.copy(request)
 899 | 
 900 |         if request.method == 'GET':
 901 |             # source is a field in the form
 902 |             # because its value is in the url,
 903 |             # we have to set the initial value manually
 904 |             request.GET = request.GET.copy()
 905 |             request.GET['source'] = obj.page_id
 906 |         return self.add_view(request)

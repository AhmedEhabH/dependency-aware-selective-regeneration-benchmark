543 |     @require_POST
544 |     @transaction.atomic
545 |     def move_page(self, request, page_id, extra_context=None):
546 |         """
547 |         Move the page to the requested target, at the given position.
548 | 
549 |         NOTE: We have to change from one "coordinate system" to another to
550 |         adapt JSTree to Django Treebeard.
551 | 
552 |         If the Tree looks like this:
553 | 
554 |             <root>
555 |                ⊢ …
556 |                ⊢ …
557 |                ⊢ Page 4
558 |                    ⊢ Page 5 (position 0)
559 |                    ⊢ …
560 | 
561 |         For example,
562 |             target=4, position=1 => target=5, position="right"
563 |             target=4, position=0 => target=4, position="first-child"
564 | 
565 |         """
566 |         site = get_site(request)
567 |         page = self.get_object(request, object_id=page_id)
568 | 
569 |         if page is None:
570 |             return jsonify_request(HttpResponseBadRequest("error"))
571 | 
572 |         user = request.user
573 |         form = self.move_form(request.POST or None, page=page, site=site)
574 | 
575 |         if not form.is_valid():
576 |             return jsonify_request(HttpResponseBadRequest("error"))
577 | 
578 |         target = form.cleaned_data['target']
579 |         can_move_page = self.has_move_page_permission(request, obj=page)
580 | 
581 |         # Does the user have permissions to do this...?
582 |         if not can_move_page or (target and not target.has_add_permission(user)):
583 |             message = force_str(
584 |                 _("Error! You don't have permissions to move this page. Please reload the page")
585 |             )
586 |             return jsonify_request(HttpResponseForbidden(message))
587 | 
588 |         operation_token = send_pre_page_operation(
589 |             request=request,
590 |             operation=operations.MOVE_PAGE,
591 |             obj=page,
592 |             sender=self.model,
593 |         )
594 | 
595 |         form.move_page()
596 | 
597 |         send_post_page_operation(
598 |             request=request,
599 |             operation=operations.MOVE_PAGE,
600 |             token=operation_token,
601 |             obj=page,
602 |             sender=self.model,
603 |         )
604 |         return jsonify_request(HttpResponse(status=200))

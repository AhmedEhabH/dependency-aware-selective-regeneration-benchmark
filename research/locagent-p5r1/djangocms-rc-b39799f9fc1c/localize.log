57 |     def _update_descendants_tree(self, root):
58 |         nodes = TreeNode.objects.all()
59 |         descendants_by_parent = OrderedDict()
60 | 
61 |         for descendant in get_descendants(root):
62 |             parent_id = descendant.parent_id
63 |             descendants_by_parent.setdefault(parent_id, []).append(descendant)
64 | 
65 |         for tree in descendants_by_parent.values():
66 |             last_node = None
67 | 
68 |             for node in tree:
69 |                 node.refresh_from_db()
70 | 
71 |                 if last_node:
72 |                     # This is not the first loop so this is not the first draft
73 |                     # child. Set this page a sibling of the last processed
74 |                     # draft page.
75 |                     last_node.refresh_from_db()
76 |                     node.move(target=last_node, pos='right')
77 |                 else:
78 |                     # This is the first time through the loop so this is the first
79 |                     # draft child for this parent.
80 |                     node.move(target=nodes.get(pk=tree[0].parent_id), pos='first-child')

258 | class ShowBreadcrumb(InclusionTag):
259 |     """
260 |     Shows the breadcrumb from the node that has the same url as the current request
261 | 
262 |     - start level: after which level should the breadcrumb start? 0=home
263 |     - template: template used to render the breadcrumb
264 |     """
265 |     name = 'show_breadcrumb'
266 |     template = 'menu/dummy.html'
267 | 
268 |     options = Options(
269 |         Argument('start_level', default=0, required=False),
270 |         Argument('template', default='menu/breadcrumb.html', required=False),
271 |         Argument('only_visible', default=True, required=False),
272 |     )
273 | 
274 |     def get_context(self, context, start_level, template, only_visible):
275 |         try:
276 |             # If there's an exception (500), default context_processors may not be called.
277 |             request = context['request']
278 |         except KeyError:
279 |             return {'template': 'cms/content.html'}
280 |         if not (isinstance(start_level, int) or start_level.isdigit()):
281 |             only_visible = template
282 |             template = start_level
283 |             start_level = 0
284 |         try:
285 |             only_visible = bool(int(only_visible))
286 |         except:  # NOQA
287 |             only_visible = bool(only_visible)
288 |         ancestors = []
289 | 
290 |         menu_renderer = context.get('cms_menu_renderer')
291 | 
292 |         if not menu_renderer:
293 |             menu_renderer = menu_pool.get_renderer(request)
294 | 
295 |         nodes = menu_renderer.get_nodes(breadcrumb=True)
296 | 
297 |         # Find home
298 |         home = None
299 |         root_url = unquote(reverse("pages-root"))
300 |         home = next((node for node in nodes if node.get_absolute_url() == root_url), None)
301 | 
302 |         # Find selected
303 |         selected = None
304 |         selected = next((node for node in nodes if node.selected), None)
305 | 
306 |         if selected and selected != home:
307 |             node = selected
308 |             while node:
309 |                 if node.visible or not only_visible:
310 |                     ancestors.append(node)
311 |                 node = node.parent
312 |         if not ancestors or (ancestors and ancestors[-1] != home) and home:
313 |             ancestors.append(home)
314 |         ancestors.reverse()
315 |         if len(ancestors) >= start_level:
316 |             ancestors = ancestors[start_level:]
317 |         else:
318 |             ancestors = []
319 |         context['ancestors'] = ancestors
320 |         context['template'] = template
321 |         return context
```


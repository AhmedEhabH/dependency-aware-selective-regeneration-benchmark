658 |     @require_POST
659 |     @transaction.atomic
660 |     def copy_page(self, request, page_id):
661 |         """
662 |         Copy the page and all its plugins and descendants to the requested
663 |         target, at the given position
664 |         """
665 |         page = self.get_page_from_id(page_id)
666 | 
667 |         if page is None:
668 |             return jsonify_request(HttpResponseBadRequest("error"))
669 | 
670 |         user = request.user
671 |         site = get_site(request)
672 |         form = self.copy_form(request.POST or None, page=page, site=site)
673 | 
674 |         if not form.is_valid():
675 |             return jsonify_request(HttpResponseBadRequest("error"))
676 | 
677 |         target = form.cleaned_data['target']
678 |         source_site = form.cleaned_data['source_site']
679 | 
680 |         # User can only copy pages he can see
681 |         can_copy_page = page_permissions.user_can_view_page(user, page, source_site)
682 | 
683 |         if can_copy_page and target:
684 |             # User can only copy a page into another one if he has permission
685 |             # to add a page under the target page.
686 |             can_copy_page = page_permissions.user_can_add_subpage(user, target, site)
687 |         elif can_copy_page:
688 |             # User can only copy / paste a page if he has permission to add a page
689 |             can_copy_page = page_permissions.user_can_add_page(user, site)
690 | 
691 |         if not can_copy_page:
692 |             message = force_str(_("Error! You don't have permissions to copy this page."))
693 |             return jsonify_request(HttpResponseForbidden(message))
694 | 
695 |         page_languages = page.get_languages()
696 |         site_languages = get_language_list(site_id=site.pk)
697 | 
698 |         if not any(lang in page_languages for lang in site_languages):
699 |             message = force_str(_("Error! The page you're pasting is not "
700 |                                   "translated in any of the languages configured by the target site."))
701 |             return jsonify_request(HttpResponseBadRequest(message))
702 | 
703 |         new_page = form.copy_page()
704 |         return HttpResponse(json.dumps({"id": new_page.pk}), content_type='application/json')

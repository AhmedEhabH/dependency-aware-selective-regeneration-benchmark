1084 |     def changelist_view(self, request, extra_context=None):
1085 |         from django.contrib.admin.views.main import ERROR_FLAG
1086 | 
1087 |         if not self.has_change_permission(request, obj=None):
1088 |             raise PermissionDenied
1089 | 
1090 |         if request.method == 'POST' and 'site' in request.POST:
1091 |             site_id = request.POST['site']
1092 | 
1093 |             if site_id.isdigit() and Site.objects.filter(pk=site_id).exists():
1094 |                 request.session['cms_admin_site'] = site_id
1095 | 
1096 |         site = get_site(request)
1097 |         language = get_site_language_from_request(request, site_id=site.pk)
1098 |         query = request.GET.get('q', '')
1099 |         page_contents = self.get_queryset(request)
1100 |         page_contents, _ = self.get_search_results(request, page_contents, query)
1101 |         changelist_form = self.changelist_form(request.GET)
1102 | 
1103 |         try:
1104 |             changelist_form.full_clean()
1105 |             page_contents = changelist_form.run_filters(page_contents)
1106 |         except (ValueError, ValidationError):
1107 |             # Wacky lookup parameters were given, so redirect to the main
1108 |             # changelist page, without parameters, and pass an 'invalid=1'
1109 |             # parameter via the query string. If wacky parameters were given
1110 |             # and the 'invalid=1' parameter was already in the query string,
1111 |             # something is screwed up with the database, so display an error
1112 |             # page.
1113 |             if ERROR_FLAG in request.GET.keys():
1114 |                 return SimpleTemplateResponse('admin/invalid_setup.html', {
1115 |                     'title': _('Database error'),
1116 |                 })
1117 |             return HttpResponseRedirect(request.path + '?' + ERROR_FLAG + '=1')
1118 | 
1119 |         pages = (
1120 |             Page
1121 |             .objects
1122 |             .on_site(site)
1123 |             .filter(pagecontent_set__in=page_contents)
1124 |             .distinct()
1125 |             .order_by('node__path')
1126 |         )
1127 |         pages = pages.prefetch_related(
1128 |             Prefetch(
1129 |                 'pagecontent_set',
1130 |                 to_attr='filtered_translations',
1131 |                 queryset=self.get_queryset(request),
1132 |             ),
1133 |         )
1134 | 
1135 |         if changelist_form.is_filtered():
1136 |             # Evaluates the queryset
1137 |             has_items = len(pages) >= 1
1138 |         else:
1139 |             has_items = pages.exists()
1140 | 
1141 |         context = self.admin_site.each_context(request)
1142 |         context.update({
1143 |             'opts': self.model._meta,
1144 |             'media': self.media,
1145 |             'CMS_MEDIA_URL': get_cms_setting('MEDIA_URL'),
1146 |             'CMS_PERMISSION': get_cms_setting('PERMISSION'),
1147 |             'site_languages': get_language_tuple(site.pk),
1148 |             'preview_language': language,
1149 |             'changelist_form': changelist_form,
1150 |             'cms_current_site': site,
1151 |             'has_add_permission': self.has_add_permission(request),
1152 |             'module_name': force_str(self.model._meta.verbose_name_plural),
1153 |             'admin': self,
1154 |             'tree': {
1155 |                 'site': site,
1156 |                 'query': query,
1157 |                 'is_filtered': changelist_form.is_filtered(),
1158 |                 'items': pages,
1159 |                 'has_items': has_items,
1160 |             },
1161 |         })
1162 |         context.update(extra_context or {})
1163 |         request.current_app = self.admin_site.name
1164 |         return TemplateResponse(request, self.change_list_template, context)

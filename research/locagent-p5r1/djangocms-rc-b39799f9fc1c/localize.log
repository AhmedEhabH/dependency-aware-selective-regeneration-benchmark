1350 | 
1351 |         Used for lazy loading pages in cms.pagetree.js
1352 |         """
1353 |         site = get_site(request)
1354 |         pages = Page.objects.on_site(site).order_by('node__path')
1355 |         node_id = request.GET.get('nodeId')
1356 |         open_nodes = list(map(int, request.GET.getlist('openNodes[]')))
1357 | 
1358 |         if node_id:
1359 |             page = get_object_or_404(pages, node_id=int(node_id))
1360 |             pages = page.get_descendant_pages().filter(Q(node__in=open_nodes) | Q(node__parent__in=open_nodes))
1361 |         else:
1362 |             page = None
1363 |             pages = pages.filter(
1364 |                 # get all root nodes
1365 |                 # or children which were previously open
1366 |                 # or children of the open descendants
1367 |                 Q(node__depth=1) | Q(node__depth=2, node__in=open_nodes) | Q(node__parent__in=open_nodes)
1368 |             )

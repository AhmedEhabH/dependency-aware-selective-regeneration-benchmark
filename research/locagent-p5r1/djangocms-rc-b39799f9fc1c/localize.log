606 |     def get_permissions(self, request, page_id):
607 |         rows = []
608 |         user = request.user
609 |         page = self.get_object(request, object_id=page_id)
610 | 
611 |         if page is None:
612 |             raise self._get_404_exception(page_id)
613 | 
614 |         site = get_site(request)
615 |         PermissionRow = namedtuple('Permission', ['is_global', 'can_change', 'permission'])
616 | 
617 |         global_permissions = GlobalPagePermission.objects.filter(sites__in=[site.pk])
618 |         can_change_global_permissions = permissions.user_can_change_global_permissions(user, site)
619 | 
620 |         for permission in global_permissions.iterator():
621 |             row = PermissionRow(
622 |                 is_global=True,
623 |                 can_change=can_change_global_permissions,
624 |                 permission=permission,
625 |             )
626 |             rows.append(row)
627 | 
628 |         _page_permissions = (
629 |             PagePermission
630 |             .objects
631 |             .for_page(page)
632 |             .select_related('page')
633 |         )
634 | 
635 |         if not can_change_global_permissions:
636 |             allowed_pages = frozenset(page_permissions.get_change_id_list(user, site, check_global=False))
637 | 
638 |         for permission in _page_permissions.iterator():
639 |             if can_change_global_permissions:
640 |                 can_change = True
641 |             else:
642 |                 can_change = permission.page_id in allowed_pages
643 | 
644 |             row = PermissionRow(
645 |                 is_global=False,
646 |                 can_change=can_change,
647 |                 permission=permission,
648 |             )
649 |             rows.append(row)
650 | 
651 |         context = {
652 |             'page': page,
653 |             'rows': rows,
654 |             'opts': self.opts,
655 |         }
656 |         return render(request, 'admin/cms/page/permissions.html', context)

412 | def modify(self, request, nodes, namespace, root_id, post_cut, breadcrumb):
413 |         # only apply this modifier if we're pre-cut (since what we do is cut)
414 |         # or if no id argument is provided, indicating {% show_menu_below_id %}
415 |         if post_cut or root_id:
416 |             return nodes
417 |         selected = None
418 |         root_nodes = []
419 |         # find the selected node as well as all the root nodes
420 |         for node in nodes:
421 |             if node.selected:
422 |                 selected = node
423 |             if not node.parent:
424 |                 root_nodes.append(node)
425 | 
426 |         # if we found a selected ...
427 |         if selected:
428 |             # and the selected is a softroot
429 |             if selected.attr.get("soft_root", False):
430 |                 # get it's descendants
431 |                 nodes = selected.get_descendants()
432 |                 # remove the link to parent
433 |                 selected.parent = None
434 |                 # make the selected page the root in the menu
435 |                 nodes = [selected] + nodes
436 |             else:
437 |                 # if it's not a soft root, walk ancestors (upwards!)
438 |                 nodes = self.find_ancestors_and_remove_children(selected, nodes)
439 |         return nodes

13 | def _find_subclasses(module, klass):
14 |     """
15 |     Helper function.
16 | 
17 |     Returns a list of classes in module which inherit from klass.
18 |     """
19 |     classes = []
20 |     # Find all classes that inherit from klass
21 |     for name, obj in inspect.getmembers(module):
22 |         is_subclass = (
23 |             # Ignore the import of klass itself
24 |             inspect.isclass(obj) and issubclass(obj, klass) and obj != klass
25 |         )
26 |         if is_subclass:
27 |             classes.append(obj)
28 |     return classes

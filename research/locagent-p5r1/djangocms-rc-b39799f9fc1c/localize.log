427 |         if selected:
428 |             # and the selected is a softroot
429 |             if selected.attr.get("soft_root", False):
430 |                 # get it's descendants
431 |                 nodes = selected.get_descendants()
432 |                 # remove the link to parent
433 |                 selected.parent = None
434 |                 # make the selected page the root in the menu
435 |                 nodes = [selected] + nodes

414 |         # or if no id argument is provided, indicating {% show_menu_below_id %}
415 |         if post_cut or root_id:
416 |             return nodes
417 |         selected = None
418 |         root_nodes = []
419 |         # find the selected node as well as all the root nodes
420 |         for node in nodes:
421 |             if node.selected:
422 |                 selected = node

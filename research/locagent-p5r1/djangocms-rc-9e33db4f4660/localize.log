578 |         target_tree = self.get_plugins(plugin.language)
579 |         last_plugin = self.get_last_plugin(plugin.language)
580 |         source_plugin_desc_count = plugin._get_descendants_count()
581 |         # Attn: The following line assumes that all children and grand-children have consecutive positions!
582 |         source_plugin_range = (plugin.position, plugin.position + source_plugin_desc_count)
583 | 
584 |         if target_position < plugin.position:
585 |             # Moving left
586 |             # Make a big hole on the right side of the current plugin's position
587 |             # by shifting all right nodes further to the right, excluding the current plugin
588 |             # but including the target plugin and its descendants.
589 |             (target_tree
590 |              .filter(position__gte=target_position)
591 |              .exclude(position__range=source_plugin_range)
592 |              ).update(position=(models.F('position') + last_plugin.position))
593 | 
594 |             # Make a big hole on the left side of the current plugin's position
595 |             # by shifting all right nodes further the right, including the current plugin
596 |             # and its descendants.
597 |             target_tree.filter(
598 |                 position__lte=source_plugin_range[1]
599 |             ).update(position=models.F('position') - last_plugin.position)
600 |         else:
601 |             # Moving right
602 |             # Make a big hole on the left side of the target position,
603 |             # by shifting all left nodes further to the left, excluding the current plugin
604 |             # but including the target plugin and its descendants.
605 |             # Left node in the common case is target_position but if the current plugin
606 |             # has descendants then left node is the closest node to the right side of the
607 |             # last descendant.
608 |             (target_tree
609 |              .filter(position__lte=target_position + source_plugin_desc_count)
610 |              .exclude(position__range=source_plugin_range)
611 |              ).update(position=(models.F('position') - last_plugin.position))
612 | 
613 |             # Make a big hole on the right side of the current plugin's position
614 |             # by shifting all right nodes further the right, including the current plugin
615 |             # and its descendants.
616 |             target_tree.filter(

391 |     def modify(self, request, nodes, namespace, root_id, post_cut, breadcrumb):
392 |         if post_cut:
393 |             return nodes
394 |         # rearrange the parent relations
395 |         # Find home
396 |         home = next((n for n in nodes if n.attr.get("is_home", False)), None)
397 |         # Find nodes with NavExtenders
398 |         exts = []
399 |         for node in nodes:
400 |             extenders = node.attr.get("navigation_extenders", None)
401 |             if extenders:
402 |                 for ext in extenders:
403 |                     if ext not in exts:
404 |                         exts.append(ext)
405 |                     # Link the nodes
406 |                     for extnode in nodes:
407 |                         if extnode.namespace == ext and not extnode.parent_id:
408 |                             # if home has nav extenders but home is not visible
409 |                             if node == home and not node.visible:
410 |                                 # extnode.parent_id = None
411 |                                 extnode.parent_namespace = None
412 |                                 extnode.parent = None
413 |                             else:
414 |                                 extnode.parent_id = node.id
415 |                                 extnode.parent_namespace = node.namespace
416 |                                 extnode.parent = node
417 |                                 node.children.append(extnode)
418 |         removed = []
419 | 
420 |         # find all not assigned nodes
421 |         for menu in self.renderer.menus.items():
422 |             if hasattr(menu[1], "cms_enabled") and menu[1].cms_enabled and menu[0] not in exts:
423 |                 for node in nodes:
424 |                     if node.namespace == menu[0]:
425 |                         removed.append(node)
426 |         if breadcrumb:
427 |             # if breadcrumb and home not in navigation add node
428 |             if breadcrumb and home and not home.visible:
429 |                 home.visible = True
430 |                 if request.path_info == home.get_absolute_url():
431 |                     home.selected = True
432 |                 else:
433 |                     home.selected = False
434 |         # remove all nodes that are nav_extenders and not assigned
435 |         for node in removed:
436 |             nodes.remove(node)

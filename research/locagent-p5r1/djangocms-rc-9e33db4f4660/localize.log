678 | def delete_plugin(self, instance):
679 |         """
680 |         .. versionadded:: 4.0
681 | 
682 |         Removes a plugin and its descendants from the placeholder and database.
683 | 
684 |         :param instance: Plugin to add. It's position parameter needs to be set.
685 |         :type instance: :class:`cms.models.pluginmodel.CMSPlugin` instance
686 |         """
687 |         with transaction.atomic():
688 |             # We're using raw sql - make the whole operation atomic
689 |             plugins = self.get_plugins(language=instance.language).count()  # 1st hit: Count plugins
690 |             descendants = instance._get_descendants_ids()  # 2nd hit: Get descendant ids
691 |             to_delete = [instance.pk] + descendants  # Instance plus descendants pk
692 |             self.cmsplugin_set.filter(pk__in=to_delete).delete()  # 3rd hit: Delete all plugins in one query
693 | 
694 |             last_position = instance.position + len(descendants)  # Last position of deleted plugins
695 |             if last_position < plugins:
696 |                 # Close the gap in the plugin tree (2 hits)
697 |                 self._shift_plugin_positions(
698 |                     instance.language,
699 |                     start=instance.position,
700 |                     offset=plugins,
701 |                 )
702 |                 self._recalculate_plugin_positions(instance.language)

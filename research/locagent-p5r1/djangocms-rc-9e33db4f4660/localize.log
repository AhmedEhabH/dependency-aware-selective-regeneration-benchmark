690 |             descendants = instance._get_descendants_ids()  # 2nd hit: Get descendant ids
691 |             to_delete = [instance.pk] + descendants  # Instance plus descendants pk
692 |             self.cmsplugin_set.filter(pk__in=to_delete).delete()  # 3rd hit: Delete all plugins in one query
693 | 
694 |             last_position = instance.position + len(descendants)  # Last position of deleted plugins
695 |             if last_position < plugins:

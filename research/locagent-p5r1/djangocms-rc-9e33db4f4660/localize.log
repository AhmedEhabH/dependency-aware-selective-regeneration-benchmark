617 |     @classmethod
618 |     def get_child_classes(cls, slot, page, instance=None):
619 |         """
620 |         Returns a list of plugin types that can be added
621 |         as children to this plugin.
622 |         """
623 |         # Placeholder overrides are highest in priority
624 |         child_classes = cls.get_child_class_overrides(slot, page)
625 | 
626 |         if child_classes:
627 |             return child_classes
628 | 
629 |         # Get all child plugin candidates
630 |         installed_plugins = cls.get_child_plugin_candidates(slot, page)
631 | 
632 |         child_classes = []
633 |         plugin_type = cls.__name__
634 | 
635 |         # The following will go through each
636 |         # child plugin candidate and check if
637 |         # has configured parent class restrictions.
638 |         # If there are restrictions then the plugin
639 |         # is only a valid child class if the current plugin
640 |         # matches one of the parent restrictions.
641 |         # If there are no restrictions then the plugin
642 |         # is a valid child class.
643 |         for plugin_class in installed_plugins:
644 |             allowed_parents = plugin_class.get_parent_classes(slot, page, instance)
645 |             if not allowed_parents or plugin_type in allowed_parents:
646 |                 # Plugin has no parent restrictions or
647 |                 # Current plugin (self) is a configured parent
648 |                 child_classes.append(plugin_class.__name__)
649 | 
650 |         return child_classes

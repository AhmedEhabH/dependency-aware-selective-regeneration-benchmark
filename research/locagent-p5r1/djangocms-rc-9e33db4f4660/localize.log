339 | def get_bound_plugins(plugins):
340 |     """
341 |     Get the bound plugins by downcasting the plugins to their respective classes. Raises a KeyError if the plugin type
342 |     is not available.
343 | 
344 |     Creates a map of plugin types and their corresponding plugin IDs for later use in downcasting.
345 |     Then, retrieves the plugin instances from the plugin model using the mapped plugin IDs.
346 |     Finally, iterates over the plugins and yields the downcasted versions if they have a valid parent.
347 |     Does not affect caching.
348 | 
349 |     :param plugins:  List of ``CMSPlugin`` instances.
350 |     :type plugins: List[CMSPlugin]
351 |     :return: Generator that yields the downcasted plugins.
352 |     :rtype: Generator[CMSPlugin, None, None]
353 | 
354 |     Example::
355 | 
356 |         plugins = [plugin_instance1, plugin_instance2]
357 |         for bound_plugin in get_bound_plugins(plugins):
358 |             # Do something with the bound_plugin
359 |             pass
360 |     """
361 |     get_plugin = plugin_pool.get_plugin
362 |     plugin_types_map = defaultdict(list)
363 |     plugin_ids = []
364 |     plugin_lookup = {}
365 | 
366 |     # make a map of plugin types, needed later for downcasting
367 |     for plugin in plugins:
368 |         plugin_ids.append(plugin.pk)
369 |         plugin_types_map[plugin.plugin_type].append(plugin.pk)
370 | 
371 |     for plugin_type, pks in plugin_types_map.items():
372 |         plugin_model = get_plugin(plugin_type).model
373 |         plugin_queryset = plugin_model.objects.filter(pk__in=pks)
374 | 
375 |         # put them in a map, so we can replace the base CMSPlugins with their
376 |         # downcasted versions
377 |         for instance in plugin_queryset.iterator():
378 |             plugin_lookup[instance.pk] = instance
379 | 
380 |     for plugin in plugins:
381 |         parent_not_available = (not plugin.parent_id or plugin.parent_id not in plugin_ids)
382 |         # The plugin either has no parent or needs to have a non-ghost parent
383 |         valid_parent = (parent_not_available or plugin.parent_id in plugin_lookup)
384 | 
385 |         if valid_parent and plugin.pk in plugin_lookup:
386 |             yield plugin_lookup[plugin.pk]

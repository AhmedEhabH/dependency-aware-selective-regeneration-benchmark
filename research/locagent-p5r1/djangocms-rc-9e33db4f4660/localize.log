447 |     def save_model(self, request, obj, form, change):
448 |         """
449 |         Override original method, and add some attributes to obj
450 |         This has to be made, because if the object is newly created, it must know
451 |         where it lives.
452 |         """
453 |         from django.contrib.admin import site
454 | 
455 |         pl = obj.placeholder
456 |         pl_admin = site._registry[obj.placeholder.__class__]
457 |         operation_kwargs = {
458 |             'request': request,
459 |             'placeholder': pl,
460 |         }
461 |         if change:
462 |             operation_kwargs['old_plugin'] = self.model.objects.get(pk=obj.pk)
463 |             operation_kwargs['new_plugin'] = obj
464 |             operation_kwargs['operation'] = operations.CHANGE_PLUGIN
465 |         else:
466 |             parent_id = obj.parent.pk if obj.parent else None
467 |             tree_order = obj.placeholder.get_plugin_tree_order(parent_id)
468 |             operation_kwargs['plugin'] = obj
469 |             operation_kwargs['operation'] = operations.ADD_PLUGIN
470 |             operation_kwargs['tree_order'] = tree_order
471 |         # Remember the operation token
472 |         self._operation_token = pl_admin._send_pre_placeholder_operation(**operation_kwargs)
473 |         # Saves the plugin
474 |         # remember the saved object
475 |         self.saved_object = pl.add_plugin(obj)
476 |         pl.clear_cache(obj.language)

293 |         Returns all registered menu classes.
294 | 
295 |         :param for_rendering: Flag that when True forces us to include
296 |             all CMSAttachMenu subclasses, even if they're not attached.
297 |         """
298 |         self.discover_menus()
299 |         registered_menus = {}
300 | 
301 |         for menu_class_name, menu_cls in self.menus.items():
302 |             if isinstance(menu_cls, Menu):
303 |                 # A Menu **instance** was registered,
304 |                 # this is non-standard, but acceptable.
305 |                 menu_cls = menu_cls.__class__
306 |             if hasattr(menu_cls, "get_instances"):
307 |                 # It quacks like a CMSAttachMenu.
308 |                 # Expand the one CMSAttachMenu into multiple classes.
309 |                 # Each class is bound to the instance the menu is attached to.
310 |                 _get_menu_class = partial(_get_menu_class_for_instance, menu_cls)
311 | 
312 |                 instances = menu_cls.get_instances() or []
313 |                 for instance in instances:
314 |                     # For each instance, we create a unique class
315 |                     # that is bound to that instance.
316 |                     # Doing this allows us to delay the instantiation
317 |                     # of the menu class until it's needed.
318 |                     # Plus we keep the menus consistent by always
319 |                     # pointing to a class instead of an instance.
320 |                     namespace = f"{menu_class_name}:{instance.pk}"
321 |                     registered_menus[namespace] = _get_menu_class(instance)
322 | 
323 |                 if not instances and not for_rendering:
324 |                     # The menu is a CMSAttachMenu but has no instances,
325 |                     # normally we'd just ignore it but it's been
326 |                     # explicitly set that we are not rendering these menus
327 |                     # via the (for_rendering) flag.
328 |                     registered_menus[menu_class_name] = menu_cls
329 |             elif hasattr(menu_cls, "get_nodes"):
330 |                 # This is another type of Menu, cannot be expanded, but must be
331 |                 # instantiated, none-the-less.
332 |                 registered_menus[menu_class_name] = menu_cls
333 |             else:
334 |                 raise ValidationError(
335 |                     "Something was registered as a menu, but isn't.")

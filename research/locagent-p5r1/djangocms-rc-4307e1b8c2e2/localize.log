 612 |         if self.reverse_id == "":
 613 |             self.reverse_id = None
 614 |         if self.application_namespace == "":
 615 |             self.application_namespace = None
 616 | 
 617 |         created = not bool(self.pk)
 618 |         from cms.utils.permissions import get_current_user_name
 619 |         self.changed_by = get_current_user_name()
 620 |         if created:
 621 |             self.created_by = self.changed_by
 622 | 
 623 |         super(Page, self).save(**kwargs)

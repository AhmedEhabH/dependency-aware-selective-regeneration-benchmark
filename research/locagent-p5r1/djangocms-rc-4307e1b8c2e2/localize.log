 625 |     def update(self, refresh=False, **data):
 626 |         cls = self.__class__
 627 |         cls.objects.filter(pk=self.pk).update(**data)
 628 | 
 629 |         if refresh:
 630 |             return self.reload()
 631 |         else:
 632 |             for field, value in data.items():
 633 |                 setattr(self, field, value)
 634 |         return

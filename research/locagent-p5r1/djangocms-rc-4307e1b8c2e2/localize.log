 374 |     def set_tree_node(self, site, target=None, position='first-child'):
 375 |         assert position in ('last-child', 'first-child', 'left', 'right')
 376 | 
 377 |         new_node = TreeNode(site=site)
 378 | 
 379 |         if target is None:
 380 |             self.node = TreeNode.add_root(instance=new_node)
 381 |         elif position == 'first-child' and target.is_branch:
 382 |             self.node = target.get_first_child().add_sibling(pos='left', instance=new_node)
 383 |         elif position in ('last-child', 'first-child'):
 384 |             self.node = target.add_child(instance=new_node)
 385 |         else:
 386 |             self.node = target.add_sibling(pos=position, instance=new_node)
 387 | 
 388 |     def move_page(self, target_node, position='first-child'):
 389 |         """
 390 |         Called from admin interface when page is moved. Should be used on
 391 |         all the places which are changing page position. Used like an interface
 392 |         to django-treebeard, but after move is done page_moved signal is fired.
 393 | 
 394 |         Note for issue #1166: url conflicts are handled by updated
 395 |         check_title_slugs, overwrite_url on the moved page don't need any check
 396 |         as it remains the same regardless of the page position in the tree
 397 |         """
 398 |         assert isinstance(target_node, TreeNode)
 399 | 
 400 |         inherited_template = self.template == constants.TEMPLATE_INHERITANCE_MAGIC
 401 | 
 402 |         if inherited_template and target_node.is_root() and position in ('left', 'right'):
 403 |             # The page is being moved to a root position.
 404 |             # Explicitly set the inherited template on the titles
 405 |             # to keep all plugins / placeholders.
 406 |             template = self.get_template()
 407 |             self.update_translations(template=template)
 408 | 
 409 |         # Don't use a cached node. Always get a fresh one.
 410 |         self._clear_internal_cache()
 411 | 
 412 |         # Runs the SQL updates on the treebeard fields
 413 |         self.node.move(target_node, position)
 414 | 
 415 |         if position in ('first-child', 'last-child'):
 416 |             parent_id = target_node.pk
 417 |         else:
 418 |             # moving relative to sibling
 419 |             # or to the root of the tree
 420 |             parent_id = target_node.parent_id
 421 |         # Runs the SQL updates on the parent field
 422 |         self.node.update(parent_id=parent_id)
 423 | 
 424 |         # Clear the cached node once again to trigger a db query
 425 |         # on access.
 426 |         self._clear_node_cache()
 427 | 
 428 |         # Update the urls for the page being moved
 429 |         # and is descendants.
 430 |         languages = (
 431 |             self
 432 |             .urls
 433 |             .filter(language__in=self.get_languages())
 434 |             .values_list('language', flat=True)
 435 |         )
 436 | 
 437 |         for language in languages:
 438 |             if not self.is_home:
 439 |                 self._update_url_path(language)
 440 |             self._update_url_path_recursive(language)
 441 |         self.clear_cache()
 442 |         return self
 443 | 
 444 |     def _clear_placeholders(self, language):
 445 |         from cms.models import CMSPlugin
 446 | 
 447 |         placeholders = self.get_placeholders(language)
 448 |         placeholder_ids = (placeholder.pk for placeholder in placeholders)
 449 |         plugins = CMSPlugin.objects.filter(placeholder__in=placeholder_ids, language=language)
 450 |         models.query.QuerySet.delete(plugins)
 451 |         return placeholders

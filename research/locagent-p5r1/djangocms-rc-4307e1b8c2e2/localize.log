 247 |     def set_as_homepage(self, user=None):
 248 |         """
 249 |         Sets the given page as the homepage.
 250 |         Updates the title paths for all affected pages.
 251 |         Returns the old home page (if any).
 252 |         """
 253 |         if user:
 254 |             changed_by = get_clean_username(user)
 255 |         else:
 256 |             changed_by = constants.SCRIPT_USERNAME
 257 | 
 258 |         changed_date = now()
 259 | 
 260 |         try:
 261 |             old_home = self.__class__.objects.get(
 262 |                 is_home=True,
 263 |                 node__site=self.node.site_id,
 264 |             )
 265 |         except self.__class__.DoesNotExist:
 266 |             old_home_tree = []
 267 |         else:
 268 |             old_home.update(
 269 |                 is_home=False,
 270 |                 changed_by=changed_by,
 271 |                 changed_date=changed_date,
 272 |             )
 273 |             old_home_tree = old_home._set_title_root_path()
 274 | 
 275 |         self.update(
 276 |             is_home=True,
 277 |             changed_by=changed_by,
 278 |             changed_date=changed_date,
 279 |         )
 280 |         new_home_tree = self._remove_title_root_path()
 281 |         return (new_home_tree, old_home_tree)
 282 | 
 283 |     def _get_path_sql_value(self, base_path=''):
 284 |         if base_path:
 285 |             new_path = Concat(models.Value(base_path), models.Value('/'), models.F('slug'))
 286 |         elif base_path is None:
 287 |             new_path = None
 288 |         else:
 289 |             # the homepage
 290 |             new_path = models.F('slug')
 291 |         return new_path
 292 | 
 293 |     def _update_url_path(self, language):
 294 |         parent_page = self.get_parent_page()
 295 |         base_path = parent_page.get_path(language) if parent_page else ''
 296 |         new_path = self._get_path_sql_value(base_path)
 297 | 
 298 |         (PageUrl
 299 |          .objects
 300 |          .filter(language=language, page=self)
 301 |          .exclude(managed=False)
 302 |          .update(path=new_path))
 303 | 
 304 |     def _update_url_path_recursive(self, language):
 305 |         if self.node.is_leaf() or language not in self.get_languages():
 306 |             return
 307 | 
 308 |         pages = self.get_child_pages()
 309 |         base_path = self.get_path(language)
 310 |         new_path = self._get_path_sql_value(base_path)
 311 | 
 312 |         (PageUrl
 313 |          .objects
 314 |          .filter(language=language, page__in=pages)
 315 |          .exclude(managed=False)
 316 |          .update(path=new_path))
 317 | 
 318 |         for child in pages.filter(urls__language=language).iterator():
 319 |             child._update_url_path_recursive(language)
 320 | 
 321 |     def _set_title_root_path(self):
 322 |         node_tree = TreeNode.get_tree(self.node)
 323 |         page_tree = self.__class__.objects.filter(node__in=node_tree)
 324 |         page_urls = PageUrl.objects.filter(page__in=page_tree, managed=True, path__isnull=False)
 325 | 
 326 |         for language, slug in self.urls.values_list('language', 'slug'):
 327 |             # Update the translations for all descendants of this page
 328 |             # to include this page's slug as its path prefix
 329 |             (page_urls
 330 |              .filter(language=language)
 331 |              .update(path=Concat(models.Value(slug), models.Value('/'), 'path')))
 332 |             self.update_urls(language, path=slug)
 333 |         return page_tree
 334 | 
 335 |     def _remove_title_root_path(self):
 336 |         node_tree = TreeNode.get_tree(self.node)
 337 |         page_tree = self.__class__.objects.filter(node__in=node_tree)
 338 |         page_urls = PageUrl.objects.filter(page__in=page_tree, managed=True, path__isnull=False)
 339 | 
 340 |         for language, slug in self.urls.values_list('language', 'slug'):
 341 |             # Use 2 because of 1 indexing plus the fact we need to trim
 342 |             # the "/" character.
 343 |             trim_count = len(slug) + 2
 344 |             sql_func = models.Func(
 345 |                 models.F('path'),
 346 |                 models.Value(trim_count),
 347 |                 function='substr',
 348 |             )
 349 |             (page_urls
 350 |              .filter(language=language, path__startswith=slug)
 351 |              .update(path=sql_func))
 352 |         return page_tree
 353 | 
 354 |     def is_potential_home(self):
 355 |         """
 356 |         Encapsulates logic for determining if this page is eligible to be set
 357 |         as `is_home`. This is a public method so that it can be accessed in the
 358 |         admin for determining whether to enable the "Set as home" menu item.
 359 |         :return: Boolean
 360 |         """
 361 |         # Only root nodes are eligible for homepage
 362 |         return not self.is_home and bool(self.node.is_root())
 363 | 
 364 |     def get_absolute_url(self, language=None, fallback=True):
 365 |         if not language:
 366 |             language = get_current_language()
 367 | 
 368 |         with force_language(language):
 369 |             if self.is_home:
 370 |                 return reverse('pages-root')
 371 |             path = self.get_path(language, fallback) or self.get_slug(language, fallback)
 372 |             return reverse('pages-details-by-slug', kwargs={"slug": path})

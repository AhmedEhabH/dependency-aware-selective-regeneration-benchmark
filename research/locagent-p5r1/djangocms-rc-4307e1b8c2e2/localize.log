 768 |     def get_title_obj(self, language=None, fallback=True, force_reload=False):
 769 |         """Helper function for accessing wanted / current title.
 770 |         If wanted title doesn't exists, EmptyPageContent instance will be returned.
 771 |         """
 772 |         language = self._get_title_cache(language, fallback, force_reload)
 773 |         if language in self.title_cache:
 774 |             return self.title_cache[language]
 775 |         from cms.models import EmptyPageContent
 776 | 

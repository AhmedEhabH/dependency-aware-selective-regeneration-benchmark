 453 |     def copy(self, site, parent_node=None, language=None,
 454 |              translations=True, permissions=False, extensions=True):
 455 |         from cms.utils.page import get_available_slug
 456 | 
 457 |         if parent_node:
 458 |             new_node = parent_node.add_child(site=site)
 459 |             parent_page = parent_node.item
 460 |         else:
 461 |             new_node = TreeNode.add_root(site=site)
 462 |             parent_page = None
 463 | 
 464 |         new_page = copy.copy(self)
 465 |         new_page._state = ModelState()
 466 |         new_page._clear_internal_cache()
 467 |         new_page.pk = None
 468 |         new_page.node = new_node
 469 |         new_page.publisher_public_id = None
 470 |         new_page.is_home = False
 471 |         new_page.reverse_id = None
 472 |         new_page.languages = ''
 473 |         new_page.save()
 474 | 
 475 |         # Have the node remember its page.
 476 |         # This is done to save some queries
 477 |         # when the node's descendants are copied.
 478 |         new_page.node.__dict__['item'] = new_page
 479 | 
 480 |         if language and translations:
 481 |             page_urls = self.urls.filter(language=language)
 482 |             translations = self.pagecontent_set.filter(language=language)
 483 |         elif translations:
 484 |             page_urls = self.urls.all()
 485 |             translations = self.pagecontent_set.all()
 486 |         else:
 487 |             page_urls = self.urls.none()
 488 |             translations = self.pagecontent_set.none()
 489 |         translations = translations.prefetch_related('placeholders')
 490 | 
 491 |         for page_url in page_urls:
 492 |             new_url = copy.copy(page_url)
 493 |             new_url.pk = None
 494 |             new_url.page = new_page
 495 | 
 496 |             if parent_page:
 497 |                 base = parent_page.get_path(page_url.language)
 498 |                 path = '%s/%s' % (base, page_url.slug) if base else page_url.slug
 499 |             else:
 500 |                 base = ''
 501 |                 path = page_url.slug
 502 | 
 503 |             new_url.slug = get_available_slug(site, path, page_url.language)
 504 |             new_url.path = '%s/%s' % (base, new_url.slug) if base else new_url.slug
 505 |             new_url.save()
 506 | 
 507 |         # copy titles of this page
 508 |         for title in translations:
 509 |             new_title = copy.copy(title)
 510 |             new_title.pk = None
 511 |             new_title.page = new_page
 512 |             new_title.template = title.template
 513 |             new_title.xframe_options = title.xframe_options
 514 |             new_title.save()
 515 | 
 516 |             for placeholder in title.placeholders.all():
 517 |                 # copy the placeholders (and plugins on those placeholders!)
 518 |                 new_placeholder = new_title.placeholders.create(
 519 |                     slot=placeholder.slot,
 520 |                     default_width=placeholder.default_width,
 521 |                 )
 522 |                 placeholder.copy_plugins(new_placeholder, language=new_title.language)
 523 |             new_page.title_cache[new_title.language] = new_title
 524 |         new_page.update_languages([trans.language for trans in translations])
 525 | 
 526 |         if extensions:
 527 |             from cms.extensions import extension_pool
 528 |             extension_pool.copy_extensions(self, new_page)
 529 | 
 530 |         # copy permissions if requested
 531 |         if permissions and get_cms_setting('PERMISSION'):
 532 |             permissions = self.pagepermission_set.iterator()
 533 |             permissions_new = []
 534 | 
 535 |             for permission in permissions:
 536 |                 permission.pk = None
 537 |                 permission.page = new_page
 538 |                 permissions_new.append(permission)
 539 | 
 540 |             if permissions_new:
 541 |                 new_page.pagepermission_set.bulk_create(permissions_new)
 542 |         return new_page
 543 | 
 544 |     def copy_with_descendants(self, target_node=None, position=None,
 545 |                               copy_permissions=True, target_site=None):
 546 |         """
 547 |         Copy a page [ and all its descendants to a new location ]
 548 |         """
 549 |         if position in ('first-child', 'last-child'):
 550 |             parent_node = target_node
 551 |         elif target_node:
 552 |             parent_node = target_node.parent
 553 |         else:
 554 |             parent_node = None
 555 | 
 556 |         if target_site is None:
 557 |             target_site = parent_node.site if parent_node else self.node.site
 558 | 
 559 |         # Evaluate the descendants queryset BEFORE copying the page.
 560 |         # Otherwise, if the page is copied and pasted on itself, it will duplicate.
 561 |         descendants = list(
 562 |             self.get_descendant_pages()
 563 |             .select_related('node')
 564 |             .prefetch_related('urls', 'pagecontent_set')
 565 |         )
 566 |         new_root_page = self.copy(target_site, parent_node=parent_node)
 567 |         new_root_node = new_root_page.node
 568 | 
 569 |         if target_node and position in ('first-child'):
 570 |             # target node is a parent and user has requested to
 571 |             # insert the new page as its first child
 572 |             new_root_node.move(target_node, position)
 573 |             new_root_node.refresh_from_db(fields=('path', 'depth'))
 574 | 
 575 |         if target_node and position in ('left', 'last-child'):
 576 |             # target node is a sibling
 577 |             new_root_node.move(target_node, position)
 578 |             new_root_node.refresh_from_db(fields=('path', 'depth'))
 579 | 
 580 |         nodes_by_id = {self.node.pk: new_root_node}
 581 | 
 582 |         for page in descendants:
 583 |             parent = nodes_by_id[page.node.parent_id]
 584 |             new_page = page.copy(
 585 |                 target_site,
 586 |                 parent_node=parent,
 587 |                 translations=True,
 588 |                 permissions=copy_permissions,
 589 |             )
 590 |             nodes_by_id[page.node_id] = new_page.node
 591 |         return new_root_page
 592 | 

 788 |     def get_path(self, language, fallback=True):
 789 |         """
 790 |         get the path of the page depending on the given language
 791 |         """
 792 |         languages = [language]
 793 | 
 794 |         if fallback:
 795 |             languages.extend(self.get_fallbacks(language))
 796 | 
 797 |         page_languages = self.get_languages()
 798 | 
 799 |         for _language in languages:
 800 |             if _language in page_languages:
 801 |                 language = _language
 802 |                 break
 803 | 
 804 |         if language not in self.urls_cache:
 805 |             self.urls_cache.update({
 806 |                 url.language: url for url in self.urls.filter(language__in=languages)
 807 |             })
 808 | 
 809 |             for _language in languages:
 810 |                 self.urls_cache.setdefault(_language, None)
 811 | 
 812 |         try:
 813 |             return self.urls_cache[language].path
 814 |         except (AttributeError, KeyError):
 815 |             return None
 816 | 
 817 |     def get_slug(self, language, fallback=True):
 818 |         languages = [language]
 819 | 
 820 |         if fallback:
 821 |             languages.extend(self.get_fallbacks(language))
 822 | 
 823 |         page_languages = self.get_languages()
 824 | 
 825 |         for _language in languages:
 826 |             if _language in page_languages:
 827 |                 language = _language
 828 |                 break
 829 | 
 830 |         if language not in self.urls_cache:
 831 |             self.urls_cache.update({
 832 |                 url.language: url for url in self.urls.filter(language__in=languages)
 833 |             })
 834 | 
 835 |             for _language in languages:
 836 |                 self.urls_cache.setdefault(_language, None)
 837 | 

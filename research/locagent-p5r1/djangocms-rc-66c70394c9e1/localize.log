193 | class ShowSubMenu(InclusionTag):
194 |     """
195 |     show the sub menu of the current nav-node.
196 |     - levels: how many levels deep
197 |     - root_level: the level to start the menu at
198 |     - nephews: the level of descendants of siblings (nephews) to show
199 |     - template: template used to render the navigation
200 |     """
201 |     name = 'show_sub_menu'
202 |     template = 'menu/dummy.html'
203 | 
204 |     options = Options(
205 |         IntegerArgument('levels', default=100, required=False),
206 |         Argument('root_level', default=None, required=False),
207 |         IntegerArgument('nephews', default=100, required=False),
208 |         Argument('template', default='menu/sub_menu.html', required=False),
209 |     )
210 | 
211 |     def get_context(self, context, levels, root_level, nephews, template):
212 |         # Django 1.4 doesn't accept 'None' as a tag value and resolve to ''
213 |         # So we need to force it to None again
214 |         if not root_level and root_level != 0:
215 |             root_level = None
216 |         try:
217 |             # If there's an exception (500), default context_processors may not be called.
218 |             request = context['request']
219 |         except KeyError:
220 |             return {'template': 'menu/empty.html'}
221 | 
222 |         menu_renderer = context.get('cms_menu_renderer')
223 | 
224 |         if not menu_renderer:
225 |             menu_renderer = menu_pool.get_renderer(request)
226 | 
227 |         nodes = menu_renderer.get_nodes()
228 |         children = []
229 |         # adjust root_level so we cut before the specified level, not after
230 |         include_root = False
231 |         if root_level is not None and root_level > 0:
232 |             root_level -= 1
233 |         elif root_level is not None and root_level == 0:
234 |             include_root = True
235 |         for node in nodes:
236 |             if root_level is None:
237 |                 if node.selected:
238 |                     # if no root_level specified, set it to the selected nodes level
239 |                     root_level = node.level
240 |                     # is this the ancestor of current selected node at the root level?
241 |             is_root_ancestor = (node.ancestor and node.level == root_level)
242 |             # is a node selected on the root_level specified
243 |             root_selected = (node.selected and node.level == root_level)
244 |             if is_root_ancestor or root_selected:
245 |                 cut_after(node, levels, [])
246 |                 children = node.children
247 |                 for child in children:
248 |                     if child.sibling:
249 |                         cut_after(child, nephews, [])
250 |                         # if root_level was 0 we need to give the menu the entire tree
251 |                     # not just the children
252 |                 if include_root:
253 |                     children = menu_renderer.apply_modifiers([node], post_cut=True)
254 |                 else:
255 |                     children = menu_renderer.apply_modifiers(children, post_cut=True)
256 |         context['children'] = children
257 |         context['template'] = template
258 |         context['from_level'] = 0
259 |         context['to_level'] = 0
260 |         context['extra_inactive'] = 0
261 |         context['extra_active'] = 0
262 |         return context

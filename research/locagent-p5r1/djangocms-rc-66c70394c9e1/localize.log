102 | class ShowMenu(InclusionTag):
103 |     """
104 |     render a nested list of all children of the pages
105 |     - from_level: starting level
106 |     - to_level: max level
107 |     - extra_inactive: how many levels should be rendered of the not active tree?
108 |     - extra_active: how deep should the children of the active node be rendered?
109 |     - namespace: the namespace of the menu. if empty will use all namespaces
110 |     - root_id: the id of the root node
111 |     - template: template used to render the menu
112 |     """
113 |     name = 'show_menu'
114 |     template = 'menu/dummy.html'
115 | 
116 |     options = Options(
117 |         IntegerArgument('from_level', default=0, required=False),
118 |         IntegerArgument('to_level', default=100, required=False),
119 |         IntegerArgument('extra_inactive', default=0, required=False),
120 |         IntegerArgument('extra_active', default=1000, required=False),
121 |         StringArgument('template', default='menu/menu.html', required=False),
122 |         StringArgument('namespace', default=None, required=False),
123 |         StringArgument('root_id', default=None, required=False),
124 |         Argument('next_page', default=None, required=False),
125 |     )
126 | 
127 |     def get_context(self, context, from_level, to_level, extra_inactive,
128 |                     extra_active, template, namespace, root_id, next_page):
129 |         try:
130 |             # If there's an exception (500), default context_processors may not be called.
131 |             request = context['request']
132 |         except KeyError:
133 |             return {'template': 'menu/empty.html'}
134 | 
135 |         if next_page:
136 |             children = next_page.children
137 |         else:
138 |             # new menu... get all the data so we can save a lot of queries
139 |             menu_renderer = context.get('cms_menu_renderer')
140 | 
141 |             if not menu_renderer:
142 |                 menu_renderer = menu_pool.get_renderer(request)
143 | 
144 |             nodes = menu_renderer.get_nodes(namespace, root_id)
145 |             if root_id:  # find the root id and cut the nodes
146 |                 id_nodes = menu_pool.get_nodes_by_attribute(nodes, "reverse_id", root_id)
147 |                 if id_nodes:
148 |                     node = id_nodes[0]
149 |                     nodes = node.children
150 |                     for remove_parent in nodes:
151 |                         remove_parent.parent = None
152 |                     from_level += node.level + 1
153 |                     to_level += node.level + 1
154 |                     nodes = flatten(nodes)
155 |                 else:
156 |                     nodes = []
157 |             children = cut_levels(nodes, from_level, to_level, extra_inactive, extra_active)
158 |             children = menu_renderer.apply_modifiers(children, namespace, root_id, post_cut=True)
159 | 
160 |         try:
161 |             context['children'] = children
162 |             context['template'] = template
163 |             context['from_level'] = from_level
164 |             context['to_level'] = to_level
165 |             context['extra_inactive'] = extra_inactive
166 |             context['extra_active'] = extra_active
167 |             context['namespace'] = namespace
168 |         except:
169 |             context = {"template": template}

174 |                         _('Menu %s cannot be loaded. Please, make sure all '
175 |                           'its urls exist and can be resolved.') %
176 |                         menu_class_name)
177 |                 logger.error("Menu %s could not be loaded." %
178 |                     menu_class_name, exc_info=True)
179 |             # nodes is a list of navigation nodes (page tree in cms + others)
180 |             final_nodes += _build_nodes_inner_for_one_menu(nodes, menu_class_name)
181 | 
182 |         cache.set(key, final_nodes, get_cms_setting('CACHE_DURATIONS')['menus'])
183 | 
184 |         if not self.is_cached:
185 |             # No need to invalidate the internal lookup cache,
186 |             # just set the value directly.
187 |             self.__dict__['is_cached'] = True
188 |             # We need to have a list of the cache keys for languages and sites that

 73 | def get_menu_node_for_page(renderer, page, language, fallbacks=None):
 74 |     """
 75 |     Transform a CMS page into a navigation node.
 76 | 
 77 |     :param renderer: MenuRenderer instance bound to the request
 78 |     :param page: the page you wish to transform
 79 |     :param language: The current language used to render the menu
 80 |     """
 81 |     if fallbacks is None:
 82 |         fallbacks = []
 83 | 
 84 |     # Theses are simple to port over, since they are not calculated.
 85 |     # Other attributes will be added conditionally later.
 86 |     attr = {
 87 |         'is_page': True,
 88 |         'soft_root': page.get_soft_root(language),
 89 |         'auth_required': page.login_required,
 90 |         'reverse_id': page.reverse_id,
 91 |     }
 92 | 
 93 |     limit_visibility_in_menu = page.get_limit_visibility_in_menu(language)
 94 | 
 95 |     if limit_visibility_in_menu is constants.VISIBILITY_ALL:
 96 |         attr['visible_for_authenticated'] = True
 97 |         attr['visible_for_anonymous'] = True
 98 |     else:
 99 |         attr['visible_for_authenticated'] = limit_visibility_in_menu == constants.VISIBILITY_USERS
100 |         attr['visible_for_anonymous'] = limit_visibility_in_menu == constants.VISIBILITY_ANONYMOUS
101 |     attr['is_home'] = page.is_home
102 |     # Extenders can be either navigation extenders or from apphooks.
103 |     extenders = []
104 |     if page.navigation_extenders:
105 |         if page.navigation_extenders in renderer.menus:
106 |             extenders.append(page.navigation_extenders)
107 |         elif "{0}:{1}".format(page.navigation_extenders, page.pk) in renderer.menus:
108 |             extenders.append("{0}:{1}".format(page.navigation_extenders, page.pk))
109 |     # Is this page an apphook? If so, we need to handle the apphooks's nodes
110 |     # Only run this if we have a translation in the requested language for this
111 |     # object. The title cache should have been prepopulated in CMSMenu.get_nodes
112 |     # but otherwise, just request the title normally
113 |     if page.title_cache.get(language) and page.application_urls:
114 |         # it means it is an apphook
115 |         app = apphook_pool.get_apphook(page.application_urls)
116 | 
117 |         if app:
118 |             extenders += app.get_menus(page, language)
119 |     exts = []
120 |     for ext in extenders:
121 |         if hasattr(ext, "get_instances"):
122 |             # CMSAttachMenus are treated a bit differently to allow them to be
123 |             # able to be attached to multiple points in the navigation.
124 |             exts.append("{0}:{1}".format(ext.__name__, page.pk))
125 |         elif hasattr(ext, '__name__'):
126 |             exts.append(ext.__name__)
127 |         else:
128 |             exts.append(ext)

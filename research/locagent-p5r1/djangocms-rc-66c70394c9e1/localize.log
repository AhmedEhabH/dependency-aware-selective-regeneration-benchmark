137 | 
138 |         Namespaces: they are ID prefixes to avoid node ID clashes when plugging
139 |         multiple trees together.
140 | 
141 |         - We iterate on the list of nodes.
142 |         - We store encountered nodes in a dict (with namespaces):
143 |             done_nodes[<namespace>][<node's id>] = node
144 |         - When a node has a parent defined, we lookup that parent in done_nodes
145 |             if it's found:
146 |                 set the node as the node's parent's child (re-read this)
147 |             else:
148 |                 the node is put at the bottom of the list
149 |         """
150 |         key = self.cache_key
151 | 
152 |         cached_nodes = cache.get(key, None)
153 | 
154 |         if cached_nodes and self.is_cached:
155 |             # Only use the cache if the key is present in the database.
156 |             # This prevents a condition where keys which have been removed
157 |             # from the database due to a change in content, are still used.
158 |             return cached_nodes
159 | 
160 |         final_nodes = []
161 |         toolbar = getattr(self.request, 'toolbar', None)
162 | 
163 |         for menu_class_name in self.menus:
164 |             menu = self.get_menu(menu_class_name)
165 | 

321 |                                 extnode.parent_namespace = node.namespace
322 |                                 extnode.parent = node
323 |                                 node.children.append(extnode)
324 |         removed = []
325 | 
326 |         # find all not assigned nodes
327 |         for menu in self.renderer.menus.items():
328 |             if (hasattr(menu[1], 'cms_enabled')

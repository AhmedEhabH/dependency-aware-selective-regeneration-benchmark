253 | def get_registered_menus(self, for_rendering=False):
254 |         """
255 |         Returns all registered menu classes.
256 | 
257 |         :param for_rendering: Flag that when True forces us to include
258 |             all CMSAttachMenu subclasses, even if they're not attached.
259 |         """
260 |         self.discover_menus()
261 |         registered_menus = {}
262 | 
263 |         for menu_class_name, menu_cls in self.menus.items():
264 |             if isinstance(menu_cls, Menu):
265 |                 # A Menu **instance** was registered,
266 |                 # this is non-standard, but acceptable.
267 |                 menu_cls = menu_cls.__class__
268 |             if hasattr(menu_cls, "get_instances"):
269 |                 # It quacks like a CMSAttachMenu.
270 |                 # Expand the one CMSAttachMenu into multiple classes.
271 |                 # Each class is bound to the instance the menu is attached to.
272 |                 _get_menu_class = partial(_get_menu_class_for_instance, menu_cls)
273 | 
274 |                 instances = menu_cls.get_instances() or []
275 |                 for instance in instances:
276 |                     # For each instance, we create a unique class
277 |                     # that is bound to that instance.
278 |                     # Doing this allows us to delay the instantiation
279 |                     # of the menu class until it's needed.
280 |                     # Plus we keep the menus consistent by always
281 |                     # pointing to a class instead of an instance.
282 |                     namespace = "{0}:{1}".format(
283 |                         menu_class_name, instance.pk)
284 |                     registered_menus[namespace] = _get_menu_class(instance)
285 | 
286 |                 if not instances and not for_rendering:
287 |                     # The menu is a CMSAttachMenu but has no instances,
288 |                     # normally we'd just ignore it but it's been
289 |                     # explicitly set that we are not rendering these menus
290 |                     # via the (for_rendering) flag.
291 |                     registered_menus[menu_class_name] = menu_cls
292 |             elif hasattr(menu_cls, "get_nodes"):
293 |                 # This is another type of Menu, cannot be expanded, but must be
294 |                 # instantiated, none-the-less.
295 |                 registered_menus[menu_class_name] = menu_cls
296 |             else:
297 |                 raise ValidationError(
298 |                     "Something was registered as a menu, but isn't.")
299 |         return registered_menus
```


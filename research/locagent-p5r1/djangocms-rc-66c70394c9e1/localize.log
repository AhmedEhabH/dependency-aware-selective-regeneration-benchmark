235 | def get_subordinate_users(user, site):
236 |     """
237 |     Returns users queryset, containing all subordinate users to given user
238 |     including users created by given user and not assigned to any page.
239 | 
240 |     Not assigned users must be returned, because they shouldn't get lost, and
241 |     user should still have possibility to see them.
242 | 
243 |     Only users created_by given user which are on the same, or lover level are
244 |     returned.
245 | 
246 |     If user haves global permissions or is a superuser, then he can see all the
247 |     users.
248 | 
249 |     This function is currently used in PagePermissionInlineAdminForm for limit
250 |     users in permission combobox.
251 | 
252 |     Example:
253 |                               A,W                    level 0
254 |                             /    \
255 |                           user    B,GroupE           level 1
256 |                 Z       /     \
257 |                       C,X     D,Y,W                  level 2
258 | 
259 |         Rules: W was created by user, Z was created by user, but is not assigned
260 |         to any page.
261 | 
262 |         Will return [user, C, X, D, Y, Z]. W was created by user, but is also
263 |         assigned to higher level.
264 |     """
265 |     from cms.utils.page_permissions import get_change_permissions_id_list
266 | 
267 |     try:
268 |         user_level = get_user_permission_level(user, site)
269 |     except NoPermissionsException:
270 |         # user has no Global or Page permissions.
271 |         # return only staff users created by user
272 |         # whose page permission record has no page attached.
273 |         qs = get_user_model().objects.distinct().filter(
274 |                 Q(is_staff=True) &
275 |                 Q(pageuser__created_by=user) &
276 |                 Q(pagepermission__page=None)
277 |         )
278 |         qs = qs.exclude(pk=user.pk).exclude(groups__user__pk=user.pk)
279 |         return qs
280 | 
281 |     if user_level == ROOT_USER_LEVEL:
282 |         return get_user_model().objects.all()
283 | 
284 |     page_id_allow_list = get_change_permissions_id_list(user, site, check_global=False)
285 | 
286 |     # normal query
287 |     qs = get_user_model().objects.distinct().filter(
288 |         Q(is_staff=True) &
289 |         (Q(pagepermission__page__id__in=page_id_allow_list) & Q(pagepermission__page__node__depth__gte=user_level))
290 |         | (Q(pageuser__created_by=user) & Q(pagepermission__page=None))
291 |     )
292 |     qs = qs.exclude(pk=user.pk).exclude(groups__user__pk=user.pk)
293 |     return qs

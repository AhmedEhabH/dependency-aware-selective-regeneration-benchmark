199 |                                                "in site %r" % (key, site))
200 |             language_code = language_object['code']
201 |             for key in language_object:
202 |                 if key not in valid_language_keys:
203 |                     raise ImproperlyConfigured(
204 |                         "CMS_LANGUAGES has invalid key %r in language %r in site %r" % (key, language_code, site)
205 |                     )
206 | 
207 |             if 'fallbacks' not in language_object:
208 |                 if default_fallbacks:
209 |                     language_object['fallbacks'] = default_fallbacks
210 |                 else:
211 |                     needs_fallbacks.append((site, language_object))
212 |             for key in simple_defaults:
213 |                 if key not in language_object:
214 |                     language_object[key] = defaults[key]
215 | 
216 |     site_fallbacks = {}
217 |     for site, language_object in needs_fallbacks:
218 |         if site not in site_fallbacks:
219 |             site_fallbacks[site] = [lang['code'] for lang in languages[site] if lang['public']]
220 |         language_object['fallbacks'] = [lang_code for lang_code in site_fallbacks[site] if
221 |             lang_code != language_object['code']]
222 | 
223 |     languages['default'] = defaults

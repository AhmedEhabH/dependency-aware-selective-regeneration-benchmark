25 | def get_visible_nodes(request, pages, site):
26 |     """
27 |      This code is basically a many-pages-at-once version of
28 |      cms.utils.page_permissions.user_can_view_page
29 |      pages contains all published pages
30 |     """
31 |     user = request.user
32 |     public_for = get_cms_setting('PUBLIC_FOR')
33 |     can_see_unrestricted = public_for == 'all' or (public_for == 'staff' and user.is_staff)
34 | 
35 |     if not user.is_authenticated and not can_see_unrestricted:
36 |         # User is not authenticated and can't see unrestricted pages,
37 |         # no need to check for page restrictions because if there's some,
38 |         # user is anon and if there is not any, user can't see unrestricted.
39 |         return []
40 | 
41 |     if user_can_view_all_pages(user, site):
42 |         return list(pages)
43 | 
44 |     restricted_pages = get_view_restrictions(pages)
45 | 
46 |     if not restricted_pages:
47 |         # If there's no restrictions, let the user see all pages
48 |         # only if he can see unrestricted, otherwise return no pages.
49 |         return list(pages) if can_see_unrestricted else []
50 | 
51 |     user_id = user.pk
52 |     user_groups = SimpleLazyObject(lambda: frozenset(user.groups.values_list('pk', flat=True)))
53 |     is_auth_user = user.is_authenticated
54 | 
55 |     def user_can_see_page(page):
56 |         page_permissions = restricted_pages.get(page.pk, [])
57 | 
58 |         if not page_permissions:
59 |             # Page has no view restrictions, fallback to the project's
60 |             # CMS_PUBLIC_FOR setting.
61 |             return can_see_unrestricted
62 | 
63 |         if not is_auth_user:
64 |             return False
65 | 
66 |         for perm in page_permissions:
67 |             if perm.user_id == user_id or perm.group_id in user_groups:
68 |                 return True
69 |         return False
70 |     return [page for page in pages if user_can_see_page(page)]

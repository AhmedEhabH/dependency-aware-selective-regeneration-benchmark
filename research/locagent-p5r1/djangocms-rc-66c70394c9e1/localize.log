175 |             " as keys. Please check the format.")
176 | 
177 |     defaults = languages.pop('default', {})
178 |     default_fallbacks = defaults.get('fallbacks')
179 |     needs_fallbacks = []
180 | 
181 |     for key in defaults:
182 |         if key not in valid_language_keys:
183 |             raise ImproperlyConfigured("CMS_LANGUAGES has an invalid property in the default properties: %s" % key)
184 | 
185 |     for key in simple_defaults:
186 |         if key not in defaults:
187 |             defaults[key] = True
188 | 

349 | class SoftRootCutter(Modifier):
350 |     """
351 |     Ask evildmp/superdmp if you don't understand softroots!
352 | 
353 |     Softroot description from the docs:
354 | 
355 |         A soft root is a page that acts as the root for a menu navigation tree.
356 | 
357 |         Typically, this will be a page that is the root of a significant new
358 |         section on your site.
359 | 
360 |         When the soft root feature is enabled, the navigation menu for any page
361 |         will start at the nearest soft root, rather than at the real root of
362 |         the site’s page hierarchy.
363 | 
364 |         This feature is useful when your site has deep page hierarchies (and
365 |         therefore multiple levels in its navigation trees). In such a case, you
366 |         usually don’t want to present site visitors with deep menus of nested
367 |         items.
368 | 
369 |         For example, you’re on the page -Introduction to Bleeding-?, so the menu
370 |         might look like this:
371 | 
372 |             School of Medicine
373 |                 Medical Education
374 |                 Departments
375 |                     Department of Lorem Ipsum
376 |                     Department of Donec Imperdiet
377 |                     Department of Cras Eros
378 |                     Department of Mediaeval Surgery
379 |                         Theory
380 |                         Cures
381 |                         Bleeding
382 |                             Introduction to Bleeding <this is the current page>
383 |                             Bleeding - the scientific evidence
384 |                             Cleaning up the mess
385 |                             Cupping
386 |                             Leaches
387 |                             Maggots
388 |                         Techniques
389 |                         Instruments
390 |                     Department of Curabitur a Purus
391 |                     Department of Sed Accumsan
392 |                     Department of Etiam
393 |                 Research
394 |                 Administration
395 |                 Contact us
396 |                 Impressum
397 | 
398 |         which is frankly overwhelming.
399 | 
400 |         By making -Department of Mediaeval Surgery-? a soft root, the menu
401 |         becomes much more manageable:
402 | 
403 |             Department of Mediaeval Surgery
404 |                 Theory
405 |                 Cures
406 |                     Bleeding
407 |                         Introduction to Bleeding <current page>
408 |                         Bleeding - the scientific evidence
409 |                         Cleaning up the mess
410 |                     Cupping
411 |                     Leaches
412 |                     Maggots
413 |                 Techniques
414 |                 Instruments
415 |     """
416 | 
417 |     def modify(self, request, nodes, namespace, root_id, post_cut, breadcrumb):
418 |         # only apply this modifier if we're pre-cut (since what we do is cut)
419 |         # or if no id argument is provided, indicating {% show_menu_below_id %}
420 |         if post_cut or root_id:
421 |             return nodes
422 |         selected = None
423 |         root_nodes = []
424 |         # find the selected node as well as all the root nodes
425 |         for node in nodes:
426 |             if node.selected:
427 |                 selected = node
428 |             if not node.parent:
429 |                 root_nodes.append(node)
430 | 
431 |         # if we found a selected ...
432 |         if selected:
433 |             # and the selected is a softroot
434 |             if selected.attr.get("soft_root", False):
435 |                 # get it's descendants
436 |                 nodes = selected.get_descendants()
437 |                 # remove the link to parent
438 |                 selected.parent = None
439 |                 # make the selected page the root in the menu
440 |                 nodes = [selected] + nodes
441 |             else:
442 |                 # if it's not a soft root, walk ancestors (upwards!)
443 |                 nodes = self.find_ancestors_and_remove_children(selected, nodes)
444 |         return nodes
445 | 
446 |     def find_and_remove_children(self, node, nodes):
447 |         for child in node.children:
448 |             if child.attr.get("soft_root", False):
449 |                 self.remove_children(child, nodes)
450 |         return nodes
451 | 
452 |     def remove_children(self, node, nodes):
453 |         for child in node.children:
454 |             nodes.remove(child)
455 |             self.remove_children(child, nodes)
456 |         node.children = []
457 | 
458 |     def find_ancestors_and_remove_children(self, node, nodes):
459 |         """
460 |         Check ancestors of node for soft roots
461 |         """
462 |         if node.parent:
463 |             if node.parent.attr.get("soft_root", False):
464 |                 nodes = node.parent.get_descendants()
465 |                 node.parent.parent = None
466 |                 nodes = [node.parent] + nodes
467 |             else:
468 |                 nodes = self.find_ancestors_and_remove_children(
469 |                     node.parent, nodes)
470 |         else:
471 |             for newnode in nodes:
472 |                 if newnode != node and not newnode.parent:
473 |                     self.find_and_remove_children(newnode, nodes)
474 |         for child in node.children:
475 |             if child != node:
476 |                 self.find_and_remove_children(child, nodes)
477 |         return nodes

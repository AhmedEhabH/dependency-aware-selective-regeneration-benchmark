 170 |     def _get_model_admin(self, obj: models.Model) -> admin.ModelAdmin:
 171 |         # FrontendEditableAdminMixin needs to be added to the model's model admin class.
 172 |         # Hence, the relevant admin is the model admin itself.
 173 |         return self

 151 | class FrontendEditableAdminMixin(BaseEditableAdminMixin):
 152 |     """
 153 |     Adding ``FrontendEditableAdminMixin`` to  models admin class allows to open that admin
 154 |     in the frontend by double-clicking on fields rendered with the ``render_model`` template
 155 |     tag.
 156 |     """
 157 |     def get_urls(self) -> list[str]:
 158 |         """
 159 |         Register the url for the edit field view
 160 |         """
 161 |         info = f"{self.model._meta.app_label}_{self.model._meta.model_name}"
 162 | 
 163 |         def pat(regex, fn):
 164 |             return re_path(regex, self.admin_site.admin_view(fn), name=f"{info}_{fn.__name__}")
 165 |         url_patterns = [
 166 |             pat(r'edit-field/(%s)/([a-z\-]+)/$' % SLUG_REGEXP, self.edit_field),
 167 |         ]
 168 |         return url_patterns + super().get_urls()

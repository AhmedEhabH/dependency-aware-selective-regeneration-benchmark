 685 |     @method_decorator(require_POST)
 686 |     @xframe_options_sameorigin
 687 |     @transaction.atomic
 688 |     def move_plugin(self, request):
 689 |         """
 690 |         Performs a move or a "paste" operation (when «move_a_copy» is set)
 691 | 
 692 |         POST request with following parameters:
 693 |         - plugin_id
 694 |         - placeholder_id
 695 |         - target_position (optional)
 696 |         - plugin_language (optional)
 697 |         - plugin_parent (optional)
 698 |         - plugin_order (array, optional)
 699 |         - move_a_copy (Boolean, optional) (anything supplied here except a case-
 700 |                                         insensitive "false" is True)
 701 |         NOTE: If move_a_copy is set, the plugin_order should contain an item
 702 |               '__COPY__' with the desired destination of the copied plugin.
 703 |         """
 704 |         # plugin_id and placeholder_id are required, so, if nothing is supplied,
 705 |         # an ValueError exception will be raised by get_int().
 706 |         try:
 707 |             plugin_id = get_int(request.POST.get('plugin_id'))
 708 |         except TypeError:
 709 |             raise RuntimeError("'plugin_id' is a required parameter.")
 710 | 
 711 |         plugin = self._get_plugin_from_id(plugin_id)
 712 | 
 713 |         if request.POST.get('placeholder_id'):
 714 |             placeholder_id = get_int(request.POST.get('placeholder_id'))
 715 |             placeholder = Placeholder.objects.get(pk=placeholder_id)
 716 |             assert plugin.placeholder_id != placeholder_id
 717 |         else:
 718 |             placeholder = None
 719 | 
 720 |         # The rest are optional
 721 |         target_position = int(request.POST.get('target_position', "0"))
 722 |         parent_id = get_int(request.POST.get('plugin_parent', ""), None)
 723 |         target_language = request.POST['target_language']
 724 |         move_a_copy = request.POST.get('move_a_copy')
 725 |         move_a_copy = (
 726 |             move_a_copy and move_a_copy != "0" and move_a_copy.lower() != "false"
 727 |         )
 728 |         move_to_clipboard = placeholder == request.toolbar.clipboard
 729 |         source_placeholder = plugin.placeholder
 730 | 
 731 |         if placeholder and placeholder != source_placeholder:
 732 |             try:
 733 |                 template = self.get_placeholder_template(request, placeholder)
 734 |                 has_reached_plugin_limit(placeholder, plugin.plugin_type,
 735 |                                          target_language, template=template)
 736 |             except PluginLimitReached as er:
 737 |                 return HttpResponseBadRequest(er)
 738 | 
 739 |         # True if the plugin is not being moved from the clipboard
 740 |         # to a placeholder or from a placeholder to the clipboard.
 741 |         move_a_plugin = not move_a_copy and not move_to_clipboard
 742 | 
 743 |         if parent_id and plugin.parent_id != parent_id:
 744 |             target_pl = placeholder or plugin.placeholder
 745 | 
 746 |             if move_a_plugin:
 747 |                 target_parent = get_object_or_404(
 748 |                     CMSPlugin,
 749 |                     pk=parent_id,
 750 |                     language=target_language,
 751 |                     placeholder=target_pl,
 752 |                 )
 753 |             else:
 754 |                 target_parent = get_object_or_404(CMSPlugin, pk=parent_id)
 755 |         elif parent_id:
 756 |             target_parent = plugin.parent
 757 |         else:
 758 |             target_parent = None
 759 | 
 760 |         old_parent = None
 761 |         fetch_tree = True
 762 | 
 763 |         if move_a_copy and plugin.plugin_type == "PlaceholderPlugin":
 764 |             fetch_tree = False
 765 |             new_plugin = None
 766 |             new_plugins = self._paste_placeholder(
 767 |                 request,
 768 |                 plugin=plugin,
 769 |                 target_language=target_language,
 770 |                 target_placeholder=placeholder,
 771 |                 target_position=target_position,
 772 |             )
 773 |         elif move_a_copy:
 774 |             new_plugin = self._paste_plugin(
 775 |                 request,
 776 |                 plugin=plugin,
 777 |                 target_parent=target_parent,

 193 |         parents = [b for b in bases if isinstance(b, PlaceholderAdminMixinBase)]
 194 | 
 195 |         if not parents:
 196 |             return super_new(cls, name, bases, attrs)
 197 |         warnings.warn(
 198 |             "PlaceholderAdminMixin is no longer needed and thus will be removed in django CMS 5.0",
 199 |             RemovedInDjangoCMS51Warning,
 200 |             stacklevel=2,
 201 |         )
 202 |         return super_new(cls, name, bases, attrs)
 203 | 
 204 | 
 205 | class PlaceholderAdminMixin(metaclass=PlaceholderAdminMixinBase):
 206 |     """
 207 |     .. warning::
 208 | 
 209 |         PlaceholderAdminMixin is deprecated. It is no longer needed and thus will be removed
 210 |     """
 211 |     pass
 212 | 
 213 | 
 214 | @admin.register(Placeholder)
 215 | class PlaceholderAdmin(BaseEditableAdminMixin, admin.ModelAdmin):
 216 |     """Placeholder admin manages placeholders and their plugins, as well as the preview, edit, and
 217 |     structure endpoints."""
 218 | 
 219 |     def has_add_permission(self, request):
 220 |         # Placeholders are created by the system
 221 |         return False
 222 | 
 223 |     def has_change_permission(self, request, obj=None):
 224 |         # Placeholders are not editable in the admin
 225 |         return False
 226 | 
 227 |     def has_delete_permission(self, request, obj=None):
 228 |         # Placeholders are deleted by cascading the deletion of their source object
 229 |         # so we don't need to check for delete permissions here.
 230 |         return True
 231 | 
 232 |     def has_module_permission(self, request):
 233 |         # Do not show in admin
 234 |         return False
 235 | 
 236 |     def delete_view(self, request, object_id, extra_context=None):
 237 |         # Placeholder are deleted by cascading the deletion of their source object
 238 |         # but the admin's delete view is not available for placeholders.
 239 |         raise PermissionDenied
 240 | 
 241 |     def get_urls(self) -> list[str]:
 242 |         """
 243 |         Register the plugin specific urls (add/edit/copy/remove/move)
 244 |         """
 245 |         info = f"{self.model._meta.app_label}_{self.model._meta.model_name}"
 246 | 
 247 |         def pat(regex, fn):
 248 |             return re_path(regex, self.admin_site.admin_view(fn), name=f"{info}_{fn.__name__}")
 249 |         url_patterns = [
 250 |             re_path(r'^cms_wizard/', include('cms.wizards.urls')),
 251 |             pat(r'^copy-plugins/$', self.copy_plugins),
 252 |             pat(r'^add-plugin/$', self.add_plugin),
 253 |             pat(r'^edit-plugin/([0-9]+)/$', self.edit_plugin),
 254 |             pat(r'^edit-plugin/([0-9]+)/([a-z\-]+)/$', self.edit_field),
 255 |             pat(r'^delete-plugin/([0-9]+)/$', self.delete_plugin),
 256 |             pat(r'^clear-placeholder/([0-9]+)/$', self.clear_placeholder),
 257 |             pat(r'^move-plugin/$', self.move_plugin),
 258 |             # Register object edit/structure/preview endpoints.
 259 |             # pat(r'^object/(?P<content_type_id>\d+)/structure/(?P<object_id>.+)$', render_object_structure),
 260 |             pat(r'^object/([0-9]+)/edit/([0-9]+)/$', render_object_edit),
 261 |             pat(r'^object/([0-9]+)/structure/([0-9]+)/$', render_object_structure),
 262 |             pat(r'^object/([0-9]+)/preview/([0-9]+)/$', render_object_preview),
 263 |         ]
 264 |         return url_patterns
 265 | 
 266 |     def _get_object_for_single_field(self, object_id: int, language: str) -> CMSPlugin:
 267 |         # For BaseEditableAdminMixin: This (private) method retrieves the corresponding CMSPlugin and
 268 |         # downcasts it to the appropriate plugin model. language is ignored. This provides the plugin for
 269 |         # edit_field"""
 270 |         plugin = get_object_or_404(CMSPlugin, pk=object_id)  # Returns a CMSPlugin instance
 271 |         return plugin.get_bound_plugin()  # Returns the plugin model instance of the appropriate type
 272 | 
 273 |     def _get_model_admin(self, obj: CMSPlugin) -> admin.ModelAdmin:
 274 |         # For BaseEditableAdminMixin: This (private) method retrieves the model admin for the plugin model
 275 |         # which is the plugin instance itself.
 276 |         return obj.get_plugin_class_instance(admin=self.admin_site)
 277 | 
 278 |     def _get_operation_language(self, request):
 279 |         # Unfortunately the ?language GET query
 280 |         # has a special meaning on the CMS.
 281 |         # It allows users to see another language while maintaining
 282 |         # the same url. This complicates language detection.
 283 |         site = get_current_site()
 284 |         parsed_url = urlparse(request.GET['cms_path'])
 285 |         queries = dict(parse_qsl(parsed_url.query))
 286 |         language = queries.get('language')
 287 | 
 288 |         if not language:
 289 |             language = get_language_from_path(parsed_url.path)
 290 |         return get_language_code(language, site_id=site.pk)
 291 | 
 292 |     def _get_operation_origin(self, request):
 293 |         return urlparse(request.GET['cms_path']).path
 294 | 
 295 |     def _send_pre_placeholder_operation(self, request, operation, **kwargs):
 296 |         token = str(uuid.uuid4())
 297 | 
 298 |         if not request.GET.get('cms_path'):
 299 |             warnings.warn('All custom placeholder admin endpoints require '
 300 |                           'a "cms_path" GET query which points to the path '
 301 |                           'where the request originates from.'
 302 |                           'This backwards compatible shim will be removed on 3.5 '
 303 |                           'and an HttpBadRequest response will be returned instead.',
 304 |                           UserWarning)
 305 |             return token
 306 | 
 307 |         pre_placeholder_operation.send(
 308 |             sender=self.__class__,
 309 |             operation=operation,
 310 |             request=request,
 311 |             language=self._get_operation_language(request),
 312 |             token=token,
 313 |             origin=self._get_operation_origin(request),
 314 |             **kwargs
 315 |         )
 316 |         return token
 317 | 
 318 |     def _send_post_placeholder_operation(self, request, operation, token, **kwargs):
 319 |         if not request.GET.get('cms_path'):
 320 |             # No need to re-raise the warning
 321 |             return
 322 | 
 323 |         post_placeholder_operation.send(
 324 |             sender=self.__class__,
 325 |             operation=operation,
 326 |             request=request,
 327 |             language=self._get_operation_language(request),
 328 |             token=token,
 329 |             origin=self._get_operation_origin(request),
 330 |             **kwargs
 331 |         )
 332 | 
 333 |     def _get_plugin_from_id(self, plugin_id):
 334 |         queryset = CMSPlugin.objects.values_list('plugin_type', flat=True)
 335 |         plugin_type = get_list_or_404(queryset, pk=plugin_id)[0]
 336 |         # CMSPluginBase subclass
 337 |         plugin_class = plugin_pool.get_plugin(plugin_type)
 338 |         real_queryset = plugin_class.get_render_queryset().select_related('parent', 'placeholder')
 339 |         return get_object_or_404(real_queryset, pk=plugin_id)
 340 | 
 341 |     def has_add_plugin_permission(self, request, placeholder, plugin_type):
 342 |         return placeholder.has_add_plugin_permission(request.user, plugin_type)
 343 | 
 344 |     def has_change_plugin_permission(self, request, plugin):
 345 |         placeholder = plugin.placeholder
 346 |         return placeholder.has_change_plugin_permission(request.user, plugin)
 347 | 
 348 |     def has_delete_plugin_permission(self, request, plugin):
 349 |         placeholder = plugin.placeholder
 350 |         return placeholder.has_delete_plugin_permission(request.user, plugin)
 351 | 
 352 |     def has_copy_plugins_permission(self, request, plugins):
 353 |         # Plugins can only be copied to the clipboard
 354 |         placeholder = request.toolbar.clipboard
 355 |         return placeholder.has_add_plugins_permission(request.user, plugins)
 356 | 
 357 |     def has_copy_from_clipboard_permission(self, request, placeholder, plugins):
 358 |         return placeholder.has_add_plugins_permission(request.user, plugins)
 359 | 
 360 |     def has_copy_from_placeholder_permission(self, request, source_placeholder, target_placeholder, plugins):
 361 |         if not source_placeholder.has_add_plugins_permission(request.user, plugins):
 362 |             return False
 363 |         return target_placeholder.has_add_plugins_permission(request.user, plugins)
 364 | 
 365 |     def has_move_plugin_permission(self, request, plugin, target_placeholder):
 366 |         placeholder = plugin.placeholder
 367 |         return placeholder.has_move_plugin_permission(request.user, plugin, target_placeholder)
 368 | 
 369 |     def has_clear_placeholder_permission(self, request, placeholder, language=None):
 370 |         if language:
 371 |             languages = [language]
 372 |         else:
 373 |             # fetch all languages this placeholder contains
 374 |             # based on it's plugins
 375 |             languages = (
 376 |                 placeholder
 377 |                 .cmsplugin_set
 378 |                 .values_list('language', flat=True)
 379 |                 .distinct()
 380 |                 .order_by()
 381 |             )
 382 |         return placeholder.has_clear_permission(request.user, languages)
 383 | 
 384 |     def get_placeholder_template(self, request, placeholder):
 385 |         pass

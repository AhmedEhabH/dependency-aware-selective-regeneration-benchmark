 387 |     @xframe_options_sameorigin
 388 |     def add_plugin(self, request):
 389 |         """
 390 |         Shows the add plugin form and saves it on POST.
 391 | 
 392 |         Requires the following GET parameters:
 393 |             - cms_path
 394 |             - placeholder_id
 395 |             - plugin_type
 396 |             - plugin_language
 397 |             - plugin_position
 398 |             - plugin_parent (optional)
 399 |         """
 400 |         form = PluginAddValidationForm(request.GET)
 401 | 
 402 |         if not form.is_valid():
 403 |             # list() is necessary for python 3 compatibility.
 404 |             # errors is s dict mapping fields to a list of errors
 405 |             # for that field.
 406 |             error = list(form.errors.values())[0][0]
 407 |             return HttpResponseBadRequest(conditional_escape(force_str(error)))
 408 | 
 409 |         plugin_data = form.cleaned_data
 410 |         placeholder = plugin_data['placeholder_id']
 411 |         plugin_type = plugin_data['plugin_type']
 412 | 
 413 |         if not self.has_add_plugin_permission(request, placeholder, plugin_type):
 414 |             message = _('You do not have permission to add a plugin')
 415 |             return HttpResponseForbidden(message)
 416 | 
 417 |         if not placeholder.check_source(request.user):
 418 |             message = _('You do not have permission to add a plugin')
 419 |             return HttpResponseForbidden(message)
 420 | 
 421 |         plugin_class = plugin_pool.get_plugin(plugin_type)
 422 |         plugin_instance = plugin_class(plugin_class.model, self.admin_site)
 423 | 
 424 |         # Setting attributes on the form class is perfectly fine.
 425 |         # The form class is created by modelform factory every time
 426 |         # this get_form() method is called.
 427 |         plugin_instance._cms_initial_attributes = {
 428 |             'language': plugin_data['plugin_language'],
 429 |             'placeholder': plugin_data['placeholder_id'],
 430 |             'parent': plugin_data.get('plugin_parent', None),
 431 |             'plugin_type': plugin_data['plugin_type'],
 432 |             'position': plugin_data['plugin_position'],
 433 |         }
 434 | 
 435 |         if request.method == 'POST' and not plugin_class.show_add_form:
 436 |             # If the plugin has show_add_form set to False,
 437 |             # the post data is missing the initial values of the plugin form
 438 |             # Get the fields, the form and the initial values from the plugin instance
 439 |             # Replace the POST parameters by those initial values plus any concrete changes
 440 |             # the form.
 441 |             # TODO: Make this work with Text plugins which use ghost plugins and have to
 442 |             # have show_add_form=True
 443 |             fieldsets = plugin_instance.get_fieldsets(request, obj=None)
 444 |             fields = flatten_fieldsets(fieldsets)
 445 |             # Instantiate the add form for all fields
 446 |             initial_form = plugin_instance.get_form(request, None, change=False, fields=fields)()
 447 |             # Turn the initial values in a multi-value dict. In a multi-value dict each value is a list.
 448 |             # Hence, if the initial value is not a list, it is turned into a list.
 449 |             query_dict = MultiValueDict({
 450 |                 name: field.initial if isinstance(field.initial, (tuple, list)) else [field.initial]
 451 |                 for name, field in initial_form.fields.items()
 452 |                 if getattr(field, "initial", None) is not None and name not in request.POST
 453 |             })
 454 |             # Add the actual post parameters
 455 |             query_dict.update(request.POST)
 456 |             # Use the QueryDict as the POST data
 457 |             request.POST = query_dict
 458 | 
 459 |         response = plugin_instance.add_view(request)
 460 |         plugin = getattr(plugin_instance, 'saved_object', None)
 461 | 
 462 |         if plugin_instance._operation_token:
 463 |             self._send_post_placeholder_operation(
 464 |                 request,
 465 |                 operation=operations.ADD_PLUGIN,
 466 |                 token=plugin_instance._operation_token,
 467 |                 plugin=plugin,
 468 |                 placeholder=plugin.placeholder,
 469 |             )
 470 |         return response
 471 | 
 472 |     @method_decorator(require_POST)
 473 |     @xframe_options_sameorigin
 474 |     @transaction.atomic
 475 |     def copy_plugins(self, request):
 476 |         """
 477 |         POST request should have the following data:
 478 | 
 479 |         - cms_path
 480 |         - source_language
 481 |         - source_placeholder_id
 482 |         - source_plugin_id (optional)
 483 |         - target_language
 484 |         - target_placeholder_id
 485 |         """
 486 |         source_placeholder_id = request.POST['source_placeholder_id']
 487 |         target_language = request.POST['target_language']
 488 |         target_placeholder_id = request.POST['target_placeholder_id']
 489 |         source_placeholder = get_object_or_404(Placeholder, pk=source_placeholder_id)
 490 |         target_placeholder = get_object_or_404(Placeholder, pk=target_placeholder_id)
 491 | 
 492 |         if not target_language or target_language not in get_language_list():
 493 |             return HttpResponseBadRequest(_("Language must be set to a supported language!"))
 494 | 
 495 |         copy_to_clipboard = target_placeholder.pk == request.toolbar.clipboard.pk
 496 |         source_plugin_id = request.POST.get('source_plugin_id', None)
 497 | 
 498 |         if copy_to_clipboard and source_plugin_id:
 499 |             new_plugin = self._copy_plugin_to_clipboard(
 500 |                 request,
 501 |                 target_placeholder,
 502 |             )
 503 |             new_plugins = [new_plugin]
 504 |         elif copy_to_clipboard:
 505 |             new_plugin = self._copy_placeholder_to_clipboard(
 506 |                 request,
 507 |                 source_placeholder,
 508 |                 target_placeholder,
 509 |             )
 510 |             new_plugins = [new_plugin]
 511 |         else:
 512 |             new_plugins = self._add_plugins_from_placeholder(
 513 |                 request,
 514 |                 source_placeholder,
 515 |                 target_placeholder,
 516 |             )
 517 |         data = get_plugin_tree(request, new_plugins)
 518 |         return HttpResponse(json.dumps(data), content_type='application/json')
 519 | 
 520 |     def _copy_plugin_to_clipboard(self, request, target_placeholder):
 521 |         source_language = request.POST['source_language']
 522 |         source_plugin_id = request.POST.get('source_plugin_id')
 523 |         target_language = request.POST['target_language']
 524 | 
 525 |         source_plugin = get_object_or_404(
 526 |             CMSPlugin,
 527 |             pk=source_plugin_id,
 528 |             language=source_language,
 529 |         )
 530 |         old_plugins = [source_plugin] + list(source_plugin.get_descendants())
 531 | 
 532 |         if not self.has_copy_plugins_permission(request, old_plugins):
 533 |             message = _('You do not have permission to copy these plugins.')
 534 |             raise PermissionDenied(message)
 535 | 
 536 |         if not target_placeholder.check_source(request.user):
 537 |             message = _('You do not have permission to copy these plugins.')
 538 |             raise PermissionDenied(message)
 539 | 
 540 |         # Empty the clipboard
 541 |         target_placeholder.clear()
 542 | 
 543 |         copied_plugins = copy_plugins_to_placeholder(
 544 |             old_plugins,
 545 |             placeholder=target_placeholder,
 546 |             language=target_language,
 547 |         )
 548 |         return copied_plugins[0]
 549 | 
 550 |     def _copy_placeholder_to_clipboard(self, request, source_placeholder, target_placeholder):
 551 |         source_language = request.POST['source_language']
 552 |         target_language = request.POST['target_language']
 553 | 
 554 |         # User is copying the whole placeholder to the clipboard.
 555 |         old_plugins = source_placeholder.get_plugins_list(language=source_language)
 556 | 
 557 |         if not self.has_copy_plugins_permission(request, old_plugins):
 558 |             message = _('You do not have permission to copy this placeholder.')
 559 |             raise PermissionDenied(message)
 560 | 
 561 |         if not target_placeholder.check_source(request.user):
 562 |             message = _('You do not have permission to copy this placeholder.')
 563 |             raise PermissionDenied(message)
 564 | 
 565 |         # Empty the clipboard
 566 |         target_placeholder.clear()
 567 | 
 568 |         # Create a PlaceholderReference plugin which in turn
 569 |         # creates a blank placeholder called "clipboard"
 570 |         # the real clipboard has the reference placeholder inside but the plugins
 571 |         # are inside of the newly created blank clipboard.
 572 |         # This allows us to wrap all plugins in the clipboard under one plugin
 573 |         reference = PlaceholderReference.objects.create(
 574 |             name=source_placeholder.get_label(),
 575 |             plugin_type='PlaceholderPlugin',
 576 |             language=target_language,
 577 |             placeholder=target_placeholder,
 578 |         )
 579 |         copy_plugins_to_placeholder(
 580 |             old_plugins,
 581 |             placeholder=reference.placeholder_ref,
 582 |             language=target_language,
 583 |         )
 584 |         return reference
 585 | 
 586 |     def _add_plugins_from_placeholder(self, request, source_placeholder, target_placeholder):
 587 |         # Plugins are being copied from a placeholder in another language
 588 |         # using the "Copy from language" placeholder operation.
 589 |         source_language = request.POST['source_language']
 590 |         target_language = request.POST['target_language']
 591 | 
 592 |         old_plugins = source_placeholder.get_plugins_list(language=source_language)
 593 | 
 594 |         # Check if the user can copy plugins from source placeholder to
 595 |         # target placeholder.
 596 |         has_permissions = self.has_copy_from_placeholder_permission(
 597 |             request,
 598 |             source_placeholder,
 599 |             target_placeholder,
 600 |             old_plugins,
 601 |         )
 602 | 
 603 |         if not has_permissions:
 604 |             message = _('You do not have permission to copy these plugins.')
 605 |             raise PermissionDenied(message)
 606 | 
 607 |         if not target_placeholder.check_source(request.user):
 608 |             message = _('You do not have permission to copy these plugins.')
 609 |             raise PermissionDenied(message)
 610 | 
 611 |         target_tree_order = target_placeholder.get_plugin_tree_order(
 612 |             language=target_language,
 613 |             parent_id=None,
 614 |         )
 615 | 
 616 |         operation_token = self._send_pre_placeholder_operation(
 617 |             request,
 618 |             operation=operations.ADD_PLUGINS_FROM_PLACEHOLDER,
 619 |             plugins=old_plugins,
 620 |             source_language=source_language,
 621 |             source_placeholder=source_placeholder,
 622 |             target_language=target_language,
 623 |             target_placeholder=target_placeholder,
 624 |             target_order=target_tree_order,
 625 |         )
 626 | 
 627 |         copied_plugins = copy_plugins_to_placeholder(old_plugins, target_placeholder, language=target_language)
 628 |         new_plugin_ids = (new.pk for new in copied_plugins)
 629 | 
 630 |         target_placeholder.clear_cache(target_language)
 631 | 
 632 |         new_plugins = CMSPlugin.objects.filter(pk__in=new_plugin_ids)
 633 |         new_plugins = list(new_plugins)
 634 | 
 635 |         self._send_post_placeholder_operation(
 636 |             request,
 637 |             operation=operations.ADD_PLUGINS_FROM_PLACEHOLDER,
 638 |             token=operation_token,
 639 |             plugins=new_plugins,
 640 |             source_language=source_language,
 641 |             source_placeholder=source_placeholder,
 642 |             target_language=target_language,
 643 |             target_placeholder=target_placeholder,
 644 |             target_order=target_tree_order,
 645 |         )
 646 |         return new_plugins
 647 | 
 648 |     @xframe_options_sameorigin
 649 |     def edit_plugin(self, request, plugin_id):
 650 |         try:
 651 |             plugin_id = int(plugin_id)
 652 |         except ValueError:
 653 |             return HttpResponseNotFound(_("Plugin not found"))
 654 | 
 655 |         obj = self._get_plugin_from_id(plugin_id)
 656 | 
 657 |         # CMSPluginBase subclass instance
 658 |         plugin_instance = obj.get_plugin_class_instance(admin=self.admin_site)
 659 | 
 660 |         if not self.has_change_plugin_permission(request, obj):
 661 |             return HttpResponseForbidden(_("You do not have permission to edit this plugin"))
 662 | 
 663 |         if not obj.placeholder.check_source(request.user):
 664 |             message = _("You do not have permission to edit this plugin")
 665 |             return HttpResponseForbidden(message)
 666 | 
 667 |         response = plugin_instance.change_view(request, str(plugin_id))
 668 | 
 669 |         plugin = getattr(plugin_instance, 'saved_object', None)
 670 | 
 671 |         if plugin:
 672 |             plugin.placeholder.clear_cache(plugin.language)
 673 | 
 674 |         if plugin_instance._operation_token:
 675 |             self._send_post_placeholder_operation(
 676 |                 request,
 677 |                 operation=operations.CHANGE_PLUGIN,
 678 |                 token=plugin_instance._operation_token,
 679 |                 old_plugin=obj,
 680 |                 new_plugin=plugin,
 681 |                 placeholder=plugin.placeholder,
 682 |             )
 683 |         return response

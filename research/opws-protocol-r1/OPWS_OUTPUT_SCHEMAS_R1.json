{
  "mission": "M17_OPWS_PROTOCOL_FREEZE_R1",
  "artifact": "opws_output_schemas_r1",
  "phase": "P12",
  "freeze_date": "2026-10-12",
  "status": "FROZEN_SCHEMA_ONLY",
  "purpose": "Predefined output schemas that a FUTURE OPWS execution must produce. No scientific result value is generated by this freeze mission.",
  "schema_version": "opws_output_schema_v1",
  "files": {
    "OPWS_EXECUTION_MANIFEST.json": {
      "purpose": "Complete frozen execution plan for the bound population",
      "mandatory_fields": [
        "protocol_sha256",
        "population_binding_sha256",
        "n_tasks",
        "n_physical_executions",
        "n_logical_arm_records",
        "task_major_order_sha256",
        "environment_id",
        "execution_start_utc",
        "execution_end_utc",
        "generated_by",
        "generated_sha256"
      ]
    },
    "OPWS_TASK_ARM_RESULTS.jsonl": {
      "purpose": "One JSON object per logical arm-record",
      "mandatory_fields": [
        "task_id",
        "arm_id",
        "scope_size_files",
        "selected_scope_hash",
        "reference_patch_hash",
        "test_contract_hash",
        "environment_id",
        "physical_execution_id",
        "behavior_sufficient",
        "preservation_pass",
        "opws_joint_pass",
        "historical_recall",
        "recall_gap",
        "outcome_class",
        "invalid_code",
        "duplicate_prediction_count",
        "invalid_prediction_path_count",
        "wall_time_seconds",
        "patch_apply_seconds",
        "test_seconds"
      ]
    },
    "OPWS_PHYSICAL_EXECUTION_MAP.json": {
      "purpose": "Physical-execution to logical-arm mapping (dedup)",
      "mandatory_fields": [
        "physical_execution_id",
        "task_id",
        "scope_hash",
        "reference_patch_hash",
        "test_contract_hash",
        "environment_id",
        "logical_arm_ids",
        "dedup_reason"
      ]
    },
    "OPWS_FAILURE_TAXONOMY_COUNTS.json": {
      "purpose": "Counts per OPWS_OUTCOME_TAXONOMY_R1.json class",
      "mandatory_fields": [
        "n_tasks",
        "n_arm_records",
        "counts_per_class",
        "counts_per_invalid_code",
        "generated_sha256"
      ]
    },
    "OPWS_ARM_SUMMARY.json": {
      "purpose": "Per-arm aggregates",
      "mandatory_fields": [
        "arm_id",
        "role",
        "n_eligible",
        "BEHAVIOR_SUFFICIENCY_RATE",
        "PRESERVATION_PASS_RATE",
        "JOINT_OPWS_PASS_RATE",
        "MEAN_SCOPE_SIZE",
        "MEDIAN_SCOPE_SIZE",
        "scope_size_distribution",
        "recall_gap_rate"
      ]
    },
    "OPWS_PAIRED_COMPARISONS.json": {
      "purpose": "Paired estimates per comparison (primary + secondary)",
      "mandatory_fields": [
        "comparison_id",
        "arm_a",
        "arm_b",
        "n_paired",
        "estimand",
        "point_estimate",
        "ci95_low",
        "ci95_high",
        "n_bootstrap",
        "bootstrap_seed",
        "scope_size_delta"
      ]
    },
    "OPWS_BOOTSTRAP_RESULTS.json": {
      "purpose": "Full bootstrap delta distribution summary",
      "mandatory_fields": [
        "comparison_id",
        "estimand",
        "n_bootstrap",
        "seed",
        "point_estimate",
        "ci95_low",
        "ci95_high",
        "distribution_sha256"
      ]
    },
    "OPWS_SUFFICIENCY_SCOPE_FRONTIER.csv": {
      "purpose": "Primary RQ3 frontier table",
      "mandatory_fields": [
        "arm_id",
        "joint_opws_pass_rate",
        "behavior_sufficiency_rate",
        "preservation_rate",
        "mean_scope_size",
        "median_scope_size",
        "n_eligible"
      ]
    },
    "OPWS_INVALID_TASKS.json": {
      "purpose": "All invalidated task/arm records with reasons; no silent exclusion",
      "mandatory_fields": [
        "task_id",
        "arm_id",
        "invalid_code",
        "reason",
        "effective_reference_patch_identity"
      ]
    },
    "OPWS_EXECUTION_RECEIPT.json": {
      "purpose": "Final immutable execution receipt",
      "mandatory_fields": [
        "protocol_sha256",
        "population_binding_sha256",
        "environment_id",
        "all_files_sha256",
        "completion_utc",
        "audit_flags",
        "generated_sha256"
      ]
    }
  },
  "hard_rules": [
    "Result output schemas are FROZEN in this mission but NO result files or scientific values are created here.",
    "Every mandatory field must be present in future outputs; absent fields fail the protocol validator.",
    "Infrastructure and invalid classes always populate OPWS_FAILURE_TAXONOMY_COUNTS.json and OPWS_INVALID_TASKS.json; never silent.",
    "All sha256 fields use the project canon (sha256 hex lower-case over the exact serialized content)."
  ]
}
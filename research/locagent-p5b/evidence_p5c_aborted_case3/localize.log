240 |         url = admin_reverse('cms_placeholder_render_object_edit', args=[content_type.pk, obj.pk])
241 |     if get_cms_setting('ENDPOINT_LIVE_URL_QUERYSTRING_PARAM_ENABLED'):
242 |         url = add_live_url_querystring_param(obj, url, language)

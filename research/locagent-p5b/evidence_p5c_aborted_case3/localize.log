440 |     def _call_toolbar(self, func_name):
441 |         with force_language(self.toolbar_language):
442 |             first = ('cms.cms_toolbars.BasicToolbar', 'cms.cms_toolbars.PlaceholderToolbar')
443 | 
444 |             for key in first:
445 |                 toolbar = self.toolbars.get(key)
446 |                 if not toolbar:
447 |                     continue
448 |                 getattr(toolbar, func_name)()
449 | 
450 |             for key in self.toolbars:
451 |                 if key in first:
452 |                     continue
453 |                 toolbar = self.toolbars[key]
454 |                 getattr(toolbar, func_name)()

209 | def get_menu_node_for_page_content(
210 |         self,
211 |         page_content: PageContent,
212 |         preview_url: Optional[str] = None,
213 |         cut: bool = False,
214 |     ) -> CMSNavigationNode:
215 |         """
216 |         Transform a CMS page content object into a navigation node.
217 | 
218 |         :param page: The page to transform.
219 |         :param languages: The list of the current language plus fallbacks used to render the menu.
220 |         :param preview_url: If given, serves as a "pattern" for a preview url with the assumption that "/0/" is replaced
221 |             by the actual page content pk. Default is None.
222 |         :param cut: If True the parent_id is set to None. Default is False.
223 |         :returns: A CMSNavigationNode instance.
224 |         """
225 |         page = page_content.page
226 | 
227 |         # These are simple to port over, since they are not calculated.
228 |         # Other attributes will be added conditionally later.
229 |         visibility = page_content.limit_visibility_in_menu
230 |         attr = {
231 |             "is_page": True,
232 |             "soft_root": page_content.soft_root,
233 |             "auth_required": page.login_required,
234 |             "reverse_id": page.reverse_id,
235 |             "is_home": page.is_home,
236 |             "visible_for_authenticated": visibility in VISIBLE_FOR_AUTHENTICATED,
237 |             "visible_for_anonymous": visibility in VISIBLE_FOR_ANONYMOUS,
238 |         }
239 | 
240 |         extenders = []
241 |         if page.navigation_extenders:
242 |             if page.navigation_extenders in self.renderer.menus:
243 |                 extenders.append(page.navigation_extenders)
244 |             elif f"{page.navigation_extenders}:{page.pk}" in self.renderer.menus:
245 |                 extenders.append(f"{page.navigation_extenders}:{page.pk}")
246 |         # Is this page an apphook? If so, we need to handle the apphooks's nodes
247 |         # Only run this if we have a translation in the requested language for this
248 |         # object. The page content cache should have been prepopulated in CMSMenu.get_nodes
249 |         # but otherwise, just request the title normally
250 |         if page.application_urls and page_content.language == self.languages[0]:
251 |             # it means it is an apphook
252 |             app = apphook_pool.get_apphook(page.application_urls)
253 |             if app:
254 |                 extenders.extend(app.get_menus(page, self.languages[0]))
255 |         # CMSAattachMenus are treated a bit differently to allow them to be
256 |         # able to be attached to multiple points in the navigation.
257 |         attr["navigation_extenders"] = [
258 |             f"{ext.__name__}:{page.pk}" if hasattr(ext, "get_instances") else getattr(ext, "__name__", ext)
259 |             for ext in extenders
260 |         ]
261 | 
262 |         # Now finally, build the NavigationNode object and return it.
263 |         # The parent_id is manually set by the menu get_nodes method.
264 |         if preview_url:
265 |             # Build preview url by replacing "/0/" in the url template by the actual pk of the page content object
266 |             # Hacky, but faster than calling `admin_reverse` for each page content object
267 |             url = re.sub("(/0/)", f"/{page_content.pk}/", preview_url)
268 |         else:
269 |             url = page.get_absolute_url(language=page_content.language)
270 | 
271 |         return CMSNavigationNode(
272 |             title=page_content.menu_title or page_content.title,
273 |             url=url,
274 |             id=page.pk,
275 |             parent_id=None if cut else page_content.page.parent_id,
276 |             attr=attr,
277 |             visible=page_content.in_navigation,
278 |             language=(page_content.language if page_content.language != self.languages[0] else None),
279 |         )
```


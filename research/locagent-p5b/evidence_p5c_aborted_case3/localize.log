138 |         from cms.utils.placeholder import get_placeholder_conf
139 | 
140 |         self.discover_plugins()
141 |         plugins = self.plugins.values()
142 |         template = (
143 |             lazy(page.get_template, str)() if page else None
144 |         )  # Make template lazy to avoid unnecessary db access
145 | 
146 |         allowed_plugins = (
147 |             get_placeholder_conf(
148 |                 setting_key,
149 |                 placeholder,
150 |                 template,
151 |             )
152 |             or ()
153 |         )
154 |         excluded_plugins = (
155 |             get_placeholder_conf(
156 |                 "excluded_plugins",
157 |                 placeholder,
158 |                 template,
159 |             )
160 |             or ()
161 |         )
162 | 
163 |         if not include_page_only:
164 |             # Filters out any plugin marked as page only because
165 |             # the include_page_only flag has been set to False
166 |             plugins = (plugin for plugin in plugins if not plugin.page_only)
167 | 
168 |         if allowed_plugins:
169 |             # Check that plugins are in the list of the allowed ones
170 |             plugins = (plugin for plugin in plugins if plugin.__name__ in allowed_plugins)
171 | 
172 |         if excluded_plugins:
173 |             # Check that plugins are not in the list of the excluded ones
174 |             plugins = (plugin for plugin in plugins if plugin.__name__ not in excluded_plugins)
175 | 
176 |         if placeholder:

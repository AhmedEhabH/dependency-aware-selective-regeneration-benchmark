265 |                         template=TEMPLATE_INHERITANCE_MAGIC,
266 |                         limit_visibility_in_menu=constants.VISIBILITY_ALL,
267 |                         xframe_options=constants.X_FRAME_OPTIONS_INHERIT):
268 |     """
269 |     Creates a :class:`cms.models.PageContent` instance and returns it.
270 | 
271 |     ``parent`` is only used if slug=None.
272 | 
273 |     :param str language: Language code for this page. Must be in :setting:`django:LANGUAGES`
274 |     :param str title: Title of the page
275 |     :param page: The page for which to create this title
276 |     :type page: :class:`cms.models.Page` instance

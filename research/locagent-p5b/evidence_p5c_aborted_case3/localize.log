300 | def user_can_view_page(user, page, site=None):
301 |     if site is None:
302 |         site = get_current_site()
303 | 
304 |     if user.is_superuser:
305 |         return True
306 | 
307 |     public_for = get_cms_setting('PUBLIC_FOR')
308 |     can_see_unrestricted = public_for == 'all' or (public_for == 'staff' and user.is_staff)
309 | 
310 |     page = get_page_draft(page)
311 | 
312 |     # inherited and direct view permissions
313 |     is_restricted = page.has_view_restrictions(site)
314 | 
315 |     if not is_restricted and can_see_unrestricted:
316 |         # Page has no restrictions and project is configured
317 |         # to allow everyone to see unrestricted pages.
318 |         return True
319 |     elif not user.is_authenticated():
320 |         # Page has restrictions or project is configured
321 |         # to require staff user status to see pages.
322 |         return False
323 | 

 23 | def cut_after(node, levels, removed):
 24 |     """
 25 |     given a tree of nodes cuts after N levels
 26 |     """
 27 |     if levels == 0:
 28 |         removed.extend(node.children)
 29 |         node.children = []
 30 |     else:
 31 |         removed_local = []
 32 |         for child in node.children:
 33 |             if child.visible:
 34 |                 cut_after(child, levels - 1, removed)
 35 |             else:
 36 |                 removed_local.append(child)
 37 |         for removed_child in removed_local:
 38 |             node.children.remove(removed_child)
 39 |         removed.extend(removed_local)
 40 | 
 41 | 
 42 | def remove(node, removed):
 43 |     removed.append(node)
 44 |     if node.parent:
 45 |         if node in node.parent.children:
 46 |             node.parent.children.remove(node)
 47 | 
 48 | 
 49 | def cut_levels(nodes, from_level, to_level, extra_inactive, extra_active):
 50 |     """
 51 |     cutting nodes away from menus
 52 |     """
 53 |     final = []
 54 |     removed = []
 55 |     selected = None
 56 |     for node in nodes:
 57 |         if not hasattr(node, 'level'):
 58 |             # remove and ignore nodes that don't have level information
 59 |             remove(node, removed)
 60 |             continue
 61 |         if node.level == from_level:
 62 |             # turn nodes that are on from_level into root nodes
 63 |             final.append(node)
 64 |             node.parent = None
 65 |         if not node.ancestor and not node.selected and not node.descendant:
 66 |             # cut inactive nodes to extra_inactive, but not of descendants of
 67 |             # the selected node
 68 |             cut_after(node, extra_inactive, removed)
 69 |         if node.level > to_level and node.parent:
 70 |             # remove nodes that are too deep, but not nodes that are on
 71 |             # from_level (local root nodes)
 72 |             remove(node, removed)
 73 |         if node.selected:
 74 |             selected = node
 75 |         if not node.visible:
 76 |             remove(node, removed)
 77 |     if selected:
 78 |         cut_after(selected, extra_active, removed)
 79 |     if removed:
 80 |         for node in removed:
 81 |             if node in final:
 82 |                 final.remove(node)
 83 |     return final

361 | 
362 |     options = Options(
363 |         Argument('template', default=NOT_PROVIDED, required=False),
364 |         Argument('i18n_mode', default='raw', required=False),
365 |     )
366 | 
367 |     def get_context(self, context, template, i18n_mode):
368 |         if template in MARKERS:
369 |             _tmp = template
370 |             if i18n_mode not in MARKERS:
371 |                 template = i18n_mode
372 |             else:
373 |                 template = NOT_PROVIDED
374 |             i18n_mode = _tmp
375 |         if template is NOT_PROVIDED:
376 |             template = "menu/language_chooser.html"
377 |         if not i18n_mode in MARKERS:
378 |             i18n_mode = 'raw'
379 |         if 'request' not in context:
380 |             # If there's an exception (500), default context_processors may not be called.
381 |             return {'template': 'cms/content.html'}
382 |         marker = MARKERS[i18n_mode]
383 |         current_lang = get_language()
384 |         site = Site.objects.get_current()
385 |         languages = []
386 |         for lang in get_language_objects(site.pk):
387 |             if lang.get('public', True):
388 |                 languages.append((lang['code'], marker(lang['name'], lang['code'])))
389 |         context['languages'] = languages
390 |         context['current_language'] = current_lang
391 |         context['template'] = template
392 |         return context

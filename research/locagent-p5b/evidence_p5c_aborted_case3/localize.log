27 |                 for instance in plugin['instances']:
28 |                     uninstalled_instances.append(instance)
29 | 
30 |             for instance in plugin['unsaved_instances']:
31 |                 unsaved_instances.append(instance)
32 | 
33 |         if options.get('interactive'):
34 |             confirm = input("""
35 | You have requested to delete any instances of uninstalled plugins and empty plugin instances.
36 | There are %d uninstalled plugins and %d empty plugins.
37 | Are you sure you want to do this?
38 | Type 'yes' to continue, or 'no' to cancel: """ % (len(uninstalled_instances), len(unsaved_instances)))
39 |         else:
40 |             confirm = 'yes'
41 | 
42 |         if confirm == 'yes':
43 |             # delete items whose plugin is uninstalled and items with unsaved instances
44 |             self.stdout.write('... deleting any instances of uninstalled plugins and empty plugin instances\n')
45 | 
46 |             for instance in uninstalled_instances:
47 |                 if instance.placeholder:
48 |                     instance.placeholder.delete_plugin(instance)
49 |                 else:

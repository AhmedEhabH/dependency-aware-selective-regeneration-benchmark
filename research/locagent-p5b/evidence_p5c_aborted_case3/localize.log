483 | 
484 |         try:
485 |             root = obj.parent.get_bound_plugin() if obj.parent else obj
486 |         except ObjectDoesNotExist:
487 |             # This is a nasty edge-case.
488 |             # If the parent plugin is a ghost plugin, fetching the plugin tree
489 |             # will fail because the downcasting function filters out all ghost plugins.
490 |             # Currently, this case is only present in the djangocms-text app
491 |             # which uses ghost plugins to create inline plugins on the text.
492 |             root = obj
493 | 
494 |         plugins = [root] + list(root.get_descendants())
495 | 
496 |         target_plugin = plugins[0] if add else next(
497 |             (plugin for plugin in plugins if plugin.pk == obj.pk), None
498 |         )
499 |         structure = get_plugin_tree(request, plugins, target_plugin=target_plugin)
500 |         plugin_data = next((plugin_data for plugin_data in structure['plugins'] if plugin_data["plugin_id"] == obj.pk), None)
501 | 
502 |         context = {
503 |             'plugin': obj,
504 |             'is_popup': True,
505 |             'data_bridge': {
506 |                 **plugin_data,
507 |                 "plugin_desc": escapejs(force_str(obj.get_short_description())),
508 |                 "structure": structure,

466 |             'cms_renderer': renderer,
467 |             'cms_edit_on': self.edit_mode_url_on,
468 |             'cms_edit_off': self.edit_mode_url_off,
469 |             'cms_structure_on': self.structure_mode_url_on,
470 |             'cms_version': __version__,

222 |     """
223 |     Returns users queryset, containing all subordinate users to given user
224 |     including users created by given user and not assigned to any page.
225 | 
226 |     Not assigned users must be returned, because they shouldn't get lost, and
227 |     user should still have possibility to see them.
228 | 
229 |     Only users created_by given user which are on the same, or lover level are
230 |     returned.
231 | 
232 |     If user haves global permissions or is a superuser, then he can see all the
233 |     users.
234 | 
235 |     This function is currently used in PagePermissionInlineAdminForm for limit
236 |     users in permission combobox.
237 | 
238 |     Example:
239 |                               A,W                    level 0
240 |                             /    \
241 |                           user    B,GroupE           level 1
242 |                 Z       /     \
243 |                       C,X     D,Y,W                  level 2
244 | 
245 |         Rules: W was created by user, Z was created by user, but is not assigned
246 |         to any page.
247 | 
248 |         Will return [user, C, X, D, Y, Z]. W was created by user, but is also
249 |         assigned to higher level.
250 |     """
251 |     from cms.utils.page_permissions import get_change_permissions_id_list
252 | 
253 |     try:
254 |         user_level = get_user_permission_level(user, site)
255 |     except NoPermissionsException:
256 |         # user has no Global or Page permissions.
257 |         # return only staff users created by user
258 |         # whose page permission record has no page attached.
259 |         qs = get_user_model().objects.distinct().filter(
260 |                 Q(is_staff=True) &
261 |                 Q(pageuser__created_by=user) &
262 |                 Q(pagepermission__page=None)
263 |         )
264 |         qs = qs.exclude(pk=user.pk).exclude(groups__user__pk=user.pk)
265 |         return qs

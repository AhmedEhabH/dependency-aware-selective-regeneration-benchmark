305 |         slug = get_available_slug(page.site, base, language)
306 | 
307 |     if overwrite_url:
308 |         path = overwrite_url.strip('/')
309 |     elif path is None:
310 |         path = page.get_path_for_slug(slug, language)
311 | 
312 |     if created_by and isinstance(created_by, get_user_model()):
313 |         _thread_locals.user = created_by
314 |         created_by = get_clean_username(created_by)
315 | 
316 |     page.urls.update_or_create(
317 |         page=page,
318 |         language=language,
319 |         defaults=dict(slug=slug, path=path,  managed=not bool(overwrite_url)),
320 |     )
321 | 
322 |     # E.g., djangocms-versioning needs an User object to be passed when creating a versioned Object
323 |     user = getattr(_thread_locals, "user", "unknown user")
324 |     page_content = PageContent.objects.with_user(user).create(
325 |         language=language,
326 |         title=title,
327 |         menu_title=menu_title,
328 |         page_title=page_title,
329 |         redirect=redirect,

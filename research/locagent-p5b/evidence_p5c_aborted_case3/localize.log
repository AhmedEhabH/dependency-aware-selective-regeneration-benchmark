284 | def get_object_for_language(obj: models.Model, language: str, latest: bool = False) -> Optional[models.Model]:
285 |     """
286 |     Retrieves the correct content object for the target language. The object must be frontend-editable
287 |     and registered as such with cms.
288 | 
289 |     Two cases have to be distinguished:
290 | 
291 |     1. **Object has a language property:** If the language of the passed object is different,
292 |        sibling objects are retrieved from the database and cached in the object passed.
293 |     2. **Object has no language property:** The placeholders of the object contain the different
294 |        language content. The object itself is returned
295 |     """
296 |     if getattr(obj, "language", language) == language:
297 |         # Object does not have language field or language is requested language
298 |         # Return object itself
299 |         return obj
300 |     if isinstance(obj, PageContent):
301 |         return obj.page.get_admin_content(language, fallback=False) or None
302 |     # Does the object have a cache with sister objects
303 |     cached_object = getattr(obj, "_sibling_objects_for_language_cache", {})
304 |     if cached_object:
305 |         return cached_object.get(language)
306 | 
307 |     extension = apps.get_app_config('cms').cms_extension
308 |     model = obj.__class__
309 |     field = extension.model_groupers.get(model)
310 |     if not field:
311 |         # Cannot infer sister object if grouper field is unknown
312 |         return None
313 |     # Grouper model not registered or does not have a get_content_obj method,
314 |     # or get_content_obj does not accept language parameter
315 |     # Now query db
316 |     grouper_filter = {field: getattr(obj, field)}
317 |     qs = model.admin_manager.latest_content() if latest and hasattr(model, "admin_manager") else model.objects
318 |     obj._sibling_objects_for_language_cache = {
319 |         result.language: result for result in qs.filter(**grouper_filter)
320 |     }
321 |     return obj._sibling_objects_for_language_cache.get(language)
322 | 
```


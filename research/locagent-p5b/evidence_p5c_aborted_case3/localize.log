627 | def delete_plugin(self, instance):
628 |         """
629 |         .. versionadded:: 4.0
630 | 
631 |         Removes a plugin and its descendants from the placeholder and database.
632 | 
633 |         :param instance: Plugin to add. It's position parameter needs to be set.
634 |         :type instance: :class:`cms.models.pluginmodel.CMSPlugin` instance
635 |         """
636 |         with transaction.atomic():
637 |             # We're using raw sql - make the whole operation atomic
638 |             plugins = self.get_plugins(language=instance.language).count()  # 1st hit: Count plugins
639 |             descendants = instance._get_descendants_ids()  # 2nd hit: Get descendant ids
640 |             to_delete = [instance.pk] + descendants  # Instance plus descendants pk
641 |             self.cmsplugin_set.filter(pk__in=to_delete).delete()  # 3rd hit: Delete all plugins in one query
642 | 
643 |             last_position = instance.position + len(descendants)  # Last position of deleted plugins
644 |             if last_position < plugins:
645 |                 # Close the gap in the plugin tree (2 hits)
646 |                 self._shift_plugin_positions(
647 |                     instance.language,
648 |                     start=instance.position,
649 |                     offset=plugins,
650 |                 )
651 |                 self._recalculate_plugin_positions(instance.language)

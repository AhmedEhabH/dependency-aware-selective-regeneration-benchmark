18 |     def handle(self, *args, **options):
19 |         """
20 |         Ensure that the public pages look the same as their draft versions.
21 |         This is done by checking the content of the public pages, and reverting
22 |         the draft version to look the same.
23 | 
24 |         The second stage is to go through the draft pages and publish the ones
25 |         marked as published.
26 | 
27 |         The end result should be that the public pages and their draft versions
28 |         have the same plugins listed. If both versions exist and have content,
29 |         the public page has precedence. Otherwise, the draft version is used.
30 |         """
31 |         log.info('Reverting drafts to public versions')
32 |         for page in Page.objects.public():
33 |             for language in page.get_languages():
34 |                 if CMSPlugin.objects.filter(placeholder__page=page, language=language).exists():
35 |                     log.debug('Reverting page pk=%d' % (page.pk,))
36 |                     page.publisher_draft.revert_to_live(language)
37 | 
38 |         log.info('Publishing all published drafts')
39 |         for title in Title.objects.filter(publisher_is_draft=True, publisher_public_id__gt=0):
40 |             try:
41 |                 title.page.publish(title.language)
42 |                 log.debug('Published page pk=%d in %s' % (page.pk, title.language))
43 |             except Exception:
44 |                 log.exception('Error publishing page pk=%d in %s' % (page.pk, title.language))

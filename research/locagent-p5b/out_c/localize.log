 90 | def get_formset(self, request, obj=None, **kwargs):
 91 |         """
 92 |         Some fields may be excluded here. User can change only
 93 |         permissions which are available for him. E.g. if user does not haves
 94 |         can_publish flag, he can't change assign can_publish permissions.
 95 |         """
 96 |         exclude = self.exclude or []
 97 |         if obj:
 98 |             user = request.user
 99 |             if not obj.has_add_permission(user):
100 |                 exclude.append('can_add')
101 |             if not obj.has_delete_permission(user):
102 |                 exclude.append('can_delete')
103 |             if not obj.has_publish_permission(user):
104 |                 exclude.append('can_publish')
105 |             if not obj.has_advanced_settings_permission(user):
106 |                 exclude.append('can_change_advanced_settings')
107 |             if not obj.has_move_page_permission(user):
108 |                 exclude.append('can_move_page')
109 | 
110 |         kwargs['exclude'] = exclude
111 |         formset_cls = super(PagePermissionInlineAdmin, self).get_formset(request, obj=obj, **kwargs)
112 |         qs = self.get_queryset(request)
113 |         if obj is not None:
114 |             qs = qs.filter(page=obj)
115 |         formset_cls._queryset = qs

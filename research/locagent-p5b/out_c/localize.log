61 | def id(self):
62 |         """
63 |         To construct a unique ID for each wizard, we start with the module and
64 |         class name for uniqueness, we hash it because a wizard's ID is displayed
65 |         in the form's markup, and we'd rather not expose code paths there.
66 |         """
67 |         if not self._hash_cache:
68 |             full_path = force_str(
69 |                 ".".join([self.__module__, self.__class__.__name__])
70 |             ).encode('utf-8')
71 |             hash = hashlib.sha1()
72 |             hash.update(full_path)
73 |             self._hash_cache = hash.hexdigest()
74 |         return self._hash_cache

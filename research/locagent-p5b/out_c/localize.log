456 |     def render_plugin(self, instance, context, placeholder=None, editable=False):
457 |         if not placeholder:
458 |             placeholder = instance.placeholder
459 | 
460 |         instance, plugin = instance.get_plugin_instance()
461 | 
462 |         if not instance or not plugin.render_plugin:
463 |             return ''
464 | 
465 |         # we'd better pass a flat dict to template.render
466 |         # as plugin.render can return pretty much any kind of context / dictionary
467 |         # we'd better flatten it and force to a Context object
468 |         # flattening the context means that template must be an engine-specific template object
469 |         # which is guaranteed by get_cached_template if the template returned by
470 |         # plugin._get_render_template is either a string or an engine-specific template object
471 |         context = PluginContext(context, instance, placeholder)
472 |         try:
473 |             context = plugin.render(context, instance, placeholder.slot)
474 |             context = flatten_context(context)
475 |         except Exception:  # catch errors when executing a plugin's render method
476 |             context['exc_info'] = sys.exc_info()
477 |             content = self.render_exception('executing plugin.render', instance, context, placeholder, editable)
478 |             logger.error(
479 |                 f"{instance.__class__.__name__}.render for plugin pk={instance.id} raised an exception",
480 |                 exc_info=context['exc_info']
481 |             )
482 |         else:
483 |             template_name = plugin._get_render_template(context, instance, placeholder)
484 | 
485 |             try:
486 |                 template = self.templates.get_cached_template(template_name)
487 |                 content = template.render(context)
488 |             except Exception:  # catch errors when rendering a plugin's template
489 |                 context['exc_info'] = sys.exc_info()
490 |                 content = self.render_exception('rendering template', instance, context, placeholder, editable)
491 |                 logger.error(
492 |                     f'Rendering "{template_name}" for plugin {instance.__class__.__name__} '
493 |                     f'(pk={instance.id}) raised an exception',
494 |                     exc_info=context['exc_info']
495 |                 )
496 | 
497 |         for path in get_cms_setting('PLUGIN_PROCESSORS'):
498 |             processor = import_string(path)
499 |             content = processor(instance, placeholder, content, context)
500 | 
501 |         if editable:
502 |             content = self.plugin_edit_template.format(pk=instance.pk, content=content)
503 |             placeholder_cache = self._rendered_plugins_by_placeholder.setdefault(placeholder.pk, {})
504 |             placeholder_cache.setdefault('plugins', []).append(instance)
505 |         return mark_safe(content)
506 | 
507 |     def render_exception(self, action, instance, context, placeholder, editable):
508 |         if editable:
509 |             exc, value, traceback = context['exc_info']
510 |             return f'''
511 |                 <div style="display: inline-block; border: none; background: rgba(0, 0, 0, 0.5);
512 |                    padding: 0.6em 0.3em; cursor: not-allowed; min-height: 2em; width:100%; vertical-align:middle;
513 |                    text-align:center;">
514 |                     <span style="font-weight: bold; color: darkred;">
515 |                       Exception when {action} in {instance.plugin_type} (id={instance.id})<br />
516 |                       {exc.__name__}: {value}
517 |                     </span>
518 |                 </div>'''
519 |         return ''

10 | class LanguageCookieMiddleware(MiddlewareMixin):
11 |     def process_response(self, request, response):
12 |         language = get_language()
13 |         if hasattr(request, 'session'):
14 |             session_language = request.session.get(LANGUAGE_SESSION_KEY, None)
15 |             if session_language and not session_language == language:
16 |                 request.session[LANGUAGE_SESSION_KEY] = language
17 |                 request.session.save()
18 |         if settings.LANGUAGE_COOKIE_NAME in request.COOKIES and \
19 |                         request.COOKIES[settings.LANGUAGE_COOKIE_NAME] == language:
20 |             return response
21 |         max_age = 365 * 24 * 60 * 60  # 10 years
22 |         expires = datetime.datetime.utcnow() + datetime.timedelta(seconds=max_age)
23 |         response.set_cookie(settings.LANGUAGE_COOKIE_NAME, language, expires=expires)
24 |         return response

752 | class PluginContext(Context):
753 |     """
754 |     This subclass of template.Context automatically populates itself using
755 |     the processors defined in CMS_PLUGIN_CONTEXT_PROCESSORS.
756 |     Additional processors can be specified as a list of callables
757 |     using the "processors" keyword argument.
758 |     """
759 | 
760 |     def __init__(self, dict_, instance, placeholder, processors=None, current_app=None):
761 |         dict_ = flatten_context(dict_)
762 |         super().__init__(dict_)
763 | 
764 |         if not processors:
765 |             processors = []
766 | 
767 |         for path in get_cms_setting('PLUGIN_CONTEXT_PROCESSORS'):
768 |             processor = import_string(path)
769 |             self.update(processor(instance, placeholder, self))
770 |         for processor in processors:
771 |             self.update(processor(instance, placeholder, self))

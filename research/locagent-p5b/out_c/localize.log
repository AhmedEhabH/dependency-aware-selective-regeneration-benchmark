 52 | class AppRegexURLResolver(URLResolver):
 53 |     def __init__(self, *args, **kwargs):
 54 |         self.page_id = None
 55 |         self.url_patterns_dict = {}
 56 |         super(AppRegexURLResolver, self).__init__(*args, **kwargs)
 57 | 
 58 |     @property
 59 |     def urlconf_module(self):
 60 |         # It is valid for urlconf_module to be a list of patterns. So we just
 61 |         # return the list here.
 62 |         #
 63 |         # See https://github.com/django/django/blob/2.2.4/django/urls/resolvers.py#L578
 64 |         #
 65 |         return self.url_patterns_dict.get(get_language(), [])
 66 | 
 67 |     # On URLResolver the url_patterns property is cached and thus calls made after
 68 |     # language changes (different return values for get_language()) would not return the
 69 |     # right value. Overriding here prevents caching.
 70 |     @property
 71 |     def url_patterns(self):
 72 |         return self.urlconf_module
 73 | 
 74 |     def resolve_page_id(self, path):
 75 |         """Resolves requested path similar way how resolve does, but instead
 76 |         of return callback,.. returns page_id to which was application
 77 |         assigned.
 78 |         """
 79 |         tried = []
 80 |         pattern = getattr(self, 'pattern', self)
 81 |         match = pattern.regex.search(path)
 82 |         if match:
 83 |             new_path = path[match.end():]
 84 |             for pattern in self.url_patterns:
 85 |                 if isinstance(pattern, AppRegexURLResolver):
 86 |                     try:
 87 |                         return pattern.resolve_page_id(new_path)
 88 |                     except Resolver404:
 89 |                         pass
 90 |                 else:
 91 |                     try:
 92 |                         sub_match = pattern.resolve(new_path)
 93 |                     except Resolver404 as e:
 94 |                         tried_match = e.args[0].get('tried')
 95 |                         if tried_match is not None:
 96 |                             tried.extend([[pattern] + t for t in tried_match])
 97 |                         else:
 98 |                             tried.extend([pattern])
 99 |                     else:
100 |                         if sub_match:
101 |                             return getattr(pattern, 'page_id', None)
102 |                         pattern = getattr(pattern, 'pattern', pattern)
103 |                         tried.append(pattern.regex.pattern)
104 |             raise Resolver404({'tried': tried, 'path': new_path})

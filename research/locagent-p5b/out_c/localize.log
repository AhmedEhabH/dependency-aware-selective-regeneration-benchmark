216 | def _reunite_orphaned_placeholder_plugin_children(root_plugin, orphaned_plugin_list, plugins_by_id):
217 |     """
218 |     Handle plugins where the parent hasn't yet been copied (child seen before the parent)
219 | 
220 |     CAVEAT: The only reason this exists is because the plugin position is not
221 |            sequential through children when the user nests plugins.
222 |            It's now too late as content already has this issue, it would be a very expensive
223 |            calculation to recalculate every placeholders positions, needs to be handled gracefully
224 |            so that it doesn't actually matter :-).
225 |     """
226 |     for old_plugin_parent_id, new_plugin in orphaned_plugin_list:
227 |         new_parent = plugins_by_id.get(old_plugin_parent_id, root_plugin)
228 |         if new_parent:
229 |             new_plugin.parent = new_parent
230 |             new_plugin.save()

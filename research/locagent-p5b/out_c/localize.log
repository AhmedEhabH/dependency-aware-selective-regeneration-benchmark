398 | def move_page(self, target_page, position='first-child'):
399 |         """
400 |         Called from admin interface when page is moved. Should be used on
401 |         all the places which are changing page position. Used like an interface
402 |         to django-treebeard, but after move is done page_moved signal is fired.
403 |         """
404 |         assert isinstance(target_page, Page), f"{target_page} is not an instance of Page."
405 |         inherited_template = self.template == constants.TEMPLATE_INHERITANCE_MAGIC
406 | 
407 |         if inherited_template and target_page.is_root() and position in ('left', 'right'):
408 |             # The page is being moved to a root position.
409 |             # Explicitly set the inherited template on the titles
410 |             # to keep all plugins / placeholders.
411 |             template = self.get_template()
412 |             self.update_translations(template=template)
413 | 
414 |         # Don't use a cached node. Always get a fresh one.
415 |         self._clear_internal_cache()
416 | 
417 |         # Runs the SQL updates on the treebeard fields
418 |         self.move(target_page, position)
419 | 
420 |         if position in ('first-child', 'last-child'):
421 |             self.parent = target_page
422 |         else:
423 |             # moving relative to sibling
424 |             # or to the root of the tree
425 |             self.parent = target_page.parent
426 |         # Runs the SQL updates on the parent field
427 |         self.update(parent=self.parent)
428 |         self.refresh_from_db(fields=('path', 'depth'))
429 | 

276 |     def get_context(self, context, start_level, template, only_visible):
277 |         try:
278 |             # If there's an exception (500), default context_processors may not be called.
279 |             request = context['request']
280 |         except KeyError:
281 |             return {'template': 'cms/content.html'}
282 |         if not (isinstance(start_level, int) or start_level.isdigit()):
283 |             only_visible = template
284 |             template = start_level
285 |             start_level = 0
286 |         try:
287 |             only_visible = bool(int(only_visible))
288 |         except:
289 |             only_visible = bool(only_visible)
290 |         ancestors = []
291 | 
292 |         menu_renderer = context.get('cms_menu_renderer')
293 | 
294 |         if not menu_renderer:
295 |             menu_renderer = menu_pool.get_renderer(request)
296 | 
297 |         nodes = menu_renderer.get_nodes(breadcrumb=True)
298 | 
299 |         # Find home
300 |         home = None
301 |         root_url = unquote(reverse("pages-root"))
302 |         home = next((node for node in nodes if node.get_absolute_url() == root_url), None)
303 | 
304 |         # Find selected
305 |         selected = None
306 |         selected = next((node for node in nodes if node.selected), None)
307 | 
308 |         if selected and selected != home:
309 |             node = selected
310 |             while node:
311 |                 if node.visible or not only_visible:
312 |                     ancestors.append(node)
313 |                 node = node.parent
314 |         if not ancestors or (ancestors and ancestors[-1] != home) and home:
315 |             ancestors.append(home)
316 |         ancestors.reverse()
317 |         if len(ancestors) >= start_level:
318 |             ancestors = ancestors[start_level:]
319 |         else:
320 |             ancestors = []
321 |         context['ancestors'] = ancestors
322 |         context['template'] = template
323 |         return context

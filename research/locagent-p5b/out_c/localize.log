37 | def invalidate_cms_page_cache():
38 |     """
39 |     Invalidates the CMS PAGE CACHE.
40 |     """
41 | 
42 |     #
43 |     # NOTE: We're using a cache versioning strategy for invalidating the page
44 |     # cache when necessary. Instead of wiping all the old entries, we simply
45 |     # increment the version number rendering all previous entries
46 |     # inaccessible and left to expire naturally.
47 |     #
48 |     # ALSO NOTE: According to the Django documentation, a timeout value of
49 |     # `None' (in version 1.6+) is supposed to mean "cache forever", however,
50 |     # this is actually only implemented as only slightly less than 30 days in
51 |     # some backends (memcached, in particular). In older Djangos, `None' means
52 |     # "use default value".  To avoid issues arising from different Django
53 |     # versions and cache backend implementations, we will explicitly set the
54 |     # lifespan of the CMS_PAGE_CACHE_VERSION entry to whatever is set in
55 |     # settings.CACHE_DURATIONS['content']. This allows users to adjust as
56 |     # necessary for their backend.
57 |     #
58 |     # To prevent writing cache entries that will live longer than our version
59 |     # key, we will always re-write the current version number into the cache
60 |     # just after we write any new cache entries, thus ensuring that the
61 |     # version number will always outlive any entries written against that
62 |     # version. This is a cheap operation.
63 |     #
64 |     # If there are no new cache writes before the version key expires, its
65 |     # perfectly OK, since any previous entries cached against that version
66 |     # will have also expired, so, it'd be pointless to try to access them
67 |     # anyway.
68 |     #
69 |     version = _get_cache_version()
70 |     _set_cache_version(version + 1)

207 |     How this works:
208 | 
209 |     By looking through all titles with an app hook (application_urls) we find
210 |     all urlconf modules we have to hook into titles.
211 | 
212 |     If we use the ML URL Middleware, we namespace those patterns with the title
213 |     language.
214 | 
215 |     All 'normal' patterns from the urlconf get re-written by prefixing them with
216 |     the title path and then included into the cms url patterns.
217 | 
218 |     If the app is still configured, but is no longer installed/available, then
219 |     this method returns a degenerate patterns object: patterns('')
220 |     """
221 |     from cms.models.pagemodel import PageUrl
222 | 
223 |     included = []
224 |     hooked_applications = OrderedDict()
225 | 
226 |     # we don't have a request here so get_page_queryset() can't be used,
227 |     # so use public() queryset.
228 |     # This can be done because url patterns are used just in frontend
229 |     page_urls = PageUrl.objects.get_for_site(site)
230 | 
231 |     # Loop over all titles with an application hooked to them
232 |     page_urls = (
233 |         page_urls
234 |         .exclude(page__application_urls=None)
235 |         .exclude(page__application_urls='')
236 |         .order_by('-page__node__path')
237 |         .select_related('page')
238 |     )
239 | 
240 |     for page_url in page_urls:
241 |         mix_id = "%s:%s:%s" % (
242 |             page_url.path + "/",
243 |             page_url.page.application_urls,
244 |             page_url.language,
245 |         )
246 | 
247 |         if mix_id in included:
248 |             # don't add the same thing twice
249 |             continue
250 |         app = apphook_pool.get_apphook(page_url.page.application_urls)
251 |         if not app:
252 |             continue
253 |         if page_url.page_id not in hooked_applications:
254 |             hooked_applications[page_url.page_id] = {}
255 |         app_ns = app.app_name, page_url.page.application_namespace
256 |         with override(page_url.language):
257 |             hooked_applications[page_url.page_id][page_url.language] = (
258 |                 app_ns, get_patterns_for_page_url(page_url), app)
259 |         included.append(mix_id)
260 |         # Build the app patterns to be included in the cms urlconfs
261 |     app_patterns = []
262 |     for page_id in hooked_applications.keys():
263 |         resolver = None
264 |         for lang in hooked_applications[page_id].keys():
265 |             (app_ns, inst_ns), current_patterns, app = hooked_applications[page_id][lang]  # nopyflakes
266 |             if not resolver:
267 |                 regex_pattern = RegexPattern(r'') if not DJANGO_1_11 else r''
268 |                 resolver = AppRegexURLResolver(
269 |                     regex_pattern, 'app_resolver', app_name=app_ns, namespace=inst_ns)
270 |                 resolver.page_id = page_id
271 |             if app.permissions:
272 |                 _set_permissions(current_patterns, app.exclude_permissions)
273 | 
274 |             resolver.url_patterns_dict[lang] = current_patterns
275 |         app_patterns.append(resolver)
276 |         APP_RESOLVERS.append(resolver)
277 |     return app_patterns

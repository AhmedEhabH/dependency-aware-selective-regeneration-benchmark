521 |     def render_plugins(self, placeholder, language, context, editable=False, template=None):
522 |         plugins = self.get_plugins_to_render(
523 |             placeholder=placeholder,
524 |             template=template,
525 |             language=language,
526 |         )
527 | 
528 |         for plugin in plugins:
529 |             plugin._placeholder_cache = placeholder
530 |             yield self.render_plugin(plugin, context, placeholder, editable)

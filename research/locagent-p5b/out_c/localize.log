306 | def get_or_create_menu(self, key, verbose_name=None, disabled=False, side=LEFT, position=None):
307 |         """
308 |         If a :class:`~cms.toolbar.items.Menu` with :option:`key` already exists, this method will
309 |         return that menu. Otherwise it will create a menu with the ``key`` identifier.
310 |         """
311 |         self.populate()
312 |         if key in self.menus:
313 |             menu = self.menus[key]
314 |             if verbose_name:
315 |                 menu.name = verbose_name
316 |             if menu.side != side:
317 |                 menu.side = side
318 |             if position:
319 |                 self.remove_item(menu)
320 |                 self.add_item(menu, position=position)
321 |             return menu
322 |         menu = Menu(verbose_name, self.csrf_token, disabled=disabled, side=side)
323 |         self.menus[key] = menu
324 |         self.add_item(menu, position=position)
325 |         return menu

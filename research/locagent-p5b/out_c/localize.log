361 |     def render_page_placeholder(self, slot, context, inherit,
362 |                                 page=None, nodelist=None, editable=True):
363 |         if not self.current_page:
364 |             # This method should only be used when rendering a cms page.
365 |             return ''
366 | 
367 |         current_page = page or self.current_page
368 |         placeholder_cache = self._placeholders_by_page_cache
369 | 
370 |         if current_page.pk not in placeholder_cache:
371 |             # Instead of loading plugins for this one placeholder
372 |             # try and load them for all placeholders on the page.
373 |             self._preload_placeholders_for_page(current_page)
374 | 
375 |         try:
376 |             placeholder = placeholder_cache[current_page.pk][slot]
377 |         except KeyError:
378 |             content = ''
379 |             placeholder = None
380 |         else:
381 |             content = self.render_placeholder(
382 |                 placeholder,
383 |                 context=context,
384 |                 page=current_page,
385 |                 editable=editable,
386 |                 use_cache=True,
387 |                 nodelist=None,
388 |             )
389 |         should_inherit = (
390 |             inherit
391 |             and not content and current_page.parent
392 |             # The placeholder cache is primed when the first placeholder
393 |             # is loaded. If the current page's parent is not in there,
394 |             # it means its cache was never primed as it wasn't necessary.
395 |             and current_page.parent.pk in placeholder_cache
396 |             # don't display inherited plugins in edit mode, so that the user doesn't
397 |             # mistakenly edit/delete them. This is a fix for issue #1303. See the discussion
398 |             # there for possible enhancements
399 |             and not self.toolbar.edit_mode_active
400 |         )
401 | 
402 |         if should_inherit:
403 |             # nodelist is set to None to avoid rendering the nodes inside
404 |             # a {% placeholder or %} block tag.
405 |             content = self.render_page_placeholder(
406 |                 slot,
407 |                 context,
408 |                 inherit=True,
409 |                 page=current_page.parent,
410 |                 nodelist=None,
411 |                 editable=False,
412 |             )
413 | 
414 |         if placeholder and (editable and self._placeholders_are_editable):
415 |             # In edit mode, the contents of the placeholder are mixed with our
416 |             # internal toolbar markup, so the content variable will always be True.
417 |             # Use the rendered placeholder has_content flag instead.
418 |             has_content = self._rendered_placeholders[placeholder.pk].has_content
419 |         else:
420 |             # User is not in edit mode or the placeholder doesn't exist.
421 |             # Either way, we can trust the content variable.
422 |             has_content = bool(content)
423 | 
424 |         if not has_content and nodelist:
425 |             return content + nodelist.render(context)
426 |         return content

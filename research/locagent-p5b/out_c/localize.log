106 |         #
107 |         # When the user changes his language setting, we need to do two things:
108 |         # 1. Change the language-prefix for the sideframed admin view
109 |         # 2. Reload the whole window so that the new language affects the
110 |         #    toolbar, etc.
111 |         #
112 |         # To do this, we first redirect the sideframe to the correct new, URL,
113 |         # but we pass a GET param 'reload_window', which instructs JS on that
114 |         # page to strip (to avoid infinite redirection loops) that param then
115 |         # reload the whole window again.
116 |         #
117 |         with override(obj.language):
118 |             post_url = admin_reverse(
119 |                 'cms_usersettings_change',
120 |                 args=[obj.id, ],
121 |                 current_app=self.admin_site.name
122 |             )
123 |         return HttpResponseRedirect("{0}?reload_window".format(post_url))

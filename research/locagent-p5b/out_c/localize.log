107 | def recurse_patterns(path, pattern_list, page_id, default_args=None,
108 |                      nested=False):
109 |     """
110 |     Recurse over a list of to-be-hooked patterns for a given path prefix
111 |     """
112 |     newpatterns = []
113 |     for pattern in pattern_list:
114 |         app_pat = getattr(pattern, 'pattern', pattern).regex.pattern
115 |         # make sure we don't get patterns that start with more than one '^'!
116 |         app_pat = app_pat.lstrip('^')
117 |         path = path.lstrip('^')
118 |         regex = r'^%s%s' % (path, app_pat) if not nested else r'^%s' % (app_pat)
119 |         if isinstance(pattern, URLResolver):
120 |             # include default_args
121 |             args = pattern.default_kwargs
122 |             if default_args:
123 |                 args.update(default_args)
124 |             # see lines 243 and 236 of urlresolvers.py to understand the next line
125 |             urlconf_module = recurse_patterns(regex, pattern.url_patterns, page_id, args, nested=True)
126 |             # this is an 'include', recurse!
127 |             regex_pattern = regex
128 |             if not DJANGO_1_11:
129 |                 regex_pattern = RegexPattern(regex)
130 |             resolver = URLResolver(regex_pattern, urlconf_module,
131 |                                    pattern.default_kwargs, pattern.app_name,
132 |                                    pattern.namespace)
133 |         else:
134 |             # Re-do the URLPattern with the new regular expression
135 |             args = pattern.default_args
136 |             if default_args:
137 |                 args.update(default_args)
138 | 

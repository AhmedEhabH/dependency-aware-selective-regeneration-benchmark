533 | def move_page(self, request, page_id, extra_context=None):
534 |         """
535 |         Move the page to the requested target, at the given position.
536 | 
537 |         NOTE: We have to change from one "coordinate system" to another to
538 |         adapt JSTree to Django Treebeard.
539 | 
540 |         If the Tree looks like this:
541 | 
542 |             <root>
543 |                ⊢ …
544 |                ⊢ …
545 |                ⊢ Page 4
546 |                    ⊢ Page 5 (position 0)
547 |                    ⊢ …
548 | 
549 |         For example,
550 |             target=4, position=1 => target=5, position="right"
551 |             target=4, position=0 => target=4, position="first-child"
552 | 
553 |         """
554 |         site = get_site(request)
555 |         page = self.get_object(request, object_id=page_id)
556 | 
557 |         if page is None:
558 |             return jsonify_request(HttpResponseBadRequest("error"))
559 | 
560 |         user = request.user
561 |         form = self.move_form(request.POST or None, page=page, site=site)
562 | 
563 |         if not form.is_valid():
564 |             return jsonify_request(HttpResponseBadRequest("error"))
565 | 
566 |         target = form.cleaned_data['target']
567 |         can_move_page = self.has_move_page_permission(request, obj=page)
568 | 
569 |         # Does the user have permissions to do this...?
570 |         if not can_move_page or (target and not target.has_add_permission(user)):
571 |             message = _(
572 |                 "Error! You don't have permissions to move this page. Please reload the page"
573 |             )
574 |             return jsonify_request(HttpResponseForbidden(message))
575 | 
576 |         operation_token = send_pre_page_operation(
577 |             request=request,
578 |             operation=operations.MOVE_PAGE,
579 |             obj=page,
580 |             sender=self.model,
581 |         )
582 | 
583 |         form.move_page()
584 | 

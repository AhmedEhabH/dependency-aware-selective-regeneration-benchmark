24 |     def items(self):
25 |         #
26 |         # It is counter-productive to provide entries for:
27 |         #   > Pages which redirect:
28 |         #       - If the page redirects to another page on this site, the
29 |         #         destination page will already be in the sitemap, and
30 |         #       - If the page redirects externally, then it shouldn't be
31 |         #         part of our sitemap anyway.
32 |         #   > Pages which cannot be accessed by anonymous users (like
33 |         #     search engines are).
34 |         #
35 |         # It is noted here: http://www.sitemaps.org/protocol.html that
36 |         # "locations" that differ from the place where the sitemap is found,
37 |         # are considered invalid. E.g., if your sitemap is located here:
38 |         #
39 |         #     http://example.com/sub/sitemap.xml
40 |         #
41 |         # valid locations *must* be rooted at http://example.com/sub/...
42 |         #
43 |         # This rules any redirected locations out.
44 |         #
45 |         # If, for some reason, you require redirecting pages (Titles) to be
46 |         # included, simply create a new class inheriting from this one, and
47 |         # supply a new items() method which doesn't filter out the redirects.
48 |         all_titles = Title.objects.public().filter(
49 |             Q(redirect='') | Q(redirect__isnull=True),
50 |             page__publisher_public__login_required=False,
51 |             page__publisher_public__nodes__site=get_current_site(),
52 |         ).order_by('page__publisher_public__nodes__path')
53 |         return all_titles
54 | 
55 |     def lastmod(self, title):
56 |         modification_dates = [title.page.changed_date, title.page.publication_date]
57 |         plugins_for_placeholder = lambda placeholder: placeholder.get_plugins()
58 |         plugins = from_iterable(map(plugins_for_placeholder, title.page.placeholders.all()))
59 |         plugin_modification_dates = map(lambda plugin: plugin.changed_date, plugins)
60 |         modification_dates.extend(plugin_modification_dates)
61 |         return max(modification_dates)
62 | 
63 |     def location(self, title):
64 |         translation.activate(title.language)
65 |         url = title.page.get_absolute_url(title.language)
66 |         translation.deactivate()
67 |         return url

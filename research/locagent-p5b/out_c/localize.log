139 |         from cms.utils.placeholder import get_placeholder_conf
140 | 
141 |         self.discover_plugins()
142 |         plugins = sorted(self.plugins.values(), key=attrgetter('name'))
143 |         template = page.get_template() if page else None
144 | 
145 |         allowed_plugins = get_placeholder_conf(
146 |             setting_key,
147 |             placeholder,
148 |             template,
149 |         ) or ()
150 |         excluded_plugins = get_placeholder_conf(
151 |             'excluded_plugins',
152 |             placeholder,
153 |             template,
154 |         ) or ()
155 | 
156 |         if not include_page_only:
157 |             # Filters out any plugin marked as page only because
158 |             # the include_page_only flag has been set to False
159 |             plugins = (plugin for plugin in plugins if not plugin.page_only)
160 | 
161 |         if allowed_plugins:
162 |             # Check that plugins are in the list of the allowed ones
163 |             plugins = (plugin for plugin in plugins if plugin.__name__ in allowed_plugins)
164 | 

532 |     def _get_cached_placeholder_content(self, placeholder, language):
533 |         """
534 |         Returns a dictionary mapping placeholder content and sekizai data.
535 |         Returns None if no cache is present.
536 |         """
537 |         # Placeholders can be rendered multiple times under different sites
538 |         # it's important to have a per-site "cache".
539 |         site_id = self.current_site.pk
540 |         site_cache = self._placeholders_content_cache.setdefault(site_id, {})
541 |         # Placeholders can be rendered multiple times under different languages
542 |         # it's important to have a per-language "cache".
543 |         language_cache = site_cache.setdefault(language, {})
544 | 
545 |         if placeholder.pk not in language_cache:
546 |             cached_value = get_placeholder_cache(
547 |                 placeholder,
548 |                 lang=language,
549 |                 site_id=site_id,
550 |                 request=self.request,
551 |             )
552 | 
553 |             if cached_value is not None:
554 |                 # None means nothing in the cache
555 |                 # Anything else is a valid value
556 |                 language_cache[placeholder.pk] = cached_value
557 |         return language_cache.get(placeholder.pk)
558 | 
559 |     def _get_content_object(self, page, slots=None):
560 |         if self.toolbar.get_object() == page:
561 |             # Current object belongs to the page itself
562 |             page_content = self.toolbar.get_object()
563 |             placeholders = Placeholder.objects.get_for_obj(page_content)
564 |         elif slots:
565 |             # If looking for inherited placeholders, slots is specified
566 |             if self.toolbar.preview_mode_active or self.toolbar.edit_mode_active:
567 |                 page_content = (page.pagecontent_set(manager="admin_manager")
568 |                                 .current_content(language=self.request_language).first())
569 |             else:
570 |                 page_content = page.pagecontent_set.filter(language=self.request_language).first()
571 |             placeholders = Placeholder.objects.get_for_obj(page_content) if page_content else Placeholder.objects.none()
572 |         else:
573 |             page_content = page.get_content_obj(self.request_language, fallback=False)
574 | 
575 |             PageContent.page.field.set_cached_value(page_content, page)
576 |             # Creates any placeholders missing on the page
577 |             placeholders = page_content.rescan_placeholders().values()
578 |         return placeholders
579 | 
580 |     def _preload_placeholders_for_page(self, page, slots=None, inherit=False):
581 |         """
582 |         Populates the internal plugin cache of each placeholder
583 |         in the given page if the placeholder has not been
584 |         previously cached.
585 |         """
586 |         from cms.utils.plugins import assign_plugins
587 | 
588 |         placeholders = self._get_content_object(page, slots=slots)
589 | 
590 |         if inherit:
591 |             # When the inherit flag is True,
592 |             # assume all placeholders found are inherited and thus prefetch them.
593 |             slots_w_inheritance = [pl.slot for pl in placeholders]
594 |         elif not self.toolbar.edit_mode_active:
595 |             # Scan through the page template to find all placeholders
596 |             # that have inheritance turned on.
597 |             slots_w_inheritance = [pl.slot for pl in page.get_declared_placeholders() if pl.inherit]
598 |         else:
599 |             # Inheritance is turned off on edit-mode
600 |             slots_w_inheritance = []
601 | 
602 |         if self.placeholder_cache_is_enabled():
603 |             _cached_content = self._get_cached_placeholder_content
604 |             # Only prefetch plugins if the placeholder
605 |             # has not been cached.
606 |             placeholders_to_fetch = [
607 |                 placeholder for placeholder in placeholders
608 |                 if _cached_content(placeholder, self.request_language) is None]
609 |         else:
610 |             # cache is disabled, prefetch plugins for all
611 |             # placeholders in the page.
612 |             placeholders_to_fetch = placeholders
613 | 
614 |         if placeholders_to_fetch:
615 |             assign_plugins(
616 |                 request=self.request,
617 |                 placeholders=placeholders_to_fetch,
618 |                 template=page.get_template(),
619 |                 lang=self.request_language,
620 |             )
621 | 
622 |         # Inherit only placeholders that have no plugins
623 |         # or are not cached.
624 |         placeholders_to_inherit = [
625 |             pl.slot for pl in placeholders
626 |             if not getattr(pl, '_plugins_cache', None) and pl.slot in slots_w_inheritance
627 |         ]
628 | 
629 |         if page.parent and placeholders_to_inherit:
630 |             self._preload_placeholders_for_page(
631 |                 page=page.parent,
632 |                 slots=placeholders_to_inherit,
633 |                 inherit=True,
634 |             )
635 | 
636 |         # Internal cache mapping placeholder slots
637 |         # to placeholder instances.
638 |         page_placeholder_cache = {}
639 | 
640 |         for placeholder in placeholders:
641 |             # Save a query when the placeholder toolbar is rendered.
642 |             placeholder.page = page
643 |             page_placeholder_cache[placeholder.slot] = placeholder
644 | 
645 |         self._placeholders_by_page_cache[page.pk] = page_placeholder_cache

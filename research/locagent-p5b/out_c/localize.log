38 | def plugin_report():
39 |     """
40 |     Returns a report of existing plugins
41 | 
42 |     structure of report:
43 |     [
44 |         {
45 |             'type': CMSPlugin class,
46 |             'model': plugin_type.model,
47 |             'instances': instances in the CMSPlugin table,
48 |             'unsaved_instances': those with no corresponding model instance,
49 |         },
50 |     ]
51 |     """
52 |     plugin_report = []
53 |     all_plugins = CMSPlugin.objects.order_by('plugin_type')
54 |     plugin_types = list(set(all_plugins.values_list('plugin_type', flat=True)))
55 |     plugin_types.sort()
56 | 
57 |     for plugin_type in plugin_types:
58 |         plugin = {}
59 |         plugin['type'] = plugin_type
60 |         try:
61 |             # get all plugins of this type
62 |             plugins = CMSPlugin.objects.filter(plugin_type=plugin_type)
63 |             plugin['instances'] = plugins
64 |             # does this plugin have a model? report unsaved instances
65 |             plugin['model'] = plugin_pool.get_plugin(name=plugin_type).model
66 |             unsaved_instances = [p for p in plugins if not p.get_plugin_instance()[0]]
67 |             plugin['unsaved_instances'] = unsaved_instances
68 | 
69 |         # catch uninstalled plugins
70 |         except KeyError:
71 |             plugin['model'] = None
72 |             plugin['instances'] = plugins
73 |             plugin['unsaved_instances'] = []

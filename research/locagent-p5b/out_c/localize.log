206 | 
207 |     If we use the ML URL Middleware, we namespace those patterns with the title
208 |     language.
209 | 
210 |     All 'normal' patterns from the urlconf get re-written by prefixing them with
211 |     the title path and then included into the cms url patterns.
212 | 
213 |     If the app is still configured, but is no longer installed/available, then
214 |     this method returns a degenerate patterns object: patterns('')
215 |     """
216 |     from cms.models import Title
217 | 
218 |     included = []
219 | 
220 |     # we don't have a request here so get_page_queryset() can't be used,
221 |     # so use public() queryset.
222 |     # This can be done because url patterns are used just in frontend
223 |     title_qs = Title.objects.public().filter(page__publisher_public__nodes__site=site)
224 | 
225 |     hooked_applications = OrderedDict()
226 | 
227 |     # Loop over all titles with an application hooked to them
228 |     titles = (title_qs.exclude(page__application_urls=None)
229 |               .exclude(page__application_urls='')
230 |               .order_by('-page__publisher_public__nodes__path').select_related())
231 |     # TODO: Need to be fixed for django-treebeard when forward ported to 3.1
232 |     for title in titles:
233 |         path = title.path
234 |         mix_id = "%s:%s:%s" % (
235 |             path + "/", title.page.application_urls, title.language)
236 |         if mix_id in included:
237 |             # don't add the same thing twice
238 |             continue
239 |         if not settings.APPEND_SLASH:
240 |             path += '/'
241 |         app = apphook_pool.get_apphook(title.page.application_urls)
242 |         if not app:
243 |             continue
244 |         if title.page_id not in hooked_applications:
245 |             hooked_applications[title.page_id] = {}
246 |         app_ns = app.app_name, title.page.application_namespace
247 |         with override(title.language):
248 |             hooked_applications[title.page_id][title.language] = (
249 |                 app_ns, get_patterns_for_title(path, title), app)
250 |         included.append(mix_id)
251 |         # Build the app patterns to be included in the cms urlconfs
252 |     app_patterns = []
253 |     for page_id in hooked_applications.keys():
254 |         resolver = None
255 |         for lang in hooked_applications[page_id].keys():
256 |             (app_ns, inst_ns), current_patterns, app = hooked_applications[page_id][lang]  # nopyflakes
257 |             if not resolver:
258 |                 resolver = AppRegexURLResolver(
259 |                     r'', 'app_resolver', app_name=app_ns, namespace=inst_ns)
260 |                 resolver.page_id = page_id
261 |             if app.permissions:
262 |                 _set_permissions(current_patterns, app.exclude_permissions)
263 | 
264 |             resolver.url_patterns_dict[lang] = current_patterns
265 |         app_patterns.append(resolver)
266 |         APP_RESOLVERS.append(resolver)
267 |     return app_patterns

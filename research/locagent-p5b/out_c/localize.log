24 | def unpublish_never_published_pages(apps, schema_editor):
25 |     """
26 |     Prior to 3.5, pages would be marked as "pending"
27 |     when users tried to publish a page with an unpublished parent.
28 |     This is no longer allowed, as a result any page that's set as
29 |     published but does not have a public version is marked as unpublished.
30 |     """
31 |     Page = apps.get_model('cms', 'Page')
32 |     db_alias = schema_editor.connection.alias
33 |     draft_pages = Page.objects.using(db_alias).filter(publisher_is_draft=True)
34 |     never_published_pages = Page.objects.using(db_alias).filter(
35 |         title_set__published=True,
36 |         publisher_is_draft=True,
37 |         publisher_public__isnull=True,
38 |     )
39 | 
40 |     for page in never_published_pages.distinct():
41 |         page.title_set.update(
42 |             published=False,
43 |             publisher_state=1,
44 |         )
45 |         draft_pages.filter(pk=page.pk).update(

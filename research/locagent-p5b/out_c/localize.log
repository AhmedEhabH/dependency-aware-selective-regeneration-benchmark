1007 |     @xframe_options_sameorigin
1008 |     def delete_plugin(self, request, plugin_id):
1009 |         plugin = self._get_plugin_from_id(plugin_id)
1010 | 
1011 |         if not self.has_delete_plugin_permission(request, plugin):
1012 |             return HttpResponseForbidden(force_text(
1013 |                 _("You do not have permission to delete this plugin")))
1014 | 
1015 |         opts = plugin._meta
1016 |         using = router.db_for_write(opts.model)
1017 |         deleted_objects, __, perms_needed, protected = get_deleted_objects(
1018 |             [plugin], opts, request.user, self.admin_site, using)
1019 | 
1020 |         if request.POST:  # The user has already confirmed the deletion.
1021 |             if perms_needed:
1022 |                 raise PermissionDenied(_("You do not have permission to delete this plugin"))
1023 |             obj_display = force_text(plugin)
1024 |             placeholder = plugin.placeholder

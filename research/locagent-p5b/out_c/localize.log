22 | def validate_url_uniqueness(site, path, language, user_language=None, exclude_page=None):
23 |     """ Checks for conflicting urls
24 |     """
25 |     from cms.models.pagemodel import PageUrl
26 | 
27 |     if '/' in path:
28 |         validate_url(path)
29 | 
30 |     path = path.strip('/')
31 |     page_urls = PageUrl.objects.get_for_site(site, language=language).filter(path=path)
32 | 
33 |     if exclude_page:
34 |         page_urls = page_urls.exclude(page=exclude_page.pk)
35 | 
36 |     try:
37 |         conflict_page = page_urls[0].page
38 |     except IndexError:
39 |         return True
40 | 
41 |     conflict_translation = conflict_page.get_content_obj(language, fallback=False)
42 | 
43 |     if conflict_translation:  # No empty page content
44 |         change_url = admin_reverse('cms_pagecontent_change', args=[conflict_translation.pk])
45 |     else:
46 |         change_url = ""  # Empty page has no slug
47 |     if user_language:
48 |         change_url += f'?language={user_language}'
49 | 
50 |     conflict_url = f'<a href="{change_url}" target="_blank">{str(conflict_translation.title)}</a>'
51 | 
52 |     if exclude_page:
53 |         message = gettext('Page %(conflict_page)s has the same url \'%(url)s\' as current page "%(instance)s".')
54 |     else:
55 |         message = gettext('Page %(conflict_page)s has the same url \'%(url)s\' as current page.')
56 |     message = message % {
57 |         'conflict_page': conflict_url,
58 |         'url': path,
59 |         'instance': exclude_page.get_title(language) if exclude_page else ''
60 |     }

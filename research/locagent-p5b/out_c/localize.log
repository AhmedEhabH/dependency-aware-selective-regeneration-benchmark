 59 | def get_page_from_request(request, use_path=None, clean_path=None):
 60 |     """
 61 |     Gets the current page from a request object.
 62 | 
 63 |     URLs can be of the following form (this should help understand the code):
 64 |     http://server.whatever.com/<some_path>/"pages-root"/some/page/slug
 65 | 
 66 |     <some_path>: This can be anything, and should be stripped when resolving
 67 |         pages names. This means the CMS is not installed at the root of the
 68 |         server's URLs.
 69 |     "pages-root" This is the root of Django urls for the CMS. It is, in essence
 70 |         an empty page slug (slug == '')
 71 | 
 72 |     The page slug can then be resolved to a Page model object
 73 |     """
 74 |     from cms.models import PageUrl
 75 | 
 76 |     if hasattr(request, '_current_page_cache'):
 77 |         # The following is set by CurrentPageMiddleware
 78 |         return request._current_page_cache
 79 | 
 80 |     if clean_path is None:
 81 |         clean_path = not bool(use_path)
 82 | 
 83 |     path = request.path_info if use_path is None else use_path
 84 | 
 85 |     if clean_path:
 86 |         try:
 87 |             pages_root = reverse("pages-root")
 88 |             if path.startswith(pages_root):
 89 |                 path = path[len(pages_root):]
 90 | 
 91 |             # strip any final slash
 92 |             if path.endswith("/"):
 93 |                 path = path[:-1]
 94 |         except NoReverseMatch:
 95 |             pass
 96 | 
 97 |     site = get_current_site()
 98 |     page_urls = (
 99 |         PageUrl
100 |         .objects
101 |         .get_for_site(site)
102 |         .filter(path=path)
103 |         .select_related('page')
104 |     )
105 |     page_urls = list(page_urls)  # force queryset evaluation to save 1 query
106 |     try:
107 |         page = page_urls[0].page
108 |         if page_urls[0].language == get_language_from_request(request):
109 |             page.urls_cache = {url.language: url for url in page_urls}
110 |     except IndexError:
111 |         page = None
112 |     return page

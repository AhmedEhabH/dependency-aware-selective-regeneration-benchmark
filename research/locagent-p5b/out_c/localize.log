565 | def copy_plugins_to_language(page, source_language, target_language,
566 |                              only_empty=True):
567 |     """
568 |     Copy the plugins to another language in the same page for all the page
569 |     placeholders.
570 | 
571 |     By default, plugins are copied only if placeholder has no plugin for the
572 |     target language; use ``only_empty=False`` to change this.
573 | 
574 |     .. warning: This function skips permissions checks
575 | 
576 |     :param page: the page to copy
577 |     :type page: :class:`cms.models.pagemodel.Page` instance
578 |     :param string source_language: The source language code,
579 |      must be in :setting:`django:LANGUAGES`
580 |     :param string target_language: The source language code,
581 |      must be in :setting:`django:LANGUAGES`
582 |     :param bool only_empty: if False, plugin are copied even if
583 |      plugins exists in the target language (on a placeholder basis).
584 |     :return int: number of copied plugins
585 |     """
586 |     copied = 0
587 |     placeholders = page.get_placeholders(source_language)
588 |     for placeholder in placeholders:
589 |         # only_empty is True we check if the placeholder already has plugins and
590 |         # we skip it if has some
591 |         if not only_empty or not placeholder.get_plugins(language=target_language).exists():
592 |             plugins = list(placeholder.get_plugins(language=source_language))
593 |             copied_plugins = copy_plugins_to_placeholder(plugins, placeholder, language=target_language)
594 |             copied += len(copied_plugins)
595 |     return copied

24 | def _build_nodes_inner_for_one_menu(nodes, menu_class_name):
25 |     '''
26 |     This is an easier to test "inner loop" building the menu tree structure
27 |     for one menu (one language, one site)
28 |     '''
29 |     done_nodes = {}  # Dict of node.id:Node
30 |     final_nodes = []
31 | 
32 |     # This is to prevent infinite loops - we need to compare the number of
33 |     # times we see a specific node to "something", and for the time being,
34 |     # it's the total number of nodes
35 |     list_total_length = len(nodes)
36 | 
37 |     while nodes:
38 |         # For when the node has a parent_id but we haven't seen it yet.
39 |         # We must not append it to the final list in this case!
40 |         should_add_to_final_list = True
41 | 
42 |         node = nodes.pop(0)
43 | 
44 |         # Increment the "seen" counter for this specific node.
45 |         node._counter = getattr(node, '_counter', 0) + 1
46 | 
47 |         # Implicit namespacing by menu.__name__
48 |         if not node.namespace:
49 |             node.namespace = menu_class_name
50 |         if node.namespace not in done_nodes:
51 |             # We need to create the namespace dict to avoid KeyErrors
52 |             done_nodes[node.namespace] = {}
53 | 
54 |         # If we have seen the parent_id already...
55 |         if node.parent_id in done_nodes[node.namespace]:
56 |             # Implicit parent namespace by menu.__name__
57 |             if not node.parent_namespace:
58 |                 node.parent_namespace = menu_class_name
59 |             parent = done_nodes[node.namespace][node.parent_id]
60 |             parent.children.append(node)
61 |             node.parent = parent
62 |         # If it has a parent_id but we haven't seen it yet...
63 |         elif node.parent_id:
64 |             # We check for infinite loops here, by comparing the number of
65 |             # times we "saw" this node to the number of nodes in the list
66 |             if node._counter < list_total_length:
67 |                 nodes.append(node)
68 |             # Never add this node to the final list until it has a real
69 |             # parent (node.parent)
70 |             should_add_to_final_list = False
71 | 
72 |         if should_add_to_final_list:
73 |             final_nodes.append(node)
74 |             # add it to the "seen" list
75 |             done_nodes[node.namespace][node.id] = node
76 |     return final_nodes
```


295 | class NavExtender(Modifier):
296 | 
297 |     def modify(self, request, nodes, namespace, root_id, post_cut, breadcrumb):
298 |         if post_cut:
299 |             return nodes
300 |         # rearrange the parent relations
301 |         # Find home
302 |         home = next((n for n in nodes if n.attr.get("is_home", False)), None)
303 |         # Find nodes with NavExtenders
304 |         exts = []
305 |         for node in nodes:
306 |             extenders = node.attr.get("navigation_extenders", None)
307 |             if extenders:
308 |                 for ext in extenders:
309 |                     if ext not in exts:
310 |                         exts.append(ext)
311 |                     # Link the nodes
312 |                     for extnode in nodes:
313 |                         if extnode.namespace == ext and not extnode.parent_id:
314 |                             # if home has nav extenders but home is not visible
315 |                             if node == home and not node.visible:
316 |                                 # extnode.parent_id = None
317 |                                 extnode.parent_namespace = None
318 |                                 extnode.parent = None
319 |                             else:
320 |                                 extnode.parent_id = node.id
321 |                                 extnode.parent_namespace = node.namespace
322 |                                 extnode.parent = node
323 |                                 node.children.append(extnode)
324 |         removed = []
325 | 
326 |         # find all not assigned nodes
327 |         for menu in self.renderer.menus.items():
328 |             if (hasattr(menu[1], 'cms_enabled')
329 |                     and menu[1].cms_enabled and not menu[0] in exts):
330 |                 for node in nodes:
331 |                     if node.namespace == menu[0]:
332 |                         removed.append(node)
333 |         if breadcrumb:
334 |             # if breadcrumb and home not in navigation add node
335 |             if breadcrumb and home and not home.visible:
336 |                 home.visible = True
337 |                 if request.path_info == home.get_absolute_url():
338 |                     home.selected = True
339 |                 else:
340 |                     home.selected = False
341 |         # remove all nodes that are nav_extenders and not assigned
342 |         for node in removed:
343 |             nodes.remove(node)
344 |         return nodes

 578 |     @method_decorator(require_POST)
 579 |     @xframe_options_sameorigin
 580 |     @transaction.atomic
 581 |     def move_plugin(self, request):
 582 |         """
 583 |         Performs a move or a "paste" operation (when «move_a_copy» is set)
 584 | 
 585 |         POST request with following parameters:
 586 |         - plugin_id
 587 |         - placeholder_id
 588 |         - plugin_language (optional)
 589 |         - plugin_parent (optional)
 590 |         - plugin_order (array, optional)
 591 |         - move_a_copy (Boolean, optional) (anything supplied here except a case-
 592 |                                         insensitive "false" is True)
 593 |         NOTE: If move_a_copy is set, the plugin_order should contain an item
 594 |               '__COPY__' with the desired destination of the copied plugin.
 595 |         """
 596 |         # plugin_id and placeholder_id are required, so, if nothing is supplied,
 597 |         # an ValueError exception will be raised by get_int().
 598 |         try:
 599 |             plugin_id = get_int(request.POST.get('plugin_id'))
 600 |         except TypeError:
 601 |             raise RuntimeError("'plugin_id' is a required parameter.")
 602 | 
 603 |         plugin = self._get_plugin_from_id(plugin_id)
 604 | 
 605 |         try:
 606 |             placeholder_id = get_int(request.POST.get('placeholder_id'))
 607 |         except TypeError:
 608 |             raise RuntimeError("'placeholder_id' is a required parameter.")
 609 |         except ValueError:
 610 |             raise RuntimeError("'placeholder_id' must be an integer string.")
 611 | 
 612 |         placeholder = Placeholder.objects.get(pk=placeholder_id)
 613 | 
 614 |         # The rest are optional
 615 |         parent_id = get_int(request.POST.get('plugin_parent', ""), None)
 616 |         target_language = request.POST['target_language']
 617 |         move_a_copy = request.POST.get('move_a_copy')
 618 |         move_a_copy = (move_a_copy and move_a_copy != "0" and
 619 |                        move_a_copy.lower() != "false")
 620 |         move_to_clipboard = placeholder == request.toolbar.clipboard
 621 |         source_placeholder = plugin.placeholder
 622 | 
 623 |         order = request.POST.getlist("plugin_order[]")
 624 | 
 625 |         if placeholder != source_placeholder:
 626 |             try:
 627 |                 template = self.get_placeholder_template(request, placeholder)
 628 |                 has_reached_plugin_limit(placeholder, plugin.plugin_type,
 629 |                                          target_language, template=template)
 630 |             except PluginLimitReached as er:
 631 |                 return HttpResponseBadRequest(er)
 632 | 
 633 |         # order should be a list of plugin primary keys
 634 |         # it's important that the plugins being referenced
 635 |         # are all part of the same tree.
 636 |         exclude_from_order_check = ['__COPY__', str(plugin.pk)]
 637 |         ordered_plugin_ids = [int(pk) for pk in order if pk not in exclude_from_order_check]
 638 |         plugins_in_tree_count = (
 639 |             placeholder
 640 |             .get_plugins(target_language)
 641 |             .filter(parent=parent_id, pk__in=ordered_plugin_ids)
 642 |             .count()
 643 |         )
 644 | 
 645 |         if len(ordered_plugin_ids) != plugins_in_tree_count:
 646 |             # order does not match the tree on the db
 647 |             message = _('order parameter references plugins in different trees')
 648 |             return HttpResponseBadRequest(force_text(message))
 649 | 
 650 |         # True if the plugin is not being moved from the clipboard
 651 |         # to a placeholder or from a placeholder to the clipboard.
 652 |         move_a_plugin = not move_a_copy and not move_to_clipboard
 653 | 
 654 |         if parent_id and plugin.parent_id != parent_id:
 655 |             target_parent = get_object_or_404(CMSPlugin, pk=parent_id)
 656 | 
 657 |             if move_a_plugin and target_parent.placeholder_id != placeholder.pk:
 658 |                 return HttpResponseBadRequest(force_text(
 659 |                     _('parent must be in the same placeholder')))
 660 | 
 661 |             if move_a_plugin and target_parent.language != target_language:
 662 |                 return HttpResponseBadRequest(force_text(
 663 |                     _('parent must be in the same language as '
 664 |                       'plugin_language')))
 665 |         elif parent_id:
 666 |             target_parent = plugin.parent
 667 |         else:
 668 |             target_parent = None
 669 | 
 670 |         new_plugin = None
 671 |         fetch_tree = False
 672 | 
 673 |         if move_a_copy and plugin.plugin_type == "PlaceholderPlugin":
 674 |             new_plugins = self._paste_placeholder(
 675 |                 request,
 676 |                 plugin=plugin,
 677 |                 target_language=target_language,
 678 |                 target_placeholder=placeholder,
 679 |                 tree_order=order,
 680 |             )
 681 |         elif move_a_copy:
 682 |             fetch_tree = True
 683 |             new_plugin = self._paste_plugin(
 684 |                 request,
 685 |                 plugin=plugin,
 686 |                 target_parent=target_parent,
 687 |                 target_language=target_language,
 688 |                 target_placeholder=placeholder,
 689 |                 tree_order=order,
 690 |             )
 691 |         elif move_to_clipboard:
 692 |             new_plugin = self._cut_plugin(
 693 |                 request,
 694 |                 plugin=plugin,
 695 |                 target_language=target_language,
 696 |                 target_placeholder=placeholder,
 697 |             )
 698 |             new_plugins = [new_plugin]
 699 |         else:
 700 |             fetch_tree = True
 701 |             new_plugin = self._move_plugin(
 702 |                 request,
 703 |                 plugin=plugin,
 704 |                 target_parent=target_parent,
 705 |                 target_language=target_language,
 706 |                 target_placeholder=placeholder,
 707 |                 tree_order=order,
 708 |             )
 709 | 
 710 |         if new_plugin and fetch_tree:
 711 |             root = (new_plugin.parent or new_plugin)
 712 |             new_plugins = [root] + list(root.get_descendants().order_by('path'))
 713 | 
 714 |         # Mark the target placeholder as dirty
 715 |         placeholder.mark_as_dirty(target_language)
 716 | 
 717 |         if placeholder != source_placeholder:
 718 |             # Plugin is being moved or copied into a separate placeholder
 719 |             # Mark source placeholder as dirty
 720 |             source_placeholder.mark_as_dirty(plugin.language)
 721 |         data = get_plugin_tree_as_json(request, new_plugins)
 722 |         return HttpResponse(data, content_type='application/json')
 723 | 
 724 |     def _paste_plugin(self, request, plugin, target_language,
 725 |                       target_placeholder, tree_order, target_parent=None):
 726 |         plugins = (
 727 |             CMSPlugin
 728 |             .get_tree(parent=plugin)
 729 |             .filter(placeholder=plugin.placeholder_id)
 730 |             .order_by('path')
 731 |         )
 732 |         plugins = list(plugins)
 733 | 
 734 |         if not self.has_copy_from_clipboard_permission(request, target_placeholder, plugins):
 735 |             message = force_text(_("You have no permission to paste this plugin"))
 736 |             raise PermissionDenied(message)
 737 | 
 738 |         if target_parent:
 739 |             target_parent_id = target_parent.pk
 740 |         else:
 741 |             target_parent_id = None
 742 | 
 743 |         target_tree_order = [int(pk) for pk in tree_order if not pk == '__COPY__']
 744 | 
 745 |         action_token = self._send_pre_placeholder_operation(
 746 |             request,
 747 |             operation=operations.PASTE_PLUGIN,
 748 |             plugin=plugin,
 749 |             target_language=target_language,
 750 |             target_placeholder=target_placeholder,
 751 |             target_parent_id=target_parent_id,
 752 |             target_order=target_tree_order,
 753 |         )
 754 | 
 755 |         plugin_pairs = copy_plugins.copy_plugins_to(
 756 |             plugins,
 757 |             to_placeholder=target_placeholder,
 758 |             to_language=target_language,
 759 |             parent_plugin_id=target_parent_id,
 760 |         )
 761 |         root_plugin = plugin_pairs[0][0]
 762 | 
 763 |         # If an ordering was supplied, replace the item that has
 764 |         # been copied with the new copy
 765 |         target_tree_order.insert(tree_order.index('__COPY__'), root_plugin.pk)
 766 | 
 767 |         reorder_plugins(
 768 |             target_placeholder,
 769 |             parent_id=target_parent_id,
 770 |             language=target_language,
 771 |             order=target_tree_order,
 772 |         )
 773 | 
 774 |         # Fetch from db to update position and other tree values
 775 |         root_plugin.refresh_from_db()
 776 | 
 777 |         self._send_post_placeholder_operation(
 778 |             request,
 779 |             operation=operations.PASTE_PLUGIN,
 780 |             plugin=root_plugin.get_bound_plugin(),
 781 |             token=action_token,
 782 |             target_language=target_language,
 783 |             target_placeholder=target_placeholder,
 784 |             target_parent_id=target_parent_id,
 785 |             target_order=target_tree_order,
 786 |         )
 787 |         return root_plugin
 788 | 
 789 |     def _paste_placeholder(self, request, plugin, target_language,
 790 |                            target_placeholder, tree_order):
 791 |         plugins = plugin.placeholder_ref.get_plugins_list()
 792 | 
 793 |         if not self.has_copy_from_clipboard_permission(request, target_placeholder, plugins):
 794 |             message = force_text(_("You have no permission to paste this placeholder"))
 795 |             raise PermissionDenied(message)
 796 | 
 797 |         target_tree_order = [int(pk) for pk in tree_order if not pk == '__COPY__']
 798 | 
 799 |         action_token = self._send_pre_placeholder_operation(
 800 |             request,
 801 |             operation=operations.PASTE_PLACEHOLDER,
 802 |             plugins=plugins,
 803 |             target_language=target_language,
 804 |             target_placeholder=target_placeholder,
 805 |             target_order=target_tree_order,
 806 |         )
 807 | 
 808 |         new_plugins = copy_plugins.copy_plugins_to(
 809 |             plugins,
 810 |             to_placeholder=target_placeholder,
 811 |             to_language=target_language,
 812 |         )
 813 | 
 814 |         new_plugin_ids = (new.pk for new, old in new_plugins)
 815 | 
 816 |         # Creates a list of PKs for the top-level plugins ordered by
 817 |         # their position.
 818 |         top_plugins = (pair for pair in new_plugins if not pair[0].parent_id)
 819 |         top_plugins_pks = [p[0].pk for p in sorted(top_plugins, key=lambda pair: pair[1].position)]
 820 | 
 821 |         # If an ordering was supplied, we should replace the item that has
 822 |         # been copied with the new plugins
 823 |         target_tree_order[tree_order.index('__COPY__'):0] = top_plugins_pks
 824 | 
 825 |         reorder_plugins(
 826 |             target_placeholder,
 827 |             parent_id=None,
 828 |             language=target_language,
 829 |             order=target_tree_order,
 830 |         )
 831 | 
 832 |         new_plugins = (
 833 |             CMSPlugin
 834 |             .objects
 835 |             .filter(pk__in=new_plugin_ids)
 836 |             .order_by('path')
 837 |             .select_related('placeholder')
 838 |         )
 839 |         new_plugins = list(new_plugins)
 840 | 
 841 |         self._send_post_placeholder_operation(
 842 |             request,
 843 |             operation=operations.PASTE_PLACEHOLDER,
 844 |             token=action_token,
 845 |             plugins=new_plugins,
 846 |             target_language=target_language,
 847 |             target_placeholder=target_placeholder,
 848 |             target_order=target_tree_order,
 849 |         )
 850 |         return new_plugins
 851 | 
 852 |     def _move_plugin(self, request, plugin, target_language,
 853 |                      target_placeholder, tree_order, target_parent=None):
 854 |         if not self.has_move_plugin_permission(request, plugin, target_placeholder):
 855 |             message = force_text(_("You have no permission to move this plugin"))
 856 |             raise PermissionDenied(message)
 857 | 
 858 |         plugin_data = {
 859 |             'language': target_language,
 860 |             'placeholder': target_placeholder,
 861 |         }
 862 | 
 863 |         source_language = plugin.language
 864 |         source_placeholder = plugin.placeholder
 865 |         source_tree_order = source_placeholder.get_plugin_tree_order(
 866 |             language=source_language,
 867 |             parent_id=plugin.parent_id,
 868 |         )
 869 | 
 870 |         if target_parent:
 871 |             target_parent_id = target_parent.pk
 872 |         else:
 873 |             target_parent_id = None
 874 | 
 875 |         if target_placeholder != source_placeholder:
 876 |             target_tree_order = target_placeholder.get_plugin_tree_order(
 877 |                 language=target_language,
 878 |                 parent_id=target_parent_id,
 879 |             )
 880 |         else:
 881 |             target_tree_order = source_tree_order
 882 | 
 883 |         action_token = self._send_pre_placeholder_operation(
 884 |             request,
 885 |             operation=operations.MOVE_PLUGIN,
 886 |             plugin=plugin,
 887 |             source_language=source_language,
 888 |             source_placeholder=source_placeholder,
 889 |             source_parent_id=plugin.parent_id,
 890 |             source_order=source_tree_order,
 891 |             target_language=target_language,
 892 |             target_placeholder=target_placeholder,
 893 |             target_parent_id=target_parent_id,
 894 |             target_order=target_tree_order,
 895 |         )
 896 | 
 897 |         if target_parent and plugin.parent != target_parent:
 898 |             # Plugin is being moved to another tree (under another parent)
 899 |             updated_plugin = plugin.update(refresh=True, parent=target_parent, **plugin_data)
 900 |             updated_plugin = updated_plugin.move(target_parent, pos='last-child')
 901 |         elif target_parent:
 902 |             # Plugin is being moved within the same tree (different position, same parent)
 903 |             updated_plugin = plugin.update(refresh=True, **plugin_data)
 904 |         else:
 905 |             # Plugin is being moved to the root (no parent)
 906 |             target = CMSPlugin.get_last_root_node()
 907 |             updated_plugin = plugin.update(refresh=True, parent=None, **plugin_data)
 908 |             updated_plugin = updated_plugin.move(target, pos='right')
 909 | 
 910 |         # Update all children to match the parent's
 911 |         # language and placeholder
 912 |         updated_plugin.get_descendants().update(**plugin_data)
 913 | 
 914 |         # Avoid query by removing the plugin being moved
 915 |         # from the source order
 916 |         new_source_order = list(source_tree_order)
 917 |         new_source_order.remove(updated_plugin.pk)
 918 | 
 919 |         # Reorder all plugins in the target placeholder according to the
 920 |         # passed order
 921 |         new_target_order = [int(pk) for pk in tree_order]
 922 |         reorder_plugins(
 923 |             target_placeholder,
 924 |             parent_id=target_parent_id,
 925 |             language=target_language,
 926 |             order=new_target_order,
 927 |         )
 928 | 
 929 |         # Refresh plugin to get new tree and position values
 930 |         updated_plugin.refresh_from_db()
 931 | 
 932 |         self._send_post_placeholder_operation(
 933 |             request,
 934 |             operation=operations.MOVE_PLUGIN,
 935 |             plugin=updated_plugin.get_bound_plugin(),
 936 |             token=action_token,
 937 |             source_language=source_language,
 938 |             source_placeholder=source_placeholder,
 939 |             source_parent_id=plugin.parent_id,
 940 |             source_order=new_source_order,
 941 |             target_language=target_language,
 942 |             target_placeholder=target_placeholder,
 943 |             target_parent_id=target_parent_id,
 944 |             target_order=new_target_order,
 945 |         )
 946 |         return updated_plugin
 947 | 
 948 |     def _cut_plugin(self, request, plugin, target_language,  target_placeholder):
 949 |         if not self.has_move_plugin_permission(request, plugin, target_placeholder):
 950 |             message = force_text(_("You have no permission to cut this plugin"))
 951 |             raise PermissionDenied(message)
 952 | 
 953 |         plugin_data = {
 954 |             'language': target_language,
 955 |             'placeholder': target_placeholder,
 956 |         }
 957 | 
 958 |         source_language = plugin.language
 959 |         source_placeholder = plugin.placeholder
 960 |         source_tree_order = source_placeholder.get_plugin_tree_order(
 961 |             language=source_language,
 962 |             parent_id=plugin.parent_id,
 963 |         )
 964 | 
 965 |         action_token = self._send_pre_placeholder_operation(
 966 |             request,
 967 |             operation=operations.CUT_PLUGIN,
 968 |             plugin=plugin,
 969 |             clipboard=target_placeholder,
 970 |             clipboard_language=target_language,
 971 |             source_language=source_language,
 972 |             source_placeholder=source_placeholder,
 973 |             source_parent_id=plugin.parent_id,
 974 |             source_order=source_tree_order,
 975 |         )
 976 | 
 977 |         # Empty the clipboard
 978 |         target_placeholder.clear()
 979 | 
 980 |         target = CMSPlugin.get_last_root_node()
 981 |         updated_plugin = plugin.update(refresh=True, parent=None, **plugin_data)
 982 |         updated_plugin = updated_plugin.move(target, pos='right')
 983 | 
 984 |         # Update all children to match the parent's
 985 |         # language and placeholder (clipboard)
 986 |         updated_plugin.get_descendants().update(**plugin_data)
 987 | 
 988 |         # Avoid query by removing the plugin being moved
 989 |         # from the source order
 990 |         new_source_order = list(source_tree_order)
 991 |         new_source_order.remove(updated_plugin.pk)
 992 | 
 993 |         self._send_post_placeholder_operation(
 994 |             request,
 995 |             operation=operations.CUT_PLUGIN,
 996 |             token=action_token,
 997 |             plugin=updated_plugin.get_bound_plugin(),
 998 |             clipboard=target_placeholder,
 999 |             clipboard_language=target_language,
1000 |             source_language=source_language,
1001 |             source_placeholder=source_placeholder,
1002 |             source_parent_id=plugin.parent_id,
1003 |             source_order=new_source_order,
1004 |         )
1005 |         return updated_plugin

 94 |     plugins = list(CMSPlugin.objects.filter(placeholder__in=placeholders, language=lang))
 95 |     if not plugins:
 96 |         # Create default plugins if enabled
 97 |         plugins = create_default_plugins(request, placeholders, template, lang)
 98 |     else:
 99 |         plugins = downcast_plugins(plugins, placeholders, request=request)
100 | 
101 |     # split the plugins up by placeholder
102 |     plugins_by_placeholder = defaultdict(list)
103 | 
104 |     for plugin in plugins:
105 |         plugins_by_placeholder[plugin.placeholder_id].append(plugin)
106 | 
107 |     for placeholder in placeholders:
108 |         all_plugins = plugins_by_placeholder[placeholder.pk]

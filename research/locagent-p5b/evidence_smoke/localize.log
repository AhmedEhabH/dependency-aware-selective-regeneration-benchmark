120 | def create_default_plugins(request, placeholders, template, lang):
121 |     """
122 |     Create all default plugins for the given ``placeholders`` if they have
123 |     a "default_plugins" configuration value in settings.
124 |     return all plugins, children, grandchildren (etc.) created
125 |     """
126 |     from cms.api import add_plugin
127 | 
128 |     def _create_default_plugins(placeholder, confs, parent=None):
129 |         """
130 |         Auxiliary function that builds all of a placeholder's default plugins
131 |         at the current level and drives the recursion down the tree.
132 |         Returns the plugins at the current level along with all descendants.
133 |         """
134 |         plugins, descendants = [], []
135 |         addable_confs = (conf for conf in confs if has_plugin_permission(request.user, conf["plugin_type"], "add"))
136 |         for conf in addable_confs:
137 |             plugin = add_plugin(placeholder, conf["plugin_type"], lang, target=parent, **conf["values"])
138 |             if "children" in conf:
139 |                 args = placeholder, conf["children"], plugin
140 |                 descendants += _create_default_plugins(*args)
141 |             plugin.notify_on_autoadd(request, conf)
142 |             plugins.append(plugin)
143 |         if parent:
144 |             parent.notify_on_autoadd_children(request, conf, plugins)
145 |         return plugins + descendants
146 | 
147 |     unfiltered_confs = ((ph, get_placeholder_conf("default_plugins", ph.slot, template)) for ph in placeholders)
148 |     # Empty confs must be filtered before filtering on add permission
149 |     mutable_confs = (
150 |         (ph, default_plugin_confs)
151 |         for ph, default_plugin_confs in filter(itemgetter(1), unfiltered_confs)
152 |         if ph.has_change_permission(request.user)
153 |     )
154 |     return sum(starmap(_create_default_plugins, mutable_confs), [])

 67 | def assign_plugins(request, placeholders, template=None, lang=None):
 68 |     """
 69 |     Fetch all plugins for the given ``placeholders`` and
 70 |     cast them down to the concrete instances in one query
 71 |     per type.
 72 | 
 73 |     :param request: The current request.
 74 |     :param placeholders: An iterable of placeholder objects.
 75 |     :param template: (optional) The template object.
 76 |     :param lang: (optional) The language code.
 77 | 
 78 |     This method assigns plugins to the given placeholders. It retrieves the plugins from the database based on the
 79 |     placeholders and the language. The plugins are then downcasted to their specific plugin types.
 80 | 
 81 |     The plugins are split up by placeholder and stored in a dictionary where the key is the placeholder ID and the
 82 |     value is a list of plugins.
 83 | 
 84 |     For each placeholder, if there are plugins assigned to it, the plugins are organized as a layered tree structure.
 85 |     Otherwise, an empty list is assigned.
 86 | 
 87 |     The list of all plugins for each placeholder is stored in the `_all_plugins_cache` attribute of the placeholder,
 88 |     while the list of root plugins is stored in the `_plugins_cache` attribute
 89 |     """
 90 |     if not placeholders:
 91 |         return
 92 |     placeholders = tuple(placeholders)  # Trigger db hit
 93 |     lang = lang or get_language_from_request(request)
 94 |     plugins = list(CMSPlugin.objects.filter(placeholder__in=placeholders, language=lang))
 95 |     if not plugins:
 96 |         # Create default plugins if enabled
 97 |         plugins = create_default_plugins(request, placeholders, template, lang)
 98 |     else:
 99 |         plugins = downcast_plugins(plugins, placeholders, request=request)
100 | 
101 |     # split the plugins up by placeholder
102 |     plugins_by_placeholder = defaultdict(list)
103 | 
104 |     for plugin in plugins:
105 |         plugins_by_placeholder[plugin.placeholder_id].append(plugin)
106 | 
107 |     for placeholder in placeholders:
108 |         all_plugins = plugins_by_placeholder[placeholder.pk]
109 | 
110 |         if all_plugins:
111 |             layered_plugins = get_plugins_as_layered_tree(all_plugins)
112 |         else:
113 |             layered_plugins = []
114 |         # This is all the plugins.
115 |         placeholder._all_plugins_cache = all_plugins
116 |         # This is only the root plugins.
117 |         placeholder._plugins_cache = layered_plugins

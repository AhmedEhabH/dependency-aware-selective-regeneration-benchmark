479 | def has_reached_plugin_limit(placeholder, plugin_type, language, template=None):
480 |     """
481 |     Checks if the global maximum limit for plugins in a placeholder has been reached.
482 |     If not then it checks if it has reached its maximum plugin_type limit.
483 | 
484 |     Parameters:
485 |     - placeholder: The placeholder object to check the limit for.
486 |     - plugin_type: The type of plugin to check the limit for.
487 |     - language: The language code for the plugins.
488 |     - template: The template object for the placeholder. Optional.
489 | 
490 |     Returns:
491 |     - False if the limit has not been reached.
492 | 
493 |     Raises:
494 |     - PluginLimitReached: If the limit has been reached for the placeholder.
495 | 
496 |     """
497 |     limits = get_placeholder_conf("limits", placeholder.slot, template)
498 |     if limits:
499 |         global_limit = limits.get("global")
500 |         type_limit = limits.get(plugin_type)

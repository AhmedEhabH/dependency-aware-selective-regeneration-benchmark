 99 |     tz = get_timezone_name()
100 |     main_key = f"{prefix}|render_placeholder|id:{placeholder.pk}|lang:{lang}|site:{site_id}|tz:{tz}|v:{version}"
101 | 
102 |     if not soft:
103 |         # We are about to write to the cache, so we want to get the latest
104 |         # vary_cache_on headers and the correct cache expiration, ignoring any
105 |         # we already have. If the placeholder has already been rendered, this
106 |         # will be very efficient (zero-additional queries) due to the caching
107 |         # of all its plugins during the rendering process anyway.
108 |         vary_on_list = placeholder.get_vary_cache_on(request)
109 |         duration = placeholder.get_cache_expiration(request, now())
110 |         # Update the main placeholder cache version
111 |         _set_placeholder_cache_version(placeholder, lang, site_id, version, vary_on_list, duration)
112 | 
113 |     sub_key_list = []
114 |     for key in vary_on_list:
115 |         value = request.META.get(get_header_name(key)) or "_"
116 |         sub_key_list.append(key + ":" + value)
117 | 
118 |     cache_key = main_key
119 |     if sub_key_list:
120 |         cache_key += "|" + "|".join(sub_key_list)
121 | 
122 |     # django itself adds "version" add the end of cache-keys, e.g. "<key>:1".
123 |     # -> If `cache.set()` is for example called with `version=""`, it still adds
124 |     #    `:` at the end. So if we check the length for `> 250`, a length of 249
125 |     #    or even 250 ends up in an InvalidCacheKey-exception.
126 |     # In order to avoid these errors, we hash the keys at a lower length to also
127 |     # have a little buffer.
128 |     if len(cache_key) > 200:
129 |         cache_key = "{prefix}|{hash}".format(
130 |             prefix=prefix,
131 |             hash=hashlib.sha1(cache_key.encode("utf-8")).hexdigest(),
132 |         )
133 | 
134 |     return cache_key

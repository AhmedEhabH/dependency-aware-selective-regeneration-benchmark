46 | def get_placeholder_conf(setting: str, placeholder: str, template: Optional[str] = None, default=None):
47 |     """
48 |     Returns the placeholder configuration for a given setting. The key would for
49 |     example be 'plugins' or 'name'.
50 | 
51 |     Resulting value will be the last from:
52 | 
53 |     CMS_PLACEHOLDER_CONF[None] (global)
54 |     CMS_PLACEHOLDER_CONF['template'] (if template is given)
55 |     CMS_PLACEHOLDER_CONF['placeholder'] (where placeholder denotes a slot)
56 |     CMS_PLACEHOLDER_CONF['template placeholder'] (if template is given)
57 | 
58 |     Template is only evaluated if the placeholder configuration contains key with ".html" or ".htm"
59 |     """
60 | 
61 |     if placeholder:
62 |         keys = []
63 |         placeholder_conf = get_cms_setting("PLACEHOLDER_CONF")
64 |         template_in_conf = any(".htm" in (key or "") for key in placeholder_conf) and template
65 |         # 1st level
66 |         if template_in_conf:
67 |             keys.append(f"{template} {placeholder}")
68 |         # 2nd level
69 |         keys.append(placeholder)
70 |         # 3rd level
71 |         if template_in_conf:
72 |             keys.append(str(template))
73 |         # 4th level
74 |         keys.append(None)
75 |         for key in keys:
76 |             try:
77 |                 conf = placeholder_conf[key]
78 |                 value = conf.get(setting, None)
79 |                 if value is not None:
80 |                     return value
81 |                 inherit = conf.get("inherit")
82 |                 if inherit:
83 |                     if " " in inherit:
84 |                         inherit = inherit.split(" ")
85 |                     else:
86 |                         inherit = (None, inherit)
87 |                     value = get_placeholder_conf(
88 |                         setting, inherit[1], inherit[0], default
89 |                     )
90 |                     if value is not None:
91 |                         return value
92 |             except KeyError:
93 |                 continue
94 |     return default

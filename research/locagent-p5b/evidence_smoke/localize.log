 25 | class FixTreeCommand(SubcommandsCommand):
 26 |     help_string = 'Repairing Materialized Path Tree for Pages'
 27 |     command_name = 'fix-tree'
 28 | 
 29 |     def handle(self, *args, **options):
 30 |         """
 31 |         Repairs the tree
 32 |         """
 33 |         self.stdout.write('fixing page tree')
 34 |         Page.fix_tree()
 35 | 
 36 |         root_pages = Page.objects.filter(parent__isnull=True)
 37 | 
 38 |         last = None
 39 | 
 40 |         try:
 41 |             first = root_pages.order_by('path').first()
 42 |         except IndexError:
 43 |             first = None
 44 | 
 45 |         for page in root_pages.order_by('site__pk', 'path'):
 46 |             if last:
 47 |                 last.refresh_from_db()
 48 |                 page.refresh_from_db()
 49 |                 page.move(target=last, pos='right')
 50 |             elif first and first.pk != page.pk:
 51 |                 page.move(target=first, pos='left')
 52 |             last = page
 53 | 
 54 |         for root in root_pages.order_by('site__pk', 'path'):
 55 |             self._update_descendants_tree(root)
 56 | 
 57 |         self.stdout.write('fixing page URLs')
 58 |         for page in root_pages:
 59 |             for language in page.get_languages():
 60 |                 if not page.is_home:
 61 |                     page._update_url_path(language)
 62 |                 self._update_url_path_recursive(page, language)
 63 | 
 64 |         self.stdout.write('all done')
 65 | 
 66 |     def _update_descendants_tree(self, root):
 67 |         pages = Page.objects.all()
 68 |         descendants_by_parent = OrderedDict()
 69 | 
 70 |         for descendant in get_descendants(root):
 71 |             parent_id = descendant.parent_id
 72 |             descendants_by_parent.setdefault(parent_id, []).append(descendant)
 73 | 
 74 |         for tree in descendants_by_parent.values():
 75 |             last_page = None
 76 | 
 77 |             for page in tree:
 78 |                 page.refresh_from_db()
 79 | 
 80 |                 if last_page:
 81 |                     # This is not the first loop so this is not the first draft
 82 |                     # child. Set this page a sibling of the last processed
 83 |                     # draft page.
 84 |                     last_page.refresh_from_db()
 85 |                     page.move(target=last_page, pos='right')
 86 |                 else:
 87 |                     # This is the first time through the loop so this is the first
 88 |                     # draft child for this parent.
 89 |                     page.move(target=pages.get(pk=tree[0].parent_id), pos='first-child')
 90 |                 last_page = page
 91 | 
 92 |     def _update_url_path_recursive(self, page, language):
 93 |         if page.node.is_leaf() or language not in page.get_languages():
 94 |             return
 95 | 
 96 |         pages = page.get_child_pages()
 97 |         base_path = page.get_path(language)
 98 |         new_path = page._get_path_sql_value(base_path)
 99 | 
100 |         try:
101 |             (PageUrl
102 |              .objects
103 |              .filter(language=language, page__in=pages)
104 |              .exclude(managed=False)
105 |              .update(path=new_path))
106 |         except IntegrityError as exc:
107 |             self.stdout.write(f"{exc} while updating path for page: /{language}/{new_path}")
108 | 
109 |         for child in pages.filter(urls__language=language).iterator():
110 |             self._update_url_path_recursive(child, language)

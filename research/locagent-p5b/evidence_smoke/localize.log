451 | def add_plugin(self, instance):
452 |         """
453 |         .. versionadded:: 4.0
454 | 
455 |         Adds a plugin to the placeholder. The plugin's position field must be set to the target
456 |         position. Positions are enumerated from the start of the palceholder's plugin tree (1) to
457 |         the last plugin (*n*, where *n* is the number of plugins in the placeholder).
458 | 
459 |         :param instance: Plugin to add. It's position parameter needs to be set.
460 |         :type instance: :class:`cms.models.pluginmodel.CMSPlugin` instance
461 | 
462 |         .. note::
463 |             As of version 4 of django CMS the position counter does not re-start at 1 for the first
464 |             child plugin. The ``position`` field  and ``language`` field are unique for a placeholder.
465 | 
466 |         Example::
467 | 
468 |             new_child = MyCoolPlugin()
469 |             new_child.position = (
470 |                 parent_plugin.position + 1
471 |             )  # add as first child: directly after parent
472 |             parent_plugin.placeholder.add(new_child)
473 | 
474 |         """
475 |         last_position = self.get_last_plugin_position(instance.language) or 0
476 |         # A shift is only needed if the distance between the new plugin
477 |         # and the last plugin is greater than 1 position.
478 |         needs_shift = (instance.position - last_position) < 1
479 | 
480 |         if needs_shift:
481 |             # shift to the right
482 |             self._shift_plugin_positions(
483 |                 instance.language,
484 |                 start=instance.position,
485 |                 offset=last_position - instance.position + 2,  # behind last_position plus one to shift back
486 |             )
487 | 
488 |         instance.save()
489 | 
490 |         if needs_shift:
491 |             # The plugin tree was shifted to the right to make space,
492 |             # now squash all plugins in the tree to close any holes.
493 |             self._recalculate_plugin_positions(instance.language)
494 |         return instance
```


157 | def get_plugins_as_layered_tree(plugins):
158 |     """
159 |     Given an iterable of plugins ordered by position,
160 |     returns a deque of root plugins with their respective
161 |     children set in the child_plugin_instances attribute.
162 |     """
163 |     delayed = defaultdict(deque)
164 |     root_plugins = deque()
165 | 
166 |     for plugin in reversed(plugins):
167 |         plugin.child_plugin_instances = delayed[plugin.pk]
168 | 
169 |         if plugin.parent_id:
170 |             delayed[plugin.parent_id].appendleft(plugin)
171 |         else:

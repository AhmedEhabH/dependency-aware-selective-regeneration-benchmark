496 | def move_plugin(self, plugin, target_position, target_placeholder=None, target_plugin=None):
497 |         """
498 |         .. versionadded:: 4.0
499 | 
500 |         Moves a plugin within the placeholder (``target_placeholder=None``) or to another placeholder.
501 | 
502 |         :param plugin: Plugin to move
503 |         :type plugin: :class:`cms.models.pluginmodel.CMSPlugin` instance
504 |         :param int target_position: The plugin's new position
505 |         :param  target_placeholder: Placeholder to move plugin to (or ``None``)
506 |         :type target_placeholder: :class:`cms.models.placeholdermodel.Placeholder` instance
507 |         :param target_plugin: New parent plugin (or ``None``). The target plugin must be in the same placeholder
508 |            or in the ``target_placeholder`` if one is given.
509 |         :type target_plugin: :class:`cms.models.pluginmodel.CMSPlugin` instance
510 | 
511 |         The ``target_position`` is enumerated from the start of the palceholder's plugin tree (1) to
512 |         the last plugin (*n*, where *n* is the number of plugins in the placeholder).
513 |         """
514 | 
515 |         if target_placeholder:
516 |             return self._move_plugin_to_placeholder(
517 |                 plugin=plugin,
518 |                 target_position=target_position,
519 |                 target_placeholder=target_placeholder,
520 |                 target_plugin=target_plugin,
521 |             )
522 | 
523 |         target_tree = self.get_plugins(plugin.language)
524 |         last_plugin = self.get_last_plugin(plugin.language)
525 |         source_plugin_desc_count = plugin._get_descendants_count()
526 |         # Attn: The following line assumes that all children and grand-children have consecutive positions!
527 |         source_plugin_range = (plugin.position, plugin.position + source_plugin_desc_count)
528 | 
529 |         if target_position < plugin.position:
530 |             # Moving left
531 |             # Make a big hole on the right side of the current plugin's position
532 |             # by shifting all right nodes further to the right, excluding the current plugin
533 |             # but including the target plugin and its descendants.
534 |             (target_tree.filter(position__gte=target_position).exclude(position__range=source_plugin_range)).update(
535 |                 position=(models.F("position") + last_plugin.position)
536 |             )
537 | 
538 |             # Make a big hole on the left side of the current plugin's position
539 |             # by shifting all right nodes further the right, including the current plugin
540 |             # and its descendants.
541 |             target_tree.filter(position__lte=source_plugin_range[1]).update(
542 |                 position=models.F("position") - last_plugin.position
543 |             )
544 |         else:
545 |             # Moving right
546 |             # Make a big hole on the left side of the target position,
547 |             # by shifting all left nodes further to the left, excluding the current plugin
548 |             # but including the target plugin and its descendants.
549 |             # Left node in the common case is target_position but if the current plugin
550 |             # has descendants then left node is the closest node to the right side of the
551 |             # last descendant.
552 |             (
553 |                 target_tree.filter(position__lte=target_position + source_plugin_desc_count).exclude(
554 |                     position__range=source_plugin_range
555 |                 )
556 |             ).update(position=(models.F("position") - last_plugin.position))
557 | 
558 |             # Make a big hole on the right side of the current plugin's position
559 |             # by shifting all right nodes further the right, including the current plugin
560 |             # and its descendants.
561 |             target_tree.filter(position__gte=plugin.position).update(
562 |                 position=models.F("position") + last_plugin.position
563 |             )
564 | 
565 |         if plugin.parent != target_plugin:
566 |             # Plugin is being moved to another tree (under another parent)

 66 |     def _update_descendants_tree(self, root):
 67 |         pages = Page.objects.all()
 68 |         descendants_by_parent = OrderedDict()
 69 | 
 70 |         for descendant in get_descendants(root):
 71 |             parent_id = descendant.parent_id
 72 |             descendants_by_parent.setdefault(parent_id, []).append(descendant)
 73 | 
 74 |         for tree in descendants_by_parent.values():
 75 |             last_page = None
 76 | 
 77 |             for page in tree:
 78 |                 page.refresh_from_db()
 79 | 
 80 |                 if last_page:
 81 |                     # This is not the first loop so this is not the first draft
 82 |                     # child. Set this page a sibling of the last processed
 83 |                     # draft page.
 84 |                     last_page.refresh_from_db()
 85 |                     page.move(target=last_page, pos='right')
 86 |                 else:
 87 |                     # This is the first time through the loop so this is the first
 88 |                     # draft child for this parent.
 89 |                     page.move(target=pages.get(pk=tree[0].parent_id), pos='first-child')
 90 |                 last_page = page

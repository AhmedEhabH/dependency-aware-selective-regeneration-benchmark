 79 | def get_plugin_tree(
 80 |     request: HttpRequest,
 81 |     plugins: list[CMSPlugin],
 82 |     restrictions: Optional[dict] = None,
 83 |     target_plugin: Optional[CMSPlugin] = None,
 84 | ) -> dict[str, Any]:
 85 |     """
 86 |     Constructs a tree structure of CMS plugins for the toolbar.
 87 | 
 88 |     Args:
 89 |         request (HttpRequest): The HTTP request object.
 90 |         plugins (list[CMSPlugin]): A list of CMSPlugin instances to be organized into a tree.
 91 |         restrictions (Optional[dict], optional): A dictionary of plugin restrictions. Defaults to None.
 92 |         target_plugin (Optional[CMSPlugin], optional): The target plugin to render.
 93 |             Content will only be rendered if given. Defaults to None.
 94 | 
 95 |     Returns:
 96 |         tuple[dict[str, Any]]: A dictionary with up to five keys:
 97 |             - 'html': A string of rendered HTML for the plugin tree.
 98 |             - 'plugins': A flat list of plugin information dictionaries.
 99 |             - 'content': The rendered content of target_plugin (if given) including its children
100 |             - 'target_position': The position of the target_plugin (if given)
101 |             - 'target_placeholder_id': The placeholder id of the target_plugin (if given)
102 |     """
103 |     from cms.utils.plugins import downcast_plugins, get_plugin_restrictions
104 | 
105 |     tree_data = []
106 |     tree_structure = []
107 |     restrictions = restrictions or {}
108 |     root_plugins = deque()
109 |     plugin_children = defaultdict(deque)
110 |     toolbar = get_toolbar_from_request(request)
111 |     template = toolbar.templates.drag_item_template
112 |     get_plugin_info = get_plugin_toolbar_info
113 |     placeholder = plugins[0].placeholder
114 |     copy_to_clipboard = placeholder.pk == toolbar.clipboard.pk
115 |     plugins = list(downcast_plugins(plugins, select_placeholder=True))
116 |     plugin_ids = frozenset(plugin.pk for plugin in plugins)
117 | 
118 |     for plugin in reversed(plugins):
119 |         plugin.child_plugin_instances = plugin_children[plugin.pk]
120 | 
121 |         if plugin.parent_id in plugin_ids:
122 |             plugin_children[plugin.parent_id].appendleft(plugin)
123 |         else:
124 |             root_plugins.appendleft(plugin)
125 | 
126 |     def collect_plugin_data(plugin):
127 |         child_classes, parent_classes = get_plugin_restrictions(
128 |             plugin=plugin,
129 |             restrictions_cache=restrictions,
130 |         )
131 |         plugin_info = get_plugin_info(
132 |             plugin,
133 |             children=child_classes,
134 |             parents=parent_classes,
135 |         )
136 | 
137 |         tree_data.append(plugin_info)
138 | 
139 |         for plugin_instance in plugin.child_plugin_instances:
140 |             collect_plugin_data(plugin_instance)
141 | 
142 |     with force_language(toolbar.toolbar_language):
143 |         for root_plugin in root_plugins:
144 |             collect_plugin_data(root_plugin)
145 |             context = {
146 |                 'plugin': root_plugin,
147 |                 'request': request,
148 |                 'clipboard': copy_to_clipboard,
149 |                 'cms_toolbar': toolbar,
150 |             }
151 |             tree_structure.append(template.render(context))
152 |     tree_data.reverse()
153 | 
154 |     content = {}
155 |     # Render the target plugin if given and all plugins are local
156 |     if target_plugin and all(plugin.get_plugin_class().is_local for plugin in plugins):
157 |         # Also provide the parent plugin to the context (if available)
158 |         downcasted = next(
159 |             (plugin for plugin in plugins if plugin.pk == target_plugin.pk), None
160 |         )
161 |         parent = next(
162 |             (plugin for plugin in plugins if plugin.pk == target_plugin.parent_id), None
163 |         ) if target_plugin.parent_id else None
164 |         content["content"] = get_plugin_content(request, downcasted, {"parent": parent})
165 | 
166 |     return {'html': '\n'.join(tree_structure), 'plugins': tree_data, **content}

541 |             target_tree.filter(position__lte=source_plugin_range[1]).update(
542 |                 position=models.F("position") - last_plugin.position
543 |             )
544 |         else:
545 |             # Moving right
546 |             # Make a big hole on the left side of the target position,
547 |             # by shifting all left nodes further to the left, excluding the current plugin
548 |             # but including the target plugin and its descendants.
549 |             # Left node in the common case is target_position but if the current plugin
550 |             # has descendants then left node is the closest node to the right side of the

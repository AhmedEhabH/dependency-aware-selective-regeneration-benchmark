69 | def get_timezone_name():
70 |     """
71 |     This returns a cross-platform compatible timezone name suitable for
72 |     embedding into cache-keys. Its inclusion into cache-keys enables, but does
73 |     not guarantee by itself, that dates are display correctly for the client's
74 |     timezone. In order to complete this the project should use middleware or
75 |     some other mechanism to affect's Django's get_current_timezone_name().
76 |     """
77 |     # The datetime module doesn't restrict the output of tzname().
78 |     # Windows is known to use non-standard, locale-dependant names.
79 |     # User-defined tzinfo classes may return absolutely anything.
80 |     # Hence this paranoid conversion to create a valid cache key.
81 |     tz_name = force_str(get_current_timezone_name(), errors='ignore')
82 |     return tz_name.encode('ascii', 'ignore').decode('ascii').replace(' ', '_')

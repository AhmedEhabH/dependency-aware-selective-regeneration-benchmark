348 | def get_bound_plugins(plugins):
349 |     """
350 |     Get the bound plugins by downcasting the plugins to their respective classes. Raises a KeyError if the plugin type
351 |     is not available.
352 | 
353 |     Creates a map of plugin types and their corresponding plugin IDs for later use in downcasting.
354 |     Then, retrieves the plugin instances from the plugin model using the mapped plugin IDs.
355 |     Finally, iterates over the plugins and yields the downcasted versions if they have a valid parent.
356 |     Does not affect caching.
357 | 
358 |     :param plugins:  List of ``CMSPlugin`` instances.
359 |     :type plugins: List[CMSPlugin]
360 |     :return: Generator that yields the downcasted plugins.
361 |     :rtype: Generator[CMSPlugin, None, None]
362 | 
363 |     Example::
364 | 
365 |         plugins = [plugin_instance1, plugin_instance2]
366 |         for bound_plugin in get_bound_plugins(plugins):
367 |             # Do something with the bound_plugin
368 |             pass
369 |     """
370 |     plugin_types_map = defaultdict(list)
371 |     plugin_ids = []
372 |     plugin_lookup = {}
373 | 
374 |     # make a map of plugin types, needed later for downcasting
375 |     for plugin in plugins:
376 |         plugin_ids.append(plugin.pk)
377 |         base_model = get_plugin_model(plugin.plugin_type)._meta.concrete_model  # Collect all base models
378 |         if base_model is CMSPlugin:
379 |             plugin_lookup[plugin.pk] = plugin  # No downcast needed
380 |         else:
381 |             plugin_types_map[base_model].append(plugin.pk)
382 | 
383 |     for base_model, pks in plugin_types_map.items():
384 |         plugin_queryset = base_model.objects.filter(pk__in=pks)
385 |         # put them in a map, so we can replace the base CMSPlugins with their
386 |         # downcasted versions
387 |         for instance in plugin_queryset.iterator():
388 |             model = get_plugin_model(instance.plugin_type)  # Get original class
389 |             instance.__class__ = model  # Cast to correct model (including proxies)
390 |             plugin_lookup[instance.pk] = instance
391 | 
392 |     for plugin in plugins:
393 |         parent_not_available = not plugin.parent_id or plugin.parent_id not in plugin_ids
394 |         # The plugin either has no parent or needs to have a non-ghost parent
395 |         valid_parent = parent_not_available or plugin.parent_id in plugin_lookup
396 | 
397 |         if valid_parent and plugin.pk in plugin_lookup:
398 |             plugin._inst = plugin_lookup[plugin.pk]  # Populate bound plugin cache for plugin
399 |             yield plugin_lookup[plugin.pk]
```


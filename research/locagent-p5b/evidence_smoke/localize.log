28 | def _get_placeholder_cache_version_key(placeholder, lang, site_id):
29 |     """
30 |     Returns the version key for the given «placeholder», «lang» and «site_id».
31 | 
32 |     Invalidating this (via clear_placeholder_cache by replacing the stored
33 |     value with a new value) will effectively make all "sub-caches" relating to
34 |     this (placeholder x lang) inaccessible. Sub-caches include caches per TZ
35 |     and per VARY header.
36 |     """
37 |     prefix = get_cms_setting("CACHE_PREFIX")
38 |     key = f"{prefix}|placeholder_cache_version|id:{placeholder.pk}|lang:{str(lang)}|site:{site_id}"
39 |     # django itself adds "version" add the end of cache-keys, e.g. "<key>:1".
40 |     # -> If `cache.set()` is for example called with `version=""`, it still adds
41 |     #    `:` at the end. So if we check the length for `> 250`, a length of 249
42 |     #    or even 250 ends up in an InvalidCacheKey-exception.
43 |     # In order to avoid these errors, we hash the keys at a lower length to also
44 |     # have a little buffer.
45 |     if len(key) > 200:
46 |         key = "{prefix}|{hash}".format(
47 |             prefix=prefix,
48 |             hash=hashlib.sha1(key.encode("utf-8")).hexdigest(),
49 |         )
50 |     return key
```


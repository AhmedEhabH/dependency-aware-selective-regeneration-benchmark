402 | def downcast_plugins(
403 |     plugins: Iterable[CMSPlugin],
404 |     placeholders: Optional[list] = None,
405 |     select_placeholder: bool = False,
406 |     request: Optional[HttpRequest] = None,
407 | ) -> Iterable[CMSPlugin]:
408 |     """
409 |     Downcasts the given list of plugins to their respective classes. Ignores any plugins
410 |     that are not available.
411 | 
412 |     :param plugins: List of plugins to downcast.
413 |     :type plugins: List[CMSPlugin]
414 |     :param placeholders: List of placeholders associated with the plugins.
415 |     :type placeholders: Optional[List[Placeholder]]
416 |     :param select_placeholder: If True, select_related the plugin queryset with placeholder.
417 |     :type select_placeholder: bool
418 |     :param request: The current request.
419 |     :type request: Optional[HttpRequest]
420 |     :return: Generator that yields the downcasted plugins.
421 |     :rtype: Generator[CMSPlugin, None, None]
422 |     """
423 |     plugin_types_map = defaultdict(list)
424 |     plugin_lookup = {}
425 |     plugin_ids = []
426 | 
427 |     # make a map of plugin types, needed later for downcasting
428 |     for plugin in plugins:
429 |         # Keep track of the plugin ids we've received
430 |         try:
431 |             base_model = get_plugin_model(plugin.plugin_type)._meta.concrete_model  # Collect all base models
432 |         except KeyError:
433 |             # Plugin not available
434 |             logger.error(f"Plugin not installed: {plugin.plugin_type} (pk={plugin.pk})", exc_info=sys.exc_info())
435 |             continue
436 |         plugin_ids.append(plugin.pk)
437 |         if base_model is CMSPlugin:
438 |             plugin_lookup[plugin.pk] = plugin  # No downcast needed
439 |         else:
440 |             plugin_types_map[base_model].append(plugin.pk)
441 | 
442 |     placeholders = placeholders or []
443 |     placeholders_by_id = {placeholder.pk: placeholder for placeholder in placeholders}
444 | 
445 |     for plugin_model, pks in plugin_types_map.items():
446 |         # get all the plugins of type cls.model
447 |         plugin_qs = plugin_model.objects.filter(pk__in=pks)
448 | 
449 |         if select_placeholder:
450 |             plugin_qs = plugin_qs.select_related("placeholder")
451 | 
452 |         # put them in a map, so we can replace the base CMSPlugins with their
453 |         # downcasted versions
454 |         for instance in plugin_qs.iterator():
455 |             cls = get_plugin_class(instance.plugin_type)  # Plugin class
456 |             instance.__class__ = cls.model  # Cast to original model (including proxies)
457 |             plugin_lookup[instance.pk] = instance
458 | 
459 |     for plugin in plugins:
460 |         parent_not_available = not plugin.parent_id or plugin.parent_id not in plugin_ids
461 |         # The plugin either has no parent or needs to have a non-ghost parent
462 |         valid_parent = parent_not_available or plugin.parent_id in plugin_lookup
463 | 
464 |         if valid_parent and plugin.pk in plugin_lookup:
465 |             instance = plugin_lookup[plugin.pk]
466 |             if instance.parent_id in plugin_lookup:
467 |                 instance._state.fields_cache["parent"] = plugin_lookup[instance.parent_id]
468 |             placeholder = placeholders_by_id.get(instance.placeholder_id)
469 |             if placeholder:
470 |                 instance.placeholder = placeholder
471 |                 cls = get_plugin_class(instance.plugin_type)
472 |                 if not cls.cache and not cls().get_cache_expiration(request, instance, placeholder):
473 |                     placeholder.cache_placeholder = False
474 | 
475 |             plugin._inst = instance  # Populate bound plugin cache for plugin
476 |             yield instance
477 | 

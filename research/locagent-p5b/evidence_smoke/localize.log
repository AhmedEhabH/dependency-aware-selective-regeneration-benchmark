 29 |     def handle(self, *args, **options):
 30 |         """
 31 |         Repairs the tree
 32 |         """
 33 |         self.stdout.write('fixing page tree')
 34 |         Page.fix_tree()
 35 | 
 36 |         root_pages = Page.objects.filter(parent__isnull=True)
 37 | 
 38 |         last = None
 39 | 
 40 |         try:
 41 |             first = root_pages.order_by('path').first()
 42 |         except IndexError:
 43 |             first = None
 44 | 
 45 |         for page in root_pages.order_by('site__pk', 'path'):
 46 |             if last:
 47 |                 last.refresh_from_db()
 48 |                 page.refresh_from_db()
 49 |                 page.move(target=last, pos='right')
 50 |             elif first and first.pk != page.pk:
 51 |                 page.move(target=first, pos='left')
 52 |             last = page
 53 | 
 54 |         for root in root_pages.order_by('site__pk', 'path'):
 55 |             self._update_descendants_tree(root)
 56 | 
 57 |         self.stdout.write('fixing page URLs')
 58 |         for page in root_pages:
 59 |             for language in page.get_languages():
 60 |                 if not page.is_home:
 61 |                     page._update_url_path(language)
 62 |                 self._update_url_path_recursive(page, language)
 63 | 
 64 |         self.stdout.write('all done')

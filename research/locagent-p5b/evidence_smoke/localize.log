246 | def copy_plugins_to_placeholder(plugins, placeholder, language=None, root_plugin=None, start_positions=None):
247 |     """Copies an iterable of plugins to a placeholder
248 | 
249 |     :param iterable plugins: Plugins to be copied
250 |     :param placeholder: Target placeholder
251 |     :type placeholder: :class:`cms.models.placeholdermodel.Placeholder` instance
252 |     :param str language: target language (if no root plugin is given)
253 |     :param root_plugin:
254 |     :type placeholder: :class:`cms.models.pluginmodel.CMSPlugin` instance
255 |     :param int start_positions: Cache for start positions by language
256 | 
257 |     The logic of this method is the following:
258 | 
259 |     #. Get bound plugins for each source plugin
260 |     #. Get the parent plugin (if it exists)
261 |     #. then get a copy of the source plugin instance
262 |     #. Set the id/pk to None to it the id of the generic plugin instance above;
263 |        this will effectively change the generic plugin created above
264 |        into a concrete one
265 |     #. find the position in the new placeholder
266 |     #. save the concrete plugin (which creates a new plugin in the database)
267 |     #. trigger the copy relations
268 |     #. return the plugin ids
269 |     """
270 |     plugin_pairs = []
271 |     plugins_by_id = OrderedDict()
272 |     # Keeps track of the next available position per language.
273 |     positions_by_language = {}
274 |     orphaned_plugin_list = []
275 | 
276 |     if start_positions:
277 |         positions_by_language.update(start_positions)
278 | 
279 |     if root_plugin:
280 |         language = root_plugin.language
281 | 
282 |     for source_plugin in get_bound_plugins(plugins):
283 |         parent = plugins_by_id.get(source_plugin.parent_id, root_plugin)
284 |         plugin_model = source_plugin.__class__  # get_plugin_model(source_plugin.plugin_type)
285 | 
286 |         if plugin_model is not CMSPlugin:
287 |             new_plugin = deepcopy(source_plugin)
288 |             new_plugin.pk = None
289 |             new_plugin.id = None
290 |             new_plugin.language = language or new_plugin.language
291 |             new_plugin.placeholder = placeholder
292 |             new_plugin.parent = parent
293 |         else:
294 |             new_plugin = CMSPlugin(
295 |                 language=(language or source_plugin.language),
296 |                 parent=parent,
297 |                 plugin_type=source_plugin.plugin_type,
298 |                 placeholder=placeholder,
299 |             )
300 | 
301 |         try:
302 |             position = positions_by_language[new_plugin.language]
303 |         except KeyError:
304 |             offset = placeholder.get_last_plugin_position(language) or 0
305 |             # The position is relative to language.
306 |             position = placeholder.get_next_plugin_position(
307 |                 language=new_plugin.language,
308 |                 parent=new_plugin.parent,
309 |                 insert_order="last",
310 |             )
311 |             # Because it is the first time this language is processed,
312 |             # shift all plugins to the right of the next position.
313 |             placeholder._shift_plugin_positions(
314 |                 language,
315 |                 start=position,
316 |                 offset=offset,
317 |             )
318 | 
319 |         new_plugin.position = position
320 |         new_plugin.save()
321 |         positions_by_language[new_plugin.language] = position + 1
322 | 
323 |         if plugin_model != CMSPlugin:
324 |             new_plugin.copy_relations(source_plugin)
325 |             plugin_pairs.append((new_plugin, source_plugin))
326 |         plugins_by_id[source_plugin.pk] = new_plugin
327 | 
328 |         # Rescue any orphaned plugins
329 |         if not parent and source_plugin.parent_id:
330 |             orphaned_plugin_list.append((source_plugin.parent_id, new_plugin))
331 | 
332 |     # Reunite any orphaned plugins with the parent
333 |     if orphaned_plugin_list:
334 |         _reunite_orphaned_placeholder_plugin_children(root_plugin, orphaned_plugin_list, plugins_by_id)
335 | 
336 |     # Backwards compatibility
337 |     # This magic is needed for advanced plugins like Text Plugins that can have
338 |     # nested plugins and need to update their content based on the new plugins.
339 |     for new_plugin, old_plugin in plugin_pairs:
340 |         new_plugin.post_copy(old_plugin, plugin_pairs)
341 | 
342 |     for language in positions_by_language:
343 |         placeholder._recalculate_plugin_positions(language)
344 | 
345 |     return list(plugins_by_id.values())

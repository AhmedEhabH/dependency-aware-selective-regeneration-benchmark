 565 |     def _has_add_permission_from_request(self, request):
 566 |         site = self.get_site(request)
 567 |         parent_node_id = request.GET.get('parent_node', None)
 568 | 
 569 |         if parent_node_id:
 570 |             try:
 571 |                 parent_node = PageNode.objects.get(pk=parent_node_id)
 572 |             except Page.DoesNotExist:
 573 |                 return False
 574 |         else:
 575 |             parent_node = None
 576 | 
 577 |         if parent_node:
 578 |             has_perm = page_permissions.user_can_add_subpage(
 579 |                 request.user,
 580 |                 target=parent_node.page,
 581 |                 site=site,
 582 |             )
 583 |         else:
 584 |             has_perm = page_permissions.user_can_add_page(request.user, site=site)
 585 |         return has_perm

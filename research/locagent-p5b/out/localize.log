452 |     def delete_model(self, request, obj):
453 |         operation_token = send_pre_page_operation(
454 |             request=request,
455 |             operation=operations.DELETE_PAGE,
456 |             obj=obj,
457 |             sender=self.model
458 |         )
459 | 
460 |         cms_pages = [obj]
461 | 
462 |         if obj.node.is_branch:
463 |             nodes = obj.node.get_descendants()
464 |             cms_pages.extend(self.model.objects.filter(node__in=nodes))
465 | 
466 |         # Delete all of the pages titles contents
467 |         ct_page_content = ContentType.objects.get_for_model(PageContent)
468 |         page_content_objs = PageContent.objects.filter(page__in=cms_pages)
469 |         placeholders = Placeholder.objects.filter(
470 |             content_type=ct_page_content,
471 |             object_id__in=page_content_objs,
472 |         )
473 |         plugins = CMSPlugin.objects.filter(placeholder__in=placeholders)
474 |         QuerySet.delete(plugins)
475 |         placeholders.delete()
476 | 
477 |         super(PageAdmin, self).delete_model(request, obj)
478 | 
479 |         send_post_page_operation(
480 |             request=request,
481 |             operation=operations.DELETE_PAGE,
482 |             token=operation_token,
483 |             obj=obj,
484 |             sender=self.model,
485 |         )
486 | 
487 |         clear_permission_cache()
488 | 
489 |         if obj.application_urls:
490 |             set_restart_trigger()

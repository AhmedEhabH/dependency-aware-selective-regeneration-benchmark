 620 |     def clean(self):
 621 |         cleaned_data = super(AdvancedSettingsForm, self).clean()
 622 | 
 623 |         if self._errors:
 624 |             # Fail fast if there's errors in the form
 625 |             return cleaned_data
 626 | 
 627 |         # Language has been validated already
 628 |         # so we know it exists.
 629 |         language_name = get_language_object(
 630 |             self._language,
 631 |             site_id=self.instance.site_id,
 632 |         )['name']
 633 | 
 634 |         if not self.title_obj.slug:
 635 |             # This covers all cases where users try to edit
 636 |             # page advanced settings without setting a title slug
 637 |             # for page titles that already exist.
 638 |             message = _("Please set the %(language)s slug "
 639 |                         "before editing its advanced settings.")
 640 |             raise ValidationError(message % {'language': language_name})
 641 | 
 642 |         if 'reverse_id' in self.fields:
 643 |             id = cleaned_data['reverse_id']
 644 |             site_id = self.instance.site_id
 645 |             if id:
 646 |                 if Page.objects.filter(reverse_id=id, site=site_id, publisher_is_draft=True).exclude(
 647 |                         pk=self.instance.pk).exists():
 648 |                     self._errors['reverse_id'] = self.error_class(
 649 |                         [_('A page with this reverse URL id exists already.')])
 650 |         apphook = cleaned_data.get('application_urls', None)
 651 |         # The field 'application_namespace' is a misnomer. It should be
 652 |         # 'instance_namespace'.
 653 |         instance_namespace = cleaned_data.get('application_namespace', None)
 654 |         application_config = cleaned_data.get('application_configs', None)
 655 |         if apphook:
 656 |             # application_config wins over application_namespace
 657 |             if application_config:
 658 |                 # the value of the application config namespace is saved in
 659 |                 # the 'usual' namespace field to be backward compatible
 660 |                 # with existing apphooks
 661 |                 config = apphook_pool.get_apphook(apphook).get_configs().get(pk=int(application_config))
 662 |                 if self._check_unique_namespace_instance(config.namespace):
 663 |                     # Looks like there's already one with the default instance
 664 |                     # namespace defined.
 665 |                     self._errors['application_configs'] = ErrorList([
 666 |                         _('An application instance using this configuration already exists.')
 667 |                     ])
 668 |                 else:
 669 |                     self.cleaned_data['application_namespace'] = config.namespace
 670 |             else:
 671 |                 if instance_namespace:
 672 |                     if self._check_unique_namespace_instance(instance_namespace):
 673 |                         self._errors['application_namespace'] = ErrorList([
 674 |                             _('An application instance with this name already exists.')
 675 |                         ])
 676 |                 else:
 677 |                     # The attribute on the apps 'app_name' is a misnomer, it should be
 678 |                     # 'application_namespace'.
 679 |                     application_namespace = apphook_pool.get_apphook(apphook).app_name
 680 |                     if application_namespace and not instance_namespace:
 681 |                         if self._check_unique_namespace_instance(application_namespace):
 682 |                             # Looks like there's already one with the default instance
 683 |                             # namespace defined.
 684 |                             self._errors['application_namespace'] = ErrorList([
 685 |                                 _('An application instance with this name already exists.')
 686 |                             ])
 687 |                         else:
 688 |                             # OK, there are zero instances of THIS app that use the
 689 |                             # default instance namespace, so, since the user didn't
 690 |                             # provide one, we'll use the default. NOTE: The following
 691 |                             # line is really setting the "instance namespace" of the
 692 |                             # new app to the app’s "application namespace", which is
 693 |                             # the default instance namespace.
 694 |                             self.cleaned_data['application_namespace'] = application_namespace
 695 | 
 696 |         if instance_namespace and not apphook:
 697 |             self.cleaned_data['application_namespace'] = None
 698 | 
 699 |         if application_config and not apphook:
 700 |             self.cleaned_data['application_configs'] = None
 701 |         return self.cleaned_data
 702 | 

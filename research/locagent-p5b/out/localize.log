259 | class Placeholder(Tag):
260 |     """
261 |     This template node is used to output page content and
262 |     is also used in the admin to dynamically generate input fields.
263 | 
264 |     eg: {% placeholder "placeholder_name" %}
265 | 
266 |     {% placeholder "sidebar" inherit %}
267 | 
268 |     {% placeholder "footer" inherit or %}
269 |         <a href="/about/">About us</a>
270 |     {% endplaceholder %}
271 | 
272 |     Keyword arguments:
273 |     name -- the name of the placeholder
274 |     inherit -- optional argument which if given will result in inheriting
275 |         the content of the placeholder with the same name on parent pages
276 |     or -- optional argument which if given will make the template tag a block
277 |         tag whose content is shown if the placeholder is empty
278 |     """
279 |     name = 'placeholder'
280 |     options = PlaceholderOptions(
281 |         Argument('name', resolve=False),
282 |         MultiValueArgument('extra_bits', required=False, resolve=False),
283 |         blocks=[
284 |             ('endplaceholder', 'nodelist'),
285 |         ],
286 |     )
287 | 
288 |     def render_tag(self, context, name, extra_bits, nodelist=None):
289 |         request = context.get('request')
290 | 
291 |         if not request:
292 |             return ''
293 | 
294 |         validate_placeholder_name(name)
295 | 
296 |         toolbar = get_toolbar_from_request(request)
297 |         renderer = toolbar.get_content_renderer()
298 |         inherit = 'inherit' in extra_bits
299 | 
300 |         try:
301 |             content = renderer.render_obj_placeholder(
302 |                 slot=name,
303 |                 context=context,
304 |                 inherit=inherit,
305 |                 nodelist=nodelist,
306 |             )
307 |         except PlaceholderNotFound:
308 |             content = ''
309 | 
310 |         if not content and nodelist:
311 |             return nodelist.render(context)
312 |         return content
313 | 
314 |     def get_declaration(self):
315 |         flags = self.kwargs['extra_bits']
316 |         slot = self.kwargs['name'].var.value.strip('"').strip("'")
317 | 
318 |         if isinstance(flags, ListValue):
319 |             inherit = any(extra.var.value.strip() == 'inherit' for extra in flags)
320 |             return DeclaredPlaceholder(slot=slot, inherit=inherit)
321 |         return DeclaredPlaceholder(slot=slot, inherit=False)

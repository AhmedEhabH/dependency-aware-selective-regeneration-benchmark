 122 |                 saved_successfully = True
 123 |         else:
 124 |             form = form_class(instance=obj)
 125 |         admin_form = AdminForm(form, fieldsets=[(None, {'fields': fields})], prepopulated_fields={},
 126 |                                model_admin=self)
 127 |         media = self.media + admin_form.media
 128 |         context = {
 129 |             'CMS_MEDIA_URL': get_cms_setting('MEDIA_URL'),
 130 |             'title': opts.verbose_name,
 131 |             'plugin': None,
 132 |             'plugin_id': None,
 133 |             'adminform': admin_form,
 134 |             'add': False,
 135 |             'is_popup': True,
 136 |             'media': media,
 137 |             'opts': opts,
 138 |             'change': True,
 139 |             'save_as': False,
 140 |             'has_add_permission': False,
 141 |             'window_close_timeout': 10,
 142 |         }
 143 |         if cancel_clicked:
 144 |             # cancel button was clicked
 145 |             context.update({
 146 |                 'cancel': True,
 147 |             })
 148 |             return render(request, 'admin/cms/page/plugin/confirm_form.html', context)
 149 |         if not cancel_clicked and request.method == 'POST' and saved_successfully:
 150 |             return render(request, 'admin/cms/page/plugin/confirm_form.html', context)
 151 |         return render(request, 'admin/cms/page/plugin/change_form.html', context)

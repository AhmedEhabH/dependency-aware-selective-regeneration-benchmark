 44 | class ForwardOneToOneDescriptor(ForwardManyToOneDescriptor):
 45 |     """
 46 |     Accessor to the related object on the forward side
 47 |     of a one-to-one relation.
 48 | 
 49 |     In the example::
 50 | 
 51 |         class MyPlugin(CMSPlugin):
 52 |             cmsplugin_ptr = ForeignKey(CMSPlugin, parent_link=True)
 53 | 
 54 |     ``myplugin.cmsplugin_ptr`` is a ``ForwardOneToOneDescriptor`` instance.
 55 |     """
 56 | 
 57 |     # This class is necessary to backport the following Django fix
 58 |     # https://github.com/django/django/commit/38575b007a722d6af510ea46d46393a4cda9ca29
 59 |     # into the CMS.
 60 | 
 61 |     def get_inherited_object(self, instance):
 62 |         """
 63 |         Returns an instance of the subclassed model
 64 |         in a multi-table inheritance scenario.
 65 |         """
 66 |         # This is an exact copy of the code for get_object()
 67 |         # provided in the commit above.
 68 |         deferred = instance.get_deferred_fields()
 69 |         # Because it's a parent link, all the data is available in the
 70 |         # instance, so populate the parent model with this data.
 71 |         rel_model = self.field.rel.model
 72 |         fields = [field.attname for field in rel_model._meta.concrete_fields]
 73 | 
 74 |         # If any of the related model's fields are deferred, fallback to
 75 |         # fetching all fields from the related model. This avoids a query
 76 |         # on the related model for every deferred field.
 77 |         if not any(field in fields for field in deferred):
 78 |             kwargs = {field: getattr(instance, field) for field in fields}
 79 |             return rel_model(**kwargs)
 80 |         return
 81 | 
 82 |     def __get__(self, instance, instance_type=None):
 83 |         if instance is None:
 84 |             return self
 85 | 
 86 |         if not hasattr(instance, self.cache_name):
 87 |             # No cached object is present on the instance.
 88 |             val = self.field.get_local_related_value(instance)
 89 | 
 90 |             if None not in val:
 91 |                 # Fetch the inherited object instance
 92 |                 # using values from the current instance.
 93 |                 # This avoids an extra db call because we already
 94 |                 # have the data.
 95 |                 # This can be None if a field from the base class (CMSPlugin)
 96 |                 # was deferred.
 97 |                 rel_obj = self.get_inherited_object(instance)
 98 | 
 99 |                 if not rel_obj is None:
100 |                     # Populate the internal relationship cache.
101 |                     setattr(instance, self.cache_name, rel_obj)
102 |         return super(ForwardOneToOneDescriptor, self).__get__(instance, instance_type)

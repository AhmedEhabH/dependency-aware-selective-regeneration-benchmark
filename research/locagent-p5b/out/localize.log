195 | def _get_app_patterns(site):
196 |     """
197 |     Get a list of patterns for all hooked apps.
198 | 
199 |     How this works:
200 | 
201 |     By looking through all titles with an app hook (application_urls) we find
202 |     all urlconf modules we have to hook into titles.
203 | 
204 |     If we use the ML URL Middleware, we namespace those patterns with the title
205 |     language.
206 | 
207 |     All 'normal' patterns from the urlconf get re-written by prefixing them with
208 |     the title path and then included into the cms url patterns.
209 | 
210 |     If the app is still configured, but is no longer installed/available, then
211 |     this method returns a degenerate patterns object: patterns('')
212 |     """
213 |     from cms.models.pagemodel import PageUrl
214 | 
215 |     included = []
216 |     hooked_applications = OrderedDict()
217 | 
218 |     # we don't have a request here so get_page_queryset() can't be used,
219 |     # so use public() queryset.
220 |     # This can be done because url patterns are used just in frontend
221 |     page_urls = PageUrl.objects.get_for_site(site)
222 | 
223 |     # Loop over all titles with an application hooked to them
224 |     page_urls = (
225 |         page_urls
226 |         .exclude(page__application_urls=None)
227 |         .exclude(page__application_urls='')
228 |         .order_by('-page__node__path')
229 |         .select_related('page')
230 |     )
231 | 
232 |     for page_url in page_urls:
233 |         mix_id = "%s:%s:%s" % (
234 |             page_url.path + "/",
235 |             page_url.page.application_urls,
236 |             page_url.language,
237 |         )
238 | 
239 |         if mix_id in included:
240 |             # don't add the same thing twice
241 |             continue
242 |         app = apphook_pool.get_apphook(page_url.page.application_urls)
243 |         if not app:
244 |             continue
245 |         if page_url.page_id not in hooked_applications:
246 |             hooked_applications[page_url.page_id] = {}
247 |         app_ns = app.app_name, page_url.page.application_namespace
248 |         with override(page_url.language):
249 |             hooked_applications[page_url.page_id][page_url.language] = (
250 |                 app_ns, get_patterns_for_page_url(page_url), app)
251 |         included.append(mix_id)
252 |         # Build the app patterns to be included in the cms urlconfs
253 |     app_patterns = []
254 |     for page_id in hooked_applications.keys():
255 |         resolver = None
256 |         for lang in hooked_applications[page_id].keys():
257 |             (app_ns, inst_ns), current_patterns, app = hooked_applications[page_id][lang]  # nopyflakes
258 |             if not resolver:
259 |                 regex_pattern = RegexPattern(r'') if not DJANGO_1_11 else r''
260 |                 resolver = AppRegexURLResolver(
261 |                     regex_pattern, 'app_resolver', app_name=app_ns, namespace=inst_ns)
262 |                 resolver.page_id = page_id
263 |             if app.permissions:
264 |                 _set_permissions(current_patterns, app.exclude_permissions)
265 | 
266 |             resolver.url_patterns_dict[lang] = current_patterns
267 |         app_patterns.append(resolver)
268 |         APP_RESOLVERS.append(resolver)
269 |     return app_patterns

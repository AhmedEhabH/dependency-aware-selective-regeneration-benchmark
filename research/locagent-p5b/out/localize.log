 570 |     @require_POST
 571 |     @transaction.atomic
 572 |     def move_page(self, request, page_id, extra_context=None):
 573 |         """
 574 |         Move the page to the requested target, at the given position.
 575 | 
 576 |         NOTE: We have to change from one "coordinate system" to another to
 577 |         adapt JSTree to Django Treebeard.
 578 | 
 579 |         If the Tree looks like this:
 580 | 
 581 |             <root>
 582 |                ⊢ …
 583 |                ⊢ …
 584 |                ⊢ Page 4
 585 |                    ⊢ Page 5 (position 0)
 586 |                    ⊢ …
 587 | 
 588 |         For example,
 589 |             target=4, position=1 => target=5, position="right"
 590 |             target=4, position=0 => target=4, position="first-child"
 591 | 
 592 |         """
 593 |         site = get_site(request)
 594 |         page = self.get_object(request, object_id=page_id)
 595 | 
 596 |         if page is None:
 597 |             return jsonify_request(HttpResponseBadRequest("error"))
 598 | 
 599 |         user = request.user
 600 |         form = self.move_form(request.POST or None, page=page, site=site)
 601 | 
 602 |         if not form.is_valid():
 603 |             return jsonify_request(HttpResponseBadRequest("error"))
 604 | 
 605 |         target = form.cleaned_data['target']
 606 |         can_move_page = self.has_move_page_permission(request, obj=page)
 607 | 
 608 |         # Does the user have permissions to do this...?
 609 |         if not can_move_page or (target and not target.has_add_permission(user)):
 610 |             message = force_text(_("Error! You don't have permissions "
 611 |                                    "to move this page. Please reload the page"))
 612 |             return jsonify_request(HttpResponseForbidden(message))
 613 | 
 614 |         operation_token = send_pre_page_operation(
 615 |             request=request,
 616 |             operation=operations.MOVE_PAGE,
 617 |             obj=page,
 618 |             sender=self.model,
 619 |         )
 620 | 
 621 |         form.move_page()
 622 | 
 623 |         send_post_page_operation(
 624 |             request=request,
 625 |             operation=operations.MOVE_PAGE,
 626 |             token=operation_token,
 627 |             obj=page,
 628 |             sender=self.model,
 629 |         )
 630 |         return jsonify_request(HttpResponse(status=200))
 631 | 
 632 |     def get_permissions(self, request, page_id):
 633 |         rows = []
 634 |         user = request.user
 635 |         page = self.get_object(request, object_id=page_id)
 636 | 
 637 |         if page is None:
 638 |             raise self._get_404_exception(page_id)
 639 | 
 640 |         site = get_site(request)
 641 |         PermissionRow = namedtuple('Permission', ['is_global', 'can_change', 'permission'])
 642 | 
 643 |         global_permissions = GlobalPagePermission.objects.filter(sites__in=[site.pk])
 644 |         can_change_global_permissions = permissions.user_can_change_global_permissions(user, site)
 645 | 
 646 |         for permission in global_permissions.iterator():
 647 |             row = PermissionRow(
 648 |                 is_global=True,
 649 |                 can_change=can_change_global_permissions,
 650 |                 permission=permission,
 651 |             )
 652 |             rows.append(row)
 653 | 
 654 |         _page_permissions = (
 655 |             PagePermission
 656 |             .objects
 657 |             .for_page(page)
 658 |             .select_related('page')
 659 |         )
 660 | 
 661 |         if not can_change_global_permissions:
 662 |             allowed_pages = frozenset(page_permissions.get_change_id_list(user, site, check_global=False))
 663 | 
 664 |         for permission in _page_permissions.iterator():
 665 |             if can_change_global_permissions:
 666 |                 can_change = True
 667 |             else:
 668 |                 can_change = permission.page_id in allowed_pages
 669 | 
 670 |             row = PermissionRow(
 671 |                 is_global=False,
 672 |                 can_change=can_change,
 673 |                 permission=permission,
 674 |             )
 675 |             rows.append(row)
 676 | 
 677 |         context = {
 678 |             'page': page,
 679 |             'rows': rows,
 680 |             'opts': self.opts,
 681 |         }
 682 |         return render(request, 'admin/cms/page/permissions.html', context)
 683 | 
 684 |     @require_POST
 685 |     @transaction.atomic
 686 |     def copy_page(self, request, page_id):
 687 |         """
 688 |         Copy the page and all its plugins and descendants to the requested
 689 |         target, at the given position
 690 |         """
 691 |         page = self.get_page_from_id(page_id)
 692 | 
 693 |         if page is None:
 694 |             return jsonify_request(HttpResponseBadRequest("error"))
 695 | 
 696 |         user = request.user
 697 |         site = get_site(request)
 698 |         form = self.copy_form(request.POST or None, page=page, site=site)
 699 | 
 700 |         if not form.is_valid():
 701 |             return jsonify_request(HttpResponseBadRequest("error"))
 702 | 
 703 |         target = form.cleaned_data['target']
 704 |         source_site = form.cleaned_data['source_site']
 705 | 
 706 |         # User can only copy pages he can see
 707 |         can_copy_page = page_permissions.user_can_view_page(user, page, source_site)
 708 | 
 709 |         if can_copy_page and target:
 710 |             # User can only copy a page into another one if he has permission
 711 |             # to add a page under the target page.
 712 |             can_copy_page = page_permissions.user_can_add_subpage(user, target, site)
 713 |         elif can_copy_page:
 714 |             # User can only copy / paste a page if he has permission to add a page
 715 |             can_copy_page = page_permissions.user_can_add_page(user, site)
 716 | 
 717 |         if not can_copy_page:
 718 |             message = force_text(_("Error! You don't have permissions to copy this page."))
 719 |             return jsonify_request(HttpResponseForbidden(message))
 720 | 
 721 |         page_languages = page.get_languages()
 722 |         site_languages = get_language_list(site_id=site.pk)
 723 | 
 724 |         if not any(lang in  page_languages for lang in site_languages):
 725 |             message = force_text(_("Error! The page you're pasting is not "
 726 |                                    "translated in any of the languages configured by the target site."))
 727 |             return jsonify_request(HttpResponseBadRequest(message))
 728 | 
 729 |         new_page = form.copy_page()
 730 |         return HttpResponse(json.dumps({"id": new_page.pk}), content_type='application/json')
 731 | 
 732 |     def resolve(self, request):
 733 |         if not request.user.is_staff:
 734 |             return HttpResponse('/', content_type='text/plain')
 735 |         obj = False
 736 |         url = False
 737 |         if request.session.get('cms_log_latest', False):
 738 |             log = LogEntry.objects.get(pk=request.session['cms_log_latest'])
 739 |             try:
 740 |                 obj = log.get_edited_object()
 741 |             except (ObjectDoesNotExist, ValueError):
 742 |                 obj = None
 743 |             del request.session['cms_log_latest']
 744 |             if obj and obj.__class__ in toolbar_pool.get_watch_models() and hasattr(obj, 'get_absolute_url'):
 745 |                 # This is a test if the object url can be retrieved
 746 |                 # In case it can't, object it's not taken into account
 747 |                 try:
 748 |                     force_text(obj.get_absolute_url())
 749 |                 except:
 750 |                     obj = None
 751 |             else:
 752 |                 obj = None
 753 |         if not obj:
 754 |             pk = request.GET.get('pk', False) or request.POST.get('pk', False)
 755 |             full_model = request.GET.get('model') or request.POST.get('model', False)
 756 |             if pk and full_model:
 757 |                 app_label, model = full_model.split('.')
 758 |                 if pk and app_label:
 759 |                     ctype = ContentType.objects.get(app_label=app_label, model=model)
 760 |                     try:
 761 |                         obj = ctype.get_object_for_this_type(pk=pk)
 762 |                     except ctype.model_class().DoesNotExist:
 763 |                         obj = None
 764 |                     try:
 765 |                         force_text(obj.get_absolute_url())
 766 |                     except:
 767 |                         obj = None
 768 |         if obj:
 769 |             if not getattr(request, 'toolbar', False) or not getattr(request.toolbar, 'edit_mode_active', False):
 770 |                 if isinstance(obj, Page):
 771 |                     url = get_object_edit_url(obj.get_title_obj())
 772 |                 else:
 773 |                     url = obj.get_absolute_url()
 774 |             else:
 775 |                 url = obj.get_absolute_url()
 776 |         if url:
 777 |             return HttpResponse(force_text(url), content_type='text/plain')
 778 |         return HttpResponse('', content_type='text/plain')

 740 |         public_id = self.instance.publisher_public_id
 741 |         self._meta.model.objects.filter(pk=public_id).update(
 742 |             application_urls=self.instance.application_urls,
 743 |             application_namespace=(self.instance.application_namespace or None),
 744 |         )
 745 | 
 746 |         # Connects the apphook restart handler to the request finished signal
 747 |         set_restart_trigger()

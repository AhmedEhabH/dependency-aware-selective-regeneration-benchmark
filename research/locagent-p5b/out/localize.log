 773 | class PageTreeForm(forms.Form):
 774 | 
 775 |     position = forms.IntegerField(initial=0, required=True)
 776 |     target = forms.ModelChoiceField(queryset=Page.objects.none(), required=False)
 777 | 
 778 |     def __init__(self, *args, **kwargs):
 779 |         self.page = kwargs.pop('page')
 780 |         self._site = kwargs.pop('site', Site.objects.get_current())
 781 |         super(PageTreeForm, self).__init__(*args, **kwargs)
 782 |         self.fields['target'].queryset = Page.objects.drafts().filter(nodes__site=self._site)
 783 | 
 784 |     def get_parent_node(self, site):
 785 |         target_page = self.cleaned_data.get('target')
 786 | 
 787 |         if target_page:
 788 |             return target_page.get_node_object(site)
 789 |         return
 790 | 
 791 |     def get_tree_options(self):
 792 |         position = self.cleaned_data['position']
 793 |         parent_node = self.get_parent_node(self._site)
 794 | 
 795 |         if parent_node:
 796 |             return self._get_tree_options_for_parent(parent_node, position)
 797 |         return self._get_tree_options_for_root(position)
 798 | 
 799 |     def _get_tree_options_for_root(self, position):
 800 |         siblings = PageNode.get_root_nodes().filter(site=self._site)
 801 | 
 802 |         try:
 803 |             target_node = siblings[position]
 804 |         except IndexError:
 805 |             # The position requested is not occupied.
 806 |             # Add the node as the last root node,
 807 |             # relative to the current site.
 808 |             return (siblings.reverse()[0], 'right')
 809 |         return (target_node, 'left')
 810 | 
 811 |     def _get_tree_options_for_parent(self, parent_node, position):
 812 |         if position == 0:
 813 |             return (parent_node, 'first-child')
 814 | 
 815 |         siblings = parent_node.get_children().filter(site=self._site)
 816 | 
 817 |         try:
 818 |             target_node = siblings[position]
 819 |         except IndexError:
 820 |             # The position requested is not occupied.
 821 |             # Add the node to be the parent's first child
 822 |             return (parent_node, 'last-child')
 823 |         return (target_node, 'left')
 824 | 
 825 | 
 826 | class MovePageForm(PageTreeForm):
 827 | 
 828 |     def get_tree_options(self):
 829 |         options = super(MovePageForm, self).get_tree_options()
 830 |         target_node, target_node_position = options
 831 | 
 832 |         if target_node_position != 'left':
 833 |             return (target_node, target_node_position)
 834 | 
 835 |         node = self.page.get_node_object(self._site)
 836 |         node_is_first = node.path < target_node.path
 837 | 
 838 |         if node_is_first and node.is_sibling_of(target_node):
 839 |             # The node being moved appears before the target node
 840 |             # and is a sibling of the target node.
 841 |             # The user is moving from left to right.
 842 |             target_node_position = 'right'
 843 |         elif node_is_first:
 844 |             # The node being moved appears before the target node
 845 |             # but is not a sibling of the target node.
 846 |             # The user is moving from right to left.
 847 |             target_node_position = 'left'
 848 |         else:
 849 |             # The node being moved appears after the target node.
 850 |             # The user is moving from right to left.
 851 |             target_node_position = 'left'
 852 |         return (target_node, target_node_position)
 853 | 
 854 |     def move_page(self):
 855 |         self.page.move_page(*self.get_tree_options())
 856 | 

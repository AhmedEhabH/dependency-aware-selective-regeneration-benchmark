 284 |     @xframe_options_sameorigin
 285 |     def add_plugin(self, request):
 286 |         """
 287 |         Shows the add plugin form and saves it on POST.
 288 | 
 289 |         Requires the following GET parameters:
 290 |             - cms_path
 291 |             - placeholder_id
 292 |             - plugin_type
 293 |             - plugin_language
 294 |             - plugin_parent (optional)
 295 |             - plugin_position (optional)
 296 |         """
 297 |         form = PluginAddValidationForm(request.GET)
 298 | 
 299 |         if not form.is_valid():
 300 |             # list() is necessary for python 3 compatibility.
 301 |             # errors is s dict mapping fields to a list of errors
 302 |             # for that field.
 303 |             error = list(form.errors.values())[0][0]
 304 |             return HttpResponseBadRequest(force_text(error))
 305 | 
 306 |         plugin_data = form.cleaned_data
 307 |         placeholder = plugin_data['placeholder_id']
 308 |         plugin_type = plugin_data['plugin_type']
 309 | 
 310 |         if not self.has_add_plugin_permission(request, placeholder, plugin_type):
 311 |             message = force_text(_('You do not have permission to add a plugin'))
 312 |             return HttpResponseForbidden(message)
 313 | 
 314 |         parent = plugin_data.get('plugin_parent')
 315 | 
 316 |         if parent:
 317 |             position = parent.cmsplugin_set.count()
 318 |         else:
 319 |             position = CMSPlugin.objects.filter(
 320 |                 parent__isnull=True,
 321 |                 language=plugin_data['plugin_language'],
 322 |                 placeholder=placeholder,
 323 |             ).count()
 324 | 
 325 |         plugin_data['position'] = position
 326 | 
 327 |         plugin_class = plugin_pool.get_plugin(plugin_type)
 328 |         plugin_instance = plugin_class(plugin_class.model, self.admin_site)
 329 | 
 330 |         # Setting attributes on the form class is perfectly fine.
 331 |         # The form class is created by modelform factory every time
 332 |         # this get_form() method is called.
 333 |         plugin_instance._cms_initial_attributes = {
 334 |             'language': plugin_data['plugin_language'],
 335 |             'placeholder': plugin_data['placeholder_id'],
 336 |             'parent': plugin_data.get('plugin_parent', None),
 337 |             'plugin_type': plugin_data['plugin_type'],
 338 |             'position': plugin_data['position'],
 339 |         }
 340 | 
 341 |         response = plugin_instance.add_view(request)
 342 | 
 343 |         plugin = getattr(plugin_instance, 'saved_object', None)
 344 | 
 345 |         if plugin_instance._operation_token:
 346 |             tree_order = placeholder.get_plugin_tree_order(plugin.parent_id)
 347 |             self._send_post_placeholder_operation(
 348 |                 request,
 349 |                 operation=operations.ADD_PLUGIN,
 350 |                 token=plugin_instance._operation_token,
 351 |                 plugin=plugin,
 352 |                 placeholder=plugin.placeholder,
 353 |                 tree_order=tree_order,
 354 |             )
 355 |         return response

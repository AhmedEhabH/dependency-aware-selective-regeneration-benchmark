 143 |     def __init__(self, *args, **kwargs):
 144 |         super().__init__(*args, **kwargs)
 145 |         self.urls_cache = {}
 146 |         self.page_content_cache = {}
 147 |         #: Internal cache for page content objects visible publicly
 148 |         self.admin_content_cache = AdminCacheDict()
 149 |         #: Internal cache for page content objects visible in the admin (i.e. to staff users.)
 150 |         #: Might be larger than the page_content_cache

27 | def applications_page_check(request):
28 |     """Tries to find if given path was resolved over application.
29 |     Applications have higher priority than other cms pages.
30 |     """
31 |     # We should get in this branch only if an apphook is active on /
32 |     # This removes the non-CMS part of the URL.
33 |     path = request.path_info.replace(reverse('pages-root'), '', 1)
34 | 
35 |     # check if application resolver can resolve this
36 |     for lang in get_language_list():
37 |         if path.startswith(lang + "/"):
38 |             path = path[len(lang + "/"):]
39 | 
40 |     for resolver in APP_RESOLVERS:
41 |         try:
42 |             page_id = resolver.resolve_page_id(path)
43 |             return Page.objects.get(id=page_id)
44 |         except Resolver404:
45 |             # Raised if the page is not managed by an apphook
46 |             pass
47 |         except Page.DoesNotExist:
48 |             pass
49 |     return None

114 | class FileSectionWrapper(FileOutputWrapper):
115 |     """
116 |     Used from FileOutputWrapper to report checks in a section.
117 | 
118 |     If you want to provide your own output class, you may want to subclass
119 |     this class for the section reporting too. If you want to use your own,
120 |     you must defined at least the same API as FileOutputWrapper, as well
121 |     as these four additional methods:
122 | 
123 |         finish_success(message): End the section (successfully)
124 |         finish_error(message): End the section with errors
125 |         finish_warning(message): End this section with a warning
126 |         finish_skip(message): End this (skipped) section
127 |     """
128 |     def __init__(self, wrapper):
129 |         super(FileSectionWrapper, self).__init__(wrapper.stdout, wrapper.stderr)
130 |         self.wrapper = wrapper
131 | 
132 |     def write_line(self, message=''):
133 |         self.write(u'  - %s\n' % message)
134 | 
135 |     def write_stderr_line(self, message=''):
136 |         self.write_stderr(u'  - %s\n' % message)
137 | 
138 |     def finish_success(self, message):
139 |         self.wrapper.write_line()
140 |         self.wrapper.success(message)
141 | 
142 |     def finish_error(self, message):
143 |         self.wrapper.write_line()
144 |         self.wrapper.error(message)
145 | 
146 |     def finish_warning(self, message):
147 |         self.wrapper.write_line()
148 |         self.wrapper.warning(message)
149 | 
150 |     def finish_skip(self, message):
151 |         self.wrapper.write_lin()

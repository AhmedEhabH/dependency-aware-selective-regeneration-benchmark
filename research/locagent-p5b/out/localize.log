 864 |         target, position = self.get_tree_options()
 865 |         copy_permissions = self.cleaned_data.get('copy_permissions', False)
 866 |         new_page = self.page.copy_with_descendants(
 867 |             source_site,
 868 |             target_node=target,
 869 |             position=position,
 870 |             copy_permissions=copy_permissions,
 871 |             target_site=self._site,
 872 |         )
 873 |         return new_page

123 |             meta = attrs.get('Meta', None)
124 |             proxy = getattr(meta, 'proxy', False)
125 | 
126 |             # True if any of the base classes defines a cmsplugin_ptr field.
127 |             field_is_inherited = any(hasattr(parent, 'cmsplugin_ptr') for parent in parents)
128 | 
129 |             # Skip proxied classes which are not autonomous ORM objects

551 |         can_change_global_permissions = permissions.user_can_change_global_permissions(user, site)
552 | 
553 |         for permission in global_permissions.iterator():
554 |             row = PermissionRow(
555 |                 is_global=True,
556 |                 can_change=can_change_global_permissions,
557 |                 permission=permission,
558 |             )
559 |             rows.append(row)
560 | 
561 |         _page_permissions = (
562 |             PagePermission

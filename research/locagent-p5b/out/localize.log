 185 |     def add_child(self, **kwargs):
 186 |         if len(kwargs) == 1 and 'instance' in kwargs:
 187 |             kwargs['instance'].parent = self
 188 |         else:
 189 |             kwargs['parent'] = self
 190 |         return super().add_child(**kwargs)
 191 | 
 192 |     def add_sibling(self, pos=None, *args, **kwargs):
 193 |         if len(kwargs) == 1 and 'instance' in kwargs:
 194 |             kwargs['instance'].parent_id = self.parent_id
 195 |         else:
 196 |             kwargs['parent_id'] = self.parent_id
 197 |         return super().add_sibling(*args, **kwargs)

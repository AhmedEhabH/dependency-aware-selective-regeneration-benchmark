167 | def get_urls(self):
168 |         """Get the admin urls
169 |         """
170 |         info = "%s_%s" % (self.model._meta.app_label, self.model._meta.model_name)
171 |         pat = lambda regex, fn: url(regex, self.admin_site.admin_view(fn), name='%s_%s' % (info, fn.__name__))
172 | 
173 |         url_patterns = [
174 |             pat(r'^list/$', self.get_list),
175 |             pat(r'^([0-9]+)/actions-menu/$', self.actions_menu),
176 |             pat(r'^([0-9]+)/([a-z\-]+)/edit-field/$', self.edit_title_fields),
177 |             pat(r'^([0-9]+)/advanced-settings/$', self.advanced),
178 |             pat(r'^([0-9]+)/move-page/$', self.move_page),
179 |             pat(r'^([0-9]+)/copy-page/$', self.copy_page),
180 |             pat(r'^([0-9]+)/dialog/copy/$', self.get_copy_dialog),  # copy dialog

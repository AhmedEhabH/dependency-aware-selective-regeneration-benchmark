 154 | class PlaceholderAdminMixin(object):
 155 | 
 156 |     def _get_attached_admin(self, placeholder):
 157 |         return placeholder._get_attached_admin(admin_site=self.admin_site)
 158 | 
 159 |     def _get_operation_language(self, request):
 160 |         # Unfortunately the ?language GET query
 161 |         # has a special meaning on the CMS.
 162 |         # It allows users to see another language while maintaining
 163 |         # the same url. This complicates language detection.
 164 |         site = get_current_site()
 165 |         parsed_url = urlparse(request.GET['cms_path'])
 166 |         queries = dict(parse_qsl(parsed_url.query))
 167 |         language = queries.get('language')
 168 | 
 169 |         if not language:
 170 |             language = translation.get_language_from_path(parsed_url.path)
 171 |         return get_language_code(language, site_id=site.pk)
 172 | 
 173 |     def _get_operation_origin(self, request):
 174 |         return urlparse(request.GET['cms_path']).path
 175 | 
 176 |     def _send_pre_placeholder_operation(self, request, operation, **kwargs):
 177 |         token = str(uuid.uuid4())
 178 | 
 179 |         if not request.GET.get('cms_path'):
 180 |             warnings.warn('All custom placeholder admin endpoints require '
 181 |                           'a "cms_path" GET query which points to the path '
 182 |                           'where the request originates from.'
 183 |                           'This backwards compatible shim will be removed on 3.5 '
 184 |                           'and an HttpBadRequest response will be returned instead.',
 185 |                           UserWarning)
 186 |             return token
 187 | 
 188 |         pre_placeholder_operation.send(
 189 |             sender=self.__class__,
 190 |             operation=operation,
 191 |             request=request,
 192 |             language=self._get_operation_language(request),
 193 |             token=token,
 194 |             origin=self._get_operation_origin(request),
 195 |             **kwargs
 196 |         )
 197 |         return token
 198 | 
 199 |     def _send_post_placeholder_operation(self, request, operation, token, **kwargs):
 200 |         if not request.GET.get('cms_path'):
 201 |             # No need to re-raise the warning
 202 |             return
 203 | 
 204 |         post_placeholder_operation.send(
 205 |             sender=self.__class__,
 206 |             operation=operation,
 207 |             request=request,
 208 |             language=self._get_operation_language(request),
 209 |             token=token,
 210 |             origin=self._get_operation_origin(request),
 211 |             **kwargs
 212 |         )
 213 | 
 214 |     def _get_plugin_from_id(self, plugin_id):
 215 |         queryset = CMSPlugin.objects.values_list('plugin_type', flat=True)
 216 |         plugin_type = get_list_or_404(queryset, pk=plugin_id)[0]
 217 |         # CMSPluginBase subclass
 218 |         plugin_class = plugin_pool.get_plugin(plugin_type)
 219 |         real_queryset = plugin_class.get_render_queryset().select_related('parent', 'placeholder')
 220 |         return get_object_or_404(real_queryset, pk=plugin_id)
 221 | 
 222 |     def get_urls(self):
 223 |         """
 224 |         Register the plugin specific urls (add/edit/copy/remove/move)
 225 |         """
 226 |         info = "%s_%s" % (self.model._meta.app_label, self.model._meta.model_name)
 227 |         pat = lambda regex, fn: url(regex, self.admin_site.admin_view(fn), name='%s_%s' % (info, fn.__name__))
 228 |         url_patterns = [
 229 |             pat(r'copy-plugins/$', self.copy_plugins),
 230 |             pat(r'add-plugin/$', self.add_plugin),
 231 |             pat(r'edit-plugin/(%s)/$' % SLUG_REGEXP, self.edit_plugin),
 232 |             pat(r'delete-plugin/(%s)/$' % SLUG_REGEXP, self.delete_plugin),
 233 |             pat(r'clear-placeholder/(%s)/$' % SLUG_REGEXP, self.clear_placeholder),
 234 |             pat(r'move-plugin/$', self.move_plugin),
 235 |         ]
 236 |         return url_patterns + super(PlaceholderAdminMixin, self).get_urls()
 237 | 
 238 |     def has_add_plugin_permission(self, request, placeholder, plugin_type):
 239 |         return placeholder.has_add_plugin_permission(request.user, plugin_type)
 240 | 
 241 |     def has_change_plugin_permission(self, request, plugin):
 242 |         placeholder = plugin.placeholder
 243 |         return placeholder.has_change_plugin_permission(request.user, plugin)
 244 | 
 245 |     def has_delete_plugin_permission(self, request, plugin):
 246 |         placeholder = plugin.placeholder
 247 |         return placeholder.has_delete_plugin_permission(request.user, plugin)
 248 | 
 249 |     def has_copy_plugins_permission(self, request, plugins):
 250 |         # Plugins can only be copied to the clipboard
 251 |         placeholder = request.toolbar.clipboard
 252 |         return placeholder.has_add_plugins_permission(request.user, plugins)
 253 | 
 254 |     def has_copy_from_clipboard_permission(self, request, placeholder, plugins):
 255 |         return placeholder.has_add_plugins_permission(request.user, plugins)
 256 | 
 257 |     def has_copy_from_placeholder_permission(self, request, source_placeholder, target_placeholder, plugins):
 258 |         if not source_placeholder.has_add_plugins_permission(request.user, plugins):
 259 |             return False
 260 |         return target_placeholder.has_add_plugins_permission(request.user, plugins)
 261 | 
 262 |     def has_move_plugin_permission(self, request, plugin, target_placeholder):
 263 |         placeholder = plugin.placeholder
 264 |         return placeholder.has_move_plugin_permission(request.user, plugin, target_placeholder)
 265 | 
 266 |     def has_clear_placeholder_permission(self, request, placeholder, language=None):
 267 |         if language:
 268 |             languages = [language]
 269 |         else:
 270 |             # fetch all languages this placeholder contains
 271 |             # based on it's plugins
 272 |             languages = (
 273 |                 placeholder
 274 |                 .cmsplugin_set
 275 |                 .values_list('language', flat=True)
 276 |                 .distinct()
 277 |                 .order_by()
 278 |             )
 279 |         return placeholder.has_clear_permission(request.user, languages)

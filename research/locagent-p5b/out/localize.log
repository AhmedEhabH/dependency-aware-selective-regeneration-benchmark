 152 |     def __str__(self):
 153 |         page_content = self.get_content_obj(get_language(), fallback=True)
 154 |         if page_content:
 155 |             title = page_content.menu_title or page_content.title
 156 |         else:
 157 |             title = _("No available title")
 158 |         path = self.get_path(get_language(), fallback=True)
 159 |         return force_str(title) + ("" if path is None else f" (/{path})")

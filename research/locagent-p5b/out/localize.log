 621 |     def save(self, **kwargs):
 622 |         if self.reverse_id == "":
 623 |             self.reverse_id = None
 624 |         if self.application_namespace == "":
 625 |             self.application_namespace = None
 626 | 
 627 |         created = not bool(self.pk)
 628 |         from cms.utils.permissions import get_current_user_name
 629 |         self.changed_by = get_current_user_name()
 630 |         if created:
 631 |             self.created_by = self.changed_by
 632 | 
 633 |         super().save(**kwargs)
 634 | 
 635 |     def update(self, refresh=False, **data):
 636 |         cls = self.__class__
 637 |         cls.objects.filter(pk=self.pk).update(**data)
 638 | 
 639 |         if refresh:
 640 |             return self.reload()
 641 |         else:
 642 |             for field, value in data.items():
 643 |                 setattr(self, field, value)
 644 |         return
 645 | 
 646 |     def update_translations(self, language=None, **data):
 647 |         if language:
 648 |             translations = self.pagecontent_set.filter(language=language)
 649 |         else:
 650 |             translations = self.pagecontent_set.all()
 651 |         return translations.update(**data)
 652 | 
 653 |     def has_translation(self, language):
 654 |         return self.pagecontent_set.filter(language=language).exists()

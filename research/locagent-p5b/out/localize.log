140 |                 # under the hood to set the forward and reverse relations.
141 |                 attrs['cmsplugin_ptr'] = models.OneToOneField(
142 |                     to='cms.CMSPlugin',
143 |                     name='cmsplugin_ptr',
144 |                     related_name='%(app_label)s_%(class)s',
145 |                     auto_created=True,

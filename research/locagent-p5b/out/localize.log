146 | def get_draft_root_node(cls, position=None, site=None):
147 |         """
148 |         Returns the last draft root node if no position is specified.
149 |         If a position is specified, returns the draft root node in the
150 |         given position raising an IndexError if no such position exists.
151 |         """
152 |         # Only look at nodes marked as draft.
153 |         nodes = cls.get_root_nodes().filter(publisher_is_draft=True)
154 | 
155 |         if site:
156 |             # Filter out any nodes not belonging to provided site.
157 |             nodes = nodes.filter(site=site)
158 | 
159 |         if position is None:
160 |             # No position has been given.
161 |             # We default to the last root node
162 |             nodes = nodes.reverse()
163 |             position = 0
164 |         return nodes[position]

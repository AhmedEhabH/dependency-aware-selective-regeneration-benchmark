1272 |     def preview_page(self, request, object_id, language):
1273 |         """
1274 |         Redirecting preview function based on draft_id
1275 |         """
1276 |         page = self.get_object(request, object_id=object_id)
1277 | 
1278 |         if page is None:
1279 |             raise self._get_404_exception(object_id)
1280 | 
1281 |         site = get_current_site()
1282 |         active_site = self.get_site(request)
1283 |         is_shared_page = page.site_is_secondary(site)
1284 |         can_see_page = page_permissions.user_can_view_page(request.user, page, active_site)
1285 | 
1286 |         if can_see_page:
1287 |             can_change_page = self.has_change_permission(request, obj=page)
1288 |         else:
1289 |             can_change_page = False
1290 | 
1291 |         if can_see_page and not can_change_page:
1292 |             # User can see the page but has no permission to edit it,
1293 |             # as a result, only let them see it if is published.
1294 |             # Unless the page is a shared page.
1295 |             can_see_page = is_shared_page or page.is_published(language)
1296 | 
1297 |         if not can_see_page:
1298 |             message = ugettext('You don\'t have permissions to see page "%(title)s"')
1299 |             message = message % {'title': force_text(page)}
1300 |             self.message_user(request, message, level=messages.ERROR)
1301 |             return HttpResponseRedirect(self.get_admin_url('changelist'))
1302 | 
1303 |         attrs = "?%s" % get_cms_setting('CMS_TOOLBAR_URL__EDIT_ON')
1304 |         attrs += "&language=" + language
1305 |         url = page.get_absolute_url(language) + attrs
1306 | 
1307 |         if site != active_site and not page.nodes.filter(site=site).exists():
1308 |             # The user has selected a site using the site selector menu
1309 |             # and the page is not available on the current site's tree.
1310 |             # Redirect to the page url in the selected site
1311 |             proto = 'https' if request.is_secure() else 'http'
1312 |             url = "{}://{}{}".format(proto, active_site.domain, url)
1313 |         return HttpResponseRedirect(url)

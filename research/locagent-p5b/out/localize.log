492 |     def get_copy_dialog(self, request, page_id):
493 |         if not get_cms_setting('PERMISSION'):
494 |             return HttpResponse('')
495 | 
496 |         page = self.get_page_from_id(page_id)
497 | 
498 |         if page is None:
499 |             raise self._get_404_exception(page_id)
500 | 
501 |         if request.method == 'GET':
502 |             data = request.GET
503 |         else:
504 |             data = request.POST
505 | 
506 |         target_id = data.get('target')
507 | 
508 |         try:
509 |             source_site_id = data['source_site']
510 |             source_site = Site.objects.get(pk=source_site_id)
511 |         except (KeyError, ObjectDoesNotExist):
512 |             return HttpResponseBadRequest('source_site is required')
513 | 
514 |         site = get_site(request)

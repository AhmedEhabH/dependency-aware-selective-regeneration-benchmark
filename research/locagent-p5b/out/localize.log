569 |             allowed_pages = page_permissions.get_change_perm_tuples(user, site, check_global=False)
570 | 
571 |         for permission in _page_permissions.iterator():
572 |             if can_change_global_permissions:
573 |                 can_change = True
574 |             else:
575 |                 page_path = permission.page.path
576 |                 can_change = any(perm_tuple.contains(page_path) for perm_tuple in allowed_pages)
577 | 
578 |             row = PermissionRow(
579 |                 is_global=False,
580 |                 can_change=can_change,
581 |                 permission=permission,
582 |             )
583 |             rows.append(row)

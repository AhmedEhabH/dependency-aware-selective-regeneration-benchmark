 431 |             data['path'] = ''
 432 |             return data
 433 | 
 434 |         if 'slug' not in self.fields:
 435 |             # the {% edit_title_fields %} template tag
 436 |             # allows users to edit specific fields for a translation.
 437 |             # as a result, slug might not always be there.
 438 |             return data
 439 | 
 440 |         node = page.get_node_object(site=self._site)
 441 | 
 442 |         if node.parent:
 443 |             slug = data['slug']
 444 |             parent_path = node.parent.page.get_path(self._language)
 445 |             path = u'%s/%s' % (parent_path, slug) if parent_path else slug
 446 |         else:
 447 |             path = data['slug']
 448 | 
 449 |         try:
 450 |             # Validate the url
 451 |             validate_url_uniqueness(
 452 |                 self._site,
 453 |                 path=path,
 454 |                 language=self._language,
 455 |                 exclude_page=page,
 456 |             )
 457 |         except ValidationError as error:
 458 |             self.add_error('slug', error)
 459 |         else:
 460 |             data['path'] = path
 461 |         return data
 462 | 
 463 |     def save(self, commit=True):
 464 |         data = self.cleaned_data
 465 |         cms_page = super(ChangePageForm, self).save(commit=False)
 466 | 
 467 |         translation_data = {field: data[field]
 468 |                             for field in self.translation_fields if field in data}
 469 | 
 470 |         if 'path' in data:
 471 |             # this field is managed manually
 472 |             translation_data['path'] = data['path']
 473 | 
 474 |         update_count = cms_page.update_translations(
 475 |             self._language,
 476 |             publisher_state=PUBLISHER_STATE_DIRTY,
 477 |             **translation_data
 478 |         )
 479 | 
 480 |         if self._language in cms_page.title_cache:
 481 |             del cms_page.title_cache[self._language]
 482 | 
 483 |         if update_count == 0:
 484 |             api.create_title(language=self._language, page=cms_page, **translation_data)
 485 |         else:
 486 |             cms_page._update_title_path_recursive(self._language, self._site)
 487 |         return cms_page

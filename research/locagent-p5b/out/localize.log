 6 | class LanguageCookieMiddleware(MiddlewareMixin):
 7 |     def __init__(self, get_response):
 8 |         super().__init__(get_response)
 9 | 
10 |     def __call__(self, request):
11 |         response = self.get_response(request)
12 |         language = get_language()
13 |         if (
14 |             settings.LANGUAGE_COOKIE_NAME in request.COOKIES  # noqa: W503
15 |             and request.COOKIES[settings.LANGUAGE_COOKIE_NAME] == language
16 |         ):
17 |             return response
18 | 
19 |         # To ensure support of very old browsers, Django processed automatically "expires" according
20 |         # to max_age value.
21 |         # https://docs.djangoproject.com/en/3.2/ref/request-response/#django.http.HttpResponse.set_cookie
22 | 
23 |         response.set_cookie(
24 |             settings.LANGUAGE_COOKIE_NAME,
25 |             value=language,
26 |             domain=settings.LANGUAGE_COOKIE_DOMAIN,
27 |             max_age=settings.LANGUAGE_COOKIE_AGE or 365 * 24 * 60 * 60,  # 1 year
28 |             httponly=settings.LANGUAGE_COOKIE_HTTPONLY,
29 |             path=settings.LANGUAGE_COOKIE_PATH,
30 |             samesite=settings.LANGUAGE_COOKIE_SAMESITE,
31 |             secure=settings.LANGUAGE_COOKIE_SECURE,
32 |         )
33 |         return response

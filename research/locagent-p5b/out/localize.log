 61 | def get_page_from_request(request, use_path=None, clean_path=None):
 62 |     """
 63 |     Gets the current page from a request object.
 64 | 
 65 |     URLs can be of the following form (this should help understand the code):
 66 |     http://server.whatever.com/<some_path>/"pages-root"/some/page/slug
 67 | 
 68 |     <some_path>: This can be anything, and should be stripped when resolving
 69 |         pages names. This means the CMS is not installed at the root of the
 70 |         server's URLs.
 71 |     "pages-root" This is the root of Django urls for the CMS. It is, in essence
 72 |         an empty page slug (slug == '')
 73 | 
 74 |     The page slug can then be resolved to a Page model object
 75 |     """
 76 |     from cms.models import PageUrl
 77 | 
 78 |     if hasattr(request, '_current_page_cache'):
 79 |         # The following is set by CurrentPageMiddleware
 80 |         return request._current_page_cache
 81 | 
 82 |     if clean_path is None:
 83 |         clean_path = not bool(use_path)
 84 | 
 85 |     path = request.path_info if use_path is None else use_path
 86 | 
 87 |     if clean_path:
 88 |         pages_root = reverse("pages-root")
 89 | 
 90 |         if path.startswith(pages_root):
 91 |             path = path[len(pages_root):]
 92 | 
 93 |         # strip any final slash
 94 |         if path.endswith("/"):
 95 |             path = path[:-1]
 96 | 
 97 |     site = get_current_site()
 98 |     page_urls = (
 99 |         PageUrl
100 |         .objects
101 |         .get_for_site(site)
102 |         .filter(path=path)
103 |         .select_related('page__node')
104 |     )
105 |     page_urls = list(page_urls)
106 | 
107 |     try:
108 |         page = page_urls[0].page
109 |     except IndexError:
110 |         page = None
111 |     else:
112 |         page.urls_cache = {url.language: url for url in page_urls}
113 |     return page

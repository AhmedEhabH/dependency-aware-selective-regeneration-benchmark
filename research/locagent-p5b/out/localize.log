66 | def resolve_page_id(self, path):
67 |         """Resolves requested path similar way how resolve does, but instead
68 |         of return callback,.. returns page_id to which was application
69 |         assigned.
70 |         """
71 |         tried = []
72 |         pattern = getattr(self, 'pattern', self)
73 |         match = pattern.regex.search(path)
74 |         if match:
75 |             new_path = path[match.end():]
76 |             for pattern in self.url_patterns:
77 |                 if isinstance(pattern, AppRegexURLResolver):
78 |                     try:
79 |                         return pattern.resolve_page_id(new_path)
80 |                     except Resolver404:
81 |                         pass
82 |                 else:
83 |                     try:
84 |                         sub_match = pattern.resolve(new_path)
85 |                     except Resolver404 as e:
86 |                         tried_match = e.args[0].get('tried')
87 |                         if tried_match is not None:
88 |                             tried.extend([[pattern] + t for t in tried_match])
89 |                         else:
90 |                             tried.extend([pattern])
91 |                     else:
92 |                         if sub_match:
93 |                             return getattr(pattern, 'page_id', None)
94 |                         pattern = getattr(pattern, 'pattern', pattern)
95 |                         tried.append(pattern.regex.pattern)
96 |             raise Resolver404({'tried': tried, 'path': new_path})

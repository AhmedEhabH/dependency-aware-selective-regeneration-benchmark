340 |     def copy_plugin(self, target_placeholder, target_language, parent_cache, no_signals=False):
341 |         """
342 |         Copy this plugin and return the new plugin.
343 | 
344 |         The logic of this method is the following:
345 | 
346 |          # get a new generic plugin instance
347 |          # assign the position in the plugin tree
348 |          # save it to let mptt/treebeard calculate the tree attributes
349 |          # then get a copy of the current plugin instance
350 |          # assign to it the id of the generic plugin instance above;
351 |            this will effectively change the generic plugin created above
352 |            into a concrete one
353 |          # copy the tree related attributes from the generic plugin to
354 |            the concrete one
355 |          # save the concrete plugin
356 |          # trigger the copy relations
357 |          # return the generic plugin instance
358 | 
359 |         This copy logic is required because we don't know what the fields of
360 |         the real plugin are. By getting another instance of it at step 4 and
361 |         then overwriting its ID at step 5, the ORM will copy the custom
362 |         fields for us.
363 |         """
364 |         try:
365 |             plugin_instance, cls = self.get_plugin_instance()
366 |         except KeyError:  # plugin type not found anymore
367 |             return
368 | 
369 |         # set up some basic attributes on the new_plugin
370 |         new_plugin = CMSPlugin()
371 |         new_plugin.placeholder = target_placeholder
372 |         # we assign a parent to our new plugin
373 |         parent_cache[self.pk] = new_plugin
374 |         if self.parent:
375 |             parent = parent_cache[self.parent_id]
376 |             parent = CMSPlugin.objects.get(pk=parent.pk)
377 |             new_plugin.parent_id = parent.pk
378 |             new_plugin.parent = parent
379 |         new_plugin.language = target_language
380 |         new_plugin.plugin_type = self.plugin_type
381 |         if no_signals:
382 |             from cms.signals import pre_save_plugins
383 | 
384 |             signals.pre_save.disconnect(pre_save_plugins, sender=CMSPlugin, dispatch_uid='cms_pre_save_plugin')
385 |             signals.pre_save.disconnect(pre_save_plugins, sender=CMSPlugin)
386 |             new_plugin._no_reorder = True
387 |         new_plugin.save()
388 |         if plugin_instance:
389 |             # get a new instance so references do not get mixed up
390 |             plugin_instance = plugin_instance.__class__.objects.get(pk=plugin_instance.pk)
391 |             plugin_instance.pk = new_plugin.pk
392 |             plugin_instance.id = new_plugin.pk
393 |             plugin_instance.placeholder = target_placeholder
394 |             plugin_instance.cmsplugin_ptr = new_plugin
395 |             plugin_instance.language = target_language
396 |             plugin_instance.parent = new_plugin.parent
397 |             plugin_instance.depth = new_plugin.depth
398 |             plugin_instance.path = new_plugin.path
399 |             plugin_instance.numchild = new_plugin.numchild
400 |             plugin_instance._no_reorder = True
401 |             plugin_instance.save()
402 |             old_instance = plugin_instance.__class__.objects.get(pk=self.pk)
403 |             plugin_instance.copy_relations(old_instance)
404 |         if no_signals:
405 | 
406 |             signals.pre_save.connect(pre_save_plugins, sender=CMSPlugin, dispatch_uid='cms_pre_save_plugin')
407 | 
408 |         return new_plugin

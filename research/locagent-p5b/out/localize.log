1333 |     def get_tree(self, request):
1334 |         """
1335 |         Get html for the descendants (only) of given page or if no page_id is
1336 |         provided, all the root nodes.
1337 | 
1338 |         Used for lazy loading pages in cms.pagetree.js
1339 |         """
1340 |         nodes = self.get_nodes_queryset(request)
1341 |         node_id = request.GET.get('nodeId')
1342 |         open_nodes = list(map(int, request.GET.getlist('openNodes[]')))
1343 | 
1344 |         if node_id:
1345 |             node = get_object_or_404(nodes, pk=int(node_id))
1346 |             nodes = nodes.get_descendants(node).filter(Q(pk__in=open_nodes)|Q(parent__in=open_nodes))
1347 |         else:
1348 |             node = None
1349 |             nodes = nodes.filter(
1350 |                 # get all root nodes
1351 |                 Q(depth=1)
1352 |                 # or children which were previously open
1353 |                 | Q(depth=2, pk__in=open_nodes)
1354 |                 # or children of the open descendants
1355 |                 | Q(parent__in=open_nodes)
1356 |             )
1357 | 
1358 |         rows = self.get_tree_rows(
1359 |             request,
1360 |             nodes=nodes,
1361 |             language=get_site_language_from_request(request),
1362 |             depth=(node.depth + 1 if node else 1),
1363 |             follow_descendants=True,
1364 |         )
1365 |         return HttpResponse(u''.join(rows))
1366 | 
1367 |     def get_tree_rows(self, request, nodes, language, depth=1,
1368 |                       follow_descendants=True):
1369 |         """
1370 |         Used for rendering the page tree, inserts into context everything what
1371 |         we need for single item
1372 |         """
1373 |         user = request.user
1374 |         site = self.get_site(request)
1375 |         permissions_on = get_cms_setting('PERMISSION')
1376 |         template = get_template(self.page_tree_row_template)
1377 |         is_popup = (IS_POPUP_VAR in request.POST or IS_POPUP_VAR in request.GET)
1378 |         languages = get_language_list(site.pk)
1379 |         user_can_add = page_permissions.user_can_add_subpage
1380 | 
1381 |         def render_page_row(node):
1382 |             page = node.page
1383 |             page.title_cache = {trans.language: trans for trans in page.filtered_translations}
1384 | 
1385 |             for _language in languages:
1386 |                 # EmptyTitle is used to prevent the cms from trying
1387 |                 # to find a translation in the database

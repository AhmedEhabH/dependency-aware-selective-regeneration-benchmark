345 |     @transaction.atomic
346 |     def delete_view(self, request, object_id, extra_context=None):
347 |         # This is an unfortunate copy/paste from django's delete view.
348 |         # The reason is to add the descendant pages to the deleted objects list.
349 |         opts = self.model._meta
350 |         app_label = opts.app_label
351 | 
352 |         obj = self.get_object(request, object_id=object_id)
353 | 
354 |         if not self.has_delete_permission(request, obj):
355 |             raise PermissionDenied
356 | 
357 |         if obj is None:
358 |             raise self._get_404_exception(object_id)
359 | 
360 |         using = router.db_for_write(self.model)
361 | 
362 |         # Populate deleted_objects, a data structure of all related objects that
363 |         # will also be deleted.
364 |         objs = [obj] + list(obj.get_descendant_pages())
365 | 
366 |         if DJANGO_2_0:
367 |             get_deleted_objects_additional_kwargs = {
368 |                 'opts': opts,
369 |                 'using': using,
370 |                 'user': request.user,
371 |             }
372 |         else:
373 |             get_deleted_objects_additional_kwargs = {'request': request}
374 |         (deleted_objects, model_count, perms_needed, protected) = get_deleted_objects(
375 |             objs, admin_site=self.admin_site,
376 |             **get_deleted_objects_additional_kwargs
377 |         )
378 | 
379 |         # This is bad and I should feel bad.
380 |         if 'placeholder' in perms_needed:
381 |             perms_needed.remove('placeholder')
382 | 
383 |         if 'page content' in perms_needed:
384 |             perms_needed.remove('page content')
385 | 
386 |         if request.POST and not protected:  # The user has confirmed the deletion.
387 |             if perms_needed:
388 |                 raise PermissionDenied
389 |             obj_display = force_text(obj)
390 |             obj_id = obj.serializable_value(opts.pk.attname)
391 |             self.log_deletion(request, obj, obj_display)
392 |             self.delete_model(request, obj)
393 | 
394 |             if IS_POPUP_VAR in request.POST:
395 |                 popup_response_data = json.dumps({
396 |                     'action': 'delete',
397 |                     'value': str(obj_id),
398 |                 })
399 |                 return TemplateResponse(request, self.popup_response_template or [
400 |                     'admin/%s/%s/popup_response.html' % (opts.app_label, opts.model_name),
401 |                     'admin/%s/popup_response.html' % opts.app_label,
402 |                     'admin/popup_response.html',
403 |                 ], {'popup_response_data': popup_response_data})
404 | 
405 |             self.message_user(
406 |                 request,
407 |                 _('The %(name)s "%(obj)s" was deleted successfully.') % {
408 |                     'name': force_text(opts.verbose_name),
409 |                     'obj': force_text(obj_display),
410 |                 },
411 |                 messages.SUCCESS,
412 |             )
413 | 
414 |             can_change_any_page = page_permissions.user_can_change_at_least_one_page(
415 |                 user=request.user,
416 |                 site=get_site(request),
417 |                 use_cache=False,
418 |             )
419 | 
420 |             if can_change_any_page:
421 |                 query = self.get_preserved_filters(request)
422 |                 post_url = admin_reverse('cms_pagecontent_changelist') + '?' + query
423 |             else:
424 |                 post_url = admin_reverse('index')
425 |             return HttpResponseRedirect(post_url)
426 | 
427 |         object_name = force_text(opts.verbose_name)
428 | 
429 |         if perms_needed or protected:
430 |             title = _("Cannot delete %(name)s") % {"name": object_name}
431 |         else:
432 |             title = _("Are you sure?")
433 | 
434 |         context = dict(
435 |             self.admin_site.each_context(request),
436 |             title=title,
437 |             object_name=object_name,
438 |             object=obj,
439 |             deleted_objects=deleted_objects,
440 |             model_count=dict(model_count).items(),
441 |             perms_lacking=perms_needed,
442 |             protected=protected,
443 |             opts=opts,
444 |             app_label=app_label,
445 |             is_popup=(IS_POPUP_VAR in request.POST or
446 |                       IS_POPUP_VAR in request.GET),
447 |             to_field=None,
448 |         )
449 |         context.update(extra_context or {})
450 |         return self.render_delete_form(request, context)

 656 |     def clear_cache(self, language=None, menu=False, placeholder=False):
 657 |         from cms.cache import invalidate_cms_page_cache
 658 | 
 659 |         if get_cms_setting('PAGE_CACHE'):
 660 |             # Clears all the page caches
 661 |             invalidate_cms_page_cache()
 662 | 
 663 |         if placeholder and get_cms_setting('PLACEHOLDER_CACHE'):
 664 |             assert language, 'language is required when clearing placeholder cache'
 665 | 
 666 |             placeholders = self.get_placeholders(language)
 667 | 
 668 |             for placeholder_instance in placeholders:
 669 |                 placeholder_instance.clear_cache(language, site_id=self.site_id)
 670 | 
 671 |         if menu:
 672 |             # Clears all menu caches for this page's site
 673 |             menu_pool.clear(site_id=self.site_id)
 674 | 
 675 |     def get_child_pages(self):
 676 |         return self.get_children().order_by('path')
 677 | 
 678 |     def get_ancestor_pages(self):
 679 |         return self.get_ancestors().order_by('path')
 680 | 
 681 |     def get_descendant_pages(self):

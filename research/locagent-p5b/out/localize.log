 99 | def recurse_patterns(path, pattern_list, page_id, default_args=None,
100 |                      nested=False):
101 |     """
102 |     Recurse over a list of to-be-hooked patterns for a given path prefix
103 |     """
104 |     newpatterns = []
105 |     for pattern in pattern_list:
106 |         app_pat = getattr(pattern, 'pattern', pattern).regex.pattern
107 |         # make sure we don't get patterns that start with more than one '^'!
108 |         app_pat = app_pat.lstrip('^')
109 |         path = path.lstrip('^')
110 |         regex = r'^%s%s' % (path, app_pat) if not nested else r'^%s' % (app_pat)
111 |         if isinstance(pattern, URLResolver):
112 |             # include default_args
113 |             args = pattern.default_kwargs
114 |             if default_args:
115 |                 args.update(default_args)
116 |             # see lines 243 and 236 of urlresolvers.py to understand the next line
117 |             urlconf_module = recurse_patterns(regex, pattern.url_patterns, page_id, args, nested=True)
118 |             # this is an 'include', recurse!
119 |             regex_pattern = regex
120 |             if not DJANGO_1_11:
121 |                 regex_pattern = RegexPattern(regex)
122 |             resolver = URLResolver(regex_pattern, urlconf_module,
123 |                                    pattern.default_kwargs, pattern.app_name,
124 |                                    pattern.namespace)

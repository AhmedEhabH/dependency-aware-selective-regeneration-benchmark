480 |         Move the page to the requested target, at the given position.
481 | 
482 |         NOTE: We have to change from one "coordinate system" to another to
483 |         adapt JSTree to Django Treebeard.
484 | 
485 |         If the Tree looks like this:
486 | 
487 |             <root>
488 |                ⊢ …
489 |                ⊢ …
490 |                ⊢ Page 4
491 |                    ⊢ Page 5 (position 0)
492 |                    ⊢ …
493 | 
494 |         For example,
495 |             target=4, position=1 => target=5, position="right"
496 |             target=4, position=0 => target=4, position="first-child"
497 | 
498 |         """
499 |         site = get_site(request)
500 |         page = self.get_object(request, object_id=page_id)
501 | 
502 |         if page is None:
503 |             return jsonify_request(HttpResponseBadRequest("error"))
504 | 
505 |         user = request.user
506 |         form = self.move_form(request.POST or None, page=page, site=site)
507 | 
508 |         if not form.is_valid():
509 |             return jsonify_request(HttpResponseBadRequest("error"))
510 | 
511 |         target = form.cleaned_data['target']
512 |         can_move_page = self.has_move_page_permission(request, obj=page)
513 | 
514 |         # Does the user have permissions to do this...?
515 |         if not can_move_page or (target and not target.has_add_permission(user)):
516 |             message = _(
517 |                 "Error! You don't have permissions to move this page. Please reload the page"
518 |             )
519 |             return jsonify_request(HttpResponseForbidden(message))
520 | 
521 |         operation_token = send_pre_page_operation(
522 |             request=request,
523 |             operation=operations.MOVE_PAGE,
524 |             obj=page,
525 |             sender=self.model,
526 |         )
527 | 
528 |         form.move_page()
529 | 
530 |         send_post_page_operation(
531 |             request=request,
532 |             operation=operations.MOVE_PAGE,
533 |             token=operation_token,
534 |             obj=page,
535 |             sender=self.model,

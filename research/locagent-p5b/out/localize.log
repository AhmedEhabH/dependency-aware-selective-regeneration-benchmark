80 | def add_url_parameters(url, *args, **params):
81 |     """
82 |     adds parameters to an url -> url?p1=v1&p2=v2...
83 |     :param url: url without any parameters
84 |     :param args: one or more dictionaries containing url parameters
85 |     :param params: url parameters as keyword arguments

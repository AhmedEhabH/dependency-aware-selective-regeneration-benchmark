 875 |     def _get_tree_options_for_root(self, position):
 876 |         try:
 877 |             return super(CopyPageForm, self)._get_tree_options_for_root(position)
 878 |         except IndexError:
 879 |             # The user is copying a page to a site with no pages
 880 |             # Add the node as the last root node.
 881 |             siblings = PageNode.get_root_nodes().reverse()
 882 |             return (siblings[0], 'right')

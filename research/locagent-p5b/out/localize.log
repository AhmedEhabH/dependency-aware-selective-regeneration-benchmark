 757 |             has_url_overwrite=bool(data.get('overwrite_url')),
 758 |         )
 759 |         is_draft_and_has_public = page.publisher_is_draft and page.publisher_public_id
 760 | 
 761 |         if is_draft_and_has_public and self.has_changed_apphooks():
 762 |             self.update_apphooks()
 763 |         return page

516 |         can_view_page = page_permissions.user_can_view_page(user, page, source_site)
517 | 
518 |         if not can_view_page:
519 |             raise PermissionDenied
520 | 
521 |         if target_id:
522 |             try:
523 |                 target = Page.objects.get(pk=target_id)
524 |             except Page.DoesNotExist:
525 |                 raise Http404
526 | 
527 |             if not page_permissions.user_can_add_subpage(user, target, site):
528 |                 raise PermissionDenied
529 |         elif not page_permissions.user_can_add_page(user, site):
530 |             raise PermissionDenied
531 | 
532 |         context = {
533 |             'dialog_id': 'dialog-copy',
534 |             'form': CopyPermissionForm(),  # class needs to be instantiated
535 |             'opts': self.opts,
536 |         }
537 |         return render(request, "admin/cms/page/tree/copy_premissions.html", context)

 935 | class PagePermissionInlineAdminForm(BasePermissionAdminForm):
 936 |     """
 937 |     Page permission inline admin form used in inline admin. Required, because
 938 |     user and group queryset must be changed. User can see only users on the same
 939 |     level or under him in chosen page tree, and users which were created by him,
 940 |     but aren't assigned to higher page level than current user.
 941 |     """
 942 |     page = forms.ModelChoiceField(
 943 |         queryset=Page.objects.all(),
 944 |         label=_('user'),
 945 |         widget=HiddenInput(),
 946 |         required=True,
 947 |     )
 948 | 
 949 |     def __init__(self, *args, **kwargs):
 950 |         super(PagePermissionInlineAdminForm, self).__init__(*args, **kwargs)
 951 |         user = get_current_user() # current user from threadlocals
 952 |         site = Site.objects.get_current()
 953 |         sub_users = get_subordinate_users(user, site)
 954 | 
 955 |         limit_choices = True
 956 |         use_raw_id = False
 957 | 
 958 |         # Unfortunately, if there are > 500 users in the system, non-superusers
 959 |         # won't see any benefit here because if we ask Django to put all the
 960 |         # user PKs in limit_choices_to in the query string of the popup we're
 961 |         # in danger of causing 414 errors so we fall back to the normal input
 962 |         # widget.
 963 |         if get_cms_setting('RAW_ID_USERS'):
 964 |             if sub_users.count() < 500:
 965 |                 # If there aren't too many users, proceed as normal and use a
 966 |                 # raw id field with limit_choices_to
 967 |                 limit_choices = True
 968 |                 use_raw_id = True
 969 |             elif get_user_permission_level(user, site) == ROOT_USER_LEVEL:
 970 |                 # If there are enough choices to possibly cause a 414 request
 971 |                 # URI too large error, we only proceed with the raw id field if
 972 |                 # the user is a superuser & thus can legitimately circumvent
 973 |                 # the limit_choices_to condition.
 974 |                 limit_choices = False
 975 |                 use_raw_id = True
 976 | 
 977 |         # We don't use the fancy custom widget if the admin form wants to use a
 978 |         # raw id field for the user
 979 |         if use_raw_id:
 980 |             from django.contrib.admin.widgets import ForeignKeyRawIdWidget
 981 |             # This check will be False if the number of users in the system
 982 |             # is less than the threshold set by the RAW_ID_USERS setting.
 983 |             if isinstance(self.fields['user'].widget, ForeignKeyRawIdWidget):
 984 |                 # We can't set a queryset on a raw id lookup, but we can use
 985 |                 # the fact that it respects the limit_choices_to parameter.
 986 |                 if limit_choices:
 987 |                     self.fields['user'].widget.rel.limit_choices_to = dict(
 988 |                         id__in=list(sub_users.values_list('pk', flat=True))
 989 |                     )
 990 |         else:
 991 |             self.fields['user'].widget = UserSelectAdminWidget()
 992 |             self.fields['user'].queryset = sub_users
 993 |             self.fields['user'].widget.user = user # assign current user
 994 | 
 995 |         self.fields['group'].queryset = get_subordinate_groups(user, site)
 996 | 
 997 |     class Meta:
 998 |         fields = [
 999 |             'user',
1000 |             'group',

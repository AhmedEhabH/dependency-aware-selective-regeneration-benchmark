 184 |     def get_urls(self):
 185 |         """Get the admin urls
 186 |         """
 187 |         info = "%s_%s" % (self.model._meta.app_label, self.model._meta.model_name)
 188 |         pat = lambda regex, fn: url(regex, self.admin_site.admin_view(fn), name='%s_%s' % (info, fn.__name__))
 189 | 
 190 |         url_patterns = [
 191 |             pat(r'^([0-9]+)/advanced-settings/$', self.advanced),
 192 |             pat(r'^([0-9]+)/duplicate/$', self.duplicate),
 193 |             pat(r'^([0-9]+)/actions-menu/$', self.actions_menu),
 194 |             pat(r'^([0-9]+)/dates/$', self.dates),
 195 |             pat(r'^([0-9]+)/permission-settings/$', self.permissions),
 196 |             pat(r'^([0-9]+)/delete-translation/$', self.delete_translation),
 197 |             pat(r'^([0-9]+)/move-page/$', self.move_page),
 198 |             pat(r'^([0-9]+)/copy-page/$', self.copy_page),
 199 |             pat(r'^([0-9]+)/copy-language/$', self.copy_language),
 200 |             pat(r'^([0-9]+)/dialog/copy/$', self.get_copy_dialog),  # copy dialog
 201 |             pat(r'^([0-9]+)/change-navigation/$', self.change_innavigation),
 202 |             pat(r'^([0-9]+)/permissions/$', self.get_permissions),
 203 |             pat(r'^([0-9]+)/change-template/$', self.change_template),
 204 |             pat(r'^([0-9]+)/([a-z\-]+)/edit-field/$', self.edit_title_fields),
 205 |             pat(r'^([0-9]+)/([a-z\-]+)/publish/$', self.publish_page),
 206 |             pat(r'^([0-9]+)/([a-z\-]+)/unpublish/$', self.unpublish),
 207 |             pat(r'^([0-9]+)/([a-z\-]+)/preview/$', self.preview_page),
 208 |             pat(r'^([0-9]+)/([a-z\-]+)/revert-to-live/$', self.revert_to_live),
 209 |             url(r'^resolve/$', self.resolve, name="cms_page_resolve"),
 210 |             pat(r'^get-tree/$', self.get_tree),
 211 |         ]
 212 |         return url_patterns + super(BasePageAdmin, self).get_urls()

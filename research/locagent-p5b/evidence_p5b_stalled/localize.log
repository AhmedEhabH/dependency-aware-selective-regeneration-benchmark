 895 |         title = self.title_set.get(language=language)
 896 |         title.publisher_state = state
 897 |         if published is not None:
 898 |             title.published = published
 899 |         title._publisher_keep_state = True
 900 |         title.save()
 901 |         if language in self.title_cache:
 902 |             self.title_cache[language].publisher_state = state
 903 |         return title

 373 |     def get_draft_url(self, language=None, fallback=True):
 374 |         """
 375 |         Returns the URL of the draft version of the current page.
 376 |         Returns empty string if the draft page is not available.
 377 |         """
 378 |         try:
 379 |             return self.get_draft_object().get_absolute_url(language, fallback)
 380 |         except:
 381 |             return ''

 908 |     def publish(self, language):
 909 |         """
 910 |         :returns: True if page was successfully published.
 911 |         """
 912 |         from cms.utils.permissions import get_current_user_name
 913 | 
 914 |         # Publish can only be called on draft pages
 915 |         if not self.publisher_is_draft:
 916 |             raise PublicIsUnmodifiable('The public instance cannot be published. Use draft.')
 917 | 
 918 |         if not self._publisher_can_publish(language):
 919 |             return False
 920 | 
 921 |         if self.publisher_public_id:
 922 |             public_page = Page.objects.get(pk=self.publisher_public_id)
 923 |             public_languages = public_page.get_languages()
 924 |         else:
 925 |             public_page = Page(created_by=self.created_by)
 926 |             public_languages = [language]
 927 | 
 928 |         self._copy_attributes(public_page, clean=False)
 929 | 
 930 |         if language not in public_languages:
 931 |             public_languages.append(language)
 932 | 
 933 |         # TODO: Get rid of the current user thread hack
 934 |         public_page.changed_by = get_current_user_name()
 935 |         public_page.is_home = self.is_home
 936 |         public_page.publication_date = self.publication_date or now()
 937 |         public_page.publisher_public = self
 938 |         public_page.publisher_is_draft = False
 939 |         public_page.languages = ','.join(public_languages)
 940 |         public_page.save()
 941 | 
 942 |         # Copy the page translation (title) matching language
 943 |         # into a "public" version.
 944 |         public_title = self._copy_titles(public_page, language, published=True)
 945 | 
 946 |         # Ensure this draft page points to its public version
 947 |         self.update(
 948 |             draft_only=True,
 949 |             changed_by=public_page.changed_by,
 950 |             publisher_public=public_page,
 951 |             publication_date=public_page.publication_date,
 952 |         )
 953 | 
 954 |         # Set the draft page translation matching language
 955 |         # to point to its public version.
 956 |         # Its important for draft to be published even if its state
 957 |         # is pending.
 958 |         self.update_translations(
 959 |             language,
 960 |             published=True,
 961 |             publisher_public=public_title,
 962 |             publisher_state=PUBLISHER_STATE_DEFAULT,
 963 |         )
 964 |         self._copy_contents(public_page, language)
 965 | 
 966 |         if self.node.is_branch:
 967 |             self.mark_descendants_as_published(language, site=self.site)
 968 | 
 969 |         if language in self.title_cache:
 970 |             del self.title_cache[language]
 971 | 
 972 |         # fire signal after publishing is done
 973 |         import cms.signals as cms_signals
 974 | 
 975 |         cms_signals.post_publish.send(sender=Page, instance=self, language=language)
 976 | 
 977 |         public_page.clear_cache(
 978 |             language,
 979 |             menu=True,
 980 |             placeholder=True,
 981 |         )
 982 |         return True
 983 | 
 984 |     def clear_cache(self, language=None, menu=False, placeholder=False):
 985 |         from cms.cache import invalidate_cms_page_cache
 986 | 
 987 |         if get_cms_setting('PAGE_CACHE'):
 988 |             # Clears all the page caches
 989 |             invalidate_cms_page_cache()
 990 | 
 991 |         sites = self.get_attached_sites().values_list('pk', flat=True)
 992 | 
 993 |         if placeholder and get_cms_setting('PLACEHOLDER_CACHE'):
 994 |             assert language, 'language is required when clearing placeholder cache'
 995 | 
 996 |             placeholders = self.get_placeholders()
 997 | 
 998 |             for site_id in sites:
 999 |                 for placeholder in placeholders:
1000 |                     placeholder.clear_cache(language, site_id=site_id)
1001 | 
1002 |         if menu:
1003 |             for site_id in sites:
1004 |                 # Clears all menu caches for this page's site
1005 |                 menu_pool.clear(site_id=site_id)
1006 | 
1007 |     def unpublish(self, language, site=None):
1008 |         """
1009 |         Removes this page from the public site
1010 |         :returns: True if this page was successfully unpublished
1011 |         """
1012 |         # Publish can only be called on draft pages
1013 |         if not self.publisher_is_draft:
1014 |             raise PublicIsUnmodifiable('The public instance cannot be unpublished. Use draft.')
1015 | 
1016 |         self.update_translations(
1017 |             language,
1018 |             published=False,
1019 |             publisher_state=PUBLISHER_STATE_DIRTY,
1020 |         )
1021 | 
1022 |         public_page = self.get_public_object()
1023 |         public_page.update_translations(language, published=False)
1024 |         public_page._clear_placeholders(language)
1025 |         public_page.clear_cache(language)
1026 | 
1027 |         self.mark_descendants_pending(language, site=site)
1028 | 
1029 |         from cms.signals import post_unpublish
1030 |         post_unpublish.send(sender=Page, instance=self, language=language)
1031 | 
1032 |         return True
1033 | 

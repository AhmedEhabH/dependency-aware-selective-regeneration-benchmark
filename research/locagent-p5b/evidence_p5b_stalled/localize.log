 123 |     def get_admin_url(self, action, *args):
 124 |         url_name = "{}_{}_{}".format(
 125 |             self.opts.app_label,
 126 |             self.opts.model_name,
 127 |             action,
 128 |         )
 129 |         return admin_reverse(url_name, args=args)

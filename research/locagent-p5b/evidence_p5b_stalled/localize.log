37 | def copy(self, target, language):
38 |         """
39 |         This method copies this extension to an unrelated-target. If you intend
40 |         to "publish" this extension to the publisher counterpart of target, then
41 |         use copy_to_publish() instead.
42 |         """
43 |         clone = self.__class__.objects.get(pk=self.pk)  # get a copy of this instance
44 |         clone.pk = None
45 |         clone.public_extension = None
46 |         clone.extended_object = target  # set the new public object
47 | 
48 |         # Nullify all concrete parent primary keys. See issue #5494
49 |         for parent, field in clone._meta.parents.items():
50 |             if field:
51 |                 setattr(clone, parent._meta.pk.attname, None)
52 | 
53 |         clone.save(mark_page=False)
54 | 
55 |         # If the target we're copying already has a publisher counterpart, then
56 |         # connect the dots.
57 |         target_prime = getattr(target, 'publisher_public')
58 |         if target_prime:
59 |             related_name = self.__class__.__name__.lower()
60 |             clone_prime = getattr(target_prime, related_name)
61 |             if clone_prime:
62 |                 clone.public_extension = clone_prime
63 |             else:
64 |                 clone.public_extension = None
65 | 
66 |         clone.copy_relations(self, language)
67 |         clone.save(force_update=True, mark_page=False)
68 |         return clone

 148 |     def get_object_with_translation(self, language, *args, **kwargs):
 149 |         page = self.get_object(*args, **kwargs)
 150 | 
 151 |         if page is None:
 152 |             return (None, None)
 153 | 
 154 |         try:
 155 |             translation = page.title_set.get(language=language)

1109 |     def mark_as_pending(self, language):
1110 |         assert self.publisher_is_draft
1111 |         assert self.publisher_public_id
1112 | 
1113 |         self.get_public_object().title_set.filter(language=language).update(published=False)
1114 | 
1115 |         if self.get_publisher_state(language) == PUBLISHER_STATE_DEFAULT:
1116 |             # Only change the state if the draft page is published
1117 |             # and it's state is the default (0), to avoid overriding a dirty state.
1118 |             self.set_publisher_state(language, state=PUBLISHER_STATE_PENDING)
1119 | 
1120 |     def mark_descendants_pending(self, language, site=None):
1121 |         from cms.models import Title
1122 | 
1123 |         if not self.publisher_is_draft:
1124 |             raise PublicIsUnmodifiable('The public instance cannot be altered. Use draft.')
1125 | 
1126 |         if site is None:
1127 |             site = self.site
1128 | 
1129 |         node = self.get_node_object(site)
1130 |         descendants = self.get_descendant_pages(
1131 |             site=site,
1132 |             concrete=self.site_is_secondary(site),
1133 |         )
1134 | 
1135 |         if descendants.exists():
1136 |             pending_drafts = Title.objects.filter(
1137 |                 published=True,
1138 |                 language=language,
1139 |                 page__in=descendants,
1140 |             )
1141 | 
1142 |             Title.objects.filter(
1143 |                 published=True,
1144 |                 language=language,
1145 |                 publisher_public__page__in=descendants,
1146 |             ).update(published=False)
1147 | 
1148 |             # Only change the state if the draft page is not dirty
1149 |             # to avoid overriding a dirty state.
1150 |             (pending_drafts
1151 |              .filter(publisher_state=PUBLISHER_STATE_DEFAULT)
1152 |              .update(publisher_state=PUBLISHER_STATE_PENDING))
1153 | 
1154 |         if self.site_is_secondary(site):
1155 |             return
1156 | 
1157 |         nodes = self.nodes.exclude(pk=node.pk).select_related('site')
1158 | 
1159 |         for node in nodes:
1160 |             self._nodes_cache.setdefault(node.site.pk, node)
1161 |             self.mark_descendants_pending(language, site=node.site)
1162 | 
1163 |     def mark_as_published(self, language):
1164 |         from cms.models import Title
1165 | 
1166 |         (Title
1167 |          .objects
1168 |          .filter(page=self.publisher_public_id, language=language)
1169 |          .update(publisher_state=PUBLISHER_STATE_DEFAULT, published=True))
1170 | 
1171 |         draft = self.get_draft_object()
1172 | 
1173 |         if draft.get_publisher_state(language) == PUBLISHER_STATE_PENDING:
1174 |             # A check for pending is necessary because the page might have
1175 |             # been modified after it was marked as pending.
1176 |             draft.set_publisher_state(language, PUBLISHER_STATE_DEFAULT)
1177 | 
1178 |     def mark_descendants_as_published(self, language, site=None):
1179 |         from cms.models import Title
1180 | 
1181 |         if not self.publisher_is_draft:
1182 |             raise PublicIsUnmodifiable('The public instance cannot be published. Use draft.')
1183 | 
1184 |         if site is None:
1185 |             site = self.site
1186 | 
1187 |         node = self.get_node_object(site)
1188 |         children = self.get_child_pages(
1189 |             site=site,
1190 |             concrete=self.site_is_secondary(site),
1191 |         )
1192 |         base = self.get_path(language, fallback=True)
1193 | 
1194 |         # Drafts
1195 |         draft_translations = Title.objects.filter(
1196 |             published=True,
1197 |             language=language,
1198 |             page__in=children,
1199 |         )
1200 | 
1201 |         # Set public pending titles as published
1202 |         unpublished_public = Title.objects.filter(
1203 |             language=language,
1204 |             publisher_public__published=True,
1205 |             publisher_public__page__in=children,
1206 |         )
1207 | 
1208 |         # Update public title paths
1209 |         unpublished_public.exclude(has_url_overwrite=True).update(
1210 |             path=Concat(models.Value(base), models.Value('/'), models.F('slug'))
1211 |         )
1212 | 
1213 |         # Set unpublished pending titles to published
1214 |         unpublished_public.filter(published=False).update(published=True)
1215 | 
1216 |         # Update drafts
1217 |         (draft_translations
1218 |          .filter(publisher_state=PUBLISHER_STATE_PENDING)
1219 |          .update(publisher_state=PUBLISHER_STATE_DEFAULT))
1220 | 
1221 |         # Continue publishing descendants, one branch at a time.
1222 |         published_children = children.filter(
1223 |             title_set__published=True,
1224 |             title_set__language=language,
1225 |         )
1226 | 
1227 |         for child in published_children.iterator():
1228 |             child.mark_descendants_as_published(language, site)
1229 | 
1230 |         if self.site_is_secondary(site):
1231 |             return
1232 | 
1233 |         nodes = self.nodes.exclude(pk=node.pk).select_related('site')
1234 | 
1235 |         for node in nodes:
1236 |             self._nodes_cache.setdefault(node.site.pk, node)
1237 |             self.mark_descendants_as_published(language, site=node.site)
1238 | 
1239 |     def revert_to_live(self, language):
1240 |         """Revert the draft version to the same state as the public version
1241 |         """
1242 |         if not self.publisher_is_draft:
1243 |             # Revert can only be called on draft pages
1244 |             raise PublicIsUnmodifiable('The public instance cannot be reverted. Use draft.')
1245 | 
1246 |         public = self.get_public_object()
1247 | 
1248 |         if not public:
1249 |             raise PublicVersionNeeded('A public version of this page is needed')
1250 | 
1251 |         public._copy_attributes(self)
1252 |         public._copy_contents(self, language)
1253 |         public._copy_titles(self, language, public.is_published(language))
1254 | 
1255 |         self.update_translations(
1256 |             language,
1257 |             published=True,
1258 |             publisher_state=PUBLISHER_STATE_DEFAULT,
1259 |         )
1260 |         self._publisher_keep_state = True
1261 |         self.save()

 304 |     def advanced(self, request, object_id):
 305 |         page = self.get_object(request, object_id=object_id)
 306 | 
 307 |         if not self.has_change_advanced_settings_permission(request, obj=page):
 308 |             raise PermissionDenied("No permission for editing advanced settings")
 309 | 
 310 |         if page is None:
 311 |             raise self._get_404_exception(object_id)
 312 | 
 313 |         # always returns a valid language
 314 |         language = get_site_language_from_request(request, current_page=page)
 315 |         language_obj = get_language_object(language, site_id=page.site_id)
 316 | 
 317 |         if not page.has_translation(language):
 318 |             # Can't edit advanced settings for a page translation (title)
 319 |             # that does not exist.
 320 |             message = _("Please create the %(language)s page "
 321 |                         "translation before editing it's advanced settings.")
 322 |             message = message % {'language': language_obj['name']}
 323 |             self.message_user(request, message, level=messages.ERROR)
 324 |             path = self.get_admin_url('change', object_id)
 325 |             return HttpResponseRedirect("%s?language=%s" % (path, language))
 326 |         return self.change_view(request, object_id, extra_context={'advanced_settings': True, 'title': _("Advanced Settings")})
 327 | 

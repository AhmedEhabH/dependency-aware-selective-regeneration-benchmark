 909 |     @require_POST
 910 |     @transaction.atomic
 911 |     def copy_page(self, request, page_id):
 912 |         """
 913 |         Copy the page and all its plugins and descendants to the requested
 914 |         target, at the given position
 915 |         """
 916 |         page = self.get_page_from_id(page_id)
 917 | 
 918 |         if page is None:
 919 |             return jsonify_request(HttpResponseBadRequest("error"))
 920 | 
 921 |         user = request.user
 922 |         site = self.get_site(request)
 923 |         form = self.copy_form(request.POST or None, page=page, site=site)
 924 | 
 925 |         if not form.is_valid():
 926 |             return jsonify_request(HttpResponseBadRequest("error"))
 927 | 
 928 |         target = form.cleaned_data['target']
 929 |         source_site = form.cleaned_data['source_site']
 930 | 
 931 |         # User can only copy pages he can see
 932 |         can_copy_page = page_permissions.user_can_view_page(user, page, source_site)
 933 | 
 934 |         if can_copy_page and target:
 935 |             # User can only copy a page into another one if he has permission
 936 |             # to add a page under the target page.
 937 |             can_copy_page = page_permissions.user_can_add_subpage(user, target, site)
 938 |         elif can_copy_page:
 939 |             # User can only copy / paste a page if he has permission to add a page
 940 |             can_copy_page = page_permissions.user_can_add_page(user, site)
 941 | 
 942 |         if not can_copy_page:
 943 |             message = force_text(_("Error! You don't have permissions to copy this page."))
 944 |             return jsonify_request(HttpResponseForbidden(message))
 945 | 
 946 |         new_page = form.copy_page()
 947 |         return HttpResponse(json.dumps({"id": new_page.pk}), content_type='application/json')

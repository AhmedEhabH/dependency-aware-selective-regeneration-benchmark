 189 |     @classmethod
 190 |     def set_homepage(cls, page, user=None):
 191 |         """
 192 |         Sets the given page as the homepage.
 193 |         Updates the title paths for all affected pages.
 194 |         Returns the old home page (if any).
 195 |         """
 196 |         assert page.publisher_is_draft
 197 | 
 198 |         if user:
 199 |             changed_by = get_clean_username(user)
 200 |         else:
 201 |             changed_by = constants.SCRIPT_USERNAME
 202 | 
 203 |         changed_date = now()
 204 | 
 205 |         try:
 206 |             old_home = cls.objects.get(
 207 |                 is_home=True,
 208 |                 site_id=page.site_id,
 209 |                 publisher_is_draft=True,
 210 |             )
 211 |         except cls.DoesNotExist:
 212 |             old_home_tree = []
 213 |         else:
 214 |             old_home.update(
 215 |                 draft_only=False,
 216 |                 is_home=False,
 217 |                 changed_by=changed_by,
 218 |                 changed_date=changed_date,
 219 |             )
 220 |             old_home_tree = old_home._set_title_root_path()
 221 | 
 222 |         page.update(
 223 |             draft_only=False,
 224 |             is_home=True,
 225 |             changed_by=changed_by,
 226 |             changed_date=changed_date,
 227 |         )
 228 |         new_home_tree = page._remove_title_root_path()
 229 |         return (new_home_tree, old_home_tree)
 230 | 
 231 |     def _update_title_path(self, language):
 232 |         parent_page = self.get_parent()
 233 | 
 234 |         if parent_page:
 235 |             base = parent_page.get_path(language, fallback=True)
 236 |         else:
 237 |             base = ''
 238 | 
 239 |         title_obj = self.get_title_obj(language, fallback=False)
 240 |         new_path = title_obj.get_path_for_base(base)
 241 |         title_obj.path = new_path
 242 |         title_obj.save()
 243 | 
 244 |     def _update_title_path_recursive(self, language, site=None):
 245 |         from cms.models import Title
 246 | 
 247 |         if site is None:
 248 |             node = self.node
 249 |         else:
 250 |             node = self.get_node_object(site)
 251 | 
 252 |         if node.is_leaf() or language not in self.get_languages():
 253 |             return
 254 | 
 255 |         base = self.get_path(language, fallback=True)
 256 |         pages = self.get_child_pages(site, concrete=True)
 257 | 
 258 |         (Title
 259 |          .objects
 260 |          .filter(language=language, page__in=pages)
 261 |          .exclude(has_url_overwrite=True)
 262 |          .update(path=Concat(models.Value(base), models.Value('/'), models.F('slug'))))
 263 | 
 264 |         for child in pages.filter(title_set__language=language).iterator():
 265 |             child._update_title_path_recursive(language, site=site)
 266 | 
 267 |         if self.site_is_secondary(site):
 268 |             return
 269 | 
 270 |         nodes = self.nodes.exclude(pk=node.pk).select_related('site')
 271 | 
 272 |         for node in nodes:
 273 |             self._nodes_cache.setdefault(node.site.pk, node)
 274 |             self._update_title_path_recursive(language, site=node.site)
 275 | 
 276 |     def _set_title_root_path(self, site=None):
 277 |         from cms.models import Title
 278 | 
 279 |         site = site or self.site
 280 |         node = self.get_node_object(site)
 281 |         node_descendants = node.get_concrete_descendants()
 282 |         draft_pages = list(node_descendants.values_list('page', flat=True))
 283 |         public_pages = list(
 284 |             Page
 285 |             .objects
 286 |             .filter(publisher_public__in=draft_pages)
 287 |             .values_list('pk', flat=True)
 288 |         )
 289 |         pages = (draft_pages + public_pages)
 290 |         translations = Title.objects.filter(page__in=pages, has_url_overwrite=False)
 291 | 
 292 |         for language, slug in self.title_set.values_list('language', 'slug'):
 293 |             # Update the translations for all descendants of this page
 294 |             # to include this page's slug as its path prefix
 295 |             (translations
 296 |              .filter(language=language)
 297 |              .update(path=Concat(models.Value(slug), models.Value('/'), 'path')))
 298 | 
 299 |             # Explicitly update this page's path to match its slug
 300 |             # Doing this is cheaper than a TRIM call to remove the "/" characters
 301 |             self.title_set.filter(language=language).update(path=slug)
 302 |         return pages
 303 | 
 304 |     def _remove_title_root_path(self, site=None):
 305 |         from cms.models import Title
 306 | 
 307 |         site = site or self.site
 308 |         node = self.get_node_object(site)
 309 |         node_descendants = node.get_descendants()
 310 |         draft_pages = list(node_descendants.values_list('page', flat=True))
 311 |         public_pages = list(
 312 |             Page
 313 |             .objects
 314 |             .filter(publisher_public__in=draft_pages)
 315 |             .values_list('pk', flat=True)
 316 |         )
 317 |         pages = [self.pk] + draft_pages + public_pages
 318 | 
 319 |         if self.publisher_public_id:
 320 |             pages.append(self.publisher_public_id)
 321 | 
 322 |         translations = Title.objects.filter(page__in=pages, has_url_overwrite=False)
 323 | 
 324 |         for language, slug in self.title_set.values_list('language', 'slug'):
 325 |             # Use 2 because of 1 indexing plus the fact we need to trim
 326 |             # the "/" character.
 327 |             trim_count = len(slug) + 2
 328 |             sql_func = models.Func(
 329 |                 models.F('path'),
 330 |                 models.Value(trim_count),
 331 |                 function='substr',
 332 |             )
 333 |             (translations
 334 |              .filter(language=language, path__startswith=slug)
 335 |              .update(path=sql_func))
 336 |         return pages
 337 | 
 338 |     def is_dirty(self, language):
 339 |         state = self.get_publisher_state(language)
 340 |         return state == PUBLISHER_STATE_DIRTY or state == PUBLISHER_STATE_PENDING
 341 | 
 342 |     def is_potential_home(self):
 343 |         """
 344 |         Encapsulates logic for determining if this page is eligible to be set
 345 |         as `is_home`. This is a public method so that it can be accessed in the
 346 |         admin for determining whether to enable the "Set as home" menu item.
 347 |         :return: Boolean
 348 |         """
 349 |         assert self.publisher_is_draft
 350 |         # Only root nodes are eligible for homepage
 351 |         return not self.is_home and bool(self.node.is_root())
 352 | 
 353 |     def get_absolute_url(self, language=None, fallback=True):
 354 |         if not language:
 355 |             language = get_current_language()
 356 | 
 357 |         with force_language(language):
 358 |             if self.is_home:
 359 |                 return reverse('pages-root')
 360 |             path = self.get_path(language, fallback) or self.get_slug(language, fallback)
 361 |             return reverse('pages-details-by-slug', kwargs={"slug": path})
 362 | 
 363 |     def get_public_url(self, language=None, fallback=True):
 364 |         """
 365 |         Returns the URL of the published version of the current page.
 366 |         Returns empty string if the page is not published.
 367 |         """
 368 |         try:
 369 |             return self.get_public_object().get_absolute_url(language, fallback)
 370 |         except:
 371 |             return ''

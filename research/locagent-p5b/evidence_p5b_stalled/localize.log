 511 |         if obj:
 512 |             filled_languages = [t[0] for t in obj.title_set.filter(title__isnull=False).values_list('language')]
 513 |         allowed_languages = [lang[0] for lang in self._get_site_languages(request, obj)]
 514 |         return [lang for lang in filled_languages if lang in allowed_languages]

 397 |     def change_view(self, request, object_id, form_url='', extra_context=None):
 398 |         """
 399 |         The 'change' admin view for the Page model.
 400 |         """
 401 |         if extra_context is None:
 402 |             extra_context = {'basic_info': True}
 403 | 
 404 |         obj = self.get_object(request, object_id=object_id)
 405 | 
 406 |         if not self.has_change_permission(request, obj):
 407 |             raise PermissionDenied
 408 | 
 409 |         if obj is None:
 410 |             raise self._get_404_exception(object_id)
 411 | 
 412 |         context = {
 413 |             'page': obj,
 414 |             'CMS_PERMISSION': get_cms_setting('PERMISSION'),
 415 |             'can_change': self.has_change_permission(request, obj=obj),
 416 |             'can_change_permissions': self.has_change_permissions_permission(request, obj=obj),
 417 |         }
 418 |         context.update(extra_context or {})
 419 |         extra_context = self.update_language_tab_context(request, obj, context)
 420 | 
 421 |         if 'advanced_settings' in extra_context or 'basic_info' in extra_context:
 422 |             _has_advanced_settings_perm = self.has_change_advanced_settings_permission(request, obj=obj)
 423 |             extra_context['can_change_advanced_settings'] = _has_advanced_settings_perm
 424 | 
 425 |         tab_language = get_site_language_from_request(request)
 426 |         extra_context.update(self.get_unihandecode_context(tab_language))
 427 | 
 428 |         response = super(BasePageAdmin, self).change_view(
 429 |             request, object_id, form_url=form_url, extra_context=extra_context)
 430 |         if tab_language and response.status_code == 302 and response._headers['location'][1] == request.path_info:
 431 |             location = response._headers['location']
 432 |             response._headers['location'] = (location[0], "%s?language=%s" % (location[1], tab_language))
 433 |         return response

 803 |     def get_path(self, language, fallback=True):
 804 |         """Get the path of the page depending on the given language"""
 805 |         languages = [language]
 806 | 
 807 |         if fallback:
 808 |             languages.extend(self.get_fallbacks(language))
 809 | 
 810 |         page_languages = self.get_languages()
 811 | 
 812 |         for _language in languages:
 813 |             if _language in page_languages:
 814 |                 language = _language
 815 |                 break
 816 | 
 817 |         if language not in self.urls_cache:
 818 |             self.urls_cache.update({
 819 |                 url.language: url for url in self.urls.all() if url.language in languages # TODO: overwrites multiple urls
 820 |             })
 821 | 
 822 |             for _language in languages:
 823 |                 self.urls_cache.setdefault(_language, None)
 824 | 
 825 |         try:
 826 |             return self.urls_cache[language].path
 827 |         except (AttributeError, KeyError):

 171 |         if site.pk in self._nodes_cache:
 172 |             # node is cached.
 173 |             # clear it to trigger a re-fetch with new tree attributes
 174 |             del self._nodes_cache[site.pk]
 175 | 
 176 |     @cached_property
 177 |     def node(self):
 178 |         if hasattr(self, '_site_cache'):
 179 |             #TODO: This changed in Django 2.0
 180 |             return self.get_node_object(site=self.site)
 181 | 
 182 |         try:
 183 |             node = self._nodes_cache[self.site_id]
 184 |         except KeyError:
 185 |             node = self._get_node_object(self.site_id)
 186 |             self._nodes_cache[self.site_id] = node
 187 |         return node

 591 |     def copy(self, site, parent_node=None, language=None,
 592 |              translations=True, permissions=False, extensions=True):
 593 |         from cms.utils.page import get_available_slug
 594 | 
 595 |         new_page = copy.copy(self)
 596 |         new_page.pk = None
 597 |         new_page.site = site
 598 |         new_page.publisher_public_id = None
 599 |         new_page.is_home = False
 600 |         new_page.reverse_id = None
 601 |         new_page.publication_date = None
 602 |         new_page.publication_end_date = None
 603 |         new_page.title_cache = {}
 604 |         new_page.languages = ''
 605 |         new_page.save()
 606 | 
 607 |         if 'node' in new_page.__dict__:
 608 |             del new_page.__dict__['node']
 609 | 
 610 |         if hasattr(new_page, '_prefetched_objects_cache'):
 611 |             del new_page._prefetched_objects_cache
 612 | 
 613 |         if parent_node:
 614 |             new_node = parent_node.add_child(page=new_page, site=site)
 615 |             parent_page = parent_node.page
 616 |         else:
 617 |             new_node = PageNode.add_root(page=new_page, site=site)
 618 |             parent_page = None
 619 | 
 620 |         new_page._nodes_cache = {site.pk: new_node}
 621 | 
 622 |         if language and translations:
 623 |             translations = self.title_set.filter(language=language)
 624 |         elif translations:
 625 |             translations = self.title_set.all()
 626 |         else:
 627 |             translations = self.title_set.none()
 628 | 
 629 |         # copy titles of this page
 630 |         for title in translations:
 631 |             title = copy.copy(title)
 632 |             title.pk = None
 633 |             title.page = new_page
 634 |             title.published = False
 635 |             title.publisher_public = None
 636 | 
 637 |             if parent_node:
 638 |                 base = parent_page.get_path(title.language)
 639 |                 path = u'%s/%s' % (base, title.slug)
 640 |             else:
 641 |                 base = ''
 642 |                 path = title.slug
 643 | 
 644 |             slug = get_available_slug(site, path, title.language)
 645 | 
 646 |             title.slug = slug
 647 |             title.path = '%s/%s' % (base, slug) if base else slug
 648 |             title.save()
 649 | 
 650 |             new_page.title_cache[title.language] = title
 651 | 
 652 |         # copy the placeholders (and plugins on those placeholders!)
 653 |         for placeholder in self.placeholders.iterator():
 654 |             new_placeholder = copy.copy(placeholder)
 655 |             new_placeholder.pk = None
 656 |             new_placeholder.save()
 657 |             new_page.placeholders.add(new_placeholder)
 658 |             placeholder.copy_plugins(new_placeholder, language=language)
 659 | 
 660 |         if extensions:
 661 |             from cms.extensions import extension_pool
 662 |             extension_pool.copy_extensions(self, new_page)
 663 | 
 664 |         # copy permissions if requested
 665 |         if permissions and get_cms_setting('PERMISSION'):
 666 |             permissions = self.pagepermission_set.iterator()
 667 |             permissions_new = []
 668 | 
 669 |             for permission in permissions:
 670 |                 permission.pk = None
 671 |                 permission.page = new_page
 672 |                 permissions_new.append(permission)
 673 | 
 674 |             if permissions_new:
 675 |                 new_page.pagepermission_set.bulk_create(permissions_new)
 676 | 
 677 |         if self.site_is_secondary(site):
 678 |             return new_page
 679 | 
 680 |         # user is copying a primary page
 681 |         # create a node for each site the page was attached to
 682 |         attached_sites = self.get_attached_sites().exclude(pk=site.pk)
 683 | 
 684 |         if parent_node:
 685 |             # There's a parent node, filter out sites that the parent
 686 |             # page has not been attached to.
 687 |             for site in attached_sites.filter(djangocms_page_nodes__page=parent_page):
 688 |                 target = parent_node.get_remote(site)
 689 |                 target.add_child(page=new_page, site=site)
 690 |         else:
 691 |             for site in attached_sites:
 692 |                 PageNode.add_root(page=new_page, site=site)
 693 |         return new_page
 694 | 
 695 |     def copy_with_descendants(self, site, target_node=None, position=None,
 696 |                               copy_permissions=True, target_site=None):
 697 |         """
 698 |         Copy a page [ and all its descendants to a new location ]
 699 |         """
 700 |         if not self.publisher_is_draft:
 701 |             raise PublicIsUnmodifiable("copy page is not allowed for public pages")
 702 | 
 703 |         if target_site is None:
 704 |             target_site = site
 705 | 
 706 |         if position in ('first-child', 'last-child'):
 707 |             parent_node = target_node
 708 |         elif target_node:
 709 |             parent_node = target_node.parent
 710 |         else:
 711 |             parent_node = None
 712 | 
 713 |         node = self.get_node_object(site)
 714 |         # Evaluate the descendants queryset BEFORE copying the page.
 715 |         # Otherwise, if the page is copied and pasted on itself, it will duplicate.
 716 |         descendants = list(node.get_descendants().prefetch_related('page__title_set'))
 717 |         new_root_page = self.copy(target_site, parent_node=parent_node)
 718 |         new_root_node = new_root_page.get_node_object(target_site)
 719 | 
 720 |         if target_node and position in ('first-child'):
 721 |             # target node is a parent and user has requested to
 722 |             # insert the new page as its first child
 723 |             new_root_node.move(target_node, position)
 724 |             new_root_node.refresh_from_db(fields=('path', 'depth'))
 725 | 
 726 |         if target_node and position in ('left', 'last-child'):
 727 |             # target node is a sibling
 728 |             new_root_node.move(target_node, position)
 729 |             new_root_node.refresh_from_db(fields=('path', 'depth'))
 730 | 
 731 |         nodes_by_id = {node.pk: new_root_node}
 732 | 
 733 |         for node in descendants:
 734 |             parent = nodes_by_id[node.parent_id]
 735 |             new_page = node.page.copy(
 736 |                 target_site,
 737 |                 parent_node=parent,
 738 |                 translations=True,
 739 |                 permissions=copy_permissions,
 740 |             )
 741 |             nodes_by_id[node.pk] = new_page.get_node_object(target_site)
 742 |         return new_root_page
 743 | 
 744 |     def delete(self, *args, **kwargs):
 745 |         nodes = self.nodes.all()
 746 |         parents = set()
 747 |         query = models.Q(pk=self.pk)
 748 | 
 749 |         for node in nodes:
 750 |             if node.parent_id:
 751 |                 parents.add(node.parent_id)
 752 |             query |= models.Q(nodes__path__startswith=node.path)
 753 | 
 754 |         self.__class__.objects.filter(query).delete()
 755 |         (PageNode
 756 |          .objects
 757 |          .filter(pk__in=parents)
 758 |          .update(numchild=models.F('numchild') - 1))
 759 |         self.clear_cache(menu=True)
 760 | 
 761 |     def delete_translations(self, language=None):
 762 |         if language is None:
 763 |             languages = self.get_languages()
 764 |         else:
 765 |             languages = [language]
 766 | 
 767 |         self.title_set.filter(language__in=languages).delete()
 768 | 
 769 |         for language in languages:
 770 |             self.mark_descendants_pending(language)
 771 | 
 772 |     def save(self, no_signals=False, commit=True, **kwargs):
 773 |         """
 774 |         Args:
 775 |             commit: True if model should be really saved
 776 |         """
 777 |         # delete template cache
 778 |         if hasattr(self, '_template_cache'):
 779 |             delattr(self, '_template_cache')
 780 | 
 781 |         created = not bool(self.pk)
 782 |         if self.reverse_id == "":
 783 |             self.reverse_id = None
 784 |         if self.application_namespace == "":
 785 |             self.application_namespace = None
 786 |         from cms.utils.permissions import get_current_user_name
 787 | 
 788 |         self.changed_by = get_current_user_name()
 789 | 
 790 |         if created:
 791 |             self.created_by = self.changed_by
 792 | 
 793 |         if commit:
 794 |             super(Page, self).save(**kwargs)
 795 | 
 796 |     def save_base(self, *args, **kwargs):
 797 |         """Overridden save_base. If an instance is draft, and was changed, mark
 798 |         it as dirty.
 799 | 
 800 |         Dirty flag is used for changed nodes identification when publish method
 801 |         takes place. After current changes are published, state is set back to
 802 |         PUBLISHER_STATE_DEFAULT (in publish method).
 803 |         """
 804 |         keep_state = getattr(self, '_publisher_keep_state', None)
 805 |         if self.publisher_is_draft and not keep_state and self.is_new_dirty():
 806 |             self.title_set.all().update(publisher_state=PUBLISHER_STATE_DIRTY)
 807 |         if keep_state:
 808 |             delattr(self, '_publisher_keep_state')
 809 |         return super(Page, self).save_base(*args, **kwargs)
 810 | 
 811 |     def update(self, refresh=False, draft_only=True, **data):
 812 |         assert self.publisher_is_draft
 813 | 
 814 |         cls = self.__class__
 815 | 
 816 |         if not draft_only and self.publisher_public_id:
 817 |             ids = [self.pk, self.publisher_public_id]
 818 |             cls.objects.filter(pk__in=ids).update(**data)
 819 |         else:
 820 |             cls.objects.filter(pk=self.pk).update(**data)
 821 | 
 822 |         if refresh:
 823 |             return self.reload()
 824 |         else:
 825 |             for field, value in data.items():
 826 |                 setattr(self, field, value)
 827 |         return
 828 | 
 829 |     def update_translations(self, language=None, **data):
 830 |         if language:
 831 |             translations = self.title_set.filter(language=language)
 832 |         else:
 833 |             translations = self.title_set.all()
 834 |         return translations.update(**data)
 835 | 
 836 |     def has_translation(self, language):
 837 |         return self.title_set.filter(language=language).exists()
 838 | 
 839 |     def is_new_dirty(self):
 840 |         if self.pk:
 841 |             fields = [
 842 |                 'publication_date', 'publication_end_date', 'in_navigation', 'soft_root', 'reverse_id',
 843 |                 'navigation_extenders', 'template', 'login_required', 'limit_visibility_in_menu'
 844 |             ]
 845 |             try:
 846 |                 old_page = Page.objects.get(pk=self.pk)
 847 |             except Page.DoesNotExist:
 848 |                 return True
 849 |             for field in fields:
 850 |                 old_val = getattr(old_page, field)
 851 |                 new_val = getattr(self, field)
 852 |                 if not old_val == new_val:
 853 |                     return True
 854 |             return False
 855 |         return True
 856 | 
 857 |     def is_published(self, language, force_reload=False):
 858 |         title_obj = self.get_title_obj(language, fallback=False, force_reload=force_reload)
 859 |         return title_obj.published and title_obj.publisher_state != PUBLISHER_STATE_PENDING
 860 | 
 861 |     def is_reachable(self):
 862 |         the_now = now()
 863 |         reachable = True
 864 | 
 865 |         if self.publication_date:
 866 |             reachable = self.publication_date <= the_now
 867 | 
 868 |         if self.publication_end_date:
 869 |             reachable = reachable and self.publication_end_date > the_now
 870 |         return reachable
 871 | 
 872 |     def toggle_in_navigation(self, set_to=None):
 873 |         '''
 874 |         Toggles (or sets) in_navigation and invalidates the cms page cache
 875 |         '''
 876 |         old = self.in_navigation
 877 |         if set_to in [True, False]:
 878 |             self.in_navigation = set_to
 879 |         else:
 880 |             self.in_navigation = not self.in_navigation
 881 |         self.save()
 882 | 
 883 |         # If there was a change, invalidate the cms page cache
 884 |         if self.in_navigation != old:
 885 |             self.clear_cache()
 886 |         return self.in_navigation

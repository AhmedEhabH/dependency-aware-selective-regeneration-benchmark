1367 |     def get_tree_rows(self, request, nodes, language, depth=1,
1368 |                       follow_descendants=True):
1369 |         """
1370 |         Used for rendering the page tree, inserts into context everything what
1371 |         we need for single item
1372 |         """
1373 |         user = request.user
1374 |         site = self.get_site(request)
1375 |         permissions_on = get_cms_setting('PERMISSION')
1376 |         template = get_template(self.page_tree_row_template)
1377 |         is_popup = (IS_POPUP_VAR in request.POST or IS_POPUP_VAR in request.GET)
1378 |         languages = get_language_list(site.pk)
1379 |         user_can_add = page_permissions.user_can_add_subpage
1380 | 
1381 |         def render_page_row(node):
1382 |             page = node.page
1383 |             page.title_cache = {trans.language: trans for trans in page.filtered_translations}
1384 | 
1385 |             for _language in languages:
1386 |                 # EmptyTitle is used to prevent the cms from trying
1387 |                 # to find a translation in the database
1388 |                 page.title_cache.setdefault(_language, EmptyTitle(language=_language))
1389 | 
1390 |             has_move_page_permission = self.has_move_page_permission(request, obj=page)
1391 | 
1392 |             if permissions_on and not has_move_page_permission:
1393 |                 # TODO: check if this is really needed
1394 |                 metadata = '{"valid_children": False, "draggable": False}'
1395 |             else:
1396 |                 metadata = ''
1397 | 
1398 |             context = {
1399 |                 'admin': self,
1400 |                 'opts': self.opts,
1401 |                 'site': site,
1402 |                 'node': node,
1403 |                 'page': page,
1404 |                 'ancestors': node.get_cached_ancestors(),
1405 |                 'descendants': node.get_cached_descendants(),
1406 |                 'request': request,
1407 |                 'lang': language,
1408 |                 'metadata': metadata,
1409 |                 'is_shared_page': page.site_is_secondary(site),
1410 |                 'page_languages': page.get_languages(),
1411 |                 'preview_language': language,
1412 |                 'follow_descendants': follow_descendants,
1413 |                 'site_languages': languages,
1414 |                 'is_popup': is_popup,
1415 |                 'has_add_page_permission': user_can_add(user, target=page),
1416 |                 'has_change_permission': self.has_change_permission(request, obj=page),
1417 |                 'has_publish_permission':  self.has_publish_permission(request, obj=page),
1418 |                 'has_change_advanced_settings_permission': self.has_change_advanced_settings_permission(request, obj=page),
1419 |                 'has_move_page_permission': has_move_page_permission,
1420 |             }
1421 |             return template.render(context)
1422 | 
1423 |         if follow_descendants:
1424 |             root_nodes = (node for node in nodes if node.depth == depth)
1425 |         else:
1426 |             # When the tree is filtered, it's displayed as a flat structure
1427 |             root_nodes = nodes
1428 | 
1429 |         if depth == 1:
1430 |             for node in root_nodes:
1431 |                 node._set_hierarchy(nodes)
1432 |                 yield render_page_row(node)
1433 |         else:
1434 |             for node in root_nodes:
1435 |                 yield render_page_row(node)

 917 |     def _get_page_content_cache(self, language, fallback, force_reload):
 918 |         """
 919 |         Sets the internal page object cache for page content objects available to the general user.
 920 |         It optionally respe
 921 |         """
 922 |         def get_fallback_language(page, language):
 923 |             fallback_langs = i18n.get_fallback_languages(language)
 924 |             for lang in fallback_langs:
 925 |                 if page.page_content_cache.get(lang):
 926 |                     return lang
 927 | 
 928 |         if not language:
 929 |             language = get_language()
 930 | 
 931 |         # Update page_content_cache from _prefetched_objects_cache if available
 932 |         prefetch_cache = getattr(self, "_prefetched_objects_cache", {})
 933 |         cached_page_content = prefetch_cache.get("pagecontent_set", [])
 934 |         for page_content in cached_page_content:
 935 |             self.page_content_cache[page_content.language] = page_content
 936 | 
 937 |         # Reload if explicitly needed or language not in content cache
 938 |         if force_reload or language not in self.page_content_cache:
 939 |             for page_content in self.pagecontent_set.all():
 940 |                 self.page_content_cache[page_content.language] = page_content
 941 | 
 942 |         if self.page_content_cache.get(language):
 943 |             return language
 944 | 
 945 |         use_fallback = all([
 946 |             fallback,
 947 |             not self.page_content_cache.get(language),
 948 |             get_fallback_language(self, language)
 949 |         ])
 950 |         if use_fallback:
 951 |             # language can be in the cache but might be an EmptyPageContent instance
 952 |             return get_fallback_language(self, language)
 953 |         return language
 954 | 

1116 |     @require_POST
1117 |     @transaction.atomic
1118 |     def unpublish(self, request, page_id, language):
1119 |         """
1120 |         Publish or unpublish a language of a page
1121 |         """
1122 |         page = self.get_object(request, object_id=page_id)
1123 | 
1124 |         if not self.has_publish_permission(request, obj=page):
1125 |             return HttpResponseForbidden(force_text(_("You do not have permission to unpublish this page")))
1126 | 
1127 |         if page is None:
1128 |             raise self._get_404_exception(page_id)
1129 | 
1130 |         if not page.publisher_public_id:
1131 |             return HttpResponseBadRequest(force_text(_("This page was never published")))
1132 | 
1133 |         has_translation = page.publisher_public.title_set.filter(language=language).exists()
1134 | 
1135 |         if not has_translation:
1136 |             raise Http404('No translation matches requested language.')
1137 | 
1138 |         language_name = get_language_object(language, site_id=page.site_id)['name']
1139 | 
1140 |         try:
1141 |             page.unpublish(language)
1142 |             message = _('The %(language)s page "%(page)s" was successfully unpublished') % {
1143 |                 'language': language_name, 'page': page}
1144 |             messages.info(request, message)
1145 |             LogEntry.objects.log_action(
1146 |                 user_id=request.user.id,
1147 |                 content_type_id=ContentType.objects.get_for_model(Page).pk,
1148 |                 object_id=page_id,
1149 |                 object_repr=page.get_title(),
1150 |                 action_flag=CHANGE,
1151 |                 change_message=message,
1152 |             )
1153 |         except RuntimeError:
1154 |             exc = sys.exc_info()[1]
1155 |             messages.error(request, exc.message)
1156 |         except ValidationError:

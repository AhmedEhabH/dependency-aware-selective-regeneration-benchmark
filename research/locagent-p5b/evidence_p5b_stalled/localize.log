 380 |                 return None
 381 | 
 382 |     def set_tree_node(self, site, target=None, position='first-child'):
 383 |         warnings.warn(
 384 |             "Method `set_tree_node` is deprecated. Use `add_to_tree` instead.",
 385 |             RemovedInDjangoCMS43Warning,
 386 |             stacklevel=2
 387 |         )
 388 |         self.site = site
 389 |         self.parent = target
 390 |         return self.add_to_tree(position=position)
 391 | 
 392 |     def add_to_tree(self, position='first-child'):
 393 |         assert position in ('last-child', 'first-child', 'left', 'right')
 394 | 
 395 |         if self.parent is None:
 396 |             Page.add_root(instance=self)
 397 |         elif position == 'first-child' and self.parent.is_branch:
 398 |             self.parent.get_first_child().add_sibling(pos='left', instance=self)
 399 |         elif position in ('last-child', 'first-child'):
 400 |             self.parent.add_child(instance=self)
 401 |         else:
 402 |             self.parent.add_sibling(pos=position, instance=self)
 403 | 
 404 |     def move_page(self, target_page, position='first-child'):
 405 |         """
 406 |         Called from admin interface when page is moved. Should be used on
 407 |         all the places which are changing page position. Used like an interface
 408 |         to django-treebeard, but after move is done page_moved signal is fired.
 409 |         """
 410 |         assert isinstance(target_page, Page), f"{target_page} is not an instance of Page."
 411 |         inherited_template = self.template == constants.TEMPLATE_INHERITANCE_MAGIC
 412 | 
 413 |         if inherited_template and target_page.is_root() and position in ('left', 'right'):
 414 |             # The page is being moved to a root position.
 415 |             # Explicitly set the inherited template on the titles
 416 |             # to keep all plugins / placeholders.
 417 |             template = self.get_template()
 418 |             self.update_translations(template=template)
 419 | 
 420 |         # Don't use a cached node. Always get a fresh one.
 421 |         self._clear_internal_cache()
 422 | 
 423 |         # Runs the SQL updates on the treebeard fields
 424 |         self.move(target_page, position)
 425 | 
 426 |         if position in ('first-child', 'last-child'):
 427 |             self.parent = target_page
 428 |         else:
 429 |             # moving relative to sibling
 430 |             # or to the root of the tree
 431 |             self.parent = target_page.parent
 432 |         # Runs the SQL updates on the parent field
 433 |         self.update(parent=self.parent)
 434 |         self.refresh_from_db(fields=('path', 'depth'))
 435 | 
 436 |         # Update the urls for the page being moved
 437 |         # and is descendants.
 438 |         languages = (
 439 |             self
 440 |             .urls
 441 |             .filter(language__in=self.get_languages())
 442 |             .values_list('language', flat=True)
 443 |         )
 444 | 
 445 |         for language in languages:
 446 |             if not self.is_home:
 447 |                 self._update_url_path(language)
 448 |             self._update_url_path_recursive(language)
 449 |         self.clear_cache(menu=True)
 450 |         return self
 451 | 
 452 |     def _clear_placeholders(self, language):
 453 |         from cms.models import CMSPlugin
 454 | 
 455 |         placeholders = self.get_placeholders(language)
 456 |         placeholder_ids = (placeholder.pk for placeholder in placeholders)
 457 |         plugins = CMSPlugin.objects.filter(placeholder__in=placeholder_ids, language=language)
 458 |         models.query.QuerySet.delete(plugins)
 459 |         return placeholders
 460 | 
 461 |     def copy(self, site, parent_page=None, parent_node=None, language=None,
 462 |              translations=True, permissions=False, extensions=True, user=None):
 463 |         from cms.models import PageContent
 464 |         from cms.utils.page import get_available_slug
 465 | 
 466 |         assert parent_page is None or isinstance(parent_page, Page), f"{parent_page} is not an instance of Page."
 467 |         assert isinstance(user, get_user_model()), f"{user} is not an instance of User."
 468 | 
 469 |         if parent_node is not None:
 470 |             warnings.warn(
 471 |                 "Argument `parent_node` is deprecated. Use `parent_page` instead.",
 472 |                 RemovedInDjangoCMS43Warning,
 473 |                 stacklevel=2,
 474 |             )
 475 |             parent_page = parent_page or parent_node
 476 | 
 477 |         if parent_page:
 478 |             new_page = parent_page.add_child(site=site)
 479 |         else:
 480 |             new_page = Page.add_root(site=site)
 481 | 
 482 |         new_page._state = ModelState()
 483 |         new_page._clear_internal_cache()
 484 | 
 485 |         if language and translations:
 486 |             page_urls = self.urls.filter(language=language)
 487 |             translations = self.pagecontent_set(manager="admin_manager").filter(language=language)
 488 |         elif translations:
 489 |             page_urls = self.urls.all()
 490 |             translations = self.pagecontent_set(manager="admin_manager")
 491 |         else:
 492 |             page_urls = self.urls.none()
 493 |             translations = self.pagecontent_set(manager="admin_manager").none()
 494 |         translations = translations.prefetch_related('placeholders')
 495 | 
 496 |         for page_url in page_urls:
 497 |             new_url = model_to_dict(page_url)
 498 |             new_url.pop("id", None)  # No PK
 499 |             new_url["page"] = new_page
 500 | 
 501 |             if parent_page:
 502 |                 base = parent_page.get_path(page_url.language)
 503 |                 path = f'{base}/{page_url.slug}' if base else page_url.slug
 504 |             else:
 505 |                 base = ''
 506 |                 path = page_url.slug
 507 | 
 508 |             new_url["slug"] = get_available_slug(site, path, page_url.language)
 509 |             new_url["path"] = '{}/{}'.format(base, new_url["slug"]) if base else new_url["slug"]
 510 |             PageUrl.objects.with_user(user).create(**new_url)
 511 | 
 512 |         # copy titles of this page
 513 |         for title in translations.current_content():
 514 |             new_title = model_to_dict(title)
 515 |             new_title.pop("id", None)  # No PK
 516 |             new_title["page"] = new_page
 517 |             new_title = PageContent.objects.with_user(user).create(**new_title)
 518 | 
 519 |             for placeholder in title.placeholders.all():
 520 |                 # copy the placeholders (and plugins on those placeholders!)
 521 |                 new_placeholder = new_title.placeholders.create(
 522 |                     slot=placeholder.slot,
 523 |                     default_width=placeholder.default_width,
 524 |                 )
 525 |                 placeholder.copy_plugins(new_placeholder, language=new_title.language)
 526 |             new_page.page_content_cache[new_title.language] = new_title
 527 |         new_page.update_languages([trans.language for trans in translations])
 528 | 
 529 |         if extensions:
 530 |             from cms.extensions import extension_pool
 531 |             extension_pool.copy_extensions(self, new_page)
 532 | 
 533 |         # copy permissions if requested
 534 |         if permissions and get_cms_setting('PERMISSION'):
 535 |             permissions = self.pagepermission_set.iterator()
 536 |             permissions_new = []
 537 | 
 538 |             for permission in permissions:
 539 |                 permission.pk = None
 540 |                 permission.page = new_page
 541 |                 permissions_new.append(permission)
 542 | 
 543 |             if permissions_new:
 544 |                 new_page.pagepermission_set.bulk_create(permissions_new)
 545 |         return new_page
 546 | 
 547 |     def copy_with_descendants(self, target_page=None, target_node=None, position=None,
 548 |                               copy_permissions=True, target_site=None, user=None):
 549 |         """
 550 |         Copy a page [ and all its descendants to a new location ]
 551 |         """
 552 |         from cms.models import PageContent
 553 | 
 554 |         if target_node is not None:
 555 |             warnings.warn(
 556 |                 "Argument `parent_node` is deprecated. Use `parent_page` instead.",
 557 |                 RemovedInDjangoCMS43Warning,
 558 |                 stacklevel=2,
 559 |             )
 560 |             target_page = target_page or target_node
 561 | 
 562 |         if position in ('first-child', 'last-child'):
 563 |             parent_page = target_page
 564 |         elif target_page:
 565 |             parent_page = target_page.parent
 566 |         else:
 567 |             parent_page = None
 568 | 
 569 |         if target_site is None:
 570 |             target_site = parent_page.site if parent_page else self.site
 571 | 
 572 |         # Evaluate the descendants queryset BEFORE copying the page.
 573 |         # Otherwise, if the page is copied and pasted on itself, it will duplicate.
 574 |         descendants = list(
 575 |             self.get_descendant_pages()
 576 |             .prefetch_related(
 577 |                 'urls',
 578 |                 Prefetch('pagecontent_set', queryset=PageContent.admin_manager.all()),
 579 |             )
 580 |         )
 581 |         new_root_page = self.copy(target_site, parent_page=parent_page, user=user)
 582 | 
 583 |         if target_page and position in ('first-child'):
 584 |             # target page is a parent and user has requested to
 585 |             # insert the new page as its first child
 586 |             new_root_page.move(target_page, position)
 587 |             new_root_page.refresh_from_db(fields=('path', 'depth'))
 588 | 
 589 |         if target_page and position in ('left', 'last-child'):
 590 |             # target page is a sibling
 591 |             new_root_page.move(target_page, position)
 592 |             new_root_page.refresh_from_db(fields=('path', 'depth'))
 593 | 
 594 |         pages_by_id = {self.id: new_root_page}
 595 |         for page in descendants:
 596 |             parent = pages_by_id[page.parent_id]
 597 |             pages_by_id[page.id] = page.copy(
 598 |                 target_site,
 599 |                 parent_page=parent,
 600 |                 translations=True,
 601 |                 permissions=copy_permissions,
 602 |                 user=user
 603 |             )
 604 |         return new_root_page
 605 | 
 606 |     def delete(self, *args, **kwargs):

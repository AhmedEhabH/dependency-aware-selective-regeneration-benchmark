 285 |     def duplicate(self, request, object_id):
 286 |         """
 287 |         Leverages the add view logic to duplicate the page.
 288 |         """
 289 |         page = self.get_object(request, object_id=object_id)
 290 | 
 291 |         if page is None:
 292 |             raise self._get_404_exception(object_id)
 293 | 
 294 |         request = copy.copy(request)
 295 | 
 296 |         if request.method == 'GET':
 297 |             # source is a field in the form
 298 |             # because its value is in the url,
 299 |             # we have to set the initial value manually
 300 |             request.GET = request.GET.copy()
 301 |             request.GET['source'] = page.pk
 302 |         return self.add_view(request)

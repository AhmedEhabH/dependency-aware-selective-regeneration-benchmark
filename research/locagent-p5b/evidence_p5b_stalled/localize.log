487 | def copy_plugins_to_language(page, source_language, target_language,
488 |                              only_empty=True):
489 |     """
490 |     Copy the plugins to another language in the same page for all the page
491 |     placeholders.
492 | 
493 |     By default plugins are copied only if placeholder has no plugin for the
494 |     target language; use ``only_empty=False`` to change this.
495 | 
496 |     .. warning: This function skips permissions checks
497 | 
498 |     :param page: the page to copy
499 |     :type page: :class:`cms.models.pagemodel.Page` instance
500 |     :param string source_language: The source language code,
501 |      must be in :setting:`django:LANGUAGES`
502 |     :param string target_language: The source language code,
503 |      must be in :setting:`django:LANGUAGES`
504 |     :param bool only_empty: if False, plugin are copied even if
505 |      plugins exists in the target language (on a placeholder basis).
506 |     :return int: number of copied plugins
507 |     """
508 |     copied = 0
509 |     placeholders = page.get_placeholders()
510 |     for placeholder in placeholders:
511 |         # only_empty is True we check if the placeholder already has plugins and
512 |         # we skip it if has some
513 |         if not only_empty or not placeholder.get_plugins(language=target_language).exists():
514 |             plugins = list(
515 |                 placeholder.get_plugins(language=source_language).order_by('path'))
516 |             copied_plugins = copy_plugins.copy_plugins_to(plugins, placeholder, target_language)
517 |             copied += len(copied_plugins)
518 |     return copied

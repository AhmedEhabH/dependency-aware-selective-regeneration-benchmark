 949 |     @require_POST
 950 |     @transaction.atomic
 951 |     def revert_to_live(self, request, page_id, language):
 952 |         """
 953 |         Resets the draft version of the page to match the live one
 954 |         """
 955 |         page = self.get_object(request, object_id=page_id)
 956 | 
 957 |         if not self.has_revert_to_live_permission(request, language, obj=page):
 958 |             return HttpResponseForbidden(force_text(_("You do not have permission to revert this page.")))
 959 | 
 960 |         if page is None:
 961 |             raise self._get_404_exception(page_id)
 962 | 
 963 |         try:
 964 |             translation = page.title_set.get(language=language)
 965 |         except Title.DoesNotExist:
 966 |             raise Http404('No translation matches requested language.')
 967 | 
 968 |         page.title_cache[language] = translation
 969 |         operation_token = self._send_pre_page_operation(
 970 |             request,
 971 |             operation=operations.REVERT_PAGE_TRANSLATION_TO_LIVE,
 972 |             obj=page,
 973 |             translation=translation,
 974 |         )
 975 | 
 976 |         page.revert_to_live(language)
 977 | 
 978 |         # Fetch updated translation
 979 |         translation.refresh_from_db()
 980 | 
 981 |         self._send_post_page_operation(
 982 |             request,
 983 |             operation=operations.REVERT_PAGE_TRANSLATION_TO_LIVE,
 984 |             token=operation_token,
 985 |             obj=page,
 986 |             translation=translation,
 987 |         )
 988 | 
 989 |         messages.info(request, _('"%s" was reverted to the live version.') % page)
 990 | 
 991 |         path = page.get_absolute_url(language=language)
 992 |         path = '%s?%s' % (path, get_cms_setting('CMS_TOOLBAR_URL__EDIT_OFF'))
 993 |         return HttpResponseRedirect(path)

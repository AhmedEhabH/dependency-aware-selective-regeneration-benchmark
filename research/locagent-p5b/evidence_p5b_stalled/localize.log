 635 |     def update(self, refresh=False, **data):
 636 |         cls = self.__class__
 637 |         cls.objects.filter(pk=self.pk).update(**data)
 638 | 
 639 |         if refresh:
 640 |             return self.reload()
 641 |         else:
 642 |             for field, value in data.items():
 643 |                 setattr(self, field, value)
 644 |         return

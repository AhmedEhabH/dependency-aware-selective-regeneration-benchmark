120 |     you must defined at least the same API as FileOutputWrapper, as well
121 |     as these four additional methods:
122 | 
123 |         finish_success(message): End the section (successfully)
124 |         finish_error(message): End the section with errors
125 |         finish_warning(message): End this section with a warning
126 |         finish_skip(message): End this (skipped) section
127 |     """
128 |     def __init__(self, wrapper):
129 |         super(FileSectionWrapper, self).__init__(wrapper.stdout, wrapper.stderr)
130 |         self.wrapper = wrapper
131 | 
132 |     def write_line(self, message=''):

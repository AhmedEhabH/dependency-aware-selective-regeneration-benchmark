1649 |     def get_published_pagelist(self, *args, **kwargs):
1650 |         """
1651 |          This view is used by the PageSmartLinkWidget as the user type to feed the autocomplete drop-down.
1652 |         """
1653 |         request = args[0]
1654 | 
1655 |         if request.is_ajax():
1656 |             query_term = request.GET.get('q','').strip('/')
1657 | 
1658 |             language_code = request.GET.get('language_code', settings.LANGUAGE_CODE)
1659 |             matching_published_pages = self.model.objects.published().public().filter(
1660 |                 Q(title_set__title__icontains=query_term, title_set__language=language_code)
1661 |                 | Q(title_set__path__icontains=query_term, title_set__language=language_code)
1662 |                 | Q(title_set__menu_title__icontains=query_term, title_set__language=language_code)
1663 |                 | Q(title_set__page_title__icontains=query_term, title_set__language=language_code)
1664 |             ).distinct()
1665 | 
1666 |             results = []
1667 |             for page in matching_published_pages:
1668 |                 results.append(
1669 |                     {
1670 |                         'path': page.get_path(language=language_code),
1671 |                         'title': page.get_title(language=language_code),
1672 |                         'redirect_url': page.get_absolute_url(language=language_code)
1673 |                     }
1674 |                 )
1675 |             return HttpResponse(json.dumps(results), content_type='application/json')
1676 |         return HttpResponseForbidden()

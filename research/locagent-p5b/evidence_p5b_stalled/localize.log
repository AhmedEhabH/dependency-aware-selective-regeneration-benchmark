1080 |     def get_parent(self):
1081 |         node = self._nodes_cache.get(self.site_id)
1082 | 
1083 |         if not node:
1084 |             if self.publisher_is_draft:
1085 |                 node = (
1086 |                     self
1087 |                     .nodes
1088 |                     .select_related('parent', 'parent__page')
1089 |                     .get(site=self.site_id)
1090 |                 )
1091 |             else:
1092 |                 node = (
1093 |                     PageNode
1094 |                     .objects
1095 |                     .select_related(
1096 |                         'parent',
1097 |                         'parent__page',
1098 |                         'parent__page__publisher_public',
1099 |                     )
1100 |                     .get(page=self.publisher_public_id, site=self.site_id)
1101 |                 )
1102 | 
1103 |             self._nodes_cache[self.site_id] = node
1104 | 
1105 |         if self.publisher_is_draft or not node.parent_page:
1106 |             return node.parent_page
1107 |         return node.parent_page.get_public_object()

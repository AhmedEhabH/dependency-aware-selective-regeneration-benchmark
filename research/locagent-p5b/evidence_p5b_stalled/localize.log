 885 |     @require_POST
 886 |     @transaction.atomic
 887 |     def copy_language(self, request, page_id):
 888 |         page = self.get_object(request, object_id=page_id)
 889 |         source_language = request.POST.get('source_language')
 890 |         target_language = request.POST.get('target_language')
 891 | 
 892 |         if not self.has_change_permission(request, obj=page):
 893 |             raise PermissionDenied
 894 | 
 895 |         if page is None:
 896 |             raise self._get_404_exception(page_id)
 897 | 
 898 |         if not target_language or not target_language in get_language_list(site_id=page.site_id):
 899 |             return HttpResponseBadRequest(force_text(_("Language must be set to a supported language!")))
 900 | 
 901 |         for placeholder in page.get_placeholders():
 902 |             plugins = list(
 903 |                 placeholder.get_plugins(language=source_language).order_by('path'))
 904 |             if not placeholder.has_add_plugins_permission(request.user, plugins):
 905 |                 return HttpResponseForbidden(force_text(_('You do not have permission to copy these plugins.')))
 906 |             copy_plugins.copy_plugins_to(plugins, placeholder, target_language)
 907 |         return HttpResponse("ok")

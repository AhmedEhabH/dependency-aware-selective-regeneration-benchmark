 461 |     def get_copy_dialog(self, request, page_id):
 462 |         if not get_cms_setting('PERMISSION'):
 463 |             return HttpResponse('')
 464 | 
 465 |         page = self.get_page_from_id(page_id)
 466 | 
 467 |         if page is None:
 468 |             raise self._get_404_exception(page_id)
 469 | 
 470 |         if request.method == 'GET':
 471 |             data = request.GET
 472 |         else:
 473 |             data = request.POST
 474 | 
 475 |         target_id = data.get('target')
 476 | 
 477 |         try:
 478 |             source_site_id = data['source_site']
 479 |             source_site = Site.objects.get(pk=source_site_id)
 480 |         except (KeyError, ObjectDoesNotExist):
 481 |             return HttpResponseBadRequest('source_site is required')
 482 | 
 483 |         site = self.get_site(request)
 484 |         user = request.user
 485 |         can_view_page = page_permissions.user_can_view_page(user, page, source_site)
 486 | 
 487 |         if not can_view_page:
 488 |             raise PermissionDenied
 489 | 
 490 |         if target_id:
 491 |             try:
 492 |                 target = Page.objects.get(pk=target_id)
 493 |             except Page.DoesNotExist:
 494 |                 raise Http404
 495 | 
 496 |             if not page_permissions.user_can_add_subpage(user, target, site):
 497 |                 raise PermissionDenied
 498 |         elif not page_permissions.user_can_add_page(user, site):
 499 |             raise PermissionDenied
 500 | 
 501 |         context = {
 502 |             'dialog_id': 'dialog-copy',
 503 |             'form': CopyPermissionForm(),  # class needs to be instantiated
 504 |             'opts': self.opts,
 505 |         }
 506 |         return render(request, "admin/cms/page/tree/copy_premissions.html", context)
 507 | 
 508 |     def get_filled_languages(self, request, obj):

1605 |     @require_POST
1606 |     @transaction.atomic
1607 |     def set_home(self, request, object_id):
1608 |         page = self.get_object(request, object_id=object_id)
1609 | 
1610 |         if not self.has_change_permission(request, page):
1611 |             raise PermissionDenied("You do not have permission to set 'home'")
1612 | 
1613 |         if page is None:
1614 |             raise self._get_404_exception(object_id)
1615 | 
1616 |         if not page.is_potential_home():
1617 |             return HttpResponseBadRequest(force_text(_("The page is not eligible to be home.")))
1618 | 
1619 |         new_home_tree, old_home_tree = Page.set_homepage(page, user=request.user)
1620 | 
1621 |         # Check if one of the affected pages either from the old homepage
1622 |         # or the homepage had an apphook attached
1623 |         if old_home_tree:
1624 |             apphooks_affected = (
1625 |                 self
1626 |                 .model
1627 |                 .objects
1628 |                 .filter(pk__in=old_home_tree, publisher_is_draft=False)
1629 |                 .has_apphooks()
1630 |             )
1631 |         else:
1632 |             apphooks_affected = False
1633 | 
1634 |         if not apphooks_affected:
1635 |             apphooks_affected = (
1636 |                 self
1637 |                 .model
1638 |                 .objects
1639 |                 .filter(pk__in=new_home_tree, publisher_is_draft=False)
1640 |                 .has_apphooks()
1641 |             )
1642 | 
1643 |         if apphooks_affected:
1644 |             # One or more pages affected by this operation was attached to an apphook.
1645 |             # As a result, fire the apphook reload signal to reload the url patterns.
1646 |             set_restart_trigger()
1647 |         return HttpResponse('ok')

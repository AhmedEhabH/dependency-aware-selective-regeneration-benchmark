 677 |     def changelist_view(self, request, extra_context=None):
 678 |         from django.contrib.admin.views.main import ERROR_FLAG
 679 | 
 680 |         if not self.has_change_permission(request, obj=None):
 681 |             raise PermissionDenied
 682 | 
 683 |         if request.method == 'POST' and 'site' in request.POST:
 684 |             site_id = request.POST['site']
 685 | 
 686 |             if site_id.isdigit() and Site.objects.filter(pk=site_id).exists():
 687 |                 request.session['cms_admin_site'] = site_id
 688 | 
 689 |         site = self.get_site(request)
 690 |         # Language may be present in the GET dictionary but empty
 691 |         language = request.GET.get('language', get_language())
 692 | 
 693 |         if not language:
 694 |             language = get_language()
 695 | 
 696 |         node_admin = self.node_admin(model=PageNode, admin_site=self.admin_site)
 697 | 
 698 |         query = request.GET.get('q', '')
 699 |         nodes = self.get_nodes_queryset(request)
 700 |         nodes, use_distinct = node_admin.get_search_results(request, nodes, query)
 701 | 
 702 |         changelist_form = self.changelist_form(request.GET)
 703 | 
 704 |         try:
 705 |             changelist_form.full_clean()
 706 |             nodes = changelist_form.run_filters(nodes)
 707 |         except (ValueError, ValidationError):
 708 |             # Wacky lookup parameters were given, so redirect to the main
 709 |             # changelist page, without parameters, and pass an 'invalid=1'
 710 |             # parameter via the query string. If wacky parameters were given
 711 |             # and the 'invalid=1' parameter was already in the query string,
 712 |             # something is screwed up with the database, so display an error
 713 |             # page.
 714 |             if ERROR_FLAG in request.GET.keys():
 715 |                 return SimpleTemplateResponse('admin/invalid_setup.html', {
 716 |                     'title': _('Database error'),
 717 |                 })
 718 |             return HttpResponseRedirect(request.path + '?' + ERROR_FLAG + '=1')
 719 | 
 720 |         if changelist_form.is_filtered():
 721 |             nodes = nodes.distinct() if use_distinct else nodes
 722 |             # Evaluates the queryset
 723 |             has_items = len(nodes) >= 1
 724 |         else:
 725 |             has_items = nodes.exists()
 726 | 
 727 |         context = self.admin_site.each_context(request)
 728 |         context.update({
 729 |             'opts': self.model._meta,
 730 |             'media': self.media,
 731 |             'CMS_MEDIA_URL': get_cms_setting('MEDIA_URL'),
 732 |             'CMS_PERMISSION': get_cms_setting('PERMISSION'),
 733 |             'site_languages': get_language_list(site.pk),
 734 |             'preview_language': language,
 735 |             'changelist_form': changelist_form,
 736 |             'cms_current_site': site,
 737 |             'has_add_permission': self.has_add_permission(request),
 738 |             'module_name': force_text(self.model._meta.verbose_name_plural),
 739 |             'admin': self,
 740 |             #'preserved_filters': self.get_preserved_filters(request),
 741 |             'tree': {
 742 |                 'site': site,
 743 |                 'sites': permissions.get_user_sites_queryset(request.user),
 744 |                 'query': query,
 745 |                 'is_filtered': changelist_form.is_filtered(),
 746 |                 'items': nodes,
 747 |                 'has_items': has_items,
 748 |             },
 749 |         })
 750 |         context.update(extra_context or {})
 751 |         request.current_app = self.admin_site.name
 752 |         return TemplateResponse(request, self.change_list_template, context)

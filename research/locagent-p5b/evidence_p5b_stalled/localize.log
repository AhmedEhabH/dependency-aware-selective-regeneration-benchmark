 6 | 
 7 | class SafeJSONEncoder(DjangoJSONEncoder):
 8 |     def _recursive_escape(self, o, esc=conditional_escape):
 9 |         if isinstance(o, dict):
10 |             return type(o)((esc(k), self._recursive_escape(v)) for (k, v) in dict.items(o))
11 |         if isinstance(o, (list, tuple)):
12 |             return type(o)(self._recursive_escape(v) for v in o)
13 |         if isinstance(o, bool):
14 |             return o
15 |         try:
16 |             return type(o)(esc(o))
17 |         except (ValueError, TypeError):
18 |             return self.default(o)
19 | 
20 |     def encode(self, o):
21 |         value = self._recursive_escape(o)
22 |         return super().encode(value)
23 | 
24 |     def default(self, o):

 773 |     @require_POST
 774 |     @transaction.atomic
 775 |     def move_page(self, request, page_id, extra_context=None):
 776 |         """
 777 |         Move the page to the requested target, at the given position.
 778 | 
 779 |         NOTE: We have to change from one "coordinate system" to another to
 780 |         adapt JSTree to Django Treebeard.
 781 | 
 782 |         If the Tree looks like this:
 783 | 
 784 |             <root>
 785 |                ⊢ …
 786 |                ⊢ …
 787 |                ⊢ Page 4
 788 |                    ⊢ Page 5 (position 0)
 789 |                    ⊢ …
 790 | 
 791 |         For example,
 792 |             target=4, position=1 => target=5, position="right"
 793 |             target=4, position=0 => target=4, position="first-child"
 794 | 
 795 |         """
 796 |         site = self.get_site(request)
 797 |         page = self.get_object(request, object_id=page_id)
 798 | 
 799 |         if page is None:
 800 |             return jsonify_request(HttpResponseBadRequest("error"))
 801 | 
 802 |         user = request.user
 803 |         form = self.move_form(request.POST or None, page=page, site=site)
 804 | 
 805 |         if not form.is_valid():
 806 |             return jsonify_request(HttpResponseBadRequest("error"))
 807 | 
 808 |         target = form.cleaned_data['target']
 809 |         can_move_page = self.has_move_page_permission(request, obj=page)
 810 | 
 811 |         # Does the user have permissions to do this...?
 812 |         if not can_move_page or (target and not target.has_add_permission(user)):
 813 |             message = force_text(_("Error! You don't have permissions "
 814 |                                    "to move this page. Please reload the page"))
 815 |             return jsonify_request(HttpResponseForbidden(message))
 816 | 
 817 |         operation_token = self._send_pre_page_operation(
 818 |             request,
 819 |             operation=operations.MOVE_PAGE,
 820 |             obj=page,
 821 |         )
 822 | 
 823 |         form.move_page()
 824 | 
 825 |         self._send_post_page_operation(
 826 |             request,
 827 |             operation=operations.MOVE_PAGE,
 828 |             token=operation_token,
 829 |             obj=page,
 830 |         )
 831 |         return jsonify_request(HttpResponse(status=200))
 832 | 
 833 |     def get_permissions(self, request, page_id):
 834 |         rows = []
 835 |         user = request.user
 836 |         page = self.get_object(request, object_id=page_id)
 837 | 
 838 |         if page is None:
 839 |             raise self._get_404_exception(page_id)
 840 | 
 841 |         site = self.get_site(request)
 842 |         PermissionRow = namedtuple('Permission', ['is_global', 'can_change', 'permission'])
 843 | 
 844 |         global_permissions = GlobalPagePermission.objects.filter(sites__in=[site.pk])
 845 |         can_change_global_permissions = permissions.user_can_change_global_permissions(user, site)
 846 | 
 847 |         for permission in global_permissions.iterator():
 848 |             row = PermissionRow(
 849 |                 is_global=True,
 850 |                 can_change=can_change_global_permissions,
 851 |                 permission=permission,
 852 |             )
 853 |             rows.append(row)
 854 | 
 855 |         _page_permissions = (
 856 |             PagePermission
 857 |             .objects
 858 |             .for_page(page)
 859 |             .select_related('page')
 860 |         )
 861 | 
 862 |         if not can_change_global_permissions:
 863 |             allowed_pages = frozenset(page_permissions.get_change_id_list(user, site, check_global=False))
 864 | 
 865 |         for permission in _page_permissions.iterator():
 866 |             if can_change_global_permissions:
 867 |                 can_change = True
 868 |             else:
 869 |                 can_change = permission.page_id in allowed_pages
 870 | 
 871 |             row = PermissionRow(
 872 |                 is_global=False,
 873 |                 can_change=can_change,
 874 |                 permission=permission,
 875 |             )
 876 |             rows.append(row)
 877 | 
 878 |         context = {
 879 |             'page': page,
 880 |             'rows': rows,
 881 |             'opts': self.opts,
 882 |         }
 883 |         return render(request, 'admin/cms/page/permissions.html', context)

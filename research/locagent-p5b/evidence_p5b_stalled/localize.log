 558 |     def _get_404_exception(self, object_id):
 559 |         exception = Http404(_('%(name)s object with primary key %(key)r does not exist.') % {
 560 |             'name': force_text(self.opts.verbose_name),
 561 |             'key': escape(object_id),
 562 |         })
 563 |         return exception

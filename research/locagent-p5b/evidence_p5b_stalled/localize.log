 995 |     @require_POST
 996 |     @transaction.atomic
 997 |     def publish_page(self, request, page_id, language):
 998 |         page = self.get_object(request, object_id=page_id)
 999 | 
1000 |         if page and not self.has_publish_permission(request, obj=page):
1001 |             return HttpResponseForbidden(force_text(_("You do not have permission to publish this page")))
1002 | 
1003 |         if page:
1004 |             translation = page.get_title_obj(language, fallback=False)
1005 |         else:
1006 |             translation = None
1007 | 
1008 |         if page and not translation:
1009 |             raise Http404('No translation matches requested language.')
1010 | 
1011 |         all_published = True
1012 | 
1013 |         statics = request.GET.get('statics', '')
1014 | 
1015 |         if not statics and not page:
1016 |             raise Http404("No page or static placeholder found for publishing.")
1017 | 
1018 |         if translation and translation.publisher_public:
1019 |             reload_urls = translation._url_properties_changed()
1020 |         else:
1021 |             reload_urls = bool(page and page.application_urls and translation)
1022 | 
1023 |         if page:
1024 |             operation_token = self._send_pre_page_operation(
1025 |                 request,
1026 |                 operation=operations.PUBLISH_PAGE_TRANSLATION,
1027 |                 obj=page,
1028 |                 translation=translation,
1029 |             )
1030 |             all_published = page.publish(language)
1031 |             page = page.reload()
1032 |             self._send_post_page_operation(
1033 |                 request,
1034 |                 operation=operations.PUBLISH_PAGE_TRANSLATION,
1035 |                 token=operation_token,
1036 |                 obj=page,
1037 |                 translation=translation,
1038 |                 successful=all_published,
1039 |             )
1040 | 
1041 |         if statics:
1042 |             static_ids = statics.split(',')
1043 |             static_placeholders = StaticPlaceholder.objects.filter(pk__in=static_ids)
1044 | 
1045 |             for static_placeholder in static_placeholders.iterator():
1046 |                 # TODO: Maybe only send one signal...
1047 |                 # this would break the obj signal format though
1048 |                 operation_token = self._send_pre_page_operation(
1049 |                     request,
1050 |                     operation=operations.PUBLISH_STATIC_PLACEHOLDER,
1051 |                     obj=static_placeholder,
1052 |                     target_language=language,
1053 |                 )
1054 | 
1055 |                 published = static_placeholder.publish(request, language)
1056 | 
1057 |                 self._send_post_page_operation(
1058 |                     request,
1059 |                     operation=operations.PUBLISH_STATIC_PLACEHOLDER,
1060 |                     token=operation_token,
1061 |                     obj=static_placeholder,
1062 |                     target_language=language,
1063 |                 )
1064 |                 if not published:
1065 |                     all_published = False
1066 | 
1067 |         if page:
1068 |             if all_published:
1069 |                 if reload_urls:
1070 |                     set_restart_trigger()
1071 | 
1072 |                 if page.get_publisher_state(language) == PUBLISHER_STATE_PENDING:
1073 |                     messages.warning(request, _("Page not published! A parent page is not published yet."))
1074 |                 else:
1075 |                     messages.info(request, _('The content was successfully published.'))
1076 |                 LogEntry.objects.log_action(
1077 |                     user_id=request.user.id,
1078 |                     content_type_id=ContentType.objects.get_for_model(Page).pk,
1079 |                     object_id=page_id,
1080 |                     object_repr=page.get_title(language),
1081 |                     action_flag=CHANGE,
1082 |                 )
1083 |             else:
1084 |                 if page.get_publisher_state(language) == PUBLISHER_STATE_PENDING:
1085 |                     messages.warning(request, _("Page not published! A parent page is not published yet."))
1086 |                 else:
1087 |                     messages.warning(request, _("There was a problem publishing your content"))
1088 | 
1089 |         if 'node' in request.GET or 'node' in request.POST:
1090 |             # if request comes from tree..
1091 |             # 204 -> request was successful but no response returned.
1092 |             return HttpResponse(status=204)
1093 | 
1094 |         if 'redirect' in request.GET:
1095 |             return HttpResponseRedirect(request.GET['redirect'])
1096 |         referrer = request.META.get('HTTP_REFERER', '')
1097 | 
1098 |         path = admin_reverse("cms_page_changelist")
1099 |         if request.GET.get('redirect_language'):
1100 |             path = "%s?language=%s&page_id=%s" % (path, request.GET.get('redirect_language'), request.GET.get('redirect_page_id'))
1101 |         if admin_reverse('index') not in referrer:
1102 |             if all_published:
1103 |                 if page:
1104 |                     if page.get_publisher_state(language) == PUBLISHER_STATE_PENDING:
1105 |                         path = page.get_absolute_url(language, fallback=True)
1106 |                     else:
1107 |                         public_page = Page.objects.get(publisher_public=page.pk)
1108 |                         path = '%s?preview&%s' % (public_page.get_absolute_url(language, fallback=True), get_cms_setting('CMS_TOOLBAR_URL__EDIT_OFF'))
1109 |                 else:
1110 |                     path = '%s?preview&%s' % (referrer, get_cms_setting('CMS_TOOLBAR_URL__EDIT_OFF'))
1111 |             else:
1112 |                 path = '/?preview&%s' % get_cms_setting('CMS_TOOLBAR_URL__EDIT_OFF')
1113 | 
1114 |         return HttpResponseRedirect(path)

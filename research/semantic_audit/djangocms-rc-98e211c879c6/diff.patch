+    key = '{prefix}|placeholder_cache_version|id:{id}|lang:{lang}'.format(
+        prefix=prefix,
+        id=placeholder.pk,
+        lang=str(lang)
+    )
+    if len(key) > 250:
+        key = '{prefix}|{hash}'.format(
+            prefix=prefix,
+            hash=hashlib.md5(key.encode('utf-8')).hexdigest(),
+        )
+    return key
+

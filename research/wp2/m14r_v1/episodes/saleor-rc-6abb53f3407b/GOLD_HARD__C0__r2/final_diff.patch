+def handle_updated_payment_intent(
+    payment_intent: StripeObject, gateway_config: "GatewayConfig", _channel_slug: str
+):
+    """Handle payment intent updated event - typically when payment method changes."""
+    payment = _get_payment(payment_intent.id)
+
+    if not payment:
+        logger.warning(
+            "Payment for PaymentIntent was not found",
+            extra={"payment_intent": payment_intent.id},
+        )
+        return
+
+    # Update payment method details if they changed
+    payment_method_info = get_payment_method_details(payment_intent)
+    if payment_method_info:
+        changed_fields: List[str] = []
+        update_payment_method_details(payment, payment_method_info, changed_fields)
+        if changed_fields:
+            payment.save(update_fields=changed_fields)
+

+
+
+class ProductSetAvailabilityForPurchase(BaseMutation):
+    product = graphene.Field(Product)
+
+    class Arguments:
+        product_id = graphene.ID(
+            required=True, description="ID of a product to set availability for purchase."
+        )
+        is_available = graphene.Boolean(
+            required=True, description="Determine if product is available for purchase."
+        )
+
+    class Meta:
+        description = "Set product availability for purchase."
+        permissions = (ProductPermissions.MANAGE_PRODUCTS,)
+        error_type_class = ProductError
+        error_type_field = "product_errors"
+
+    @classmethod
+    def perform_mutation(cls, _root, info, product_id, is_available):
+        product = cls.get_node_or_error(
+            info, product_id, field="productId", only_type=Product
+        )
+        
+        if is_available and not product.category:
+            raise ValidationError(
+                {
+                    "productId": ValidationError(
+                        "Product must have a category to be available for purchase.",
+                        code=ProductErrorCode.REQUIRED,
+                    )
+                }
+            )
+            
+        product.available_for_purchase = None if not is_available else product.available_for_purchase or timezone.now().date()
+        product.save(update_fields=["available_for_purchase"])
+        
+        return ProductSetAvailabilityForPurchase(product=product)

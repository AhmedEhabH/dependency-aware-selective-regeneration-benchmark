+def _release_voucher_usage(checkout: Checkout):
+    """Release the voucher usage when voucher is removed from checkout."""
+    if not checkout.voucher_code:
+        return
+        
+    try:
+        voucher = Voucher.objects.get(code=checkout.voucher_code)
+        
+        # Decrease the voucher usage count if it was applied
+        if voucher.used > 0:
+            voucher.used -= 1
+            voucher.save(update_fields=["used"])
+            
+        # Remove the customer voucher record if exists
+        if checkout.user_id:
+            VoucherCustomer.objects.filter(
+                voucher=voucher,
+                customer_id=checkout.user_id
+            ).delete()
+            
+    except Voucher.DoesNotExist:
+        pass
+

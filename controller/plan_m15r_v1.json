{
 "id": "WP2_M15R_V1",
 "settings": {
  "state_file": "research/wp2/m15r_v1/controller_state.json",
  "report_dir": "research/wp2/m15r_v1/controller_reports",
  "stop_flag": "logs/M15R_STOP.flag",
  "kit_manifest": "controller/KIT_MANIFEST_M15R.json",
  "git_commit": true,
  "git_push": true,
  "remote": "origin",
  "branch": "main",
  "stop_commit_prefixes": [
   "research/wp2/m15r_v1/"
  ],
  "resumable_tokens": [
   "READINESS_ENV_FAIL",
   "NOT_AUTHORIZED",
   "PAID_PREFLIGHT_FAIL",
   "E2E_PROVIDER_OUTAGE",
   "HOLD_ACTIVE",
   "USER_STOP_FLAG",
   "EVAL_ERROR",
   "CLOSE_FAIL",
   "POST_ACTION_FAILED",
   "FINAL_ACTION_FAILED"
  ],
  "exports": {
   "light": [
    "{python}",
    "scripts/wp2_export_light.py",
    "--profile",
    "controller/light_profile_m15r.json",
    "--label",
    "{label}"
   ]
  },
  "final_actions": [
   {
    "type": "commit",
    "prefixes": [
     "research/wp2/m15r_v1/",
     "docs/WP2_M15R_V1_RESULT.md",
     "docs/WP2_M15R_V1_OPWS_RESULT.md"
    ],
    "message": "evidence(wp2): close M15-R V1"
   },
   {
    "type": "push"
   },
   {
    "type": "tag",
    "name": "wp2-m15r-v1-result-{date}",
    "message": "WP2 M15-R V1 result"
   },
   {
    "type": "exports",
    "label": "M15R_RESULT",
    "required": [
     "light"
    ]
   }
  ]
 },
 "phases": [
  {
   "id": "Q00_KIT_SELFTEST",
   "title": "M15-R kit self-tests (zero network)",
   "command": [
    "{python}",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "tests/unit/wp2/m15r"
   ],
   "timeout_s": 900,
   "fail_token": "KIT_SELFTEST_FAIL",
   "allowed_write_prefixes": []
  },
  {
   "id": "Q01_GUARD",
   "title": "design/M14R/Pilot-A immutability + Pilot-B protection guard (zero API)",
   "requires": [
    "Q00_KIT_SELFTEST"
   ],
   "command": [
    "{python}",
    "scripts/wp2_m15r_run.py",
    "guard"
   ],
   "timeout_s": 1800,
   "fail_token": "M15R_GUARD_FAIL",
   "exit_codes": {
    "78": "STOP:M15R_GUARD_FAIL"
   },
   "allowed_write_prefixes": [
    "research/wp2/m15r_v1/m15r_guard.json"
   ],
   "commit_message": "evidence(wp2): M15-R guard"
  },
  {
   "id": "Q02_READINESS",
   "title": "S0 readiness: empty-diff negative + scoped-gold positive (zero API, Docker)",
   "requires": [
    "Q01_GUARD"
   ],
   "kind": "loop",
   "done_checks": [
    {
     "type": "command_ok",
     "command": [
      "{python}",
      "scripts/wp2_m15r_run.py",
      "readiness-check"
     ]
    }
   ],
   "command": [
    "{python}",
    "scripts/wp2_m15r_run.py",
    "readiness",
    "--max-new",
    "1"
   ],
   "timeout_s": 14400,
   "max_retries": 0,
   "max_iterations": 30,
   "fail_token": "READINESS_ENV_FAIL",
   "exit_codes": {
    "33": "STOP:READINESS_ENV_FAIL",
    "78": "STOP:M15R_INVARIANT"
   },
   "progress": {
    "glob": "research/wp2/m15r_v1/readiness/*/record.json"
   },
   "allowed_write_prefixes": [
    "research/wp2/m15r_v1/readiness/",
    "research/wp2/m15r_v1/junit/"
   ],
   "commit_each_iteration": true,
   "commit_message": "evidence(wp2): M15-R readiness progress"
  },
  {
   "id": "Q03_MEMBERSHIP",
   "title": "apply the frozen readiness rule (>= 6 READY tasks)",
   "requires": [
    "Q02_READINESS"
   ],
   "command": [
    "{python}",
    "scripts/wp2_m15r_run.py",
    "membership"

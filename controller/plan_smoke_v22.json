{
 "id": "WP2_E2E_SMOKE_ENG_V22",
 "settings": {
  "state_file": "research/wp2/e2e_smoke_eng_v22/controller_state.json",
  "report_dir": "research/wp2/e2e_smoke_eng_v22/controller_reports",
  "stop_flag": "logs/E2E_STOP.flag",
  "git_commit": true, "git_push": true, "remote": "origin", "branch": "main",
  "stop_commit_prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
  "resumable_tokens": ["E2E_PROVIDER_OUTAGE", "HOLD_ACTIVE", "USER_STOP_FLAG",
                       "ENV_DOCTOR_FAIL", "PAID_PREFLIGHT_FAIL", "EVAL_ERROR"],
  "exports": {
   "light": ["{python}", "scripts/wp2_export_light.py", "--profile",
             "controller/light_profile_v22.json", "--label", "{label}"]
  }
 },
 "phases": [
  {"id": "P00_KIT_SELFTEST", "title": "kit hashes + kit unit tests",
   "command": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/unit/wp2/e2e_v22"],
   "timeout_s": 1800, "fail_token": "KIT_SELFTEST_FAIL", "allowed_write_prefixes": []},

  {"id": "P01_CLOSE_V21", "title": "close v2.1 as TRANSPORT_ABORTED_DIAGNOSTIC_RUN",
   "requires": ["P00_KIT_SELFTEST"],
   "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--close-v21"],
   "fail_token": "V21_CLOSE_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v21/HOLD",
                              "research/wp2/e2e_smoke_eng_v21/V21_CLOSURE.json"],
   "pass_checks": [{"type": "file_exists", "path": "research/wp2/e2e_smoke_eng_v21/HOLD"},
                   {"type": "file_exists", "path": "research/wp2/e2e_smoke_eng_v21/V21_CLOSURE.json"}],
   "commit_message": "evidence(wp2): close v2.1 as TRANSPORT_ABORTED_DIAGNOSTIC_RUN (controller)"},

  {"id": "P02_DOCTOR_OFFLINE", "title": "local environment doctor",
   "requires": ["P01_CLOSE_V21"],
   "command": ["{python}", "scripts/wp2_e2e_v22_doctor.py", "--offline"],
   "timeout_s": 1800, "max_retries": 1, "fail_token": "ENV_DOCTOR_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/doctor/"],
   "commit_message": "evidence(wp2): v2.2 doctor offline PASS (controller)"},

  {"id": "P03_ENV_CANARY", "title": "zero-API positive/negative evaluator canary",
   "requires": ["P02_DOCTOR_OFFLINE"],
   "command": ["{python}", "scripts/wp2_e2e_v22_canary.py"],
   "timeout_s": 7200, "max_retries": 1, "fail_token": "ENV_CANARY_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/controls/",
                              "research/wp2/e2e_smoke_eng_v22/junit/"],
   "pass_checks": [{"type": "json_equals", "path": "research/wp2/e2e_smoke_eng_v22/controls/canary_v22.json",
                    "key": "pass", "value": true}],
   "commit_message": "evidence(wp2): v2.2 environment canary PASS (controller)"},

  {"id": "P04_DOCTOR_PAID", "title": "key, credit >= $5, pricing <= 2x (read-only endpoints)",
   "requires": ["P03_ENV_CANARY"],
   "command": ["{python}", "scripts/wp2_e2e_v22_doctor.py", "--paid"],
   "timeout_s": 1800, "max_retries": 1, "fail_token": "PAID_PREFLIGHT_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/doctor/"],
   "commit_message": "evidence(wp2): v2.2 doctor paid PASS (controller)"},

  {"id": "P05_FREEZE", "title": "freeze code, scopes, evaluator, env identity, policy",
   "requires": ["P04_DOCTOR_PAID"],
   "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--build"],
   "timeout_s": 1800, "fail_token": "FREEZE_BUILD_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/smoke_v22_freeze.json"],
   "pass_checks": [{"type": "file_exists", "path": "research/wp2/e2e_smoke_eng_v22/smoke_v22_freeze.json"},
                   {"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--verify"],
                    "fail_token": "FREEZE_DRIFT"}],
   "post_actions": [{"type": "commit", "prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
                     "message": "feat(wp2): freeze E2E Smoke ENG v2.2 (controller)"},
                    {"type": "tag", "name": "wp2-e2e-smoke-eng-v22-freeze-{date}",
                     "message": "E2E Smoke ENG v2.2 freeze (controller)"},
                    {"type": "push"}]},

  {"id": "P06_GEN_MAIN", "title": "main generation 56 episodes (paid, <= $2.00 total)",
   "kind": "loop", "requires": ["P05_FREEZE"],
   "pre_checks": [{"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--verify"],
                   "fail_token": "FREEZE_DRIFT"}],
   "command": ["{python}", "scripts/wp2_e2e_v22_generate.py", "--mode", "main",
               "--max-new-episodes", "8", "--max-seconds", "5400"],
   "timeout_s": 10800, "max_retries": 1, "max_iterations": 40,
   "exit_codes": {"3": "STOP:HOLD_ACTIVE", "4": "STOP:USER_STOP_FLAG",
                  "75": "STOP:E2E_PROVIDER_OUTAGE", "76": "STOP:E2E_REQUEST_REJECTED",
                  "77": "STOP:E2E_BUDGET_STOP", "78": "STOP:E2E_INVARIANT_OR_INSTRUMENT_ERROR"},
   "done_checks": [{"type": "count_files", "glob": "research/wp2/e2e_smoke_eng_v22/episodes/*/*/episode.json",
                    "where": {"status": ["NO_SCOPE", "INVALID_AFTER_REPAIR", "APPLIED"]},
                    "op": "==", "value": 56}],
   "progress": {"glob": "research/wp2/e2e_smoke_eng_v22/episodes/*/*/episode.json",
                "where": {"status": ["NO_SCOPE", "INVALID_AFTER_REPAIR", "APPLIED"]}},
   "fail_token": "E2E_GENERATION_ERROR",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
   "commit_message": "evidence(wp2): v2.2 main generation progress (controller)"},

  {"id": "P07_GEN_VARIANCE", "title": "variance probe 3 tasks x GOLD x 2 replicates",
   "kind": "loop", "requires": ["P06_GEN_MAIN"],
   "pre_checks": [{"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--verify"],
                   "fail_token": "FREEZE_DRIFT"}],
   "command": ["{python}", "scripts/wp2_e2e_v22_generate.py", "--mode", "variance",
               "--max-new-episodes", "6", "--max-seconds", "5400"],
   "timeout_s": 10800, "max_retries": 1, "max_iterations": 10,
   "exit_codes": {"3": "STOP:HOLD_ACTIVE", "4": "STOP:USER_STOP_FLAG",
                  "75": "STOP:E2E_PROVIDER_OUTAGE", "76": "STOP:E2E_REQUEST_REJECTED",
                  "77": "STOP:E2E_BUDGET_STOP", "78": "STOP:E2E_INVARIANT_OR_INSTRUMENT_ERROR"},
   "done_checks": [{"type": "count_files", "glob": "research/wp2/e2e_smoke_eng_v22/variance/*/*/episode.json",
                    "where": {"status": ["NO_SCOPE", "INVALID_AFTER_REPAIR", "APPLIED"]},
                    "op": "==", "value": 6}],
   "progress": {"glob": "research/wp2/e2e_smoke_eng_v22/variance/*/*/episode.json",
                "where": {"status": ["NO_SCOPE", "INVALID_AFTER_REPAIR", "APPLIED"]}},
   "fail_token": "E2E_GENERATION_ERROR",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
   "commit_message": "evidence(wp2): v2.2 variance generation progress (controller)"},

  {"id": "P08_GENERATION_FREEZE", "title": "generation invariants + freeze + push before any evaluation",
   "requires": ["P07_GEN_VARIANCE"],
   "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--generation-freeze"],
   "timeout_s": 1800, "fail_token": "GENERATION_FREEZE_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/generation_freeze_v22.json"],
   "pass_checks": [{"type": "json_equals", "path": "research/wp2/e2e_smoke_eng_v22/generation_freeze_v22.json",
                    "key": "n_episodes", "value": 62}],
   "post_actions": [{"type": "commit", "prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
                     "message": "evidence(wp2): v2.2 generation frozen (controller)"},
                    {"type": "push"}]},

  {"id": "P09_EVAL_PLAN", "title": "unique-diff evaluation plan",
   "requires": ["P08_GENERATION_FREEZE"],
   "pre_checks": [{"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--verify"],
                   "fail_token": "FREEZE_DRIFT"}],
   "command": ["{python}", "scripts/wp2_e2e_v22_evaluate.py", "--plan"],
   "timeout_s": 1800, "fail_token": "EVAL_PLAN_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/evaluations/"],
   "pass_checks": [{"type": "file_exists", "path": "research/wp2/e2e_smoke_eng_v22/evaluations/plan.json"}],
   "commit_message": "evidence(wp2): v2.2 evaluation plan (controller)"},

  {"id": "P10_EVALUATE", "title": "evaluate unique diffs (zero API, workers=1)",
   "kind": "loop", "requires": ["P09_EVAL_PLAN"],
   "pre_checks": [{"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--verify"],
                   "fail_token": "FREEZE_DRIFT"}],
   "command": ["{python}", "scripts/wp2_e2e_v22_evaluate.py", "--resume", "--max-evals", "4"],
   "timeout_s": 10800, "max_retries": 1, "max_iterations": 40,
   "done_checks": [{"type": "command_ok", "command": ["{python}", "scripts/wp2_e2e_v22_freeze.py", "--eval-complete"]}],
   "progress": {"glob": "research/wp2/e2e_smoke_eng_v22/evaluations/**/evaluation.json"},
   "fail_token": "EVAL_ERROR",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/"],
   "commit_message": "evidence(wp2): v2.2 evaluation progress (controller)"},

  {"id": "P11_SUMMARY", "title": "mechanical summary, gates, token, NEXT",
   "requires": ["P10_EVALUATE"],
   "command": ["{python}", "scripts/wp2_e2e_v22_summary.py"],
   "timeout_s": 1800, "fail_token": "SUMMARY_FAIL",
   "allowed_write_prefixes": ["research/wp2/e2e_smoke_eng_v22/smoke_v22_summary.json",
                              "docs/WP2_E2E_SMOKE_ENG_V22_REPORT_"],
   "pass_checks": [{"type": "file_exists", "path": "research/wp2/e2e_smoke_eng_v22/smoke_v22_summary.json"}],
   "post_actions": [{"type": "commit", "prefixes": ["research/wp2/e2e_smoke_eng_v22/", "docs/"],
                     "message": "evidence(wp2): E2E Smoke ENG v2.2 result (controller)"}]},

  {"id": "P12_CLOSE", "title": "result tag + exports + push",
   "requires": ["P11_SUMMARY"], "builtin": "noop", "fail_token": "CLOSE_FAIL",
   "allowed_write_prefixes": [],
   "post_actions": [{"type": "tag", "name": "wp2-e2e-smoke-eng-v22-result-{date}",
                     "message": "E2E Smoke ENG v2.2 result (controller)"},
                    {"type": "exports", "label": "SMOKE_V22_RESULT", "required": ["light"]},
                    {"type": "push"}]}
 ]
}

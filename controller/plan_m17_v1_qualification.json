{
  "id": "WP2_M17_V1_QUALIFICATION",
  "phases": [
    {
      "allowed_write_prefixes": [],
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "-p",
        "no:cacheprovider",
        "tests/unit/wp2/m17"
      ],
      "fail_token": "M17_KIT_SELFTEST_FAIL",
      "id": "Q00_KIT_SELFTEST",
      "timeout_s": 7200,
      "title": "M17 unit tests (zero network, zero Docker, zero WSL)"
    },
    {
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/m17_guard_qualification.json"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_run.py",
        "guard",
        "--stage",
        "qualification"
      ],
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "37": "STOP:M17_TAG_GATE",
        "78": "STOP:M17_INVARIANT",
        "79": "STOP:EVAL_ERROR"
      },
      "fail_token": "M17_INVARIANT",
      "id": "Q01_GUARD",
      "requires": [
        "Q00_KIT_SELFTEST"
      ],
      "timeout_s": 1800,
      "title": "guard: frozen P01/P02/P04/P05 hashes, membership freeze, protected pools, resource gates, absence checks (no scopes/, no opws/)"
    },
    {
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/adapter/"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_run.py",
        "adapter-verify"
      ],
      "commit_message": "evidence(wp2): M17 adapter verification (qualification stage)",
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "37": "STOP:M17_TAG_GATE",
        "78": "STOP:M17_INVARIANT",
        "79": "STOP:EVAL_ERROR"
      },
      "fail_token": "M17_ADAPTER_FAIL",
      "id": "Q02_ADAPTER_VERIFY",
      "requires": [
        "Q01_GUARD"
      ],
      "timeout_s": 7200,
      "title": "clean adapter: ENG identity (29/29), all 220 MAIN frame rows, ADAPTER_UNRESOLVED fail-closed (zero Docker)"
    },
    {
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/qualification/"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_exec.py",
        "qualification",
        "--max-items",
        "1"
      ],
      "commit_message": "evidence(wp2): M17 qualification oracle/readiness progress",
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "37": "STOP:M17_TAG_GATE",
        "78": "STOP:M17_INVARIANT",
        "79": "STOP:EVAL_ERROR",
        "1": "CONTINUE"
      },
      "fail_token": "M17_INVARIANT",
      "id": "Q03_QUALIFICATION_RUN",
      "requires": [
        "Q02_ADAPTER_VERIFY"
      ],
      "timeout_s": 5400,
      "title": "REAL 12-task selector-blind V3+R1 qualification; one task per loop",
      "kind": "loop",
      "max_iterations": 24,
      "max_retries": 1,
      "commit_each_iteration": true,
      "progress": {
        "glob": "research/wp2/m17_v1/qualification/saleor-rc-*.json"
      },
      "done_checks": [
        {
          "type": "command_ok",
          "command": [
            "{python}",
            "scripts/wp2_m17_exec.py",
            "qualification-complete"
          ]
        }
      ]
    },
    {
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/qualification/"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_exec.py",
        "qualification-report"
      ],
      "commit_message": "evidence(wp2): M17 qualification report",
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "37": "STOP:M17_TAG_GATE",
        "78": "STOP:M17_INVARIANT",
        "79": "STOP:EVAL_ERROR"
      },
      "fail_token": "M17_INVARIANT",
      "id": "Q04_QUALIFICATION_REPORT",
      "requires": [
        "Q03_QUALIFICATION_RUN"
      ],
      "timeout_s": 1800,
      "title": "produce the qualification report (deterministic terminal classification per task; environmental failures classified, never crash the instrument)"
    },
    {
      "id": "Q05_QUALIFICATION_GATE",
      "title": "Pre-registered mechanical qualification gate before unattended MAIN oracle",
      "requires": [
        "Q04_QUALIFICATION_REPORT"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_exec.py",
        "qualification-gate"
      ],
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/m17_qualification_gate.json"
      ],
      "timeout_s": 1800,
      "fail_token": "M17_QUALIFICATION_GATE_FAIL",
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "78": "STOP:M17_QUALIFICATION_GATE_FAIL",
        "79": "STOP:EVAL_ERROR"
      }
    },
    {
      "allowed_write_prefixes": [
        "research/wp2/m17_v1/qualification/"
      ],
      "command": [
        "{python}",
        "scripts/wp2_m17_run.py",
        "resource-projection"
      ],
      "commit_message": "evidence(wp2): M17 resource projection",
      "exit_codes": {
        "3": "STOP:HOLD_ACTIVE",
        "4": "STOP:USER_STOP_FLAG",
        "33": "STOP:M17_PREFLIGHT",
        "34": "STOP:M17_RESOURCE_GATE",
        "35": "STOP:M17_ADAPTER_FAIL",
        "36": "STOP:M17_FIREWALL",
        "37": "STOP:M17_TAG_GATE",
        "78": "STOP:M17_INVARIANT",
        "79": "STOP:EVAL_ERROR"
      },
      "fail_token": "M17_RESOURCE_REVIEW",
      "id": "Q06_RESOURCE_PROJECTION",
      "requires": [
        "Q05_QUALIFICATION_GATE"
      ],
      "timeout_s": 1800,
      "title": "resource projection against the P05 disk gates (M17_RESOURCE_REVIEW if projected final C: free < 25 GiB)"
    }
  ],
  "settings": {
    "branch": "main",
    "exports": {
      "light": [
        "{python}",
        "scripts/wp2_export_light.py",
        "--profile",
        "controller/light_profile_m17_qualification.json",
        "--label",
        "{label}"
      ]
    },
    "final_actions": [
      {
        "message": "evidence(wp2): M17 qualification stage",
        "prefixes": [
          "research/wp2/m17_v1/"
        ],
        "type": "commit"
      },
      {
        "type": "push"
      },
      {
        "label": "M17_QUALIFICATION",
        "required": [
          "light"
        ],
        "type": "exports"
      }
    ],
    "git_commit": true,
    "git_push": true,
    "kit_manifest": "controller/KIT_MANIFEST_M17.json",
    "remote": "origin",
    "report_dir": "research/wp2/m17_v1/controller_reports_qualification",
    "resumable_tokens": [
      "NOT_YET",
      "HOLD_ACTIVE",
      "USER_STOP_FLAG",
      "EVAL_ERROR",
      "M17_PREFLIGHT",
      "M17_RESOURCE_GATE",
      "M17_TAG_GATE",
      "POST_ACTION_FAILED",
      "FINAL_ACTION_FAILED",
      "NO_PROGRESS"
    ],
    "state_file": "research/wp2/m17_v1/controller_state_qualification.json",
    "stop_commit_prefixes": [
      "research/wp2/m17_v1/"
    ],
    "stop_flag": "logs/M17_STOP.flag",
    "stop_token": "M17_QUALIFICATION_COMPLETE_REVIEW"
  }
}
